27223/20EB09 :                          
27224/20EB09 :                          ; ---- src/id_road_asm.asm
27225/20EB09 :                          ; id_road_asm.asm - la marche par tranches de id_road_write(), en assembleur
27226/20EB09 :                          ;
27227/20EB09 :                          ; POURQUOI EN ASSEMBLEUR. Profil de la ROM livree (tools/profil_course.py,
27228/20EB09 :                          ; temporisation de la cartouche comprise) : cette boucle etait le plus gros
27229/20EB09 :                          ; poste du tour de course. cc900 n'y gardait pas ses valeurs en registres --
27230/20EB09 :                          ; tout allait sur la pile -- et relisait chaque adresse de table par une
27231/20EB09 :                          ; instruction de cinq octets, cinquante-six fois par trame. Sur cette machine
27232/20EB09 :                          ; chaque octet d'instruction se lit dans la cartouche.
27233/20EB09 :                          ;
27234/20EB09 :                          ; LE CALCUL EST CELUI DU C, A L'OCTET PRES : la version C est gardee dans
27235/20EB09 :                          ; id_road.c (ID_ROAD_WALK_C=1) et tools/equivalence.py compare, tour de boucle
27236/20EB09 :                          ; par tour de boucle, la RAM de cette ROM a celle de la ROM d'origine sur les
27237/20EB09 :                          ; dix circuits.
27238/20EB09 :                          ;
27239/20EB09 :                          ; !! SEULEMENT DES FORMES QUE cc900 EMET DEJA. Les pieges materiel connus de ce
27240/20EB09 :                          ; processeur (docs du projet, fiches) venaient d'encodages que Toshiba n'emet
27241/20EB09 :                          ; pas. `python tools/formes_asm.py` verifie chaque instruction de ce fichier
27242/20EB09 :                          ; contre le code que cc900 genere pour ce projet (build/prof_asm/*.asm).
27243/20EB09 :                          ;
27244/20EB09 :                          ; void id_road_walk_asm(RoadWalk *w);
27245/20EB09 :                          ;
27246/20EB09 :                          ;   (xsp+0) adresse de retour, 4 octets ; (xsp+4) w.
27247/20EB09 :                          ;   cc900 : seul XIZ doit etre preserve (ses fonctions le poussent quand elles
27248/20EB09 :                          ;   s'en servent) ; XWA XBC XDE XHL XIX XIY sont a l'appele.
27249/20EB09 :                          ;
27250/20EB09 :                          ; SECONDE ECRITURE (2026-09-19). La premiere relisait dans le bloc, a chaque
27251/20EB09 :                          ; tranche, sept pointeurs de table et l'accumulateur : 44 500 cycles par tour.
27252/20EB09 :                          ; Celle-ci tient toute la marche en registres :
27253/20EB09 :                          ;
27254/20EB09 :                          ;   XIX = &id_line_of[k]   (descend de 1)   la pente a +SL_GRADE, la bande a +SL_BANDI
27255/20EB09 :                          ;   XIY = &id_shear[k]     (descend de 2)
27256/20EB09 :                          ;   XHL = &xy[ligne]       (descend de 2 par ligne ecrite)
27257/20EB09 :                          ;   XDE = &bande[ligne]    (descend de 2 par ligne ecrite)
27258/20EB09 :                          ;   B   = l'accumulateur   C = la ligne courante (>= top : tient sur un octet)
27259/20EB09 :                          ;   XIZ = &hill_rate[20]   (la cadence, indice signe)
27260/20EB09 :                          ;
27261/20EB09 :                          ; Les valeurs fixes du bloc sont RECOPIEES sur la pile de la routine (F_*) et
27262/20EB09 :                          ; lues par (xsp+d) : c'est ce qui libere XIZ pour la table des cadences.
27263/20EB09 :                          ;
27264/20EB09 :                          ; LES DEUX RETENUES SANS SEIZE BITS. c = (acc + 2 rate) >> 8 et le nouvel
27265/20EB09 :                          ; accumulateur est l'octet bas : c'est exactement le nombre de retenues de deux
27266/20EB09 :                          ; additions de `rate` sur huit bits, et l'octet restant.
27267/20EB09 :                          ;
27268/20EB09 :                          ; LA LIGNE Y. (u8)((row >> 8) - (u8)(scr - plane0)) = (row >> 8) + plane0 - scr
27269/20EB09 :                          ; modulo 256 : les deux formes rendent le meme octet.
27270/20EB09 :                          ;
27271/20EB09 :                          ; LA COULEUR DE BANDE EN DEUX TEMPS. band_col[lut[id_bandi[k]]] demande deux
27272/20EB09 :                          ; pointeurs de table et la marche n'a plus de registre. Elle pose donc l'INDICE
27273/20EB09 :                          ; id_bandi[k] dans l'octet bas de l'entree du tampon de couleur, et une passe
27274/20EB09 :                          ; courte, apres elle, le convertit sur les seules lignes ecrites. Aucun octet de
27275/20EB09 :                          ; RAM de plus : la pile n'en a pas a donner (voir RoadSlices dans id_road.c).
27276/20EB09 :                          ;
27277/20EB09 :                          
27278/20EB09 :                          ; Le bloc RoadWalk (id_road.c ; sa TAILLE y est VERIFIEE a la compilation) :
27279/20EB09 : =0H                      V_XY      equ 0     ; u16 * &xy[road_bottom]
27280/20EB09 : =4H                      V_BAND    equ 4     ; u16 * &bandcol[road_bottom]
27281/20EB09 : =8H                      V_SL      equ 8     ; u8  * &id_line_of[lines]   (juste APRES la fin)
27282/20EB09 : =0CH                     V_SH      equ 12    ; s16 * &id_shear[lines]     (juste APRES la fin)
27283/20EB09 : =10H                     V_RTAB    equ 16    ; u8  * &hill_rate[20]
27284/20EB09 : =14H                     V_LUT     equ 20    ; u8  * ligne de band_lut de cette trame
27285/20EB09 : =18H                     V_BCOL    equ 24    ; u16 * band_col
27286/20EB09 : =1CH                     V_ROW     equ 28    ; u16  row_fx     (8.8)
27287/20EB09 : =1EH                     V_STEP    equ 30    ; u16  step_fx
27288/20EB09 : =20H                     V_HALF    equ 32    ; u16  (u16)step_fx >> 1
27289/20EB09 : =22H                     V_TOP     equ 34    ; u8   top_limit        } recopies d'un mot
27290/20EB09 : =23H                     V_PLANE0  equ 35    ; u8   road_plane0      }
27291/20EB09 : =24H                     V_BASEX   equ 36    ; u8   road_base_x      } recopies d'un mot
27292/20EB09 : =25H                     V_N       equ 37    ; u8   entree : lines ; sortie : k + 1
27293/20EB09 : =26H                     V_LINE    equ 38    ; u8   entree : road_bottom ; sortie : la ligne a l'arret
27294/20EB09 :                          ; Les tableaux voisins de id_line_of (RoadSlices dans id_road.c) :
27295/20EB09 : =40H                     SL_GRADE  equ 64    ; id_grade[k] = id_line_of[k] + 64
27296/20EB09 : =80H                     SL_BANDI  equ 128   ; id_bandi[k] = id_line_of[k] + 128
27297/20EB09 :                          ; Le cadre de la routine, sous la sauvegarde de XIZ :
27298/20EB09 : =0H                      F_ROW     equ 0     ; u16  row_fx (modifie)
27299/20EB09 : =2H                      F_STEP    equ 2
27300/20EB09 : =4H                      F_HALF    equ 4
27301/20EB09 : =6H                      F_TOP     equ 6
27302/20EB09 : =7H                      F_PLANE0  equ 7
27303/20EB09 : =8H                      F_BASEX   equ 8
27304/20EB09 : =9H                      F_N       equ 9     ; le compteur de tranches
27305/20EB09 : =0AH                     F_BOT     equ 10    ; road_bottom
27306/20EB09 : =0CH                     F_SIZE    equ 12
27307/20EB09 : =14H                     F_W       equ 20    ; w : F_SIZE + XIZ (4) + adresse de retour (4)
27308/20EB09 :                          
27309/20EB09 :                          
27310/20EB09 :                          
27311/20EB09 :                          
27312/20EB09 :                          _id_road_walk_asm:
27313/20EB09 : 3E                               push    xiz
27314/20EB0A : AF 08 20                         ld      xwa,(xsp+0x8)           ; w
27315/20EB0D : BF F4 37                         lda     xsp,(xsp-F_SIZE)
27316/20EB10 : 98 1C 21                         ld      bc,(xwa+V_ROW)
27317/20EB13 : B7 51                            ld      (xsp+F_ROW),bc
27318/20EB15 : 98 1E 21                         ld      bc,(xwa+V_STEP)
27319/20EB18 : BF 02 51                         ld      (xsp+F_STEP),bc
27320/20EB1B : 98 20 21                         ld      bc,(xwa+V_HALF)
27321/20EB1E : BF 04 51                         ld      (xsp+F_HALF),bc
27322/20EB21 : 98 22 21                         ld      bc,(xwa+V_TOP)          ; top et plane0
27323/20EB24 : BF 06 51                         ld      (xsp+F_TOP),bc
27324/20EB27 : 98 24 21                         ld      bc,(xwa+V_BASEX)        ; base_x et le compteur
27325/20EB2A : BF 08 51                         ld      (xsp+F_BASEX),bc
27326/20EB2D : 88 26 23                         ld      c,(xwa+V_LINE)          ; la ligne : road_bottom, >= top (le C le verifie)
27327/20EB30 : BF 0A 43                         ld      (xsp+F_BOT),c
27328/20EB33 : A0 23                            ld      xhl,(xwa+V_XY)
27329/20EB35 : A8 04 22                         ld      xde,(xwa+V_BAND)
27330/20EB38 : A8 08 24                         ld      xix,(xwa+V_SL)
27331/20EB3B : A8 0C 25                         ld      xiy,(xwa+V_SH)
27332/20EB3E : A8 10 26                         ld      xiz,(xwa+V_RTAB)
27333/20EB41 : CA A8                            ld      b,0x0                   ; l'accumulateur part de zero, CHAQUE trame
27334/20EB43 :                          
27335/20EB43 :                          vw_slice:
27336/20EB43 : EC 69                            dec     0x1,xix
27337/20EB45 : ED 6A                            dec     0x2,xiy
27338/20EB47 :                                  ; ou va la tranche : id_line_of[k] = max(ligne, top) = la ligne, puisque
27339/20EB47 :                                  ; la marche s'arrete des qu'elle passe sous top
27340/20EB47 : B4 43                            ld      (xix),c
27341/20EB49 :                                  ; ---- la cadence : hill_rate[20 + id_grade[k]]
27342/20EB49 : 8C 40 21                         ld      a,(xix+SL_GRADE)
27343/20EB4C : D8 13                            exts    wa
27344/20EB4E : C3 07 F8 E0 21                   ld      a,(xiz+wa)
27345/20EB53 : C9 88                            ld      w,a
27346/20EB55 :                                  ; ---- les deux retenues : A = acc + rate + rate, sur huit bits
27347/20EB55 : CA 89                            ld      a,b
27348/20EB57 : C8 81                            add     a,w
27349/20EB59 : F2 6B EB 20 D7                   jp       ult,vw_c1               ; premiere retenue
27350/20EB5E : C8 81                            add     a,w
27351/20EB60 : F2 72 EB 20 D7                   jp       ult,vw_one              ; une seule retenue : une ligne
27352/20EB65 : C9 8A                            ld      b,a                     ; aucune : la tranche ne prend pas de ligne
27353/20EB67 : 1B E8 EB 20                      jp       vw_next
27354/20EB6B :                          vw_c1:
27355/20EB6B : C8 81                            add     a,w
27356/20EB6D : F2 96 EB 20 D7                   jp       ult,vw_two              ; deux retenues : deux lignes
27357/20EB72 :                          vw_one:
27358/20EB72 : C9 8A                            ld      b,a
27359/20EB74 :                                  ; ---- une ligne, a la rangee de la tranche
27360/20EB74 : 8F 01 21                         ld      a,(xsp+F_ROW+1)         ; (u8)(row_fx >> 8)
27361/20EB77 : 8F 07 81                         add     a,(xsp+F_PLANE0)
27362/20EB7A : CB A1                            sub     a,c
27363/20EB7C : C9 88                            ld      w,a
27364/20EB7E : 85 21                            ld      a,(xiy)                 ; (u8)dx
27365/20EB80 : 8F 08 81                         add     a,(xsp+F_BASEX)
27366/20EB83 : B3 50                            ld      (xhl),wa
27367/20EB85 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)        ; l'indice de bande, converti plus bas
27368/20EB8A : B2 41                            ld      (xde),a
27369/20EB8C : EB 6A                            dec     0x2,xhl
27370/20EB8E : EA 6A                            dec     0x2,xde
27371/20EB90 : CB 69                            dec     0x1,c
27372/20EB92 : 1B E8 EB 20                      jp       vw_next
27373/20EB96 :                          
27374/20EB96 :                          vw_two:
27375/20EB96 : C9 8A                            ld      b,a
27376/20EB98 :                                  ; ---- premiere ligne, a la rangee de la tranche
27377/20EB98 : 8F 01 21                         ld      a,(xsp+F_ROW+1)
27378/20EB9B : 8F 07 81                         add     a,(xsp+F_PLANE0)
27379/20EB9E : CB A1                            sub     a,c
27380/20EBA0 : C9 88                            ld      w,a
27381/20EBA2 : 85 21                            ld      a,(xiy)
27382/20EBA4 : 8F 08 81                         add     a,(xsp+F_BASEX)
27383/20EBA7 : B3 50                            ld      (xhl),wa
27384/20EBA9 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
27385/20EBAE : B2 41                            ld      (xde),a
27386/20EBB0 : EB 6A                            dec     0x2,xhl
27387/20EBB2 : EA 6A                            dec     0x2,xde
27388/20EBB4 : CB 69                            dec     0x1,c
27389/20EBB6 :                                  ; ---- seconde ligne, seulement si elle reste sur l'ecran, a mi-marche
27390/20EBB6 : 8F 06 F3                         cp      c,(xsp+F_TOP)
27391/20EBB9 : F2 E8 EB 20 D7                   jp       ult,vw_next
27392/20EBBE : 97 20                            ld      wa,(xsp+F_ROW)
27393/20EBC0 : 9F 04 F0                         cp      wa,(xsp+F_HALF)
27394/20EBC3 : F2 CB EB 20 D3                   jp       ule,vw_mid              ; row_fx <= half : pas sous la rangee 0
27395/20EBC8 : 9F 04 A0                         sub     wa,(xsp+F_HALF)
27396/20EBCB :                          vw_mid:
27397/20EBCB : C8 89                            ld      a,w                     ; (u8)(mid >> 8)
27398/20EBCD : 8F 07 81                         add     a,(xsp+F_PLANE0)
27399/20EBD0 : CB A1                            sub     a,c
27400/20EBD2 : C9 88                            ld      w,a
27401/20EBD4 : 85 21                            ld      a,(xiy)
27402/20EBD6 : 8F 08 81                         add     a,(xsp+F_BASEX)
27403/20EBD9 : B3 50                            ld      (xhl),wa
27404/20EBDB : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
27405/20EBE0 : B2 41                            ld      (xde),a
27406/20EBE2 : EB 6A                            dec     0x2,xhl
27407/20EBE4 : EA 6A                            dec     0x2,xde
27408/20EBE6 : CB 69                            dec     0x1,c
27409/20EBE8 :                          
27410/20EBE8 :                          vw_next:
27411/20EBE8 :                                  ; TOUJOURS, meme pour une tranche qui n'a pris aucune ligne
27412/20EBE8 : 9F 02 20                         ld      wa,(xsp+F_STEP)
27413/20EBEB : 97 A8                            sub     (xsp+F_ROW),wa
27414/20EBED : 8F 06 F3                         cp      c,(xsp+F_TOP)
27415/20EBF0 : F2 FD EB 20 D7                   jp       ult,vw_done             ; plus d'ecran : le compteur reste k + 1
27416/20EBF5 : 8F 09 69                         decb    0x1,(xsp+F_N)
27417/20EBF8 : F2 43 EB 20 DE                   jp       ne,vw_slice             ; au bout : 0, soit k = -1
27418/20EBFD :                          
27419/20EBFD :                          vw_done:
27420/20EBFD :                                  ; ---- les indices de bande deviennent des couleurs, lignes C+1..bas.
27421/20EBFD :                                  ; XDE pointe l'entree de la ligne C (la prochaine qu'on aurait ecrite).
27422/20EBFD : 8F 0A 21                         ld      a,(xsp+F_BOT)
27423/20EC00 : CB A1                            sub     a,c
27424/20EC02 : F2 2F EC 20 D6                   jp       eq,vw_conv_done         ; aucune ligne ecrite
27425/20EC07 : C9 8A                            ld      b,a
27426/20EC09 : AF 14 20                         ld      xwa,(xsp+F_W)
27427/20EC0C : A8 14 24                         ld      xix,(xwa+V_LUT)
27428/20EC0F : A8 18 25                         ld      xiy,(xwa+V_BCOL)
27429/20EC12 :                          vw_conv:
27430/20EC12 : EA 62                            inc     0x2,xde
27431/20EC14 : 82 21                            ld      a,(xde)
27432/20EC16 : D8 12                            extz    wa
27433/20EC18 : C3 07 F0 E0 21                   ld      a,(xix+wa)
27434/20EC1D : D8 12                            extz    wa
27435/20EC1F : D8 80                            add     wa,wa
27436/20EC21 : D3 07 F4 E0 20                   ld      wa,(xiy+wa)
27437/20EC26 : B2 50                            ld      (xde),wa
27438/20EC28 : CA 69                            dec     0x1,b                   ; huit bits : DEC pose les drapeaux
27439/20EC2A : F2 12 EC 20 DE                   jp       ne,vw_conv
27440/20EC2F :                          vw_conv_done:
27441/20EC2F : AF 14 20                         ld      xwa,(xsp+F_W)
27442/20EC32 : B8 26 43                         ld      (xwa+V_LINE),c
27443/20EC35 :                                  ; !! PAS PAR A : A est l'octet bas de XWA, qui tient le bloc. Une
27444/20EC35 :                                  ; premiere version faisait `ld a,(xsp+F_N)` ici et ecrivait le
27445/20EC35 :                                  ; compteur a 0x..00+37, dans la pile.
27446/20EC35 : 8F 09 22                         ld      b,(xsp+F_N)
27447/20EC38 : B8 25 42                         ld      (xwa+V_N),b
27448/20EC3B : BF 0C 37                         lda     xsp,(xsp+F_SIZE)
27449/20EC3E : 5E                               pop     xiz
27450/20EC3F : 0E                               ret
27451/20EC40 :                          
27452/20EC40 :                          ; ================================================================
27453/20EC40 :                          ; void id_road_ahead_asm(RoadAhead *a);
27454/20EC40 :                          ;
27455/20EC40 :                          ; build_road_ahead() de main.c : pour chaque tranche, du pare-chocs vers
27456/20EC40 :                          ; l'horizon, avancer sur le profil jusqu'a la distance que la tranche regarde,
27457/20EC40 :                          ; puis rendre le virage et la pente a cette distance, joints arrondis. La
27458/20EC40 :                          ; version C reste dans main.c (ID_ROAD_AHEAD_C=1) ; tools/equivalence.py prouve
27459/20EC40 :                          ; que les deux rendent la meme RAM, tour par tour, sur les dix circuits.
27460/20EC40 :                          ;
27461/20EC40 :                          ; Registres pendant la boucle :
27462/20EC40 :                          ;   XIX = &ahead[k]            (descend de 2)
27463/20EC40 :                          ;   XHL = &road_bend[k]        (descend de 2)
27464/20EC40 :                          ;   XBC = &id_grade[k]         (descend de 1 ; id_road_grade_buf)
27465/20EC40 :                          ;   XIY = sc, le segment courant
27466/20EC40 :                          ;   DE  = into, la position dans ce segment
27467/20EC40 :                          ;   XIZ = le bloc (ci-dessous)
27468/20EC40 :                          ;
27469/20EC40 :                          ; SECONDE ECRITURE (2026-09-19) : DEUX CACHES PAR SEGMENT, valables un appel.
27470/20EC40 :                          ; Profil par bloc : le fondu aux jonctions coutait 10 000 cycles par tour et la
27471/20EC40 :                          ; borne de pente + grade_tab 8 000, refaits a CHAQUE tranche alors qu'ils ne
27472/20EC40 :                          ; dependent que du SEGMENT tant qu'on y reste :
27473/20EC40 :                          ;   - la pente a plat d'un segment, bornee et convertie, est la meme pour
27474/20EC40 :                          ;     toutes ses tranches (cle A_FKEY) ;
27475/20EC40 :                          ;   - un fondu melange le segment courant et un voisin avec un poids w : les
27476/20EC40 :                          ;     deux ecarts (voisin - courant, virage et pente) ne dependent que du
27477/20EC40 :                          ;     segment et du cote (cles A_NKEY, A_PKEY). Il ne reste par tranche que les
27478/20EC40 :                          ;     deux multiplications, et la seconde saute quand les deux pentes sont
27479/20EC40 :                          ;     egales -- le cas de toute route plate.
27480/20EC40 :                          ; Les cles sont le numero du segment ; 0xFF = vide (track_len est un u8, un
27481/20EC40 :                          ; numero vaut au plus 254). Le C les vide avant chaque appel.
27482/20EC40 :                          ;
27483/20EC40 :                          ; Le bloc RoadAhead (main.c ; taille VERIFIEE a la compilation) :
27484/20EC40 : =0H                      A_AHEAD  equ 0      ; const u16 * &ahead[lines]            (juste APRES la fin)
27485/20EC40 : =4H                      A_BEND   equ 4      ; s16 *       &road_bend[lines]
27486/20EC40 : =8H                      A_GL     equ 8      ; s8 *        &id_grade[lines]
27487/20EC40 : =0CH                     A_SEG    equ 12     ; const Segment * track_seg
27488/20EC40 : =10H                     A_GTAB   equ 16     ; const s8 *  &grade_tab[HILL_SLOPE_MAX]  (indice signe)
27489/20EC40 : =14H                     A_SC     equ 20     ; const Segment * &track_seg[seg_index]
27490/20EC40 : =18H                     A_INTO   equ 24     ; u16 seg_pos
27491/20EC40 : =1AH                     A_W      equ 26     ; u16 want (temporaire, traversee de segments)
27492/20EC40 : =1CH                     A_K      equ 28     ; u8  lignes (> 0)
27493/20EC40 : =1DH                     A_CUR    equ 29     ; u8  seg_index
27494/20EC40 : =1EH                     A_LEN    equ 30     ; u8  track_len
27495/20EC40 : =1FH                     A_FKEY   equ 31     ; u8  segment de la pente a plat en cache (0xFF = vide)
27496/20EC40 : =20H                     A_FG     equ 32     ; s8  cette pente, bornee et convertie
27497/20EC40 : =21H                     A_NKEY   equ 33     ; u8  segment du fondu vers le SUIVANT en cache
27498/20EC40 : =22H                     A_PKEY   equ 34     ; u8  ... vers le PRECEDENT
27499/20EC40 : =24H                     A_NDB    equ 36     ; s16 suivant->bend - bend
27500/20EC40 : =26H                     A_NDP    equ 38     ; s16 suivant->slope - slope
27501/20EC40 : =28H                     A_PDB    equ 40     ; s16 precedent->bend - bend
27502/20EC40 : =2AH                     A_PDP    equ 42     ; s16 precedent->slope - slope
27503/20EC40 :                          ; Segment : span u16 +0, bend s16 +2, slope s8 +4, six octets.
27504/20EC40 :                          
27505/20EC40 :                          
27506/20EC40 :                          _id_road_ahead_asm:
27507/20EC40 : 3E                               push    xiz
27508/20EC41 : AF 08 26                         ld      xiz,(xsp+0x8)
27509/20EC44 : A6 24                            ld      xix,(xiz+A_AHEAD)
27510/20EC46 : AE 04 23                         ld      xhl,(xiz+A_BEND)
27511/20EC49 : AE 08 21                         ld      xbc,(xiz+A_GL)
27512/20EC4C : AE 14 25                         ld      xiy,(xiz+A_SC)
27513/20EC4F : 9E 18 22                         ld      de,(xiz+A_INTO)
27514/20EC52 :                                  ; la PREMIERE tranche : walked vaut 0
27515/20EC52 : EC 6A                            dec     0x2,xix
27516/20EC54 : EB 6A                            dec     0x2,xhl
27517/20EC56 : E9 69                            dec     0x1,xbc
27518/20EC58 : 94 20                            ld      wa,(xix)
27519/20EC5A : 1B 69 EC 20                      jp       ah_want
27520/20EC5E :                          
27521/20EC5E :                          _id_road_ahead_asm__L1:
27522/20EC5E :                          ah_slice:
27523/20EC5E : EC 6A                            dec     0x2,xix
27524/20EC60 : EB 6A                            dec     0x2,xhl
27525/20EC62 : E9 69                            dec     0x1,xbc
27526/20EC64 :                                  ; want = ahead[k] - walked, et walked est ahead[k+1] : la tranche
27527/20EC64 :                                  ; d'avant, deux octets plus haut dans le meme tableau
27528/20EC64 : 94 20                            ld      wa,(xix)
27529/20EC66 : 9C 02 A0                         sub     wa,(xix+0x2)
27530/20EC69 :                          _id_road_ahead_asm__L2:
27531/20EC69 :                          ah_want:
27532/20EC69 :                                  ; LE CAS COURANT SANS MEMOIRE : into += want, et si ca reste dans le
27533/20EC69 :                                  ; segment, c'est fini. (u16)(into + want) >= span se lit sur DE lui-meme.
27534/20EC69 : D8 82                            add     de,wa
27535/20EC6B : 95 F2                            cp      de,(xiy)
27536/20EC6D : F2 B3 EC 20 D7                   jp       ult,ah_seg_ok
27537/20EC72 : D8 A2                            sub     de,wa                   ; on defait, et on marche segment par segment
27538/20EC74 : BE 1A 50                         ld      (xiz+A_W),wa
27539/20EC77 :                          _id_road_ahead_asm__L3:
27540/20EC77 :                          ah_seg:
27541/20EC77 : DA 88                            ld      wa,de
27542/20EC79 : 9E 1A 80                         add     wa,(xiz+A_W)
27543/20EC7C : 95 F0                            cp      wa,(xiy)
27544/20EC7E : F2 B0 EC 20 D7                   jp       ult,ah_seg_last
27545/20EC83 : 95 20                            ld      wa,(xiy)                ; want -= span - into
27546/20EC85 : DA A0                            sub     wa,de                   ; (formes emises par cc900 ; l'ancien
27547/20EC87 : 9E 1A A8                         sub     (xiz+A_W),wa            ;  `sub wa,(xiy)` n'en etait pas une)
27548/20EC8A : 8E 1D 21                         ld      a,(xiz+A_CUR)           ; le voisin SANS modulo
27549/20EC8D : C9 61                            inc     0x1,a
27550/20EC8F : 8E 1E F1                         cp      a,(xiz+A_LEN)
27551/20EC92 : F2 99 EC 20 D7                   jp       ult,ah_cur_ok
27552/20EC97 : C9 A8                            ld      a,0x0
27553/20EC99 :                          ah_cur_ok:
27554/20EC99 : BE 1D 41                         ld      (xiz+A_CUR),a
27555/20EC9C : D8 12                            extz    wa
27556/20EC9E : D8 09 06 00                      muls    xwa,0x6
27557/20ECA2 : AE 0C 25                         ld      xiy,(xiz+A_SEG)
27558/20ECA5 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa)
27559/20ECAA : DA A8                            ld      de,0x0
27560/20ECAC : 1B 77 EC 20                      jp       ah_seg
27561/20ECB0 :                          ah_seg_last:
27562/20ECB0 : 9E 1A 82                         add     de,(xiz+A_W)            ; into += want
27563/20ECB3 :                          _id_road_ahead_asm__L4:
27564/20ECB3 :                          ah_seg_ok:
27565/20ECB3 :                                  ; rem = span - into
27566/20ECB3 : 95 20                            ld      wa,(xiy)
27567/20ECB5 : DA A0                            sub     wa,de
27568/20ECB7 : DA F0                            cp      wa,de
27569/20ECB9 : F2 2A ED 20 DB                   jp       ugt,ah_prev             ; pas (rem <= into)
27570/20ECBE : D8 CF 80 00                      cp      wa,0x80
27571/20ECC2 : F2 2A ED 20 DF                   jp       uge,ah_prev             ; pas (rem < BEND_HALF)
27572/20ECC7 : D8 07                            neg     wa                      ; w = BEND_HALF - rem
27573/20ECC9 : D8 C8 80 00                      add     wa,0x80
27574/20ECCD : 3A                               push    xde
27575/20ECCE : D8 8A                            ld      de,wa                   ; DE = w pendant le fondu
27576/20ECD0 : 8E 1D 21                         ld      a,(xiz+A_CUR)
27577/20ECD3 : 8E 21 F1                         cp      a,(xiz+A_NKEY)
27578/20ECD6 : F2 16 ED 20 D6                   jp       eq,ah_nhit
27579/20ECDB :                                  ; ---- les ecarts vers le SUIVANT, une fois par segment
27580/20ECDB : BE 21 41                         ld      (xiz+A_NKEY),a
27581/20ECDE : C9 61                            inc     0x1,a                   ; other = cursor + 1, sans modulo
27582/20ECE0 : 8E 1E F1                         cp      a,(xiz+A_LEN)
27583/20ECE3 : F2 EA EC 20 D7                   jp       ult,ah_nseg
27584/20ECE8 : C9 A8                            ld      a,0x0
27585/20ECEA :                          ah_nseg:
27586/20ECEA : D8 12                            extz    wa
27587/20ECEC : D8 09 06 00                      muls    xwa,0x6
27588/20ECF0 : 3D                               push    xiy
27589/20ECF1 : AE 0C 25                         ld      xiy,(xiz+A_SEG)
27590/20ECF4 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa); XIY = sn
27591/20ECF9 : 9D 02 20                         ld      wa,(xiy+0x2)
27592/20ECFC : BE 24 50                         ld      (xiz+A_NDB),wa
27593/20ECFF : 8D 04 21                         ld      a,(xiy+0x4)
27594/20ED02 : D8 13                            exts    wa
27595/20ED04 : BE 26 50                         ld      (xiz+A_NDP),wa
27596/20ED07 : 5D                               pop     xiy                     ; XIY = sc
27597/20ED08 : 9D 02 20                         ld      wa,(xiy+0x2)
27598/20ED0B : 9E 24 A8                         sub     (xiz+A_NDB),wa          ; (s16)(sn->bend - b)
27599/20ED0E : 8D 04 21                         ld      a,(xiy+0x4)
27600/20ED11 : D8 13                            exts    wa
27601/20ED13 : 9E 26 A8                         sub     (xiz+A_NDP),wa          ; (s16)sn->slope - p
27602/20ED16 :                          _id_road_ahead_asm__L5:
27603/20ED16 :                          ah_nhit:
27604/20ED16 :                                  ; road_bend[k] = b + (s16)(((s16)(sn->bend - b) * (s16)w) >> 8)
27605/20ED16 : 9E 24 20                         ld      wa,(xiz+A_NDB)
27606/20ED19 : DA 48                            muls    xwa,de
27607/20ED1B : D8 ED 08                         sra     0x8,wa
27608/20ED1E : 9D 02 80                         add     wa,(xiy+0x2)
27609/20ED21 : B3 50                            ld      (xhl),wa
27610/20ED23 : 9E 26 20                         ld      wa,(xiz+A_NDP)
27611/20ED26 : 1B 94 ED 20                      jp       ah_blend_slope
27612/20ED2A :                          
