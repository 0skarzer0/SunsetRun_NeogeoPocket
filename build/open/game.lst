29447/20FD8F :                          ; screen.  XIX = grid, XIY = prev (both 20 cells a row), XHL = SCR1 (32).
29448/20FD8F : =0H                      F_GRID   equ 0
29449/20FD8F : =4H                      F_PREV   equ 4
29450/20FD8F : =8H                      F_VRAM   equ 8
29451/20FD8F : =0CH                     F_ROWS   equ 12
29452/20FD8F : =0DH                     F_COLS   equ 13
