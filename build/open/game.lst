24446/20D2D1 :                          
24447/20D2D1 :                          ; ---- src/core/ngpc_syspatch.asm
24448/20D2D1 :                          
24449/20D2D1 :                          ;
24450/20D2D1 :                          ; ngpc_syspatch.asm - Power-off bug patch (SYS_PATCH equivalent)
24451/20D2D1 :                          ;
24452/20D2D1 :                          ; Part of NgpCraft_base_template (MIT License)
24453/20D2D1 :                          ;
24454/20D2D1 :                          ; Reverse-engineered from system.lib (SNK Corporation, 1998).
24455/20D2D1 :                          ;
24456/20D2D1 :                          ; The original SYS_PATCH routine fixes a bug in the initial production
24457/20D2D1 :                          ; NEOGEO POCKET system program: rapid removal/reinsertion of batteries
24458/20D2D1 :                          ; could prevent the power button from shutting down the console.
24459/20D2D1 :                          ;
24460/20D2D1 :                          ; Condition : OS_Version (0x6F91) == 0x00  [prototype firmware only]
24461/20D2D1 :                          ; Effect    : res 3, (0x6F83)              [clear undocumented sys flag]
24462/20D2D1 :                          ;             ldb (0x6DA0), 0x00           [clear undocumented power flag]
24463/20D2D1 :                          ;
24464/20D2D1 :                          ; On all retail hardware (OS_Version >= 0x01) this is a safe no-op.
24465/20D2D1 :                          ; Must be called once at startup, before enabling interrupts.
24466/20D2D1 :                          ;
24467/20D2D1 :                          ; Reference: MANSysPro.txt "SYS_PATCH", SysLib.txt p.6
24468/20D2D1 :                          ;
24469/20D2D1 :                          
24470/20D2D1 :                          
24471/20D2D1 :                          
24472/20D2D1 :                          
24473/20D2D1 :                          _ngpc_sys_patch:
24474/20D2D1 :                          
24475/20D2D1 :                                  ; cp (0x6F91), 0x00  [C1 91 6F 3F 00]
24476/20D2D1 :                                  ; Compare OS_Version with 0. Z=1 if prototype firmware.
24477/20D2D1 : C1 91 6F 3F 00                   db 0xC1, 0x91, 0x6F, 0x3F, 0x00
24478/20D2D6 :                          
24479/20D2D6 :                                  ; jr NZ, +9  [6E 09]
24480/20D2D6 :                                  ; Retail hardware (OS_Version != 0): skip patch, fall through to ret.
24481/20D2D6 : 6E 09                            db 0x6E, 0x09
24482/20D2D8 :                          
24483/20D2D8 :                                  ; res 3, (0x6F83)  [F1 83 6F B3]
24484/20D2D8 :                                  ; Clear bit 3 of undocumented system flag (between Sys_Lever and User_Boot).
24485/20D2D8 : F1 83 6F B3                      db 0xF1, 0x83, 0x6F, 0xB3
24486/20D2DC :                          
24487/20D2DC :                                  ; ldb (0x6DA0), 0x00  [F1 A0 6D 00 00]
24488/20D2DC :                                  ; Clear undocumented power state register in system RAM.
24489/20D2DC : F1 A0 6D 00 00                   db 0xF1, 0xA0, 0x6D, 0x00, 0x00
24490/20D2E1 :                          
24491/20D2E1 : 0E                               ret
24492/20D2E2 :                          
24493/20D2E2 :                          
24494/20D2E2 :                          ; ---- src/core/ngpc_vramq_asm.asm
24495/20D2E2 :                          ; ngpc_vramq_asm.asm - VRAM queue ASM helpers (TLCS-900/H)
24496/20D2E2 :                          ;
24497/20D2E2 :                          ; Part of NgpCraft_base_template (MIT License)
24498/20D2E2 :                          ;
24499/20D2E2 :                          ; Provides ngpc_memcpy_w() -- word-level block copy via LDIRW.
24500/20D2E2 :                          ; Used by ngpc_vramq.c CMD_COPY path instead of a byte-by-byte C loop.
24501/20D2E2 :                          ; dst is a near VRAM address (0x8000-0xBFFF). src can be near RAM or far ROM.
24502/20D2E2 :                          ;
24503/20D2E2 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
24504/20D2E2 :                          ;
24505/20D2E2 :                          ; cc900 calling convention -- args passed as u32 (4 bytes each, unambiguous):
24506/20D2E2 :                          ;   (xsp+0)  return address (far)   4 bytes
24507/20D2E2 :                          ;   (xsp+4)  dst_addr (u32)         4 bytes  <- near VRAM address (high 16 = 0)
24508/20D2E2 :                          ;   (xsp+8)  src_addr (u32)         4 bytes  <- RAM/ROM address (near or far)
24509/20D2E2 :                          ;   (xsp+12) words (u32)            4 bytes  <- word count (high 16 = 0)
24510/20D2E2 :                          ;
24511/20D2E2 :                          ; Using u32 args avoids ambiguity: cc900 may pad u16 args to 4 bytes on stack.
24512/20D2E2 :                          ; u32 args are always exactly 4 bytes, matching LD XRR, (xsp+N) reads.
24513/20D2E2 :                          ;
24514/20D2E2 :                          ; LDIRW guard: BC=0 at entry copies 65536 words -- skip if words==0.
24515/20D2E2 :                          ; OR A, C is safe here (ALU instruction; C is not ambiguous as condition code
24516/20D2E2 :                          ; in this context -- ambiguity only occurs in LD (mem), c indirect store form).
24517/20D2E2 :                          
24518/20D2E2 :                          
24519/20D2E2 :                          
24520/20D2E2 :                          
24521/20D2E2 :                          
24522/20D2E2 :                          ; ================================================================
24523/20D2E2 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
24524/20D2E2 :                          ;
24525/20D2E2 :                          ; Block-copies 'words' 16-bit words from src_addr to dst_addr via LDIRW.
24526/20D2E2 :                          ; Equivalent to: while (words--) *(u16*)dst++ = *(u16*)src++;
24527/20D2E2 :                          ; but uses LDIRW hardware block transfer.
24528/20D2E2 :                          ;
24529/20D2E2 :                          ; Call site (ngpc_vramq.c) passes near u16 addresses widened to u32:
24530/20D2E2 :                          ;   ngpc_memcpy_w((u32)dst_u16, (u32)src_u16, (u32)word_count)
24531/20D2E2 :                          ; So upper 16 bits of XDE/XHL are guaranteed 0. LDIRW needs upper=0. OK
24532/20D2E2 :                          ; ================================================================
24533/20D2E2 :                          _ngpc_memcpy_w:
24534/20D2E2 :                                  ; Load XDE = dst_addr (full 32-bit; upper 16 = 0 since near address)
24535/20D2E2 : AF 04 22                         ld      xde, (xsp+4)
24536/20D2E5 :                          
24537/20D2E5 :                                  ; Load XHL = src_addr (full 32-bit; may be near or far)
24538/20D2E5 : AF 08 23                         ld      xhl, (xsp+8)
24539/20D2E8 :                          
24540/20D2E8 :                                  ; Load BC = words (low 16 of u32; high 16 is 0 since words <= 65535)
24541/20D2E8 : 9F 0C 21                         ld      bc, (xsp+12)
24542/20D2EB :                          
24543/20D2EB :                                  ; BC=0 guard: if words==0, skip (LDIRW BC=0 copies 65536 words!)
24544/20D2EB :                                  ; OR A, C: ALU instruction -- C is register, not condition code here.
24545/20D2EB : CA 89                            ld      a, b
24546/20D2ED : CB E1                            or      a, c
24547/20D2EF : 66 02                            jr      z, memcpy_w_done
24548/20D2F1 :                          
24549/20D2F1 : 93 11                            ldirw                       ; block copy: BC words from XHL -> XDE
24550/20D2F3 :                          
24551/20D2F3 :                          memcpy_w_done:
24552/20D2F3 : 0E                               ret
24553/20D2F4 :                          
24554/20D2F4 :                          
24555/20D2F4 :                          ; ---- src/fx/ngpc_dma_prog.asm
24556/20D2F4 :                          
24557/20D2F4 :                          
24558/20D2F4 :                          
24559/20D2F4 :                          ; C prototypes:
24560/20D2F4 :                          ;   void dmaN_program_asm(const u8  __far *src, volatile u8 __far *dst, u16 count);
24561/20D2F4 :                          ;   void dmaN_program_u16_asm(const u16 __far *src, volatile u8 __far *dst, u16 count);
24562/20D2F4 :                          ;   void dmaN_program_u32_asm(const u32 __far *src, volatile u8 __far *dst, u16 count);
24563/20D2F4 :                          ;
24564/20D2F4 :                          ; Notes:
24565/20D2F4 :                          ; - `count` is written to DMACn directly (i.e. number of DMA "steps"/transfers,
24566/20D2F4 :                          ;   not necessarily a byte count when using word/dword modes).
24567/20D2F4 :                          ;
24568/20D2F4 :                          ; Stack layout on entry (TLCS-900/H cc900):
24569/20D2F4 :                          ;   (xsp+0)  return address (far) 4 bytes
24570/20D2F4 :                          ;   (xsp+4)  src (far pointer)   4 bytes
24571/20D2F4 :                          ;   (xsp+8)  dst (far pointer)   4 bytes
24572/20D2F4 :                          ;   (xsp+12) count (u16)         2 bytes
24573/20D2F4 :                          ;
24574/20D2F4 :                          ; DMA modes (see SDK `HDMA.H`; values here are the real hex values).
24575/20D2F4 : =8H                      DMA_MODE_SINC1  equ 8   ; 0x08: byte,  src++
24576/20D2F4 : =9H                      DMA_MODE_SINC2  equ 9   ; 0x09: word,  src++
24577/20D2F4 : =0AH                     DMA_MODE_SINC4  equ 10  ; 0x0A: dword, src++
24578/20D2F4 :                          
