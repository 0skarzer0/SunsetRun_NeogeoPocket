24585/20D303 : D8 2E 20                         ldc    dmac0,wa
24586/20D306 : 21 08                            ld      a,DMA_MODE_SINC1
24587/20D308 : C9 2E 22                         ldc    dmam0,a
24588/20D30B : 0E                               ret
