21480/20B8AC :                          
21481/20B8AC :                          ; ---- src/id_road_asm.asm
21482/20B8AC :                          ; id_road_asm.asm - la marche par tranches de id_road_write(), en assembleur
21483/20B8AC :                          ;
21484/20B8AC :                          ; POURQUOI EN ASSEMBLEUR. Profil de la ROM livree (tools/profil_course.py,
21485/20B8AC :                          ; temporisation de la cartouche comprise) : cette boucle etait le plus gros
21486/20B8AC :                          ; poste du tour de course. cc900 n'y gardait pas ses valeurs en registres --
21487/20B8AC :                          ; tout allait sur la pile -- et relisait chaque adresse de table par une
21488/20B8AC :                          ; instruction de cinq octets, cinquante-six fois par trame. Sur cette machine
21489/20B8AC :                          ; chaque octet d'instruction se lit dans la cartouche.
21490/20B8AC :                          ;
21491/20B8AC :                          ; LE CALCUL EST CELUI DU C, A L'OCTET PRES : la version C est gardee dans
21492/20B8AC :                          ; id_road.c (ID_ROAD_WALK_C=1) et tools/equivalence.py compare, tour de boucle
21493/20B8AC :                          ; par tour de boucle, la RAM de cette ROM a celle de la ROM d'origine sur les
21494/20B8AC :                          ; dix circuits.
21495/20B8AC :                          ;
21496/20B8AC :                          ; !! SEULEMENT DES FORMES QUE cc900 EMET DEJA. Les pieges materiel connus de ce
21497/20B8AC :                          ; processeur (docs du projet, fiches) venaient d'encodages que Toshiba n'emet
21498/20B8AC :                          ; pas. `python tools/formes_asm.py` verifie chaque instruction de ce fichier
21499/20B8AC :                          ; contre le code que cc900 genere pour ce projet (build/prof_asm/*.asm).
21500/20B8AC :                          ;
21501/20B8AC :                          ; void id_road_walk_asm(RoadWalk *w);
21502/20B8AC :                          ;
21503/20B8AC :                          ;   (xsp+0) adresse de retour, 4 octets ; (xsp+4) w.
21504/20B8AC :                          ;   cc900 : seul XIZ doit etre preserve (ses fonctions le poussent quand elles
21505/20B8AC :                          ;   s'en servent) ; XWA XBC XDE XHL XIX XIY sont a l'appele.
21506/20B8AC :                          ;
21507/20B8AC :                          ; SECONDE ECRITURE (2026-09-19). La premiere relisait dans le bloc, a chaque
21508/20B8AC :                          ; tranche, sept pointeurs de table et l'accumulateur : 44 500 cycles par tour.
21509/20B8AC :                          ; Celle-ci tient toute la marche en registres :
21510/20B8AC :                          ;
21511/20B8AC :                          ;   XIX = &id_line_of[k]   (descend de 1)   la pente a +SL_GRADE, la bande a +SL_BANDI
21512/20B8AC :                          ;   XIY = &id_shear[k]     (descend de 2)
21513/20B8AC :                          ;   XHL = &xy[ligne]       (descend de 2 par ligne ecrite)
21514/20B8AC :                          ;   XDE = &bande[ligne]    (descend de 2 par ligne ecrite)
21515/20B8AC :                          ;   B   = l'accumulateur   C = la ligne courante (>= top : tient sur un octet)
21516/20B8AC :                          ;   XIZ = &hill_rate[20]   (la cadence, indice signe)
21517/20B8AC :                          ;
21518/20B8AC :                          ; Les valeurs fixes du bloc sont RECOPIEES sur la pile de la routine (F_*) et
21519/20B8AC :                          ; lues par (xsp+d) : c'est ce qui libere XIZ pour la table des cadences.
21520/20B8AC :                          ;
21521/20B8AC :                          ; LES DEUX RETENUES SANS SEIZE BITS. c = (acc + 2 rate) >> 8 et le nouvel
21522/20B8AC :                          ; accumulateur est l'octet bas : c'est exactement le nombre de retenues de deux
21523/20B8AC :                          ; additions de `rate` sur huit bits, et l'octet restant.
21524/20B8AC :                          ;
21525/20B8AC :                          ; LA LIGNE Y. (u8)((row >> 8) - (u8)(scr - plane0)) = (row >> 8) + plane0 - scr
21526/20B8AC :                          ; modulo 256 : les deux formes rendent le meme octet.
21527/20B8AC :                          ;
21528/20B8AC :                          ; LA COULEUR DE BANDE EN DEUX TEMPS. band_col[lut[id_bandi[k]]] demande deux
21529/20B8AC :                          ; pointeurs de table et la marche n'a plus de registre. Elle pose donc l'INDICE
21530/20B8AC :                          ; id_bandi[k] dans l'octet bas de l'entree du tampon de couleur, et une passe
21531/20B8AC :                          ; courte, apres elle, le convertit sur les seules lignes ecrites. Aucun octet de
21532/20B8AC :                          ; RAM de plus : la pile n'en a pas a donner (voir RoadSlices dans id_road.c).
21533/20B8AC :                          ;
21534/20B8AC :                          
21535/20B8AC :                          ; Le bloc RoadWalk (id_road.c ; sa TAILLE y est VERIFIEE a la compilation) :
21536/20B8AC : =0H                      V_XY      equ 0     ; u16 * &xy[road_bottom]
21537/20B8AC : =4H                      V_BAND    equ 4     ; u16 * &bandcol[road_bottom]
21538/20B8AC : =8H                      V_SL      equ 8     ; u8  * &id_line_of[lines]   (juste APRES la fin)
21539/20B8AC : =0CH                     V_SH      equ 12    ; s16 * &id_shear[lines]     (juste APRES la fin)
21540/20B8AC : =10H                     V_RTAB    equ 16    ; u8  * &hill_rate[20]
21541/20B8AC : =14H                     V_LUT     equ 20    ; u8  * ligne de band_lut de cette trame
21542/20B8AC : =18H                     V_BCOL    equ 24    ; u16 * band_col
21543/20B8AC : =1CH                     V_ROW     equ 28    ; u16  row_fx     (8.8)
21544/20B8AC : =1EH                     V_STEP    equ 30    ; u16  step_fx
21545/20B8AC : =20H                     V_HALF    equ 32    ; u16  (u16)step_fx >> 1
21546/20B8AC : =22H                     V_TOP     equ 34    ; u8   top_limit        } recopies d'un mot
21547/20B8AC : =23H                     V_PLANE0  equ 35    ; u8   road_plane0      }
21548/20B8AC : =24H                     V_BASEX   equ 36    ; u8   road_base_x      } recopies d'un mot
21549/20B8AC : =25H                     V_N       equ 37    ; u8   entree : lines ; sortie : k + 1
21550/20B8AC : =26H                     V_LINE    equ 38    ; u8   entree : road_bottom ; sortie : la ligne a l'arret
21551/20B8AC :                          ; Les tableaux voisins de id_line_of (RoadSlices dans id_road.c) :
21552/20B8AC : =40H                     SL_GRADE  equ 64    ; id_grade[k] = id_line_of[k] + 64
21553/20B8AC : =80H                     SL_BANDI  equ 128   ; id_bandi[k] = id_line_of[k] + 128
21554/20B8AC :                          ; Le cadre de la routine, sous la sauvegarde de XIZ :
21555/20B8AC : =0H                      F_ROW     equ 0     ; u16  row_fx (modifie)
21556/20B8AC : =2H                      F_STEP    equ 2
21557/20B8AC : =4H                      F_HALF    equ 4
21558/20B8AC : =6H                      F_TOP     equ 6
21559/20B8AC : =7H                      F_PLANE0  equ 7
21560/20B8AC : =8H                      F_BASEX   equ 8
21561/20B8AC : =9H                      F_N       equ 9     ; le compteur de tranches
21562/20B8AC : =0AH                     F_BOT     equ 10    ; road_bottom
21563/20B8AC : =0CH                     F_SIZE    equ 12
21564/20B8AC : =14H                     F_W       equ 20    ; w : F_SIZE + XIZ (4) + adresse de retour (4)
21565/20B8AC :                          
21566/20B8AC :                          
21567/20B8AC :                          
21568/20B8AC :                          
21569/20B8AC :                          _id_road_walk_asm:
21570/20B8AC : 3E                               push    xiz
21571/20B8AD : AF 08 20                         ld      xwa,(xsp+0x8)           ; w
21572/20B8B0 : BF F4 37                         lda     xsp,(xsp-F_SIZE)
21573/20B8B3 : 98 1C 21                         ld      bc,(xwa+V_ROW)
21574/20B8B6 : B7 51                            ld      (xsp+F_ROW),bc
21575/20B8B8 : 98 1E 21                         ld      bc,(xwa+V_STEP)
21576/20B8BB : BF 02 51                         ld      (xsp+F_STEP),bc
21577/20B8BE : 98 20 21                         ld      bc,(xwa+V_HALF)
21578/20B8C1 : BF 04 51                         ld      (xsp+F_HALF),bc
21579/20B8C4 : 98 22 21                         ld      bc,(xwa+V_TOP)          ; top et plane0
21580/20B8C7 : BF 06 51                         ld      (xsp+F_TOP),bc
21581/20B8CA : 98 24 21                         ld      bc,(xwa+V_BASEX)        ; base_x et le compteur
21582/20B8CD : BF 08 51                         ld      (xsp+F_BASEX),bc
21583/20B8D0 : 88 26 23                         ld      c,(xwa+V_LINE)          ; la ligne : road_bottom, >= top (le C le verifie)
21584/20B8D3 : BF 0A 43                         ld      (xsp+F_BOT),c
21585/20B8D6 : A0 23                            ld      xhl,(xwa+V_XY)
21586/20B8D8 : A8 04 22                         ld      xde,(xwa+V_BAND)
21587/20B8DB : A8 08 24                         ld      xix,(xwa+V_SL)
21588/20B8DE : A8 0C 25                         ld      xiy,(xwa+V_SH)
21589/20B8E1 : A8 10 26                         ld      xiz,(xwa+V_RTAB)
21590/20B8E4 : CA A8                            ld      b,0x0                   ; l'accumulateur part de zero, CHAQUE trame
21591/20B8E6 :                          
21592/20B8E6 :                          vw_slice:
21593/20B8E6 : EC 69                            dec     0x1,xix
21594/20B8E8 : ED 6A                            dec     0x2,xiy
21595/20B8EA :                                  ; ou va la tranche : id_line_of[k] = max(ligne, top) = la ligne, puisque
21596/20B8EA :                                  ; la marche s'arrete des qu'elle passe sous top
21597/20B8EA : B4 43                            ld      (xix),c
21598/20B8EC :                                  ; ---- la cadence : hill_rate[20 + id_grade[k]]
21599/20B8EC : 8C 40 21                         ld      a,(xix+SL_GRADE)
21600/20B8EF : D8 13                            exts    wa
21601/20B8F1 : C3 07 F8 E0 21                   ld      a,(xiz+wa)
21602/20B8F6 : C9 88                            ld      w,a
