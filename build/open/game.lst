24259/20D1B1 : EB EA 01                         rl      1,xhl
24260/20D1B4 : E9 F3                            cp      xhl,xbc
24261/20D1B6 : 67 04                            jr      ult,__div32u_skip
24262/20D1B8 : E9 A3                            sub     xhl,xbc
24263/20D1BA : E8 61                            inc     1,xwa
24264/20D1BC :                          __div32u_skip:
24265/20D1BC : CD 1C EF                         djnz    e,__div32u_loop
24266/20D1BF : 0E                               ret
24267/20D1C0 :                          
