21685/20B9B2 : A8 18 25                         ld      xiy,(xwa+V_BCOL)
21686/20B9B5 :                          vw_conv:
21687/20B9B5 : EA 62                            inc     0x2,xde
21688/20B9B7 : 82 21                            ld      a,(xde)
