27887/20F16F : AF 04 20                         ld      xwa,(xsp+4)
27888/20F172 : E8 2E 04                         ldc    dmas1,xwa
27889/20F175 : AF 08 20                         ld      xwa,(xsp+8)
27890/20F178 : E8 2E 14                         ldc    dmad1,xwa
27891/20F17B : 9F 0C 20                         ld      wa,(xsp+12)
27892/20F17E : D8 2E 24                         ldc    dmac1,wa
27893/20F181 : 21 0A                            ld      a,DMA_MODE_SINC4
27894/20F183 : C9 2E 26                         ldc    dmam1,a
27895/20F186 : 0E                               ret
27896/20F187 :                          
27897/20F187 :                          _dma2_program_asm:
27898/20F187 : AF 04 20                         ld      xwa,(xsp+4)
27899/20F18A : E8 2E 08                         ldc    dmas2,xwa
27900/20F18D : AF 08 20                         ld      xwa,(xsp+8)
27901/20F190 : E8 2E 18                         ldc    dmad2,xwa
27902/20F193 : 9F 0C 20                         ld      wa,(xsp+12)
27903/20F196 : D8 2E 28                         ldc    dmac2,wa
27904/20F199 : 21 08                            ld      a,DMA_MODE_SINC1
27905/20F19B : C9 2E 2A                         ldc    dmam2,a
