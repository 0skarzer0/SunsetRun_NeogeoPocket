26973/20EA99 :                          ; ---- src/core/ngpc_flash_asm.asm
26974/20EA99 :                          
26975/20EA99 :                          ;
26976/20EA99 :                          ; ngpc_flash_asm.asm - Flash erase/write primitives for ngpc_flash.c
26977/20EA99 :                          ;
26978/20EA99 :                          ; Part of NgpCraft_base_template (MIT License)
26979/20EA99 :                          ;
26980/20EA99 :                          ; Two entry points, both called ONLY by ngpc_flash.c (never from an ISR):
26981/20EA99 :                          ;
26982/20EA99 :                          ;   _ngpc_flash_erase_asm(u32 abs_block)
26983/20EA99 :                          ;       Erases one 8 KB block with the AMD erase stub extracted from StarGunner
26984/20EA99 :                          ;       (hardware-validated), copied to RAM 0x6E00 and run from there.
26985/20EA99 :                          ;       VECT_FLASHERS cannot erase blocks 32/33/34 (SysCall.txt p.299), so the
26986/20EA99 :                          ;       erase keeps the stub.
26987/20EA99 :                          ;
26988/20EA99 :                          ;   _ngpc_flash_write_bios(const void *src, u32 offset, u32 pages)
26989/20EA99 :                          ;       Programs pages x 256 bytes through the BIOS (VECT_FLASHWRITE, swi 1),
26990/20EA99 :                          ;       the path StarGunner uses on hardware. The watchdog is refreshed right
26991/20EA99 :                          ;       before and right after, as in the SDK save pattern.
26992/20EA99 :                          ;
26993/20EA99 :                          ; THE BLOCK IS A PARAMETER, NOT A CONSTANT. The save block sits 0x6000 below
26994/20EA99 :                          ; the top of the chip, so its address depends on the cartridge size:
26995/20EA99 :                          ; 0x27A000 on 4 Mbit, 0x2FA000 on 8 Mbit, 0x3FA000 on 16 Mbit. A hard-coded
26996/20EA99 :                          ; 0x3FA000 erases 8 KB ELSEWHERE on a smaller chip - possibly the game code.
26997/20EA99 :                          ; ngpc_flash.c reads the size the BIOS stores at 0x6C58 and refuses unknown ones.
26998/20EA99 :                          ;
26999/20EA99 :                          ; cc900 ABI (CALL pushes 4-byte XPC as return address):
27000/20EA99 :                          ;   (xsp+0)..(xsp+3)  = return address
27001/20EA99 :                          ;   (xsp+4)..(xsp+7)  = 1st parameter
27002/20EA99 :                          ;   (xsp+8)..(xsp+11) = 2nd parameter
27003/20EA99 :                          ;   (xsp+12)..(xsp+15)= 3rd parameter
27004/20EA99 :                          ;
27005/20EA99 :                          ; ===========================================================================
27006/20EA99 :                          ; INTERRUPTS ARE PROHIBITED FOR THE WHOLE SEQUENCE. On hardware that is not
27007/20EA99 :                          ; optional. A flash chip being programmed or erased answers reads with STATUS,
27008/20EA99 :                          ; not with its contents. The stub runs from RAM for that reason, but the
27009/20EA99 :                          ; interrupt handlers are still in the cartridge: an interrupt taken while the
27010/20EA99 :                          ; chip is busy fetches its handler from status bits. A game taking VBlank at
27011/20EA99 :                          ; 60 Hz cannot get through a 256-byte program or an 8 KB erase without one.
27012/20EA99 :                          ;
27013/20EA99 :                          ; AN EMULATOR WHOSE FLASH KEEPS SERVING ROM DURING THE WRITE NEVER SHOWS THIS.
27014/20EA99 :                          ; Toshiba: "all interrupts are prohibited during system calls related to flash
27015/20EA99 :                          ; memory management" (SysCall.txt). Hence `di` (encoded 06 07 = EI 7) on entry
27016/20EA99 :                          ; and `ei 0` (06 00) on exit: level 0 is what ngpc_init() runs the game at.
27017/20EA99 :                          ; ===========================================================================
27018/20EA99 :                          
27019/20EA99 :                          
27020/20EA99 :                          
27021/20EA99 : =6E00H                   FLASH_RAM       equ     0x6E00          ; RAM address for stub execution
27022/20EA99 : =6EH                     FLASH_BUS_CTRL  equ     0x6E            ; I/O: flash /WE enable (0x14=on, 0xF0=off)
27023/20EA99 : =6FH                     FLASH_WD        equ     0x6F            ; I/O: watchdog  (0xB1=extended, 0x4E=refresh)
27024/20EA99 : =200000H                 CART_BASE       equ     0x200000        ; CS0 base address
27025/20EA99 :                          
27026/20EA99 :                          
27027/20EA99 :                          
27028/20EA99 :                          ; ===========================================================================
27029/20EA99 :                          ; _ngpc_flash_erase_asm
27030/20EA99 :                          ;   param 1 (xsp+4) : u32 abs_block -- ABSOLUTE address of the 8 KB block
27031/20EA99 :                          ; C prototype: void ngpc_flash_erase_asm(u32 abs_block);
27032/20EA99 :                          ; ===========================================================================
27033/20EA99 :                          _ngpc_flash_erase_asm:
27034/20EA99 :                          
27035/20EA99 : 06 07                            di                              ; see the note at the top of the file
27036/20EA9B : 08 6E 14                         ld      (FLASH_BUS_CTRL),0x14   ; enable /WE on cart bus
27037/20EA9E : 08 6F B1                         ld      (FLASH_WD),0xB1         ; watchdog: extended mode
27038/20EAA1 :                          
27039/20EAA1 :                                  ; Copy erase stub (98 bytes) from ROM to RAM at FLASH_RAM
27040/20EAA1 : 39                               push    xbc                     ; preserve XBC across copy
27041/20EAA2 : 42 00 6E 00 00                   ld      xde,FLASH_RAM           ; destination: RAM
27042/20EAA7 : 43 EE EA 20 00                   ld      xhl,_erase_stub         ; source: stub bytes in ROM
27043/20EAAC : 31 62 00                         ld      bc,0x62                 ; BC = 98 bytes
27044/20EAAF : 83 11                            db      0x83,0x11               ; ldir (xde+),(xhl+) -- copy BC bytes
27045/20EAB1 : 59                               pop     xbc                     ; restore XBC (stack back to entry)
27046/20EAB2 :                          
27047/20EAB2 :                                  ; Set up registers for stub call
27048/20EAB2 : 44 00 00 20 00                   ld      xix,CART_BASE           ; XIX = 0x200000 (AMD unlock base)
27049/20EAB7 : ED A8                            ld      xiy,0x0                 ; XIY = 0 (erase stub uses as delay counter)
27050/20EAB9 : C9 A8                            ld      a,0x0                   ; A = 0 (erase stub state init)
27051/20EABB : AF 04 22                         ld      xde,(xsp+4)             ; XDE = block, given by the caller
27052/20EABE :                          
27053/20EABE : 1C 00 6E                         call    FLASH_RAM               ; execute stub from RAM
27054/20EAC1 :                          
27055/20EAC1 : 08 6E F0                         ld      (FLASH_BUS_CTRL),0xF0   ; restore watchdog mode first
27056/20EAC4 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; then refresh the enabled watchdog
27057/20EAC7 : 06 00                            ei      0                       ; the chip answers as memory again
27058/20EAC9 : 0E                               ret
27059/20EACA :                          
27060/20EACA :                          
27061/20EACA :                          ; ===========================================================================
27062/20EACA :                          ; _ngpc_flash_write_bios
27063/20EACA :                          ;   param 1 (xsp+4)  : const void *src -- source buffer, in RAM
27064/20EACA :                          ;   param 2 (xsp+8)  : u32 offset      -- offset INSIDE the cartridge
27065/20EACA :                          ;                                         (e.g. 0x1FA000 + slot*SAVE_SIZE),
27066/20EACA :                          ;                                         not the absolute address: XDE3 wants
27067/20EACA :                          ;                                         the offset.
27068/20EACA :                          ;   param 3 (xsp+12) : u32 pages       -- number of 256-byte units
27069/20EACA :                          ; C prototype: void ngpc_flash_write_bios(const void *src, u32 offset, u32 pages);
27070/20EACA :                          ;
27071/20EACA :                          ; The BIOS holds the bus itself (no manual 0x6E write). The AMD write stub used
27072/20EACA :                          ; before disabled the watchdog and wrote its refresh code while it was off.
27073/20EACA :                          ; ===========================================================================
27074/20EACA :                          _ngpc_flash_write_bios:
27075/20EACA :                          
27076/20EACA : 06 07                            di                              ; see the note at the top of the file
27077/20EACC : AF 04 23                         ld      xhl,(xsp+4)             ; 1st param: source
27078/20EACF : AF 08 22                         ld      xde,(xsp+8)             ; 2nd param: cartridge offset
27079/20EAD2 : AF 0C 21                         ld      xbc,(xsp+12)            ; 3rd param: 256-byte pages
27080/20EAD5 : E7 3C 9B                         ld      xhl3,xhl                ; bank 3: the BIOS reads its arguments there
27081/20EAD8 : E7 38 9A                         ld      xde3,xde
27082/20EADB : E7 34 99                         ld      xbc3,xbc
27083/20EADE : C7 30 A8                         ld      ra3,0                   ; CS0
27084/20EAE1 : C7 31 AE                         ld      rw3,0x0006              ; VECT_FLASHWRITE
27085/20EAE4 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; watchdog refreshed RIGHT BEFORE
27086/20EAE7 : F9                               swi     1
27087/20EAE8 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; and right after
27088/20EAEB : 06 00                            ei      0
27089/20EAED : 0E                               ret
27090/20EAEE :                          
27091/20EAEE :                          
27092/20EAEE :                          ; ===========================================================================
27093/20EAEE :                          ; Erase stub, extracted from StarGunner/bin/main.ngp (hardware-validated).
27094/20EAEE :                          ; 98 bytes, file offset 0x13733. Position-independent, uses XIX for AMD cycles.
27095/20EAEE :                          ;   AMD unlock -> reset -> unlock -> erase setup (0x80) -> unlock -> sector
27096/20EAEE :                          ;   erase (0x30) -> poll DQ7 -> final reset/unlock -> ret
27097/20EAEE :                          ;   Register interface: XIX=cart_base XDE=block_addr XIY=0 A=0
27098/20EAEE :                          ; ===========================================================================
27099/20EAEE :                          
27100/20EAEE :                          _erase_stub:
27101/20EAEE : F3 F1 55 55 00 AA F3 F1          db      0xF3,0xF1,0x55,0x55,0x00,0xAA, 0xF3,0xF1,0xAA,0x2A,0x00,0x55
      20EAF6 : AA 2A 00 55            
27102/20EAFA : F3 F1 55 55 00 F0 00 00          db      0xF3,0xF1,0x55,0x55,0x00,0xF0, 0x00,0x00,0xF3,0xF1,0x55,0x55
      20EB02 : F3 F1 55 55            
27103/20EB06 : 00 AA F3 F1 AA 2A 00 55          db      0x00,0xAA,0xF3,0xF1,0xAA,0x2A, 0x00,0x55,0xF3,0xF1,0x55,0x55
      20EB0E : F3 F1 55 55            
27104/20EB12 : 00 80 F3 F1 55 55 00 AA          db      0x00,0x80,0xF3,0xF1,0x55,0x55, 0x00,0xAA,0xF3,0xF1,0xAA,0x2A
      20EB1A : F3 F1 AA 2A            
27105/20EB1E : 00 55 B2 00 30 82 3F FF          db      0x00,0x55,0xB2,0x00,0x30,0x82, 0x3F,0xFF,0x66,0x15,0xED,0x61
      20EB26 : 66 15 ED 61            
27106/20EB2A : ED CF FF FF 1F 00 66 09          db      0xED,0xCF,0xFF,0xFF,0x1F,0x00, 0x66,0x09,0xB2,0xCD,0x66,0xED
      20EB32 : B2 CD 66 ED            
27107/20EB36 : 82 3F FF 66 02 21 FF F3          db      0x82,0x3F,0xFF,0x66,0x02,0x21, 0xFF,0xF3,0xF1,0x55,0x55,0x00
      20EB3E : F1 55 55 00            
27108/20EB42 : AA F3 F1 AA 2A 00 55 F3          db      0xAA,0xF3,0xF1,0xAA,0x2A,0x00, 0x55,0xF3,0xF1,0x55,0x55,0x00
      20EB4A : F1 55 55 00            
27109/20EB4E : F0 0E                            db      0xF0,0x0E
27110/20EB50 :                          
27111/20EB50 :                          ; ---- src/core/ngpc_syspatch.asm
27112/20EB50 :                          
27113/20EB50 :                          ;
27114/20EB50 :                          ; ngpc_syspatch.asm - Power-off bug patch (SYS_PATCH equivalent)
27115/20EB50 :                          ;
27116/20EB50 :                          ; Part of NgpCraft_base_template (MIT License)
27117/20EB50 :                          ;
27118/20EB50 :                          ; Reverse-engineered from system.lib (SNK Corporation, 1998).
27119/20EB50 :                          ;
27120/20EB50 :                          ; The original SYS_PATCH routine fixes a bug in the initial production
27121/20EB50 :                          ; NEOGEO POCKET system program: rapid removal/reinsertion of batteries
27122/20EB50 :                          ; could prevent the power button from shutting down the console.
27123/20EB50 :                          ;
27124/20EB50 :                          ; Condition : OS_Version (0x6F91) == 0x00  [prototype firmware only]
27125/20EB50 :                          ; Effect    : res 3, (0x6F83)              [clear undocumented sys flag]
27126/20EB50 :                          ;             ldb (0x6DA0), 0x00           [clear undocumented power flag]
27127/20EB50 :                          ;
27128/20EB50 :                          ; On all retail hardware (OS_Version >= 0x01) this is a safe no-op.
27129/20EB50 :                          ; Must be called once at startup, before enabling interrupts.
27130/20EB50 :                          ;
27131/20EB50 :                          ; Reference: MANSysPro.txt "SYS_PATCH", SysLib.txt p.6
27132/20EB50 :                          ;
27133/20EB50 :                          
27134/20EB50 :                          
27135/20EB50 :                          
27136/20EB50 :                          
27137/20EB50 :                          _ngpc_sys_patch:
27138/20EB50 :                          
27139/20EB50 :                                  ; cp (0x6F91), 0x00  [C1 91 6F 3F 00]
27140/20EB50 :                                  ; Compare OS_Version with 0. Z=1 if prototype firmware.
27141/20EB50 : C1 91 6F 3F 00                   db 0xC1, 0x91, 0x6F, 0x3F, 0x00
27142/20EB55 :                          
27143/20EB55 :                                  ; jr NZ, +9  [6E 09]
27144/20EB55 :                                  ; Retail hardware (OS_Version != 0): skip patch, fall through to ret.
27145/20EB55 : 6E 09                            db 0x6E, 0x09
27146/20EB57 :                          
27147/20EB57 :                                  ; res 3, (0x6F83)  [F1 83 6F B3]
27148/20EB57 :                                  ; Clear bit 3 of undocumented system flag (between Sys_Lever and User_Boot).
27149/20EB57 : F1 83 6F B3                      db 0xF1, 0x83, 0x6F, 0xB3
27150/20EB5B :                          
27151/20EB5B :                                  ; ldb (0x6DA0), 0x00  [F1 A0 6D 00 00]
27152/20EB5B :                                  ; Clear undocumented power state register in system RAM.
27153/20EB5B : F1 A0 6D 00 00                   db 0xF1, 0xA0, 0x6D, 0x00, 0x00
27154/20EB60 :                          
27155/20EB60 : 0E                               ret
27156/20EB61 :                          
27157/20EB61 :                          
27158/20EB61 :                          ; ---- src/core/ngpc_vramq_asm.asm
27159/20EB61 :                          ; ngpc_vramq_asm.asm - VRAM queue ASM helpers (TLCS-900/H)
27160/20EB61 :                          ;
27161/20EB61 :                          ; Part of NgpCraft_base_template (MIT License)
27162/20EB61 :                          ;
27163/20EB61 :                          ; Provides ngpc_memcpy_w() -- word-level block copy via LDIRW.
27164/20EB61 :                          ; Used by ngpc_vramq.c CMD_COPY path instead of a byte-by-byte C loop.
27165/20EB61 :                          ; dst is a near VRAM address (0x8000-0xBFFF). src can be near RAM or far ROM.
27166/20EB61 :                          ;
27167/20EB61 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
27168/20EB61 :                          ;
27169/20EB61 :                          ; cc900 calling convention -- args passed as u32 (4 bytes each, unambiguous):
27170/20EB61 :                          ;   (xsp+0)  return address (far)   4 bytes
27171/20EB61 :                          ;   (xsp+4)  dst_addr (u32)         4 bytes  <- near VRAM address (high 16 = 0)
27172/20EB61 :                          ;   (xsp+8)  src_addr (u32)         4 bytes  <- RAM/ROM address (near or far)
27173/20EB61 :                          ;   (xsp+12) words (u32)            4 bytes  <- word count (high 16 = 0)
27174/20EB61 :                          ;
27175/20EB61 :                          ; Using u32 args avoids ambiguity: cc900 may pad u16 args to 4 bytes on stack.
27176/20EB61 :                          ; u32 args are always exactly 4 bytes, matching LD XRR, (xsp+N) reads.
27177/20EB61 :                          ;
27178/20EB61 :                          ; LDIRW guard: BC=0 at entry copies 65536 words -- skip if words==0.
27179/20EB61 :                          ; OR A, C is safe here (ALU instruction; C is not ambiguous as condition code
27180/20EB61 :                          ; in this context -- ambiguity only occurs in LD (mem), c indirect store form).
27181/20EB61 :                          
27182/20EB61 :                          
27183/20EB61 :                          
27184/20EB61 :                          
27185/20EB61 :                          
27186/20EB61 :                          ; ================================================================
27187/20EB61 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
27188/20EB61 :                          ;
27189/20EB61 :                          ; Block-copies 'words' 16-bit words from src_addr to dst_addr via LDIRW.
27190/20EB61 :                          ; Equivalent to: while (words--) *(u16*)dst++ = *(u16*)src++;
27191/20EB61 :                          ; but uses LDIRW hardware block transfer.
27192/20EB61 :                          ;
27193/20EB61 :                          ; Call site (ngpc_vramq.c) passes near u16 addresses widened to u32:
27194/20EB61 :                          ;   ngpc_memcpy_w((u32)dst_u16, (u32)src_u16, (u32)word_count)
27195/20EB61 :                          ; So upper 16 bits of XDE/XHL are guaranteed 0. LDIRW needs upper=0. OK
27196/20EB61 :                          ; ================================================================
27197/20EB61 :                          _ngpc_memcpy_w:
27198/20EB61 :                                  ; Load XDE = dst_addr (full 32-bit; upper 16 = 0 since near address)
27199/20EB61 : AF 04 22                         ld      xde, (xsp+4)
27200/20EB64 :                          
27201/20EB64 :                                  ; Load XHL = src_addr (full 32-bit; may be near or far)
27202/20EB64 : AF 08 23                         ld      xhl, (xsp+8)
27203/20EB67 :                          
27204/20EB67 :                                  ; Load BC = words (low 16 of u32; high 16 is 0 since words <= 65535)
27205/20EB67 : 9F 0C 21                         ld      bc, (xsp+12)
27206/20EB6A :                          
27207/20EB6A :                                  ; BC=0 guard: if words==0, skip (LDIRW BC=0 copies 65536 words!)
27208/20EB6A :                                  ; OR A, C: ALU instruction -- C is register, not condition code here.
27209/20EB6A : CA 89                            ld      a, b
27210/20EB6C : CB E1                            or      a, c
27211/20EB6E : 66 02                            jr      z, memcpy_w_done
27212/20EB70 :                          
27213/20EB70 : 93 11                            ldirw                       ; block copy: BC words from XHL -> XDE
27214/20EB72 :                          
27215/20EB72 :                          memcpy_w_done:
27216/20EB72 : 0E                               ret
27217/20EB73 :                          
27218/20EB73 :                          
27219/20EB73 :                          ; ---- src/fx/ngpc_dma_prog.asm
27220/20EB73 :                          
27221/20EB73 :                          
27222/20EB73 :                          
27223/20EB73 :                          ; C prototypes:
27224/20EB73 :                          ;   void dmaN_program_asm(const u8  __far *src, volatile u8 __far *dst, u16 count);
27225/20EB73 :                          ;   void dmaN_program_u16_asm(const u16 __far *src, volatile u8 __far *dst, u16 count);
27226/20EB73 :                          ;   void dmaN_program_u32_asm(const u32 __far *src, volatile u8 __far *dst, u16 count);
27227/20EB73 :                          ;
27228/20EB73 :                          ; Notes:
27229/20EB73 :                          ; - `count` is written to DMACn directly (i.e. number of DMA "steps"/transfers,
27230/20EB73 :                          ;   not necessarily a byte count when using word/dword modes).
27231/20EB73 :                          ;
27232/20EB73 :                          ; Stack layout on entry (TLCS-900/H cc900):
27233/20EB73 :                          ;   (xsp+0)  return address (far) 4 bytes
27234/20EB73 :                          ;   (xsp+4)  src (far pointer)   4 bytes
27235/20EB73 :                          ;   (xsp+8)  dst (far pointer)   4 bytes
27236/20EB73 :                          ;   (xsp+12) count (u16)         2 bytes
27237/20EB73 :                          ;
27238/20EB73 :                          ; DMA modes (see SDK `HDMA.H`; values here are the real hex values).
27239/20EB73 : =8H                      DMA_MODE_SINC1  equ 8   ; 0x08: byte,  src++
27240/20EB73 : =9H                      DMA_MODE_SINC2  equ 9   ; 0x09: word,  src++
27241/20EB73 : =0AH                     DMA_MODE_SINC4  equ 10  ; 0x0A: dword, src++
27242/20EB73 :                          
27243/20EB73 :                          _dma0_program_asm:
27244/20EB73 : AF 04 20                         ld      xwa,(xsp+4)
27245/20EB76 : E8 2E 00                         ldc    dmas0,xwa
27246/20EB79 : AF 08 20                         ld      xwa,(xsp+8)
27247/20EB7C : E8 2E 10                         ldc    dmad0,xwa
27248/20EB7F : 9F 0C 20                         ld      wa,(xsp+12)
27249/20EB82 : D8 2E 20                         ldc    dmac0,wa
27250/20EB85 : 21 08                            ld      a,DMA_MODE_SINC1
27251/20EB87 : C9 2E 22                         ldc    dmam0,a
27252/20EB8A : 0E                               ret
27253/20EB8B :                          
27254/20EB8B :                          _dma0_program_u16_asm:
27255/20EB8B : AF 04 20                         ld      xwa,(xsp+4)
27256/20EB8E : E8 2E 00                         ldc    dmas0,xwa
27257/20EB91 : AF 08 20                         ld      xwa,(xsp+8)
27258/20EB94 : E8 2E 10                         ldc    dmad0,xwa
27259/20EB97 : 9F 0C 20                         ld      wa,(xsp+12)
27260/20EB9A : D8 2E 20                         ldc    dmac0,wa
27261/20EB9D : 21 09                            ld      a,DMA_MODE_SINC2
27262/20EB9F : C9 2E 22                         ldc    dmam0,a
27263/20EBA2 : 0E                               ret
27264/20EBA3 :                          
27265/20EBA3 :                          _dma0_program_u32_asm:
27266/20EBA3 : AF 04 20                         ld      xwa,(xsp+4)
