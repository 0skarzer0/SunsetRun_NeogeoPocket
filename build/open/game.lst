21217/20B769 :                          ; ---- src/core/ngpc_syspatch.asm
21218/20B769 :                          
21219/20B769 :                          ;
21220/20B769 :                          ; ngpc_syspatch.asm - Power-off bug patch (SYS_PATCH equivalent)
21221/20B769 :                          ;
21222/20B769 :                          ; Part of NgpCraft_base_template (MIT License)
21223/20B769 :                          ;
21224/20B769 :                          ; Reverse-engineered from system.lib (SNK Corporation, 1998).
21225/20B769 :                          ;
21226/20B769 :                          ; The original SYS_PATCH routine fixes a bug in the initial production
21227/20B769 :                          ; NEOGEO POCKET system program: rapid removal/reinsertion of batteries
21228/20B769 :                          ; could prevent the power button from shutting down the console.
21229/20B769 :                          ;
21230/20B769 :                          ; Condition : OS_Version (0x6F91) == 0x00  [prototype firmware only]
21231/20B769 :                          ; Effect    : res 3, (0x6F83)              [clear undocumented sys flag]
21232/20B769 :                          ;             ldb (0x6DA0), 0x00           [clear undocumented power flag]
21233/20B769 :                          ;
21234/20B769 :                          ; On all retail hardware (OS_Version >= 0x01) this is a safe no-op.
21235/20B769 :                          ; Must be called once at startup, before enabling interrupts.
21236/20B769 :                          ;
21237/20B769 :                          ; Reference: MANSysPro.txt "SYS_PATCH", SysLib.txt p.6
21238/20B769 :                          ;
21239/20B769 :                          
21240/20B769 :                          
21241/20B769 :                          
21242/20B769 :                          
21243/20B769 :                          _ngpc_sys_patch:
21244/20B769 :                          
21245/20B769 :                                  ; cp (0x6F91), 0x00  [C1 91 6F 3F 00]
21246/20B769 :                                  ; Compare OS_Version with 0. Z=1 if prototype firmware.
21247/20B769 : C1 91 6F 3F 00                   db 0xC1, 0x91, 0x6F, 0x3F, 0x00
21248/20B76E :                          
21249/20B76E :                                  ; jr NZ, +9  [6E 09]
21250/20B76E :                                  ; Retail hardware (OS_Version != 0): skip patch, fall through to ret.
21251/20B76E : 6E 09                            db 0x6E, 0x09
21252/20B770 :                          
21253/20B770 :                                  ; res 3, (0x6F83)  [F1 83 6F B3]
21254/20B770 :                                  ; Clear bit 3 of undocumented system flag (between Sys_Lever and User_Boot).
21255/20B770 : F1 83 6F B3                      db 0xF1, 0x83, 0x6F, 0xB3
21256/20B774 :                          
21257/20B774 :                                  ; ldb (0x6DA0), 0x00  [F1 A0 6D 00 00]
21258/20B774 :                                  ; Clear undocumented power state register in system RAM.
21259/20B774 : F1 A0 6D 00 00                   db 0xF1, 0xA0, 0x6D, 0x00, 0x00
21260/20B779 :                          
21261/20B779 : 0E                               ret
21262/20B77A :                          
21263/20B77A :                          
21264/20B77A :                          ; ---- src/core/ngpc_vramq_asm.asm
21265/20B77A :                          ; ngpc_vramq_asm.asm - VRAM queue ASM helpers (TLCS-900/H)
21266/20B77A :                          ;
21267/20B77A :                          ; Part of NgpCraft_base_template (MIT License)
21268/20B77A :                          ;
21269/20B77A :                          ; Provides ngpc_memcpy_w() -- word-level block copy via LDIRW.
21270/20B77A :                          ; Used by ngpc_vramq.c CMD_COPY path instead of a byte-by-byte C loop.
21271/20B77A :                          ; dst is a near VRAM address (0x8000-0xBFFF). src can be near RAM or far ROM.
21272/20B77A :                          ;
21273/20B77A :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
21274/20B77A :                          ;
21275/20B77A :                          ; cc900 calling convention -- args passed as u32 (4 bytes each, unambiguous):
21276/20B77A :                          ;   (xsp+0)  return address (far)   4 bytes
21277/20B77A :                          ;   (xsp+4)  dst_addr (u32)         4 bytes  <- near VRAM address (high 16 = 0)
21278/20B77A :                          ;   (xsp+8)  src_addr (u32)         4 bytes  <- RAM/ROM address (near or far)
21279/20B77A :                          ;   (xsp+12) words (u32)            4 bytes  <- word count (high 16 = 0)
21280/20B77A :                          ;
21281/20B77A :                          ; Using u32 args avoids ambiguity: cc900 may pad u16 args to 4 bytes on stack.
21282/20B77A :                          ; u32 args are always exactly 4 bytes, matching LD XRR, (xsp+N) reads.
21283/20B77A :                          ;
21284/20B77A :                          ; LDIRW guard: BC=0 at entry copies 65536 words -- skip if words==0.
21285/20B77A :                          ; OR A, C is safe here (ALU instruction; C is not ambiguous as condition code
21286/20B77A :                          ; in this context -- ambiguity only occurs in LD (mem), c indirect store form).
21287/20B77A :                          
21288/20B77A :                          
21289/20B77A :                          
21290/20B77A :                          
21291/20B77A :                          
21292/20B77A :                          ; ================================================================
21293/20B77A :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
21294/20B77A :                          ;
21295/20B77A :                          ; Block-copies 'words' 16-bit words from src_addr to dst_addr via LDIRW.
21296/20B77A :                          ; Equivalent to: while (words--) *(u16*)dst++ = *(u16*)src++;
21297/20B77A :                          ; but uses LDIRW hardware block transfer.
21298/20B77A :                          ;
21299/20B77A :                          ; Call site (ngpc_vramq.c) passes near u16 addresses widened to u32:
21300/20B77A :                          ;   ngpc_memcpy_w((u32)dst_u16, (u32)src_u16, (u32)word_count)
21301/20B77A :                          ; So upper 16 bits of XDE/XHL are guaranteed 0. LDIRW needs upper=0. OK
21302/20B77A :                          ; ================================================================
21303/20B77A :                          _ngpc_memcpy_w:
21304/20B77A :                                  ; Load XDE = dst_addr (full 32-bit; upper 16 = 0 since near address)
21305/20B77A : AF 04 22                         ld      xde, (xsp+4)
21306/20B77D :                          
21307/20B77D :                                  ; Load XHL = src_addr (full 32-bit; may be near or far)
21308/20B77D : AF 08 23                         ld      xhl, (xsp+8)
21309/20B780 :                          
21310/20B780 :                                  ; Load BC = words (low 16 of u32; high 16 is 0 since words <= 65535)
21311/20B780 : 9F 0C 21                         ld      bc, (xsp+12)
21312/20B783 :                          
21313/20B783 :                                  ; BC=0 guard: if words==0, skip (LDIRW BC=0 copies 65536 words!)
21314/20B783 :                                  ; OR A, C: ALU instruction -- C is register, not condition code here.
21315/20B783 : CA 89                            ld      a, b
21316/20B785 : CB E1                            or      a, c
21317/20B787 : 66 02                            jr      z, memcpy_w_done
21318/20B789 :                          
21319/20B789 : 93 11                            ldirw                       ; block copy: BC words from XHL -> XDE
21320/20B78B :                          
21321/20B78B :                          memcpy_w_done:
21322/20B78B : 0E                               ret
21323/20B78C :                          
21324/20B78C :                          
21325/20B78C :                          ; ---- src/fx/ngpc_dma_prog.asm
21326/20B78C :                          
21327/20B78C :                          
21328/20B78C :                          
21329/20B78C :                          ; C prototypes:
21330/20B78C :                          ;   void dmaN_program_asm(const u8  __far *src, volatile u8 __far *dst, u16 count);
21331/20B78C :                          ;   void dmaN_program_u16_asm(const u16 __far *src, volatile u8 __far *dst, u16 count);
21332/20B78C :                          ;   void dmaN_program_u32_asm(const u32 __far *src, volatile u8 __far *dst, u16 count);
21333/20B78C :                          ;
21334/20B78C :                          ; Notes:
21335/20B78C :                          ; - `count` is written to DMACn directly (i.e. number of DMA "steps"/transfers,
21336/20B78C :                          ;   not necessarily a byte count when using word/dword modes).
21337/20B78C :                          ;
21338/20B78C :                          ; Stack layout on entry (TLCS-900/H cc900):
21339/20B78C :                          ;   (xsp+0)  return address (far) 4 bytes
21340/20B78C :                          ;   (xsp+4)  src (far pointer)   4 bytes
21341/20B78C :                          ;   (xsp+8)  dst (far pointer)   4 bytes
21342/20B78C :                          ;   (xsp+12) count (u16)         2 bytes
21343/20B78C :                          ;
21344/20B78C :                          ; DMA modes (see SDK `HDMA.H`; values here are the real hex values).
21345/20B78C : =8H                      DMA_MODE_SINC1  equ 8   ; 0x08: byte,  src++
21346/20B78C : =9H                      DMA_MODE_SINC2  equ 9   ; 0x09: word,  src++
21347/20B78C : =0AH                     DMA_MODE_SINC4  equ 10  ; 0x0A: dword, src++
21348/20B78C :                          
21349/20B78C :                          _dma0_program_asm:
21350/20B78C : AF 04 20                         ld      xwa,(xsp+4)
21351/20B78F : E8 2E 00                         ldc    dmas0,xwa
21352/20B792 : AF 08 20                         ld      xwa,(xsp+8)
21353/20B795 : E8 2E 10                         ldc    dmad0,xwa
21354/20B798 : 9F 0C 20                         ld      wa,(xsp+12)
21355/20B79B : D8 2E 20                         ldc    dmac0,wa
21356/20B79E : 21 08                            ld      a,DMA_MODE_SINC1
21357/20B7A0 : C9 2E 22                         ldc    dmam0,a
21358/20B7A3 : 0E                               ret
21359/20B7A4 :                          
21360/20B7A4 :                          _dma0_program_u16_asm:
21361/20B7A4 : AF 04 20                         ld      xwa,(xsp+4)
21362/20B7A7 : E8 2E 00                         ldc    dmas0,xwa
21363/20B7AA : AF 08 20                         ld      xwa,(xsp+8)
21364/20B7AD : E8 2E 10                         ldc    dmad0,xwa
21365/20B7B0 : 9F 0C 20                         ld      wa,(xsp+12)
21366/20B7B3 : D8 2E 20                         ldc    dmac0,wa
21367/20B7B6 : 21 09                            ld      a,DMA_MODE_SINC2
21368/20B7B8 : C9 2E 22                         ldc    dmam0,a
21369/20B7BB : 0E                               ret
21370/20B7BC :                          
21371/20B7BC :                          _dma0_program_u32_asm:
21372/20B7BC : AF 04 20                         ld      xwa,(xsp+4)
21373/20B7BF : E8 2E 00                         ldc    dmas0,xwa
21374/20B7C2 : AF 08 20                         ld      xwa,(xsp+8)
21375/20B7C5 : E8 2E 10                         ldc    dmad0,xwa
21376/20B7C8 : 9F 0C 20                         ld      wa,(xsp+12)
21377/20B7CB : D8 2E 20                         ldc    dmac0,wa
21378/20B7CE : 21 0A                            ld      a,DMA_MODE_SINC4
21379/20B7D0 : C9 2E 22                         ldc    dmam0,a
21380/20B7D3 : 0E                               ret
21381/20B7D4 :                          
21382/20B7D4 :                          _dma1_program_asm:
21383/20B7D4 : AF 04 20                         ld      xwa,(xsp+4)
21384/20B7D7 : E8 2E 04                         ldc    dmas1,xwa
21385/20B7DA : AF 08 20                         ld      xwa,(xsp+8)
21386/20B7DD : E8 2E 14                         ldc    dmad1,xwa
21387/20B7E0 : 9F 0C 20                         ld      wa,(xsp+12)
21388/20B7E3 : D8 2E 24                         ldc    dmac1,wa
21389/20B7E6 : 21 08                            ld      a,DMA_MODE_SINC1
21390/20B7E8 : C9 2E 26                         ldc    dmam1,a
21391/20B7EB : 0E                               ret
21392/20B7EC :                          
21393/20B7EC :                          _dma1_program_u16_asm:
21394/20B7EC : AF 04 20                         ld      xwa,(xsp+4)
21395/20B7EF : E8 2E 04                         ldc    dmas1,xwa
21396/20B7F2 : AF 08 20                         ld      xwa,(xsp+8)
21397/20B7F5 : E8 2E 14                         ldc    dmad1,xwa
21398/20B7F8 : 9F 0C 20                         ld      wa,(xsp+12)
21399/20B7FB : D8 2E 24                         ldc    dmac1,wa
21400/20B7FE : 21 09                            ld      a,DMA_MODE_SINC2
21401/20B800 : C9 2E 26                         ldc    dmam1,a
21402/20B803 : 0E                               ret
21403/20B804 :                          
21404/20B804 :                          _dma1_program_u32_asm:
21405/20B804 : AF 04 20                         ld      xwa,(xsp+4)
21406/20B807 : E8 2E 04                         ldc    dmas1,xwa
21407/20B80A : AF 08 20                         ld      xwa,(xsp+8)
21408/20B80D : E8 2E 14                         ldc    dmad1,xwa
21409/20B810 : 9F 0C 20                         ld      wa,(xsp+12)
21410/20B813 : D8 2E 24                         ldc    dmac1,wa
21411/20B816 : 21 0A                            ld      a,DMA_MODE_SINC4
21412/20B818 : C9 2E 26                         ldc    dmam1,a
21413/20B81B : 0E                               ret
21414/20B81C :                          
21415/20B81C :                          _dma2_program_asm:
21416/20B81C : AF 04 20                         ld      xwa,(xsp+4)
21417/20B81F : E8 2E 08                         ldc    dmas2,xwa
21418/20B822 : AF 08 20                         ld      xwa,(xsp+8)
21419/20B825 : E8 2E 18                         ldc    dmad2,xwa
21420/20B828 : 9F 0C 20                         ld      wa,(xsp+12)
21421/20B82B : D8 2E 28                         ldc    dmac2,wa
21422/20B82E : 21 08                            ld      a,DMA_MODE_SINC1
21423/20B830 : C9 2E 2A                         ldc    dmam2,a
21424/20B833 : 0E                               ret
21425/20B834 :                          
21426/20B834 :                          _dma2_program_u16_asm:
21427/20B834 : AF 04 20                         ld      xwa,(xsp+4)
21428/20B837 : E8 2E 08                         ldc    dmas2,xwa
21429/20B83A : AF 08 20                         ld      xwa,(xsp+8)
21430/20B83D : E8 2E 18                         ldc    dmad2,xwa
21431/20B840 : 9F 0C 20                         ld      wa,(xsp+12)
21432/20B843 : D8 2E 28                         ldc    dmac2,wa
21433/20B846 : 21 09                            ld      a,DMA_MODE_SINC2
21434/20B848 : C9 2E 2A                         ldc    dmam2,a
21435/20B84B : 0E                               ret
21436/20B84C :                          
21437/20B84C :                          _dma2_program_u32_asm:
21438/20B84C : AF 04 20                         ld      xwa,(xsp+4)
21439/20B84F : E8 2E 08                         ldc    dmas2,xwa
21440/20B852 : AF 08 20                         ld      xwa,(xsp+8)
21441/20B855 : E8 2E 18                         ldc    dmad2,xwa
21442/20B858 : 9F 0C 20                         ld      wa,(xsp+12)
21443/20B85B : D8 2E 28                         ldc    dmac2,wa
21444/20B85E : 21 0A                            ld      a,DMA_MODE_SINC4
21445/20B860 : C9 2E 2A                         ldc    dmam2,a
