24710/20D414 :                          
24711/20D414 :                          ; ---- src/id_road_asm.asm
24712/20D414 :                          ; id_road_asm.asm - la marche par tranches de id_road_write(), en assembleur
24713/20D414 :                          ;
24714/20D414 :                          ; POURQUOI EN ASSEMBLEUR. Profil de la ROM livree (tools/profil_course.py,
24715/20D414 :                          ; temporisation de la cartouche comprise) : cette boucle etait le plus gros
24716/20D414 :                          ; poste du tour de course. cc900 n'y gardait pas ses valeurs en registres --
24717/20D414 :                          ; tout allait sur la pile -- et relisait chaque adresse de table par une
24718/20D414 :                          ; instruction de cinq octets, cinquante-six fois par trame. Sur cette machine
24719/20D414 :                          ; chaque octet d'instruction se lit dans la cartouche.
24720/20D414 :                          ;
24721/20D414 :                          ; LE CALCUL EST CELUI DU C, A L'OCTET PRES : la version C est gardee dans
24722/20D414 :                          ; id_road.c (ID_ROAD_WALK_C=1) et tools/equivalence.py compare, tour de boucle
24723/20D414 :                          ; par tour de boucle, la RAM de cette ROM a celle de la ROM d'origine sur les
24724/20D414 :                          ; dix circuits.
24725/20D414 :                          ;
24726/20D414 :                          ; !! SEULEMENT DES FORMES QUE cc900 EMET DEJA. Les pieges materiel connus de ce
24727/20D414 :                          ; processeur (docs du projet, fiches) venaient d'encodages que Toshiba n'emet
24728/20D414 :                          ; pas. `python tools/formes_asm.py` verifie chaque instruction de ce fichier
24729/20D414 :                          ; contre le code que cc900 genere pour ce projet (build/prof_asm/*.asm).
24730/20D414 :                          ;
24731/20D414 :                          ; void id_road_walk_asm(RoadWalk *w);
24732/20D414 :                          ;
24733/20D414 :                          ;   (xsp+0) adresse de retour, 4 octets ; (xsp+4) w.
24734/20D414 :                          ;   cc900 : seul XIZ doit etre preserve (ses fonctions le poussent quand elles
24735/20D414 :                          ;   s'en servent) ; XWA XBC XDE XHL XIX XIY sont a l'appele.
24736/20D414 :                          ;
24737/20D414 :                          ; SECONDE ECRITURE (2026-09-19). La premiere relisait dans le bloc, a chaque
24738/20D414 :                          ; tranche, sept pointeurs de table et l'accumulateur : 44 500 cycles par tour.
24739/20D414 :                          ; Celle-ci tient toute la marche en registres :
24740/20D414 :                          ;
24741/20D414 :                          ;   XIX = &id_line_of[k]   (descend de 1)   la pente a +SL_GRADE, la bande a +SL_BANDI
24742/20D414 :                          ;   XIY = &id_shear[k]     (descend de 2)
24743/20D414 :                          ;   XHL = &xy[ligne]       (descend de 2 par ligne ecrite)
24744/20D414 :                          ;   XDE = &bande[ligne]    (descend de 2 par ligne ecrite)
24745/20D414 :                          ;   B   = l'accumulateur   C = la ligne courante (>= top : tient sur un octet)
24746/20D414 :                          ;   XIZ = &hill_rate[20]   (la cadence, indice signe)
24747/20D414 :                          ;
24748/20D414 :                          ; Les valeurs fixes du bloc sont RECOPIEES sur la pile de la routine (F_*) et
24749/20D414 :                          ; lues par (xsp+d) : c'est ce qui libere XIZ pour la table des cadences.
24750/20D414 :                          ;
24751/20D414 :                          ; LES DEUX RETENUES SANS SEIZE BITS. c = (acc + 2 rate) >> 8 et le nouvel
24752/20D414 :                          ; accumulateur est l'octet bas : c'est exactement le nombre de retenues de deux
24753/20D414 :                          ; additions de `rate` sur huit bits, et l'octet restant.
24754/20D414 :                          ;
24755/20D414 :                          ; LA LIGNE Y. (u8)((row >> 8) - (u8)(scr - plane0)) = (row >> 8) + plane0 - scr
24756/20D414 :                          ; modulo 256 : les deux formes rendent le meme octet.
24757/20D414 :                          ;
24758/20D414 :                          ; LA COULEUR DE BANDE EN DEUX TEMPS. band_col[lut[id_bandi[k]]] demande deux
24759/20D414 :                          ; pointeurs de table et la marche n'a plus de registre. Elle pose donc l'INDICE
24760/20D414 :                          ; id_bandi[k] dans l'octet bas de l'entree du tampon de couleur, et une passe
24761/20D414 :                          ; courte, apres elle, le convertit sur les seules lignes ecrites. Aucun octet de
24762/20D414 :                          ; RAM de plus : la pile n'en a pas a donner (voir RoadSlices dans id_road.c).
24763/20D414 :                          ;
24764/20D414 :                          
24765/20D414 :                          ; Le bloc RoadWalk (id_road.c ; sa TAILLE y est VERIFIEE a la compilation) :
24766/20D414 : =0H                      V_XY      equ 0     ; u16 * &xy[road_bottom]
24767/20D414 : =4H                      V_BAND    equ 4     ; u16 * &bandcol[road_bottom]
24768/20D414 : =8H                      V_SL      equ 8     ; u8  * &id_line_of[lines]   (juste APRES la fin)
24769/20D414 : =0CH                     V_SH      equ 12    ; s16 * &id_shear[lines]     (juste APRES la fin)
24770/20D414 : =10H                     V_RTAB    equ 16    ; u8  * &hill_rate[20]
24771/20D414 : =14H                     V_LUT     equ 20    ; u8  * ligne de band_lut de cette trame
24772/20D414 : =18H                     V_BCOL    equ 24    ; u16 * band_col
24773/20D414 : =1CH                     V_ROW     equ 28    ; u16  row_fx     (8.8)
24774/20D414 : =1EH                     V_STEP    equ 30    ; u16  step_fx
24775/20D414 : =20H                     V_HALF    equ 32    ; u16  (u16)step_fx >> 1
24776/20D414 : =22H                     V_TOP     equ 34    ; u8   top_limit        } recopies d'un mot
24777/20D414 : =23H                     V_PLANE0  equ 35    ; u8   road_plane0      }
24778/20D414 : =24H                     V_BASEX   equ 36    ; u8   road_base_x      } recopies d'un mot
24779/20D414 : =25H                     V_N       equ 37    ; u8   entree : lines ; sortie : k + 1
24780/20D414 : =26H                     V_LINE    equ 38    ; u8   entree : road_bottom ; sortie : la ligne a l'arret
24781/20D414 :                          ; Les tableaux voisins de id_line_of (RoadSlices dans id_road.c) :
24782/20D414 : =40H                     SL_GRADE  equ 64    ; id_grade[k] = id_line_of[k] + 64
24783/20D414 : =80H                     SL_BANDI  equ 128   ; id_bandi[k] = id_line_of[k] + 128
24784/20D414 :                          ; Le cadre de la routine, sous la sauvegarde de XIZ :
24785/20D414 : =0H                      F_ROW     equ 0     ; u16  row_fx (modifie)
24786/20D414 : =2H                      F_STEP    equ 2
24787/20D414 : =4H                      F_HALF    equ 4
24788/20D414 : =6H                      F_TOP     equ 6
24789/20D414 : =7H                      F_PLANE0  equ 7
24790/20D414 : =8H                      F_BASEX   equ 8
24791/20D414 : =9H                      F_N       equ 9     ; le compteur de tranches
24792/20D414 : =0AH                     F_BOT     equ 10    ; road_bottom
24793/20D414 : =0CH                     F_SIZE    equ 12
24794/20D414 : =14H                     F_W       equ 20    ; w : F_SIZE + XIZ (4) + adresse de retour (4)
24795/20D414 :                          
24796/20D414 :                          
24797/20D414 :                          
24798/20D414 :                          
24799/20D414 :                          _id_road_walk_asm:
24800/20D414 : 3E                               push    xiz
24801/20D415 : AF 08 20                         ld      xwa,(xsp+0x8)           ; w
24802/20D418 : BF F4 37                         lda     xsp,(xsp-F_SIZE)
24803/20D41B : 98 1C 21                         ld      bc,(xwa+V_ROW)
24804/20D41E : B7 51                            ld      (xsp+F_ROW),bc
24805/20D420 : 98 1E 21                         ld      bc,(xwa+V_STEP)
24806/20D423 : BF 02 51                         ld      (xsp+F_STEP),bc
24807/20D426 : 98 20 21                         ld      bc,(xwa+V_HALF)
24808/20D429 : BF 04 51                         ld      (xsp+F_HALF),bc
24809/20D42C : 98 22 21                         ld      bc,(xwa+V_TOP)          ; top et plane0
24810/20D42F : BF 06 51                         ld      (xsp+F_TOP),bc
24811/20D432 : 98 24 21                         ld      bc,(xwa+V_BASEX)        ; base_x et le compteur
24812/20D435 : BF 08 51                         ld      (xsp+F_BASEX),bc
24813/20D438 : 88 26 23                         ld      c,(xwa+V_LINE)          ; la ligne : road_bottom, >= top (le C le verifie)
24814/20D43B : BF 0A 43                         ld      (xsp+F_BOT),c
24815/20D43E : A0 23                            ld      xhl,(xwa+V_XY)
24816/20D440 : A8 04 22                         ld      xde,(xwa+V_BAND)
24817/20D443 : A8 08 24                         ld      xix,(xwa+V_SL)
24818/20D446 : A8 0C 25                         ld      xiy,(xwa+V_SH)
24819/20D449 : A8 10 26                         ld      xiz,(xwa+V_RTAB)
24820/20D44C : CA A8                            ld      b,0x0                   ; l'accumulateur part de zero, CHAQUE trame
24821/20D44E :                          
24822/20D44E :                          vw_slice:
24823/20D44E : EC 69                            dec     0x1,xix
24824/20D450 : ED 6A                            dec     0x2,xiy
24825/20D452 :                                  ; ou va la tranche : id_line_of[k] = max(ligne, top) = la ligne, puisque
24826/20D452 :                                  ; la marche s'arrete des qu'elle passe sous top
24827/20D452 : B4 43                            ld      (xix),c
24828/20D454 :                                  ; ---- la cadence : hill_rate[20 + id_grade[k]]
24829/20D454 : 8C 40 21                         ld      a,(xix+SL_GRADE)
24830/20D457 : D8 13                            exts    wa
24831/20D459 : C3 07 F8 E0 21                   ld      a,(xiz+wa)
24832/20D45E : C9 88                            ld      w,a
24833/20D460 :                                  ; ---- les deux retenues : A = acc + rate + rate, sur huit bits
24834/20D460 : CA 89                            ld      a,b
24835/20D462 : C8 81                            add     a,w
24836/20D464 : F2 76 D4 20 D7                   jp       ult,vw_c1               ; premiere retenue
24837/20D469 : C8 81                            add     a,w
24838/20D46B : F2 7D D4 20 D7                   jp       ult,vw_one              ; une seule retenue : une ligne
24839/20D470 : C9 8A                            ld      b,a                     ; aucune : la tranche ne prend pas de ligne
24840/20D472 : 1B F3 D4 20                      jp       vw_next
24841/20D476 :                          vw_c1:
24842/20D476 : C8 81                            add     a,w
24843/20D478 : F2 A1 D4 20 D7                   jp       ult,vw_two              ; deux retenues : deux lignes
24844/20D47D :                          vw_one:
24845/20D47D : C9 8A                            ld      b,a
24846/20D47F :                                  ; ---- une ligne, a la rangee de la tranche
24847/20D47F : 8F 01 21                         ld      a,(xsp+F_ROW+1)         ; (u8)(row_fx >> 8)
24848/20D482 : 8F 07 81                         add     a,(xsp+F_PLANE0)
24849/20D485 : CB A1                            sub     a,c
24850/20D487 : C9 88                            ld      w,a
24851/20D489 : 85 21                            ld      a,(xiy)                 ; (u8)dx
24852/20D48B : 8F 08 81                         add     a,(xsp+F_BASEX)
24853/20D48E : B3 50                            ld      (xhl),wa
24854/20D490 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)        ; l'indice de bande, converti plus bas
24855/20D495 : B2 41                            ld      (xde),a
24856/20D497 : EB 6A                            dec     0x2,xhl
24857/20D499 : EA 6A                            dec     0x2,xde
24858/20D49B : CB 69                            dec     0x1,c
24859/20D49D : 1B F3 D4 20                      jp       vw_next
24860/20D4A1 :                          
24861/20D4A1 :                          vw_two:
24862/20D4A1 : C9 8A                            ld      b,a
24863/20D4A3 :                                  ; ---- premiere ligne, a la rangee de la tranche
24864/20D4A3 : 8F 01 21                         ld      a,(xsp+F_ROW+1)
24865/20D4A6 : 8F 07 81                         add     a,(xsp+F_PLANE0)
24866/20D4A9 : CB A1                            sub     a,c
24867/20D4AB : C9 88                            ld      w,a
24868/20D4AD : 85 21                            ld      a,(xiy)
24869/20D4AF : 8F 08 81                         add     a,(xsp+F_BASEX)
24870/20D4B2 : B3 50                            ld      (xhl),wa
24871/20D4B4 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
24872/20D4B9 : B2 41                            ld      (xde),a
24873/20D4BB : EB 6A                            dec     0x2,xhl
24874/20D4BD : EA 6A                            dec     0x2,xde
24875/20D4BF : CB 69                            dec     0x1,c
24876/20D4C1 :                                  ; ---- seconde ligne, seulement si elle reste sur l'ecran, a mi-marche
24877/20D4C1 : 8F 06 F3                         cp      c,(xsp+F_TOP)
24878/20D4C4 : F2 F3 D4 20 D7                   jp       ult,vw_next
24879/20D4C9 : 97 20                            ld      wa,(xsp+F_ROW)
24880/20D4CB : 9F 04 F0                         cp      wa,(xsp+F_HALF)
24881/20D4CE : F2 D6 D4 20 D3                   jp       ule,vw_mid              ; row_fx <= half : pas sous la rangee 0
24882/20D4D3 : 9F 04 A0                         sub     wa,(xsp+F_HALF)
24883/20D4D6 :                          vw_mid:
24884/20D4D6 : C8 89                            ld      a,w                     ; (u8)(mid >> 8)
24885/20D4D8 : 8F 07 81                         add     a,(xsp+F_PLANE0)
24886/20D4DB : CB A1                            sub     a,c
24887/20D4DD : C9 88                            ld      w,a
24888/20D4DF : 85 21                            ld      a,(xiy)
24889/20D4E1 : 8F 08 81                         add     a,(xsp+F_BASEX)
24890/20D4E4 : B3 50                            ld      (xhl),wa
24891/20D4E6 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
24892/20D4EB : B2 41                            ld      (xde),a
24893/20D4ED : EB 6A                            dec     0x2,xhl
24894/20D4EF : EA 6A                            dec     0x2,xde
24895/20D4F1 : CB 69                            dec     0x1,c
24896/20D4F3 :                          
24897/20D4F3 :                          vw_next:
24898/20D4F3 :                                  ; TOUJOURS, meme pour une tranche qui n'a pris aucune ligne
24899/20D4F3 : 9F 02 20                         ld      wa,(xsp+F_STEP)
24900/20D4F6 : 97 A8                            sub     (xsp+F_ROW),wa
24901/20D4F8 : 8F 06 F3                         cp      c,(xsp+F_TOP)
24902/20D4FB : F2 08 D5 20 D7                   jp       ult,vw_done             ; plus d'ecran : le compteur reste k + 1
24903/20D500 : 8F 09 69                         decb    0x1,(xsp+F_N)
24904/20D503 : F2 4E D4 20 DE                   jp       ne,vw_slice             ; au bout : 0, soit k = -1
24905/20D508 :                          
24906/20D508 :                          vw_done:
24907/20D508 :                                  ; ---- les indices de bande deviennent des couleurs, lignes C+1..bas.
24908/20D508 :                                  ; XDE pointe l'entree de la ligne C (la prochaine qu'on aurait ecrite).
24909/20D508 : 8F 0A 21                         ld      a,(xsp+F_BOT)
24910/20D50B : CB A1                            sub     a,c
24911/20D50D : F2 3A D5 20 D6                   jp       eq,vw_conv_done         ; aucune ligne ecrite
24912/20D512 : C9 8A                            ld      b,a
24913/20D514 : AF 14 20                         ld      xwa,(xsp+F_W)
24914/20D517 : A8 14 24                         ld      xix,(xwa+V_LUT)
24915/20D51A : A8 18 25                         ld      xiy,(xwa+V_BCOL)
24916/20D51D :                          vw_conv:
24917/20D51D : EA 62                            inc     0x2,xde
24918/20D51F : 82 21                            ld      a,(xde)
24919/20D521 : D8 12                            extz    wa
24920/20D523 : C3 07 F0 E0 21                   ld      a,(xix+wa)
24921/20D528 : D8 12                            extz    wa
24922/20D52A : D8 80                            add     wa,wa
24923/20D52C : D3 07 F4 E0 20                   ld      wa,(xiy+wa)
24924/20D531 : B2 50                            ld      (xde),wa
24925/20D533 : CA 69                            dec     0x1,b                   ; huit bits : DEC pose les drapeaux
24926/20D535 : F2 1D D5 20 DE                   jp       ne,vw_conv
24927/20D53A :                          vw_conv_done:
24928/20D53A : AF 14 20                         ld      xwa,(xsp+F_W)
24929/20D53D : B8 26 43                         ld      (xwa+V_LINE),c
24930/20D540 :                                  ; !! PAS PAR A : A est l'octet bas de XWA, qui tient le bloc. Une
24931/20D540 :                                  ; premiere version faisait `ld a,(xsp+F_N)` ici et ecrivait le
24932/20D540 :                                  ; compteur a 0x..00+37, dans la pile.
24933/20D540 : 8F 09 22                         ld      b,(xsp+F_N)
24934/20D543 : B8 25 42                         ld      (xwa+V_N),b
24935/20D546 : BF 0C 37                         lda     xsp,(xsp+F_SIZE)
24936/20D549 : 5E                               pop     xiz
24937/20D54A : 0E                               ret
24938/20D54B :                          
24939/20D54B :                          ; ================================================================
24940/20D54B :                          ; void id_road_ahead_asm(RoadAhead *a);
24941/20D54B :                          ;
24942/20D54B :                          ; build_road_ahead() de main.c : pour chaque tranche, du pare-chocs vers
24943/20D54B :                          ; l'horizon, avancer sur le profil jusqu'a la distance que la tranche regarde,
24944/20D54B :                          ; puis rendre le virage et la pente a cette distance, joints arrondis. La
24945/20D54B :                          ; version C reste dans main.c (ID_ROAD_AHEAD_C=1) ; tools/equivalence.py prouve
24946/20D54B :                          ; que les deux rendent la meme RAM, tour par tour, sur les dix circuits.
24947/20D54B :                          ;
24948/20D54B :                          ; Registres pendant la boucle :
24949/20D54B :                          ;   XIX = &ahead[k]            (descend de 2)
24950/20D54B :                          ;   XHL = &road_bend[k]        (descend de 2)
24951/20D54B :                          ;   XBC = &id_grade[k]         (descend de 1 ; id_road_grade_buf)
24952/20D54B :                          ;   XIY = sc, le segment courant
24953/20D54B :                          ;   DE  = into, la position dans ce segment
24954/20D54B :                          ;   XIZ = le bloc (ci-dessous)
24955/20D54B :                          ;
24956/20D54B :                          ; SECONDE ECRITURE (2026-09-19) : DEUX CACHES PAR SEGMENT, valables un appel.
24957/20D54B :                          ; Profil par bloc : le fondu aux jonctions coutait 10 000 cycles par tour et la
24958/20D54B :                          ; borne de pente + grade_tab 8 000, refaits a CHAQUE tranche alors qu'ils ne
24959/20D54B :                          ; dependent que du SEGMENT tant qu'on y reste :
24960/20D54B :                          ;   - la pente a plat d'un segment, bornee et convertie, est la meme pour
24961/20D54B :                          ;     toutes ses tranches (cle A_FKEY) ;
24962/20D54B :                          ;   - un fondu melange le segment courant et un voisin avec un poids w : les
24963/20D54B :                          ;     deux ecarts (voisin - courant, virage et pente) ne dependent que du
24964/20D54B :                          ;     segment et du cote (cles A_NKEY, A_PKEY). Il ne reste par tranche que les
24965/20D54B :                          ;     deux multiplications, et la seconde saute quand les deux pentes sont
24966/20D54B :                          ;     egales -- le cas de toute route plate.
24967/20D54B :                          ; Les cles sont le numero du segment ; 0xFF = vide (track_len est un u8, un
24968/20D54B :                          ; numero vaut au plus 254). Le C les vide avant chaque appel.
24969/20D54B :                          ;
24970/20D54B :                          ; Le bloc RoadAhead (main.c ; taille VERIFIEE a la compilation) :
24971/20D54B : =0H                      A_AHEAD  equ 0      ; const u16 * &ahead[lines]            (juste APRES la fin)
24972/20D54B : =4H                      A_BEND   equ 4      ; s16 *       &road_bend[lines]
24973/20D54B : =8H                      A_GL     equ 8      ; s8 *        &id_grade[lines]
24974/20D54B : =0CH                     A_SEG    equ 12     ; const Segment * track_seg
24975/20D54B : =10H                     A_GTAB   equ 16     ; const s8 *  &grade_tab[HILL_SLOPE_MAX]  (indice signe)
24976/20D54B : =14H                     A_SC     equ 20     ; const Segment * &track_seg[seg_index]
24977/20D54B : =18H                     A_INTO   equ 24     ; u16 seg_pos
24978/20D54B : =1AH                     A_W      equ 26     ; u16 want (temporaire, traversee de segments)
24979/20D54B : =1CH                     A_K      equ 28     ; u8  lignes (> 0)
24980/20D54B : =1DH                     A_CUR    equ 29     ; u8  seg_index
24981/20D54B : =1EH                     A_LEN    equ 30     ; u8  track_len
24982/20D54B : =1FH                     A_FKEY   equ 31     ; u8  segment de la pente a plat en cache (0xFF = vide)
24983/20D54B : =20H                     A_FG     equ 32     ; s8  cette pente, bornee et convertie
24984/20D54B : =21H                     A_NKEY   equ 33     ; u8  segment du fondu vers le SUIVANT en cache
24985/20D54B : =22H                     A_PKEY   equ 34     ; u8  ... vers le PRECEDENT
24986/20D54B : =24H                     A_NDB    equ 36     ; s16 suivant->bend - bend
24987/20D54B : =26H                     A_NDP    equ 38     ; s16 suivant->slope - slope
24988/20D54B : =28H                     A_PDB    equ 40     ; s16 precedent->bend - bend
24989/20D54B : =2AH                     A_PDP    equ 42     ; s16 precedent->slope - slope
24990/20D54B :                          ; Segment : span u16 +0, bend s16 +2, slope s8 +4, six octets.
24991/20D54B :                          
24992/20D54B :                          
24993/20D54B :                          _id_road_ahead_asm:
24994/20D54B : 3E                               push    xiz
24995/20D54C : AF 08 26                         ld      xiz,(xsp+0x8)
24996/20D54F : A6 24                            ld      xix,(xiz+A_AHEAD)
24997/20D551 : AE 04 23                         ld      xhl,(xiz+A_BEND)
24998/20D554 : AE 08 21                         ld      xbc,(xiz+A_GL)
24999/20D557 : AE 14 25                         ld      xiy,(xiz+A_SC)
25000/20D55A : 9E 18 22                         ld      de,(xiz+A_INTO)
25001/20D55D :                                  ; la PREMIERE tranche : walked vaut 0
25002/20D55D : EC 6A                            dec     0x2,xix
25003/20D55F : EB 6A                            dec     0x2,xhl
25004/20D561 : E9 69                            dec     0x1,xbc
25005/20D563 : 94 20                            ld      wa,(xix)
25006/20D565 : 1B 74 D5 20                      jp       ah_want
25007/20D569 :                          
25008/20D569 :                          _id_road_ahead_asm__L1:
25009/20D569 :                          ah_slice:
25010/20D569 : EC 6A                            dec     0x2,xix
25011/20D56B : EB 6A                            dec     0x2,xhl
25012/20D56D : E9 69                            dec     0x1,xbc
25013/20D56F :                                  ; want = ahead[k] - walked, et walked est ahead[k+1] : la tranche
25014/20D56F :                                  ; d'avant, deux octets plus haut dans le meme tableau
25015/20D56F : 94 20                            ld      wa,(xix)
25016/20D571 : 9C 02 A0                         sub     wa,(xix+0x2)
25017/20D574 :                          _id_road_ahead_asm__L2:
25018/20D574 :                          ah_want:
25019/20D574 :                                  ; LE CAS COURANT SANS MEMOIRE : into += want, et si ca reste dans le
25020/20D574 :                                  ; segment, c'est fini. (u16)(into + want) >= span se lit sur DE lui-meme.
25021/20D574 : D8 82                            add     de,wa
25022/20D576 : 95 F2                            cp      de,(xiy)
25023/20D578 : F2 BE D5 20 D7                   jp       ult,ah_seg_ok
25024/20D57D : D8 A2                            sub     de,wa                   ; on defait, et on marche segment par segment
25025/20D57F : BE 1A 50                         ld      (xiz+A_W),wa
25026/20D582 :                          _id_road_ahead_asm__L3:
25027/20D582 :                          ah_seg:
25028/20D582 : DA 88                            ld      wa,de
25029/20D584 : 9E 1A 80                         add     wa,(xiz+A_W)
25030/20D587 : 95 F0                            cp      wa,(xiy)
25031/20D589 : F2 BB D5 20 D7                   jp       ult,ah_seg_last
25032/20D58E : 95 20                            ld      wa,(xiy)                ; want -= span - into
25033/20D590 : DA A0                            sub     wa,de                   ; (formes emises par cc900 ; l'ancien
25034/20D592 : 9E 1A A8                         sub     (xiz+A_W),wa            ;  `sub wa,(xiy)` n'en etait pas une)
25035/20D595 : 8E 1D 21                         ld      a,(xiz+A_CUR)           ; le voisin SANS modulo
25036/20D598 : C9 61                            inc     0x1,a
25037/20D59A : 8E 1E F1                         cp      a,(xiz+A_LEN)
25038/20D59D : F2 A4 D5 20 D7                   jp       ult,ah_cur_ok
25039/20D5A2 : C9 A8                            ld      a,0x0
25040/20D5A4 :                          ah_cur_ok:
25041/20D5A4 : BE 1D 41                         ld      (xiz+A_CUR),a
25042/20D5A7 : D8 12                            extz    wa
25043/20D5A9 : D8 09 06 00                      muls    xwa,0x6
25044/20D5AD : AE 0C 25                         ld      xiy,(xiz+A_SEG)
25045/20D5B0 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa)
25046/20D5B5 : DA A8                            ld      de,0x0
25047/20D5B7 : 1B 82 D5 20                      jp       ah_seg
25048/20D5BB :                          ah_seg_last:
25049/20D5BB : 9E 1A 82                         add     de,(xiz+A_W)            ; into += want
25050/20D5BE :                          _id_road_ahead_asm__L4:
25051/20D5BE :                          ah_seg_ok:
25052/20D5BE :                                  ; rem = span - into
25053/20D5BE : 95 20                            ld      wa,(xiy)
25054/20D5C0 : DA A0                            sub     wa,de
25055/20D5C2 : DA F0                            cp      wa,de
25056/20D5C4 : F2 35 D6 20 DB                   jp       ugt,ah_prev             ; pas (rem <= into)
25057/20D5C9 : D8 CF 80 00                      cp      wa,0x80
25058/20D5CD : F2 35 D6 20 DF                   jp       uge,ah_prev             ; pas (rem < BEND_HALF)
25059/20D5D2 : D8 07                            neg     wa                      ; w = BEND_HALF - rem
25060/20D5D4 : D8 C8 80 00                      add     wa,0x80
