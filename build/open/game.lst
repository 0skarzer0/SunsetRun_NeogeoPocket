27476/20ED8D :                          
27477/20ED8D :                          ; ---- src/id_road_asm.asm
27478/20ED8D :                          ; id_road_asm.asm - la marche par tranches de id_road_write(), en assembleur
27479/20ED8D :                          ;
27480/20ED8D :                          ; POURQUOI EN ASSEMBLEUR. Profil de la ROM livree (tools/profil_course.py,
27481/20ED8D :                          ; temporisation de la cartouche comprise) : cette boucle etait le plus gros
27482/20ED8D :                          ; poste du tour de course. cc900 n'y gardait pas ses valeurs en registres --
27483/20ED8D :                          ; tout allait sur la pile -- et relisait chaque adresse de table par une
27484/20ED8D :                          ; instruction de cinq octets, cinquante-six fois par trame. Sur cette machine
27485/20ED8D :                          ; chaque octet d'instruction se lit dans la cartouche.
27486/20ED8D :                          ;
27487/20ED8D :                          ; LE CALCUL EST CELUI DU C, A L'OCTET PRES : la version C est gardee dans
27488/20ED8D :                          ; id_road.c (ID_ROAD_WALK_C=1) et tools/equivalence.py compare, tour de boucle
27489/20ED8D :                          ; par tour de boucle, la RAM de cette ROM a celle de la ROM d'origine sur les
27490/20ED8D :                          ; dix circuits.
27491/20ED8D :                          ;
27492/20ED8D :                          ; !! SEULEMENT DES FORMES QUE cc900 EMET DEJA. Les pieges materiel connus de ce
27493/20ED8D :                          ; processeur (docs du projet, fiches) venaient d'encodages que Toshiba n'emet
27494/20ED8D :                          ; pas. `python tools/formes_asm.py` verifie chaque instruction de ce fichier
27495/20ED8D :                          ; contre le code que cc900 genere pour ce projet (build/prof_asm/*.asm).
27496/20ED8D :                          ;
27497/20ED8D :                          ; void id_road_walk_asm(RoadWalk *w);
27498/20ED8D :                          ;
27499/20ED8D :                          ;   (xsp+0) adresse de retour, 4 octets ; (xsp+4) w.
27500/20ED8D :                          ;   cc900 : seul XIZ doit etre preserve (ses fonctions le poussent quand elles
27501/20ED8D :                          ;   s'en servent) ; XWA XBC XDE XHL XIX XIY sont a l'appele.
27502/20ED8D :                          ;
27503/20ED8D :                          ; SECONDE ECRITURE (2026-09-19). La premiere relisait dans le bloc, a chaque
27504/20ED8D :                          ; tranche, sept pointeurs de table et l'accumulateur : 44 500 cycles par tour.
27505/20ED8D :                          ; Celle-ci tient toute la marche en registres :
27506/20ED8D :                          ;
27507/20ED8D :                          ;   XIX = &id_line_of[k]   (descend de 1)   la pente a +SL_GRADE, la bande a +SL_BANDI
27508/20ED8D :                          ;   XIY = &id_shear[k]     (descend de 2)
27509/20ED8D :                          ;   XHL = &xy[ligne]       (descend de 2 par ligne ecrite)
27510/20ED8D :                          ;   XDE = &bande[ligne]    (descend de 2 par ligne ecrite)
27511/20ED8D :                          ;   B   = l'accumulateur   C = la ligne courante (>= top : tient sur un octet)
27512/20ED8D :                          ;   XIZ = &hill_rate[20]   (la cadence, indice signe)
27513/20ED8D :                          ;
27514/20ED8D :                          ; Les valeurs fixes du bloc sont RECOPIEES sur la pile de la routine (F_*) et
27515/20ED8D :                          ; lues par (xsp+d) : c'est ce qui libere XIZ pour la table des cadences.
27516/20ED8D :                          ;
27517/20ED8D :                          ; LES DEUX RETENUES SANS SEIZE BITS. c = (acc + 2 rate) >> 8 et le nouvel
27518/20ED8D :                          ; accumulateur est l'octet bas : c'est exactement le nombre de retenues de deux
27519/20ED8D :                          ; additions de `rate` sur huit bits, et l'octet restant.
27520/20ED8D :                          ;
27521/20ED8D :                          ; LA LIGNE Y. (u8)((row >> 8) - (u8)(scr - plane0)) = (row >> 8) + plane0 - scr
27522/20ED8D :                          ; modulo 256 : les deux formes rendent le meme octet.
27523/20ED8D :                          ;
27524/20ED8D :                          ; LA COULEUR DE BANDE EN DEUX TEMPS. band_col[lut[id_bandi[k]]] demande deux
27525/20ED8D :                          ; pointeurs de table et la marche n'a plus de registre. Elle pose donc l'INDICE
27526/20ED8D :                          ; id_bandi[k] dans l'octet bas de l'entree du tampon de couleur, et une passe
27527/20ED8D :                          ; courte, apres elle, le convertit sur les seules lignes ecrites. Aucun octet de
27528/20ED8D :                          ; RAM de plus : la pile n'en a pas a donner (voir RoadSlices dans id_road.c).
27529/20ED8D :                          ;
27530/20ED8D :                          
27531/20ED8D :                          ; Le bloc RoadWalk (id_road.c ; sa TAILLE y est VERIFIEE a la compilation) :
27532/20ED8D : =0H                      V_XY      equ 0     ; u16 * &xy[road_bottom]
27533/20ED8D : =4H                      V_BAND    equ 4     ; u16 * &bandcol[road_bottom]
27534/20ED8D : =8H                      V_SL      equ 8     ; u8  * &id_line_of[lines]   (juste APRES la fin)
27535/20ED8D : =0CH                     V_SH      equ 12    ; s16 * &id_shear[lines]     (juste APRES la fin)
27536/20ED8D : =10H                     V_RTAB    equ 16    ; u8  * &hill_rate[20]
27537/20ED8D : =14H                     V_LUT     equ 20    ; u8  * ligne de band_lut de cette trame
27538/20ED8D : =18H                     V_BCOL    equ 24    ; u16 * band_col
27539/20ED8D : =1CH                     V_ROW     equ 28    ; u16  row_fx     (8.8)
27540/20ED8D : =1EH                     V_STEP    equ 30    ; u16  step_fx
27541/20ED8D : =20H                     V_HALF    equ 32    ; u16  (u16)step_fx >> 1
27542/20ED8D : =22H                     V_TOP     equ 34    ; u8   top_limit        } recopies d'un mot
27543/20ED8D : =23H                     V_PLANE0  equ 35    ; u8   road_plane0      }
27544/20ED8D : =24H                     V_BASEX   equ 36    ; u8   road_base_x      } recopies d'un mot
27545/20ED8D : =25H                     V_N       equ 37    ; u8   entree : lines ; sortie : k + 1
27546/20ED8D : =26H                     V_LINE    equ 38    ; u8   entree : road_bottom ; sortie : la ligne a l'arret
27547/20ED8D :                          ; Les tableaux voisins de id_line_of (RoadSlices dans id_road.c) :
27548/20ED8D : =40H                     SL_GRADE  equ 64    ; id_grade[k] = id_line_of[k] + 64
27549/20ED8D : =80H                     SL_BANDI  equ 128   ; id_bandi[k] = id_line_of[k] + 128
27550/20ED8D :                          ; Le cadre de la routine, sous la sauvegarde de XIZ :
27551/20ED8D : =0H                      F_ROW     equ 0     ; u16  row_fx (modifie)
27552/20ED8D : =2H                      F_STEP    equ 2
27553/20ED8D : =4H                      F_HALF    equ 4
27554/20ED8D : =6H                      F_TOP     equ 6
27555/20ED8D : =7H                      F_PLANE0  equ 7
27556/20ED8D : =8H                      F_BASEX   equ 8
27557/20ED8D : =9H                      F_N       equ 9     ; le compteur de tranches
27558/20ED8D : =0AH                     F_BOT     equ 10    ; road_bottom
27559/20ED8D : =0CH                     F_SIZE    equ 12
27560/20ED8D : =14H                     F_W       equ 20    ; w : F_SIZE + XIZ (4) + adresse de retour (4)
27561/20ED8D :                          
27562/20ED8D :                          
27563/20ED8D :                          
27564/20ED8D :                          
27565/20ED8D :                          _id_road_walk_asm:
27566/20ED8D : 3E                               push    xiz
27567/20ED8E : AF 08 20                         ld      xwa,(xsp+0x8)           ; w
27568/20ED91 : BF F4 37                         lda     xsp,(xsp-F_SIZE)
27569/20ED94 : 98 1C 21                         ld      bc,(xwa+V_ROW)
27570/20ED97 : B7 51                            ld      (xsp+F_ROW),bc
27571/20ED99 : 98 1E 21                         ld      bc,(xwa+V_STEP)
27572/20ED9C : BF 02 51                         ld      (xsp+F_STEP),bc
27573/20ED9F : 98 20 21                         ld      bc,(xwa+V_HALF)
27574/20EDA2 : BF 04 51                         ld      (xsp+F_HALF),bc
27575/20EDA5 : 98 22 21                         ld      bc,(xwa+V_TOP)          ; top et plane0
27576/20EDA8 : BF 06 51                         ld      (xsp+F_TOP),bc
27577/20EDAB : 98 24 21                         ld      bc,(xwa+V_BASEX)        ; base_x et le compteur
27578/20EDAE : BF 08 51                         ld      (xsp+F_BASEX),bc
27579/20EDB1 : 88 26 23                         ld      c,(xwa+V_LINE)          ; la ligne : road_bottom, >= top (le C le verifie)
27580/20EDB4 : BF 0A 43                         ld      (xsp+F_BOT),c
27581/20EDB7 : A0 23                            ld      xhl,(xwa+V_XY)
27582/20EDB9 : A8 04 22                         ld      xde,(xwa+V_BAND)
27583/20EDBC : A8 08 24                         ld      xix,(xwa+V_SL)
27584/20EDBF : A8 0C 25                         ld      xiy,(xwa+V_SH)
27585/20EDC2 : A8 10 26                         ld      xiz,(xwa+V_RTAB)
27586/20EDC5 : CA A8                            ld      b,0x0                   ; l'accumulateur part de zero, CHAQUE trame
27587/20EDC7 :                          
27588/20EDC7 :                          vw_slice:
27589/20EDC7 : EC 69                            dec     0x1,xix
27590/20EDC9 : ED 6A                            dec     0x2,xiy
27591/20EDCB :                                  ; ou va la tranche : id_line_of[k] = max(ligne, top) = la ligne, puisque
27592/20EDCB :                                  ; la marche s'arrete des qu'elle passe sous top
27593/20EDCB : B4 43                            ld      (xix),c
27594/20EDCD :                                  ; ---- la cadence : hill_rate[20 + id_grade[k]]
27595/20EDCD : 8C 40 21                         ld      a,(xix+SL_GRADE)
27596/20EDD0 : D8 13                            exts    wa
27597/20EDD2 : C3 07 F8 E0 21                   ld      a,(xiz+wa)
27598/20EDD7 : C9 88                            ld      w,a
27599/20EDD9 :                                  ; ---- les deux retenues : A = acc + rate + rate, sur huit bits
27600/20EDD9 : CA 89                            ld      a,b
27601/20EDDB : C8 81                            add     a,w
27602/20EDDD : F2 EF ED 20 D7                   jp       ult,vw_c1               ; premiere retenue
27603/20EDE2 : C8 81                            add     a,w
27604/20EDE4 : F2 F6 ED 20 D7                   jp       ult,vw_one              ; une seule retenue : une ligne
27605/20EDE9 : C9 8A                            ld      b,a                     ; aucune : la tranche ne prend pas de ligne
27606/20EDEB : 1B 6C EE 20                      jp       vw_next
27607/20EDEF :                          vw_c1:
27608/20EDEF : C8 81                            add     a,w
27609/20EDF1 : F2 1A EE 20 D7                   jp       ult,vw_two              ; deux retenues : deux lignes
27610/20EDF6 :                          vw_one:
27611/20EDF6 : C9 8A                            ld      b,a
27612/20EDF8 :                                  ; ---- une ligne, a la rangee de la tranche
27613/20EDF8 : 8F 01 21                         ld      a,(xsp+F_ROW+1)         ; (u8)(row_fx >> 8)
27614/20EDFB : 8F 07 81                         add     a,(xsp+F_PLANE0)
27615/20EDFE : CB A1                            sub     a,c
27616/20EE00 : C9 88                            ld      w,a
27617/20EE02 : 85 21                            ld      a,(xiy)                 ; (u8)dx
27618/20EE04 : 8F 08 81                         add     a,(xsp+F_BASEX)
27619/20EE07 : B3 50                            ld      (xhl),wa
27620/20EE09 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)        ; l'indice de bande, converti plus bas
27621/20EE0E : B2 41                            ld      (xde),a
27622/20EE10 : EB 6A                            dec     0x2,xhl
27623/20EE12 : EA 6A                            dec     0x2,xde
27624/20EE14 : CB 69                            dec     0x1,c
27625/20EE16 : 1B 6C EE 20                      jp       vw_next
27626/20EE1A :                          
27627/20EE1A :                          vw_two:
27628/20EE1A : C9 8A                            ld      b,a
27629/20EE1C :                                  ; ---- premiere ligne, a la rangee de la tranche
27630/20EE1C : 8F 01 21                         ld      a,(xsp+F_ROW+1)
27631/20EE1F : 8F 07 81                         add     a,(xsp+F_PLANE0)
27632/20EE22 : CB A1                            sub     a,c
27633/20EE24 : C9 88                            ld      w,a
27634/20EE26 : 85 21                            ld      a,(xiy)
27635/20EE28 : 8F 08 81                         add     a,(xsp+F_BASEX)
27636/20EE2B : B3 50                            ld      (xhl),wa
27637/20EE2D : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
27638/20EE32 : B2 41                            ld      (xde),a
27639/20EE34 : EB 6A                            dec     0x2,xhl
27640/20EE36 : EA 6A                            dec     0x2,xde
27641/20EE38 : CB 69                            dec     0x1,c
27642/20EE3A :                                  ; ---- seconde ligne, seulement si elle reste sur l'ecran, a mi-marche
27643/20EE3A : 8F 06 F3                         cp      c,(xsp+F_TOP)
27644/20EE3D : F2 6C EE 20 D7                   jp       ult,vw_next
27645/20EE42 : 97 20                            ld      wa,(xsp+F_ROW)
27646/20EE44 : 9F 04 F0                         cp      wa,(xsp+F_HALF)
27647/20EE47 : F2 4F EE 20 D3                   jp       ule,vw_mid              ; row_fx <= half : pas sous la rangee 0
27648/20EE4C : 9F 04 A0                         sub     wa,(xsp+F_HALF)
27649/20EE4F :                          vw_mid:
27650/20EE4F : C8 89                            ld      a,w                     ; (u8)(mid >> 8)
27651/20EE51 : 8F 07 81                         add     a,(xsp+F_PLANE0)
27652/20EE54 : CB A1                            sub     a,c
27653/20EE56 : C9 88                            ld      w,a
27654/20EE58 : 85 21                            ld      a,(xiy)
27655/20EE5A : 8F 08 81                         add     a,(xsp+F_BASEX)
27656/20EE5D : B3 50                            ld      (xhl),wa
27657/20EE5F : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
27658/20EE64 : B2 41                            ld      (xde),a
27659/20EE66 : EB 6A                            dec     0x2,xhl
27660/20EE68 : EA 6A                            dec     0x2,xde
27661/20EE6A : CB 69                            dec     0x1,c
27662/20EE6C :                          
27663/20EE6C :                          vw_next:
27664/20EE6C :                                  ; TOUJOURS, meme pour une tranche qui n'a pris aucune ligne
27665/20EE6C : 9F 02 20                         ld      wa,(xsp+F_STEP)
27666/20EE6F : 97 A8                            sub     (xsp+F_ROW),wa
27667/20EE71 : 8F 06 F3                         cp      c,(xsp+F_TOP)
27668/20EE74 : F2 81 EE 20 D7                   jp       ult,vw_done             ; plus d'ecran : le compteur reste k + 1
27669/20EE79 : 8F 09 69                         decb    0x1,(xsp+F_N)
27670/20EE7C : F2 C7 ED 20 DE                   jp       ne,vw_slice             ; au bout : 0, soit k = -1
27671/20EE81 :                          
27672/20EE81 :                          vw_done:
27673/20EE81 :                                  ; ---- les indices de bande deviennent des couleurs, lignes C+1..bas.
27674/20EE81 :                                  ; XDE pointe l'entree de la ligne C (la prochaine qu'on aurait ecrite).
27675/20EE81 : 8F 0A 21                         ld      a,(xsp+F_BOT)
27676/20EE84 : CB A1                            sub     a,c
27677/20EE86 : F2 B3 EE 20 D6                   jp       eq,vw_conv_done         ; aucune ligne ecrite
27678/20EE8B : C9 8A                            ld      b,a
27679/20EE8D : AF 14 20                         ld      xwa,(xsp+F_W)
27680/20EE90 : A8 14 24                         ld      xix,(xwa+V_LUT)
27681/20EE93 : A8 18 25                         ld      xiy,(xwa+V_BCOL)
27682/20EE96 :                          vw_conv:
27683/20EE96 : EA 62                            inc     0x2,xde
27684/20EE98 : 82 21                            ld      a,(xde)
27685/20EE9A : D8 12                            extz    wa
27686/20EE9C : C3 07 F0 E0 21                   ld      a,(xix+wa)
27687/20EEA1 : D8 12                            extz    wa
27688/20EEA3 : D8 80                            add     wa,wa
27689/20EEA5 : D3 07 F4 E0 20                   ld      wa,(xiy+wa)
27690/20EEAA : B2 50                            ld      (xde),wa
27691/20EEAC : CA 69                            dec     0x1,b                   ; huit bits : DEC pose les drapeaux
27692/20EEAE : F2 96 EE 20 DE                   jp       ne,vw_conv
27693/20EEB3 :                          vw_conv_done:
27694/20EEB3 : AF 14 20                         ld      xwa,(xsp+F_W)
27695/20EEB6 : B8 26 43                         ld      (xwa+V_LINE),c
27696/20EEB9 :                                  ; !! PAS PAR A : A est l'octet bas de XWA, qui tient le bloc. Une
27697/20EEB9 :                                  ; premiere version faisait `ld a,(xsp+F_N)` ici et ecrivait le
27698/20EEB9 :                                  ; compteur a 0x..00+37, dans la pile.
27699/20EEB9 : 8F 09 22                         ld      b,(xsp+F_N)
27700/20EEBC : B8 25 42                         ld      (xwa+V_N),b
27701/20EEBF : BF 0C 37                         lda     xsp,(xsp+F_SIZE)
27702/20EEC2 : 5E                               pop     xiz
27703/20EEC3 : 0E                               ret
27704/20EEC4 :                          
27705/20EEC4 :                          ; ================================================================
27706/20EEC4 :                          ; void id_road_ahead_asm(RoadAhead *a);
27707/20EEC4 :                          ;
27708/20EEC4 :                          ; build_road_ahead() de main.c : pour chaque tranche, du pare-chocs vers
27709/20EEC4 :                          ; l'horizon, avancer sur le profil jusqu'a la distance que la tranche regarde,
27710/20EEC4 :                          ; puis rendre le virage et la pente a cette distance, joints arrondis. La
27711/20EEC4 :                          ; version C reste dans main.c (ID_ROAD_AHEAD_C=1) ; tools/equivalence.py prouve
27712/20EEC4 :                          ; que les deux rendent la meme RAM, tour par tour, sur les dix circuits.
27713/20EEC4 :                          ;
27714/20EEC4 :                          ; Registres pendant la boucle :
27715/20EEC4 :                          ;   XIX = &ahead[k]            (descend de 2)
27716/20EEC4 :                          ;   XHL = &road_bend[k]        (descend de 2)
27717/20EEC4 :                          ;   XBC = &id_grade[k]         (descend de 1 ; id_road_grade_buf)
27718/20EEC4 :                          ;   XIY = sc, le segment courant
27719/20EEC4 :                          ;   DE  = into, la position dans ce segment
27720/20EEC4 :                          ;   XIZ = le bloc (ci-dessous)
27721/20EEC4 :                          ;
27722/20EEC4 :                          ; SECONDE ECRITURE (2026-09-19) : DEUX CACHES PAR SEGMENT, valables un appel.
27723/20EEC4 :                          ; Profil par bloc : le fondu aux jonctions coutait 10 000 cycles par tour et la
27724/20EEC4 :                          ; borne de pente + grade_tab 8 000, refaits a CHAQUE tranche alors qu'ils ne
27725/20EEC4 :                          ; dependent que du SEGMENT tant qu'on y reste :
27726/20EEC4 :                          ;   - la pente a plat d'un segment, bornee et convertie, est la meme pour
27727/20EEC4 :                          ;     toutes ses tranches (cle A_FKEY) ;
27728/20EEC4 :                          ;   - un fondu melange le segment courant et un voisin avec un poids w : les
27729/20EEC4 :                          ;     deux ecarts (voisin - courant, virage et pente) ne dependent que du
27730/20EEC4 :                          ;     segment et du cote (cles A_NKEY, A_PKEY). Il ne reste par tranche que les
27731/20EEC4 :                          ;     deux multiplications, et la seconde saute quand les deux pentes sont
27732/20EEC4 :                          ;     egales -- le cas de toute route plate.
27733/20EEC4 :                          ; Les cles sont le numero du segment ; 0xFF = vide (track_len est un u8, un
27734/20EEC4 :                          ; numero vaut au plus 254). Le C les vide avant chaque appel.
27735/20EEC4 :                          ;
27736/20EEC4 :                          ; Le bloc RoadAhead (main.c ; taille VERIFIEE a la compilation) :
27737/20EEC4 : =0H                      A_AHEAD  equ 0      ; const u16 * &ahead[lines]            (juste APRES la fin)
27738/20EEC4 : =4H                      A_BEND   equ 4      ; s16 *       &road_bend[lines]
27739/20EEC4 : =8H                      A_GL     equ 8      ; s8 *        &id_grade[lines]
27740/20EEC4 : =0CH                     A_SEG    equ 12     ; const Segment * track_seg
27741/20EEC4 : =10H                     A_GTAB   equ 16     ; const s8 *  &grade_tab[HILL_SLOPE_MAX]  (indice signe)
27742/20EEC4 : =14H                     A_SC     equ 20     ; const Segment * &track_seg[seg_index]
27743/20EEC4 : =18H                     A_INTO   equ 24     ; u16 seg_pos
27744/20EEC4 : =1AH                     A_W      equ 26     ; u16 want (temporaire, traversee de segments)
27745/20EEC4 : =1CH                     A_K      equ 28     ; u8  lignes (> 0)
27746/20EEC4 : =1DH                     A_CUR    equ 29     ; u8  seg_index
27747/20EEC4 : =1EH                     A_LEN    equ 30     ; u8  track_len
27748/20EEC4 : =1FH                     A_FKEY   equ 31     ; u8  segment de la pente a plat en cache (0xFF = vide)
27749/20EEC4 : =20H                     A_FG     equ 32     ; s8  cette pente, bornee et convertie
27750/20EEC4 : =21H                     A_NKEY   equ 33     ; u8  segment du fondu vers le SUIVANT en cache
27751/20EEC4 : =22H                     A_PKEY   equ 34     ; u8  ... vers le PRECEDENT
27752/20EEC4 : =24H                     A_NDB    equ 36     ; s16 suivant->bend - bend
27753/20EEC4 : =26H                     A_NDP    equ 38     ; s16 suivant->slope - slope
27754/20EEC4 : =28H                     A_PDB    equ 40     ; s16 precedent->bend - bend
27755/20EEC4 : =2AH                     A_PDP    equ 42     ; s16 precedent->slope - slope
27756/20EEC4 :                          ; Segment : span u16 +0, bend s16 +2, slope s8 +4, six octets.
27757/20EEC4 :                          
27758/20EEC4 :                          
27759/20EEC4 :                          _id_road_ahead_asm:
27760/20EEC4 : 3E                               push    xiz
27761/20EEC5 : AF 08 26                         ld      xiz,(xsp+0x8)
27762/20EEC8 : A6 24                            ld      xix,(xiz+A_AHEAD)
27763/20EECA : AE 04 23                         ld      xhl,(xiz+A_BEND)
27764/20EECD : AE 08 21                         ld      xbc,(xiz+A_GL)
27765/20EED0 : AE 14 25                         ld      xiy,(xiz+A_SC)
27766/20EED3 : 9E 18 22                         ld      de,(xiz+A_INTO)
27767/20EED6 :                                  ; la PREMIERE tranche : walked vaut 0
27768/20EED6 : EC 6A                            dec     0x2,xix
27769/20EED8 : EB 6A                            dec     0x2,xhl
27770/20EEDA : E9 69                            dec     0x1,xbc
27771/20EEDC : 94 20                            ld      wa,(xix)
27772/20EEDE : 1B ED EE 20                      jp       ah_want
27773/20EEE2 :                          
27774/20EEE2 :                          _id_road_ahead_asm__L1:
27775/20EEE2 :                          ah_slice:
27776/20EEE2 : EC 6A                            dec     0x2,xix
27777/20EEE4 : EB 6A                            dec     0x2,xhl
27778/20EEE6 : E9 69                            dec     0x1,xbc
27779/20EEE8 :                                  ; want = ahead[k] - walked, et walked est ahead[k+1] : la tranche
27780/20EEE8 :                                  ; d'avant, deux octets plus haut dans le meme tableau
27781/20EEE8 : 94 20                            ld      wa,(xix)
27782/20EEEA : 9C 02 A0                         sub     wa,(xix+0x2)
27783/20EEED :                          _id_road_ahead_asm__L2:
27784/20EEED :                          ah_want:
27785/20EEED :                                  ; LE CAS COURANT SANS MEMOIRE : into += want, et si ca reste dans le
27786/20EEED :                                  ; segment, c'est fini. (u16)(into + want) >= span se lit sur DE lui-meme.
27787/20EEED : D8 82                            add     de,wa
27788/20EEEF : 95 F2                            cp      de,(xiy)
27789/20EEF1 : F2 37 EF 20 D7                   jp       ult,ah_seg_ok
27790/20EEF6 : D8 A2                            sub     de,wa                   ; on defait, et on marche segment par segment
27791/20EEF8 : BE 1A 50                         ld      (xiz+A_W),wa
27792/20EEFB :                          _id_road_ahead_asm__L3:
27793/20EEFB :                          ah_seg:
27794/20EEFB : DA 88                            ld      wa,de
27795/20EEFD : 9E 1A 80                         add     wa,(xiz+A_W)
27796/20EF00 : 95 F0                            cp      wa,(xiy)
27797/20EF02 : F2 34 EF 20 D7                   jp       ult,ah_seg_last
27798/20EF07 : 95 20                            ld      wa,(xiy)                ; want -= span - into
27799/20EF09 : DA A0                            sub     wa,de                   ; (formes emises par cc900 ; l'ancien
27800/20EF0B : 9E 1A A8                         sub     (xiz+A_W),wa            ;  `sub wa,(xiy)` n'en etait pas une)
27801/20EF0E : 8E 1D 21                         ld      a,(xiz+A_CUR)           ; le voisin SANS modulo
27802/20EF11 : C9 61                            inc     0x1,a
27803/20EF13 : 8E 1E F1                         cp      a,(xiz+A_LEN)
27804/20EF16 : F2 1D EF 20 D7                   jp       ult,ah_cur_ok
