28052/20F429 :                          ; ---- src/core/ngpc_syspatch.asm
28053/20F429 :                          
28054/20F429 :                          ;
28055/20F429 :                          ; ngpc_syspatch.asm - Power-off bug patch (SYS_PATCH equivalent)
28056/20F429 :                          ;
28057/20F429 :                          ; Part of NgpCraft_base_template (MIT License)
28058/20F429 :                          ;
28059/20F429 :                          ; Reverse-engineered from system.lib (SNK Corporation, 1998).
28060/20F429 :                          ;
28061/20F429 :                          ; The original SYS_PATCH routine fixes a bug in the initial production
28062/20F429 :                          ; NEOGEO POCKET system program: rapid removal/reinsertion of batteries
28063/20F429 :                          ; could prevent the power button from shutting down the console.
28064/20F429 :                          ;
28065/20F429 :                          ; Condition : OS_Version (0x6F91) == 0x00  [prototype firmware only]
28066/20F429 :                          ; Effect    : res 3, (0x6F83)              [clear undocumented sys flag]
28067/20F429 :                          ;             ldb (0x6DA0), 0x00           [clear undocumented power flag]
28068/20F429 :                          ;
28069/20F429 :                          ; On all retail hardware (OS_Version >= 0x01) this is a safe no-op.
28070/20F429 :                          ; Must be called once at startup, before enabling interrupts.
28071/20F429 :                          ;
28072/20F429 :                          ; Reference: MANSysPro.txt "SYS_PATCH", SysLib.txt p.6
28073/20F429 :                          ;
28074/20F429 :                          
28075/20F429 :                          
28076/20F429 :                          
28077/20F429 :                          
28078/20F429 :                          _ngpc_sys_patch:
28079/20F429 :                          
28080/20F429 :                                  ; cp (0x6F91), 0x00  [C1 91 6F 3F 00]
28081/20F429 :                                  ; Compare OS_Version with 0. Z=1 if prototype firmware.
28082/20F429 : C1 91 6F 3F 00                   db 0xC1, 0x91, 0x6F, 0x3F, 0x00
28083/20F42E :                          
28084/20F42E :                                  ; jr NZ, +9  [6E 09]
28085/20F42E :                                  ; Retail hardware (OS_Version != 0): skip patch, fall through to ret.
28086/20F42E : 6E 09                            db 0x6E, 0x09
28087/20F430 :                          
28088/20F430 :                                  ; res 3, (0x6F83)  [F1 83 6F B3]
28089/20F430 :                                  ; Clear bit 3 of undocumented system flag (between Sys_Lever and User_Boot).
28090/20F430 : F1 83 6F B3                      db 0xF1, 0x83, 0x6F, 0xB3
28091/20F434 :                          
28092/20F434 :                                  ; ldb (0x6DA0), 0x00  [F1 A0 6D 00 00]
28093/20F434 :                                  ; Clear undocumented power state register in system RAM.
28094/20F434 : F1 A0 6D 00 00                   db 0xF1, 0xA0, 0x6D, 0x00, 0x00
28095/20F439 :                          
28096/20F439 : 0E                               ret
28097/20F43A :                          
28098/20F43A :                          
28099/20F43A :                          ; ---- src/core/ngpc_vramq_asm.asm
28100/20F43A :                          ; ngpc_vramq_asm.asm - VRAM queue ASM helpers (TLCS-900/H)
28101/20F43A :                          ;
28102/20F43A :                          ; Part of NgpCraft_base_template (MIT License)
28103/20F43A :                          ;
28104/20F43A :                          ; Provides ngpc_memcpy_w() -- word-level block copy via LDIRW.
28105/20F43A :                          ; Used by ngpc_vramq.c CMD_COPY path instead of a byte-by-byte C loop.
28106/20F43A :                          ; dst is a near VRAM address (0x8000-0xBFFF). src can be near RAM or far ROM.
28107/20F43A :                          ;
28108/20F43A :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
28109/20F43A :                          ;
28110/20F43A :                          ; cc900 calling convention -- args passed as u32 (4 bytes each, unambiguous):
28111/20F43A :                          ;   (xsp+0)  return address (far)   4 bytes
28112/20F43A :                          ;   (xsp+4)  dst_addr (u32)         4 bytes  <- near VRAM address (high 16 = 0)
28113/20F43A :                          ;   (xsp+8)  src_addr (u32)         4 bytes  <- RAM/ROM address (near or far)
28114/20F43A :                          ;   (xsp+12) words (u32)            4 bytes  <- word count (high 16 = 0)
28115/20F43A :                          ;
28116/20F43A :                          ; Using u32 args avoids ambiguity: cc900 may pad u16 args to 4 bytes on stack.
28117/20F43A :                          ; u32 args are always exactly 4 bytes, matching LD XRR, (xsp+N) reads.
28118/20F43A :                          ;
28119/20F43A :                          ; LDIRW guard: BC=0 at entry copies 65536 words -- skip if words==0.
28120/20F43A :                          ; OR A, C is safe here (ALU instruction; C is not ambiguous as condition code
28121/20F43A :                          ; in this context -- ambiguity only occurs in LD (mem), c indirect store form).
28122/20F43A :                          
28123/20F43A :                          
28124/20F43A :                          
28125/20F43A :                          
28126/20F43A :                          
28127/20F43A :                          ; ================================================================
28128/20F43A :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
28129/20F43A :                          ;
28130/20F43A :                          ; Block-copies 'words' 16-bit words from src_addr to dst_addr via LDIRW.
28131/20F43A :                          ; Equivalent to: while (words--) *(u16*)dst++ = *(u16*)src++;
28132/20F43A :                          ; but uses LDIRW hardware block transfer.
28133/20F43A :                          ;
28134/20F43A :                          ; Call site (ngpc_vramq.c) passes near u16 addresses widened to u32:
28135/20F43A :                          ;   ngpc_memcpy_w((u32)dst_u16, (u32)src_u16, (u32)word_count)
28136/20F43A :                          ; So upper 16 bits of XDE/XHL are guaranteed 0. LDIRW needs upper=0. OK
28137/20F43A :                          ; ================================================================
28138/20F43A :                          _ngpc_memcpy_w:
28139/20F43A :                                  ; Load XDE = dst_addr (full 32-bit; upper 16 = 0 since near address)
28140/20F43A : AF 04 22                         ld      xde, (xsp+4)
28141/20F43D :                          
28142/20F43D :                                  ; Load XHL = src_addr (full 32-bit; may be near or far)
28143/20F43D : AF 08 23                         ld      xhl, (xsp+8)
28144/20F440 :                          
28145/20F440 :                                  ; Load BC = words (low 16 of u32; high 16 is 0 since words <= 65535)
28146/20F440 : 9F 0C 21                         ld      bc, (xsp+12)
28147/20F443 :                          
28148/20F443 :                                  ; BC=0 guard: if words==0, skip (LDIRW BC=0 copies 65536 words!)
28149/20F443 :                                  ; OR A, C: ALU instruction -- C is register, not condition code here.
28150/20F443 : CA 89                            ld      a, b
28151/20F445 : CB E1                            or      a, c
28152/20F447 : 66 02                            jr      z, memcpy_w_done
28153/20F449 :                          
28154/20F449 : 93 11                            ldirw                       ; block copy: BC words from XHL -> XDE
28155/20F44B :                          
28156/20F44B :                          memcpy_w_done:
28157/20F44B : 0E                               ret
28158/20F44C :                          
28159/20F44C :                          
28160/20F44C :                          ; ---- src/fx/ngpc_dma_prog.asm
28161/20F44C :                          
28162/20F44C :                          
28163/20F44C :                          
28164/20F44C :                          ; C prototypes:
28165/20F44C :                          ;   void dmaN_program_asm(const u8  __far *src, volatile u8 __far *dst, u16 count);
28166/20F44C :                          ;   void dmaN_program_u16_asm(const u16 __far *src, volatile u8 __far *dst, u16 count);
28167/20F44C :                          ;   void dmaN_program_u32_asm(const u32 __far *src, volatile u8 __far *dst, u16 count);
28168/20F44C :                          ;
28169/20F44C :                          ; Notes:
28170/20F44C :                          ; - `count` is written to DMACn directly (i.e. number of DMA "steps"/transfers,
28171/20F44C :                          ;   not necessarily a byte count when using word/dword modes).
28172/20F44C :                          ;
28173/20F44C :                          ; Stack layout on entry (TLCS-900/H cc900):
28174/20F44C :                          ;   (xsp+0)  return address (far) 4 bytes
28175/20F44C :                          ;   (xsp+4)  src (far pointer)   4 bytes
28176/20F44C :                          ;   (xsp+8)  dst (far pointer)   4 bytes
28177/20F44C :                          ;   (xsp+12) count (u16)         2 bytes
28178/20F44C :                          ;
28179/20F44C :                          ; DMA modes (see SDK `HDMA.H`; values here are the real hex values).
28180/20F44C : =8H                      DMA_MODE_SINC1  equ 8   ; 0x08: byte,  src++
28181/20F44C : =9H                      DMA_MODE_SINC2  equ 9   ; 0x09: word,  src++
28182/20F44C : =0AH                     DMA_MODE_SINC4  equ 10  ; 0x0A: dword, src++
28183/20F44C :                          
