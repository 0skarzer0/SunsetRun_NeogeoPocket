27194/20EBE8 :                          ; ===========================================================================
27195/20EBE8 :                          ; Erase stub, extracted from StarGunner/bin/main.ngp (hardware-validated).
27196/20EBE8 :                          ; 98 bytes, file offset 0x13733. Position-independent, uses XIX for AMD cycles.
27197/20EBE8 :                          ;   AMD unlock -> reset -> unlock -> erase setup (0x80) -> unlock -> sector
27198/20EBE8 :                          ;   erase (0x30) -> poll DQ7 -> final reset/unlock -> ret
27199/20EBE8 :                          ;   Register interface: XIX=cart_base XDE=block_addr XIY=0 A=0
27200/20EBE8 :                          ; ===========================================================================
27201/20EBE8 :                          
27202/20EBE8 :                          _erase_stub:
27203/20EBE8 : F3 F1 55 55 00 AA F3 F1          db      0xF3,0xF1,0x55,0x55,0x00,0xAA, 0xF3,0xF1,0xAA,0x2A,0x00,0x55
      20EBF0 : AA 2A 00 55            
27204/20EBF4 : F3 F1 55 55 00 F0 00 00          db      0xF3,0xF1,0x55,0x55,0x00,0xF0, 0x00,0x00,0xF3,0xF1,0x55,0x55
      20EBFC : F3 F1 55 55            
27205/20EC00 : 00 AA F3 F1 AA 2A 00 55          db      0x00,0xAA,0xF3,0xF1,0xAA,0x2A, 0x00,0x55,0xF3,0xF1,0x55,0x55
      20EC08 : F3 F1 55 55            
27206/20EC0C : 00 80 F3 F1 55 55 00 AA          db      0x00,0x80,0xF3,0xF1,0x55,0x55, 0x00,0xAA,0xF3,0xF1,0xAA,0x2A
      20EC14 : F3 F1 AA 2A            
27207/20EC18 : 00 55 B2 00 30 82 3F FF          db      0x00,0x55,0xB2,0x00,0x30,0x82, 0x3F,0xFF,0x66,0x15,0xED,0x61
      20EC20 : 66 15 ED 61            
27208/20EC24 : ED CF FF FF 1F 00 66 09          db      0xED,0xCF,0xFF,0xFF,0x1F,0x00, 0x66,0x09,0xB2,0xCD,0x66,0xED
      20EC2C : B2 CD 66 ED            
27209/20EC30 : 82 3F FF 66 02 21 FF F3          db      0x82,0x3F,0xFF,0x66,0x02,0x21, 0xFF,0xF3,0xF1,0x55,0x55,0x00
      20EC38 : F1 55 55 00            
27210/20EC3C : AA F3 F1 AA 2A 00 55 F3          db      0xAA,0xF3,0xF1,0xAA,0x2A,0x00, 0x55,0xF3,0xF1,0x55,0x55,0x00
      20EC44 : F1 55 55 00            
