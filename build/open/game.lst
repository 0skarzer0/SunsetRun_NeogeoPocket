28263/20F6ED :                          ; ---- src/core/ngpc_flash_asm.asm
28264/20F6ED :                          
28265/20F6ED :                          ;
28266/20F6ED :                          ; ngpc_flash_asm.asm - Flash erase/write primitives for ngpc_flash.c
28267/20F6ED :                          ;
28268/20F6ED :                          ; Part of NgpCraft_base_template (MIT License)
28269/20F6ED :                          ;
28270/20F6ED :                          ; Two entry points, both called ONLY by ngpc_flash.c (never from an ISR):
28271/20F6ED :                          ;
28272/20F6ED :                          ;   _ngpc_flash_erase_asm(u32 abs_block)
28273/20F6ED :                          ;       Erases one 8 KB block with the AMD erase stub extracted from StarGunner
28274/20F6ED :                          ;       (hardware-validated), copied to RAM 0x6E00 and run from there.
28275/20F6ED :                          ;       VECT_FLASHERS cannot erase blocks 32/33/34 (SysCall.txt p.299), so the
28276/20F6ED :                          ;       erase keeps the stub.
28277/20F6ED :                          ;
28278/20F6ED :                          ;   _ngpc_flash_write_bios(const void *src, u32 offset, u32 pages)
28279/20F6ED :                          ;       Programs pages x 256 bytes through the BIOS (VECT_FLASHWRITE, swi 1),
28280/20F6ED :                          ;       the path StarGunner uses on hardware. The watchdog is refreshed right
28281/20F6ED :                          ;       before and right after, as in the SDK save pattern.
28282/20F6ED :                          ;
28283/20F6ED :                          ; THE BLOCK IS A PARAMETER, NOT A CONSTANT. The save block sits 0x6000 below
28284/20F6ED :                          ; the top of the chip, so its address depends on the cartridge size:
28285/20F6ED :                          ; 0x27A000 on 4 Mbit, 0x2FA000 on 8 Mbit, 0x3FA000 on 16 Mbit. A hard-coded
28286/20F6ED :                          ; 0x3FA000 erases 8 KB ELSEWHERE on a smaller chip - possibly the game code.
28287/20F6ED :                          ; ngpc_flash.c reads the size the BIOS stores at 0x6C58 and refuses unknown ones.
28288/20F6ED :                          ;
28289/20F6ED :                          ; cc900 ABI (CALL pushes 4-byte XPC as return address):
28290/20F6ED :                          ;   (xsp+0)..(xsp+3)  = return address
28291/20F6ED :                          ;   (xsp+4)..(xsp+7)  = 1st parameter
28292/20F6ED :                          ;   (xsp+8)..(xsp+11) = 2nd parameter
28293/20F6ED :                          ;   (xsp+12)..(xsp+15)= 3rd parameter
28294/20F6ED :                          ;
28295/20F6ED :                          ; ===========================================================================
28296/20F6ED :                          ; INTERRUPTS ARE PROHIBITED FOR THE WHOLE SEQUENCE. On hardware that is not
28297/20F6ED :                          ; optional. A flash chip being programmed or erased answers reads with STATUS,
28298/20F6ED :                          ; not with its contents. The stub runs from RAM for that reason, but the
28299/20F6ED :                          ; interrupt handlers are still in the cartridge: an interrupt taken while the
28300/20F6ED :                          ; chip is busy fetches its handler from status bits. A game taking VBlank at
28301/20F6ED :                          ; 60 Hz cannot get through a 256-byte program or an 8 KB erase without one.
28302/20F6ED :                          ;
28303/20F6ED :                          ; AN EMULATOR WHOSE FLASH KEEPS SERVING ROM DURING THE WRITE NEVER SHOWS THIS.
28304/20F6ED :                          ; Toshiba: "all interrupts are prohibited during system calls related to flash
28305/20F6ED :                          ; memory management" (SysCall.txt). Hence `di` (encoded 06 07 = EI 7) on entry
28306/20F6ED :                          ; and `ei 0` (06 00) on exit: level 0 is what ngpc_init() runs the game at.
28307/20F6ED :                          ; ===========================================================================
28308/20F6ED :                          
28309/20F6ED :                          
28310/20F6ED :                          
28311/20F6ED : =6E00H                   FLASH_RAM       equ     0x6E00          ; RAM address for stub execution
28312/20F6ED : =6EH                     FLASH_BUS_CTRL  equ     0x6E            ; I/O: flash /WE enable (0x14=on, 0xF0=off)
28313/20F6ED : =6FH                     FLASH_WD        equ     0x6F            ; I/O: watchdog  (0xB1=extended, 0x4E=refresh)
28314/20F6ED : =200000H                 CART_BASE       equ     0x200000        ; CS0 base address
28315/20F6ED :                          
28316/20F6ED :                          
28317/20F6ED :                          
28318/20F6ED :                          ; ===========================================================================
28319/20F6ED :                          ; _ngpc_flash_erase_asm
28320/20F6ED :                          ;   param 1 (xsp+4) : u32 abs_block -- ABSOLUTE address of the 8 KB block
28321/20F6ED :                          ; C prototype: void ngpc_flash_erase_asm(u32 abs_block);
28322/20F6ED :                          ; ===========================================================================
28323/20F6ED :                          _ngpc_flash_erase_asm:
28324/20F6ED :                          
28325/20F6ED : 06 07                            di                              ; see the note at the top of the file
28326/20F6EF : 08 6E 14                         ld      (FLASH_BUS_CTRL),0x14   ; enable /WE on cart bus
28327/20F6F2 : 08 6F B1                         ld      (FLASH_WD),0xB1         ; watchdog: extended mode
28328/20F6F5 :                          
28329/20F6F5 :                                  ; Copy erase stub (98 bytes) from ROM to RAM at FLASH_RAM
28330/20F6F5 : 39                               push    xbc                     ; preserve XBC across copy
28331/20F6F6 : 42 00 6E 00 00                   ld      xde,FLASH_RAM           ; destination: RAM
28332/20F6FB : 43 42 F7 20 00                   ld      xhl,_erase_stub         ; source: stub bytes in ROM
28333/20F700 : 31 62 00                         ld      bc,0x62                 ; BC = 98 bytes
28334/20F703 : 83 11                            db      0x83,0x11               ; ldir (xde+),(xhl+) -- copy BC bytes
28335/20F705 : 59                               pop     xbc                     ; restore XBC (stack back to entry)
28336/20F706 :                          
28337/20F706 :                                  ; Set up registers for stub call
28338/20F706 : 44 00 00 20 00                   ld      xix,CART_BASE           ; XIX = 0x200000 (AMD unlock base)
28339/20F70B : ED A8                            ld      xiy,0x0                 ; XIY = 0 (erase stub uses as delay counter)
28340/20F70D : C9 A8                            ld      a,0x0                   ; A = 0 (erase stub state init)
28341/20F70F : AF 04 22                         ld      xde,(xsp+4)             ; XDE = block, given by the caller
28342/20F712 :                          
28343/20F712 : 1C 00 6E                         call    FLASH_RAM               ; execute stub from RAM
28344/20F715 :                          
28345/20F715 : 08 6E F0                         ld      (FLASH_BUS_CTRL),0xF0   ; restore watchdog mode first
28346/20F718 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; then refresh the enabled watchdog
28347/20F71B : 06 00                            ei      0                       ; the chip answers as memory again
28348/20F71D : 0E                               ret
28349/20F71E :                          
28350/20F71E :                          
28351/20F71E :                          ; ===========================================================================
28352/20F71E :                          ; _ngpc_flash_write_bios
28353/20F71E :                          ;   param 1 (xsp+4)  : const void *src -- source buffer, in RAM
28354/20F71E :                          ;   param 2 (xsp+8)  : u32 offset      -- offset INSIDE the cartridge
28355/20F71E :                          ;                                         (e.g. 0x1FA000 + slot*SAVE_SIZE),
28356/20F71E :                          ;                                         not the absolute address: XDE3 wants
28357/20F71E :                          ;                                         the offset.
28358/20F71E :                          ;   param 3 (xsp+12) : u32 pages       -- number of 256-byte units
28359/20F71E :                          ; C prototype: void ngpc_flash_write_bios(const void *src, u32 offset, u32 pages);
28360/20F71E :                          ;
28361/20F71E :                          ; The BIOS holds the bus itself (no manual 0x6E write). The AMD write stub used
28362/20F71E :                          ; before disabled the watchdog and wrote its refresh code while it was off.
28363/20F71E :                          ; ===========================================================================
28364/20F71E :                          _ngpc_flash_write_bios:
28365/20F71E :                          
28366/20F71E : 06 07                            di                              ; see the note at the top of the file
28367/20F720 : AF 04 23                         ld      xhl,(xsp+4)             ; 1st param: source
28368/20F723 : AF 08 22                         ld      xde,(xsp+8)             ; 2nd param: cartridge offset
28369/20F726 : AF 0C 21                         ld      xbc,(xsp+12)            ; 3rd param: 256-byte pages
28370/20F729 : E7 3C 9B                         ld      xhl3,xhl                ; bank 3: the BIOS reads its arguments there
28371/20F72C : E7 38 9A                         ld      xde3,xde
28372/20F72F : E7 34 99                         ld      xbc3,xbc
28373/20F732 : C7 30 A8                         ld      ra3,0                   ; CS0
28374/20F735 : C7 31 AE                         ld      rw3,0x0006              ; VECT_FLASHWRITE
28375/20F738 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; watchdog refreshed RIGHT BEFORE
28376/20F73B : F9                               swi     1
28377/20F73C : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; and right after
28378/20F73F : 06 00                            ei      0
28379/20F741 : 0E                               ret
28380/20F742 :                          
28381/20F742 :                          
28382/20F742 :                          ; ===========================================================================
28383/20F742 :                          ; Erase stub, extracted from StarGunner/bin/main.ngp (hardware-validated).
28384/20F742 :                          ; 98 bytes, file offset 0x13733. Position-independent, uses XIX for AMD cycles.
28385/20F742 :                          ;   AMD unlock -> reset -> unlock -> erase setup (0x80) -> unlock -> sector
28386/20F742 :                          ;   erase (0x30) -> poll DQ7 -> final reset/unlock -> ret
28387/20F742 :                          ;   Register interface: XIX=cart_base XDE=block_addr XIY=0 A=0
28388/20F742 :                          ; ===========================================================================
28389/20F742 :                          
28390/20F742 :                          _erase_stub:
28391/20F742 : F3 F1 55 55 00 AA F3 F1          db      0xF3,0xF1,0x55,0x55,0x00,0xAA, 0xF3,0xF1,0xAA,0x2A,0x00,0x55
      20F74A : AA 2A 00 55            
28392/20F74E : F3 F1 55 55 00 F0 00 00          db      0xF3,0xF1,0x55,0x55,0x00,0xF0, 0x00,0x00,0xF3,0xF1,0x55,0x55
      20F756 : F3 F1 55 55            
28393/20F75A : 00 AA F3 F1 AA 2A 00 55          db      0x00,0xAA,0xF3,0xF1,0xAA,0x2A, 0x00,0x55,0xF3,0xF1,0x55,0x55
      20F762 : F3 F1 55 55            
28394/20F766 : 00 80 F3 F1 55 55 00 AA          db      0x00,0x80,0xF3,0xF1,0x55,0x55, 0x00,0xAA,0xF3,0xF1,0xAA,0x2A
      20F76E : F3 F1 AA 2A            
28395/20F772 : 00 55 B2 00 30 82 3F FF          db      0x00,0x55,0xB2,0x00,0x30,0x82, 0x3F,0xFF,0x66,0x15,0xED,0x61
      20F77A : 66 15 ED 61            
28396/20F77E : ED CF FF FF 1F 00 66 09          db      0xED,0xCF,0xFF,0xFF,0x1F,0x00, 0x66,0x09,0xB2,0xCD,0x66,0xED
      20F786 : B2 CD 66 ED            
28397/20F78A : 82 3F FF 66 02 21 FF F3          db      0x82,0x3F,0xFF,0x66,0x02,0x21, 0xFF,0xF3,0xF1,0x55,0x55,0x00
      20F792 : F1 55 55 00            
28398/20F796 : AA F3 F1 AA 2A 00 55 F3          db      0xAA,0xF3,0xF1,0xAA,0x2A,0x00, 0x55,0xF3,0xF1,0x55,0x55,0x00
      20F79E : F1 55 55 00            
28399/20F7A2 : F0 0E                            db      0xF0,0x0E
28400/20F7A4 :                          
28401/20F7A4 :                          ; ---- src/core/ngpc_syspatch.asm
28402/20F7A4 :                          
28403/20F7A4 :                          ;
28404/20F7A4 :                          ; ngpc_syspatch.asm - Power-off bug patch (SYS_PATCH equivalent)
28405/20F7A4 :                          ;
28406/20F7A4 :                          ; Part of NgpCraft_base_template (MIT License)
28407/20F7A4 :                          ;
28408/20F7A4 :                          ; Reverse-engineered from system.lib (SNK Corporation, 1998).
28409/20F7A4 :                          ;
28410/20F7A4 :                          ; The original SYS_PATCH routine fixes a bug in the initial production
28411/20F7A4 :                          ; NEOGEO POCKET system program: rapid removal/reinsertion of batteries
28412/20F7A4 :                          ; could prevent the power button from shutting down the console.
28413/20F7A4 :                          ;
28414/20F7A4 :                          ; Condition : OS_Version (0x6F91) == 0x00  [prototype firmware only]
28415/20F7A4 :                          ; Effect    : res 3, (0x6F83)              [clear undocumented sys flag]
28416/20F7A4 :                          ;             ldb (0x6DA0), 0x00           [clear undocumented power flag]
28417/20F7A4 :                          ;
28418/20F7A4 :                          ; On all retail hardware (OS_Version >= 0x01) this is a safe no-op.
28419/20F7A4 :                          ; Must be called once at startup, before enabling interrupts.
28420/20F7A4 :                          ;
28421/20F7A4 :                          ; Reference: MANSysPro.txt "SYS_PATCH", SysLib.txt p.6
28422/20F7A4 :                          ;
28423/20F7A4 :                          
28424/20F7A4 :                          
28425/20F7A4 :                          
28426/20F7A4 :                          
28427/20F7A4 :                          _ngpc_sys_patch:
28428/20F7A4 :                          
28429/20F7A4 :                                  ; cp (0x6F91), 0x00  [C1 91 6F 3F 00]
28430/20F7A4 :                                  ; Compare OS_Version with 0. Z=1 if prototype firmware.
28431/20F7A4 : C1 91 6F 3F 00                   db 0xC1, 0x91, 0x6F, 0x3F, 0x00
28432/20F7A9 :                          
28433/20F7A9 :                                  ; jr NZ, +9  [6E 09]
28434/20F7A9 :                                  ; Retail hardware (OS_Version != 0): skip patch, fall through to ret.
28435/20F7A9 : 6E 09                            db 0x6E, 0x09
28436/20F7AB :                          
28437/20F7AB :                                  ; res 3, (0x6F83)  [F1 83 6F B3]
28438/20F7AB :                                  ; Clear bit 3 of undocumented system flag (between Sys_Lever and User_Boot).
28439/20F7AB : F1 83 6F B3                      db 0xF1, 0x83, 0x6F, 0xB3
28440/20F7AF :                          
28441/20F7AF :                                  ; ldb (0x6DA0), 0x00  [F1 A0 6D 00 00]
28442/20F7AF :                                  ; Clear undocumented power state register in system RAM.
28443/20F7AF : F1 A0 6D 00 00                   db 0xF1, 0xA0, 0x6D, 0x00, 0x00
28444/20F7B4 :                          
28445/20F7B4 : 0E                               ret
28446/20F7B5 :                          
28447/20F7B5 :                          
28448/20F7B5 :                          ; ---- src/core/ngpc_vramq_asm.asm
28449/20F7B5 :                          ; ngpc_vramq_asm.asm - VRAM queue ASM helpers (TLCS-900/H)
28450/20F7B5 :                          ;
28451/20F7B5 :                          ; Part of NgpCraft_base_template (MIT License)
28452/20F7B5 :                          ;
28453/20F7B5 :                          ; Provides ngpc_memcpy_w() -- word-level block copy via LDIRW.
28454/20F7B5 :                          ; Used by ngpc_vramq.c CMD_COPY path instead of a byte-by-byte C loop.
28455/20F7B5 :                          ; dst is a near VRAM address (0x8000-0xBFFF). src can be near RAM or far ROM.
28456/20F7B5 :                          ;
28457/20F7B5 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
28458/20F7B5 :                          ;
28459/20F7B5 :                          ; cc900 calling convention -- args passed as u32 (4 bytes each, unambiguous):
28460/20F7B5 :                          ;   (xsp+0)  return address (far)   4 bytes
28461/20F7B5 :                          ;   (xsp+4)  dst_addr (u32)         4 bytes  <- near VRAM address (high 16 = 0)
28462/20F7B5 :                          ;   (xsp+8)  src_addr (u32)         4 bytes  <- RAM/ROM address (near or far)
28463/20F7B5 :                          ;   (xsp+12) words (u32)            4 bytes  <- word count (high 16 = 0)
28464/20F7B5 :                          ;
28465/20F7B5 :                          ; Using u32 args avoids ambiguity: cc900 may pad u16 args to 4 bytes on stack.
28466/20F7B5 :                          ; u32 args are always exactly 4 bytes, matching LD XRR, (xsp+N) reads.
28467/20F7B5 :                          ;
28468/20F7B5 :                          ; LDIRW guard: BC=0 at entry copies 65536 words -- skip if words==0.
28469/20F7B5 :                          ; OR A, C is safe here (ALU instruction; C is not ambiguous as condition code
28470/20F7B5 :                          ; in this context -- ambiguity only occurs in LD (mem), c indirect store form).
28471/20F7B5 :                          
28472/20F7B5 :                          
28473/20F7B5 :                          
28474/20F7B5 :                          
28475/20F7B5 :                          
28476/20F7B5 :                          ; ================================================================
28477/20F7B5 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
28478/20F7B5 :                          ;
28479/20F7B5 :                          ; Block-copies 'words' 16-bit words from src_addr to dst_addr via LDIRW.
28480/20F7B5 :                          ; Equivalent to: while (words--) *(u16*)dst++ = *(u16*)src++;
28481/20F7B5 :                          ; but uses LDIRW hardware block transfer.
28482/20F7B5 :                          ;
28483/20F7B5 :                          ; Call site (ngpc_vramq.c) passes near u16 addresses widened to u32:
28484/20F7B5 :                          ;   ngpc_memcpy_w((u32)dst_u16, (u32)src_u16, (u32)word_count)
28485/20F7B5 :                          ; So upper 16 bits of XDE/XHL are guaranteed 0. LDIRW needs upper=0. OK
28486/20F7B5 :                          ; ================================================================
28487/20F7B5 :                          _ngpc_memcpy_w:
28488/20F7B5 :                                  ; Load XDE = dst_addr (full 32-bit; upper 16 = 0 since near address)
28489/20F7B5 : AF 04 22                         ld      xde, (xsp+4)
28490/20F7B8 :                          
28491/20F7B8 :                                  ; Load XHL = src_addr (full 32-bit; may be near or far)
28492/20F7B8 : AF 08 23                         ld      xhl, (xsp+8)
28493/20F7BB :                          
28494/20F7BB :                                  ; Load BC = words (low 16 of u32; high 16 is 0 since words <= 65535)
28495/20F7BB : 9F 0C 21                         ld      bc, (xsp+12)
28496/20F7BE :                          
28497/20F7BE :                                  ; BC=0 guard: if words==0, skip (LDIRW BC=0 copies 65536 words!)
28498/20F7BE :                                  ; OR A, C: ALU instruction -- C is register, not condition code here.
28499/20F7BE : CA 89                            ld      a, b
28500/20F7C0 : CB E1                            or      a, c
28501/20F7C2 : 66 02                            jr      z, memcpy_w_done
28502/20F7C4 :                          
28503/20F7C4 : 93 11                            ldirw                       ; block copy: BC words from XHL -> XDE
28504/20F7C6 :                          
28505/20F7C6 :                          memcpy_w_done:
28506/20F7C6 : 0E                               ret
28507/20F7C7 :                          
28508/20F7C7 :                          
28509/20F7C7 :                          ; ---- src/fx/ngpc_dma_prog.asm
28510/20F7C7 :                          
28511/20F7C7 :                          
28512/20F7C7 :                          
28513/20F7C7 :                          ; C prototypes:
28514/20F7C7 :                          ;   void dmaN_program_asm(const u8  __far *src, volatile u8 __far *dst, u16 count);
28515/20F7C7 :                          ;   void dmaN_program_u16_asm(const u16 __far *src, volatile u8 __far *dst, u16 count);
28516/20F7C7 :                          ;   void dmaN_program_u32_asm(const u32 __far *src, volatile u8 __far *dst, u16 count);
28517/20F7C7 :                          ;
28518/20F7C7 :                          ; Notes:
28519/20F7C7 :                          ; - `count` is written to DMACn directly (i.e. number of DMA "steps"/transfers,
28520/20F7C7 :                          ;   not necessarily a byte count when using word/dword modes).
28521/20F7C7 :                          ;
28522/20F7C7 :                          ; Stack layout on entry (TLCS-900/H cc900):
28523/20F7C7 :                          ;   (xsp+0)  return address (far) 4 bytes
28524/20F7C7 :                          ;   (xsp+4)  src (far pointer)   4 bytes
28525/20F7C7 :                          ;   (xsp+8)  dst (far pointer)   4 bytes
28526/20F7C7 :                          ;   (xsp+12) count (u16)         2 bytes
28527/20F7C7 :                          ;
28528/20F7C7 :                          ; DMA modes (see SDK `HDMA.H`; values here are the real hex values).
28529/20F7C7 : =8H                      DMA_MODE_SINC1  equ 8   ; 0x08: byte,  src++
28530/20F7C7 : =9H                      DMA_MODE_SINC2  equ 9   ; 0x09: word,  src++
28531/20F7C7 : =0AH                     DMA_MODE_SINC4  equ 10  ; 0x0A: dword, src++
28532/20F7C7 :                          
