27614/20ED2A :                          ah_prev:
27615/20ED2A : DA CF 80 00                      cp      de,0x80
27616/20ED2E : F2 AD ED 20 DF                   jp       uge,ah_flat             ; loin des deux joints : le cas courant
27617/20ED33 : DA 88                            ld      wa,de                   ; w = BEND_HALF - into
27618/20ED35 : D8 07                            neg     wa
27619/20ED37 : D8 C8 80 00                      add     wa,0x80
27620/20ED3B : 3A                               push    xde
27621/20ED3C : D8 8A                            ld      de,wa                   ; DE = w pendant le fondu
27622/20ED3E : 8E 1D 21                         ld      a,(xiz+A_CUR)
27623/20ED41 : 8E 22 F1                         cp      a,(xiz+A_PKEY)
27624/20ED44 : F2 84 ED 20 D6                   jp       eq,ah_phit
27625/20ED49 :                                  ; ---- les ecarts vers le PRECEDENT, une fois par segment
27626/20ED49 : BE 22 41                         ld      (xiz+A_PKEY),a
27627/20ED4C : C9 D8                            cp      a,0x0                   ; other = cursor ? cursor - 1 : len - 1
27628/20ED4E : F2 56 ED 20 DE                   jp       ne,ah_prev_dec
27629/20ED53 : 8E 1E 21                         ld      a,(xiz+A_LEN)
27630/20ED56 :                          ah_prev_dec:
27631/20ED56 : C9 69                            dec     0x1,a
27632/20ED58 : D8 12                            extz    wa
27633/20ED5A : D8 09 06 00                      muls    xwa,0x6
27634/20ED5E : 3D                               push    xiy
27635/20ED5F : AE 0C 25                         ld      xiy,(xiz+A_SEG)
27636/20ED62 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa); XIY = sn
27637/20ED67 : 9D 02 20                         ld      wa,(xiy+0x2)
27638/20ED6A : BE 28 50                         ld      (xiz+A_PDB),wa
27639/20ED6D : 8D 04 21                         ld      a,(xiy+0x4)
27640/20ED70 : D8 13                            exts    wa
27641/20ED72 : BE 2A 50                         ld      (xiz+A_PDP),wa
27642/20ED75 : 5D                               pop     xiy                     ; XIY = sc
27643/20ED76 : 9D 02 20                         ld      wa,(xiy+0x2)
27644/20ED79 : 9E 28 A8                         sub     (xiz+A_PDB),wa
27645/20ED7C : 8D 04 21                         ld      a,(xiy+0x4)
27646/20ED7F : D8 13                            exts    wa
27647/20ED81 : 9E 2A A8                         sub     (xiz+A_PDP),wa
27648/20ED84 :                          _id_road_ahead_asm__L7:
27649/20ED84 :                          ah_phit:
27650/20ED84 : 9E 28 20                         ld      wa,(xiz+A_PDB)
27651/20ED87 : DA 48                            muls    xwa,de
27652/20ED89 : D8 ED 08                         sra     0x8,wa
27653/20ED8C : 9D 02 80                         add     wa,(xiy+0x2)
27654/20ED8F : B3 50                            ld      (xhl),wa
27655/20ED91 : 9E 2A 20                         ld      wa,(xiz+A_PDP)
27656/20ED94 :                          ah_blend_slope:
27657/20ED94 :                                  ; sl = (s8)(p + (s16)(((s16)(sn->slope - p) * (s16)w) >> 8))
27658/20ED94 : D8 D8                            cp      wa,0x0
27659/20ED96 : F2 A8 ED 20 D6                   jp       eq,ah_blend_flat        ; meme pente des deux cotes : sl = p
27660/20ED9B : DA 48                            muls    xwa,de
27661/20ED9D : D8 ED 08                         sra     0x8,wa
27662/20EDA0 : 8D 04 81                         add     a,(xiy+0x4)             ; (s8) : l'octet bas de la somme suffit
27663/20EDA3 : 5A                               pop     xde
27664/20EDA4 : 1B F0 ED 20                      jp       ah_clamp
27665/20EDA8 :                          ah_blend_flat:
