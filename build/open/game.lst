28814/20F87E :                          ; ================================================================
28815/20F87E :                          ; void id_road_shear_asm(RoadShearWalk *s);
28816/20F87E :                          ;
28817/20F87E :                          ; Le cisaillement de chaque tranche, en tete de id_road_write() :
28818/20F87E :                          ;   dx = (s16)((lateral * w_lat[k]) >> 8) + curve_dx[k], borne a [min, max].
28819/20F87E :                          ; Le C reste dans id_road.c (ID_ROAD_SHEAR_C=1). cc900 y relisait sur la pile,
28820/20F87E :                          ; a chaque tranche, trois des cinq pointeurs et le deplacement lateral : 13 200
28821/20F87E :                          ; cycles par tour, le plus gros bloc C restant (2026-09-19).
28822/20F87E :                          ;
28823/20F87E :                          ;   XIX = &id_w_lat[k]      (monte de 1)
28824/20F87E :                          ;   XIY = &id_curve_dx[k]   (monte de 2)
28825/20F87E :                          ;   XHL = &id_dx_max[k]     (monte de 2) ; id_dx_min[k] est a -128 (RoadClamp)
28826/20F87E :                          ;   XBC = &id_shear[k]      (monte de 2)
28827/20F87E :                          ;   IZ  = lateral           (xsp+0) = tranches restantes
28828/20F87E : =0H                      S_W      equ 0      ; const u8  * id_w_lat
28829/20F87E : =4H                      S_CV     equ 4      ; const s16 * id_curve_dx
28830/20F87E : =8H                      S_MX     equ 8      ; const s16 * id_dx_max  (id_dx_min = id_dx_max - 128)
28831/20F87E : =0CH                     S_SH     equ 12     ; s16 *       id_shear
28832/20F87E : =10H                     S_LAT    equ 16     ; s16  lateral
28833/20F87E : =12H                     S_N      equ 18     ; u16  lignes (> 0, < 256)
28834/20F87E : =80H                     RC_MIN   equ 0x80   ; id_dx_max - id_dx_min, en octets (RoadClamp)
28835/20F87E :                          
28836/20F87E :                          
28837/20F87E :                          _id_road_shear_asm:
28838/20F87E : 3E                               push    xiz
28839/20F87F : AF 08 20                         ld      xwa,(xsp+0x8)
28840/20F882 : A0 24                            ld      xix,(xwa+S_W)
28841/20F884 : A8 04 25                         ld      xiy,(xwa+S_CV)
28842/20F887 : A8 08 23                         ld      xhl,(xwa+S_MX)
28843/20F88A : A8 0C 21                         ld      xbc,(xwa+S_SH)
28844/20F88D : 98 10 26                         ld      iz,(xwa+S_LAT)
28845/20F890 : 98 12 22                         ld      de,(xwa+S_N)
28846/20F893 : 2A                               push    de                      ; le compteur, en (xsp)
28847/20F894 :                          sh_loop:
28848/20F894 : C5 F0 25                         ld      e,(xix+)
28849/20F897 : DA 12                            extz    de
28850/20F899 : DE 4A                            muls    xde,iz
28851/20F89B : EA ED 08                         sra     0x8,xde                 ; (lateral * w) >> 8 on 32 bits (SUNSET RUN: |lateral| > 128)
28852/20F89E : D5 F5 20                         ld      wa,(xiy+)
28853/20F8A1 : DA 80                            add     wa,de
28854/20F8A3 : 93 F0                            cp      wa,(xhl)
28855/20F8A5 : F2 B9 F8 20 DA                   jp       gt,sh_hi                ; dx > max
28856/20F8AA : 9B 80 F0                         cp      wa,(xhl-RC_MIN)
28857/20F8AD : F2 BB F8 20 D9                   jp       ge,sh_st
28858/20F8B2 : 9B 80 20                         ld      wa,(xhl-RC_MIN)         ; dx < min
28859/20F8B5 : 1B BB F8 20                      jp       sh_st
28860/20F8B9 :                          sh_hi:
28861/20F8B9 : 93 20                            ld      wa,(xhl)
28862/20F8BB :                          sh_st:
28863/20F8BB : F5 E5 50                         ld      (xbc+),wa
28864/20F8BE : EB 62                            inc     0x2,xhl
28865/20F8C0 : 87 69                            decb    0x1,(xsp)
28866/20F8C2 : F2 94 F8 20 DE                   jp       ne,sh_loop
28867/20F8C7 : 4A                               pop     de
28868/20F8C8 : 5E                               pop     xiz
28869/20F8C9 : 0E                               ret
28870/20F8CA :                          
28871/20F8CA :                          ; ================================================================
28872/20F8CA :                          ; void id_road_curve_asm(RoadCurve *c);
28873/20F8CA :                          ;
28874/20F8CA :                          ; La double integration de id_road_frame_ahead() : la courbure de chaque
28875/20F8CA :                          ; tranche, du pare-chocs vers l'horizon, sommee deux fois -- le cap, puis le
28876/20F8CA :                          ; deplacement lateral. Le C reste dans id_road.c (ID_ROAD_CURVE_C=1).
28877/20F8CA :                          ;
28878/20F8CA :                          ;   XIX = &bend[k] (descend de 2)   XIY = &id_curve_dx[k] (descend de 2)
28879/20F8CA :                          ;   DE  = id_curve_cm               BC  = slope      HL = acc      IZ = k
28880/20F8CA : =0H                      C_BEND   equ 0      ; const s16 * &bend[lines]
28881/20F8CA : =4H                      C_OUT    equ 4      ; s16 *       &id_curve_dx[lines]
28882/20F8CA : =8H                      C_CM     equ 8      ; u16 id_curve_cm
28883/20F8CA : =0AH                     C_N      equ 10     ; u16 lignes (> 0)
28884/20F8CA :                          
28885/20F8CA :                          
28886/20F8CA :                          _id_road_curve_asm:
28887/20F8CA : 3E                               push    xiz
28888/20F8CB : AF 08 26                         ld      xiz,(xsp+0x8)
28889/20F8CE : A6 24                            ld      xix,(xiz+C_BEND)
28890/20F8D0 : AE 04 25                         ld      xiy,(xiz+C_OUT)
28891/20F8D3 : 9E 08 22                         ld      de,(xiz+C_CM)
28892/20F8D6 : 9E 0A 26                         ld      iz,(xiz+C_N)
28893/20F8D9 : D9 A8                            ld      bc,0x0
28894/20F8DB : DB A8                            ld      hl,0x0
28895/20F8DD :                                  ; (Un cache "meme virage que la tranche d'avant, meme c" a ete essaye
28896/20F8DD :                                  ; le 2026-09-19 : 71 a 76 % de tranches repetees, et ZERO cycle gagne
28897/20F8DD :                                  ; mesure -- la comparaison en memoire et le saut pris coutent ce que la
28898/20F8DD :                                  ; multiplication coutait. Retire.)
28899/20F8DD :                          cv_loop:
28900/20F8DD : EC 6A                            dec     0x2,xix
28901/20F8DF : 94 20                            ld      wa,(xix)                ; b
28902/20F8E1 : D8 D8                            cp      wa,0x0
28903/20F8E3 : F2 F9 F8 20 D9                   jp       ge,cv_pos
28904/20F8E8 : D8 07                            neg     wa                      ; mag = -b
28905/20F8EA : DA 40                            mul     xwa,de                  ; (u16)mag * cm, 16 bits gardes
28906/20F8EC : D8 C8 80 00                      add     wa,0x80
28907/20F8F0 : D8 EF 08                         srl     0x8,wa                  ; c
28908/20F8F3 : D8 07                            neg     wa                      ; b < 0 : -c
28909/20F8F5 : 1B 02 F9 20                      jp       cv_have
28910/20F8F9 :                          cv_pos:
28911/20F8F9 : DA 40                            mul     xwa,de
28912/20F8FB : D8 C8 80 00                      add     wa,0x80
28913/20F8FF : D8 EF 08                         srl     0x8,wa
28914/20F902 :                          cv_have:
28915/20F902 : D8 81                            add     bc,wa                   ; slope += c
28916/20F904 : D9 83                            add     hl,bc                   ; acc += slope
28917/20F906 : DB 88                            ld      wa,hl
28918/20F908 : D8 ED 08                         sra     0x8,wa
28919/20F90B : ED 6A                            dec     0x2,xiy
28920/20F90D : B5 50                            ld      (xiy),wa                ; id_curve_dx[k] = acc >> 8
28921/20F90F : DE CA 01 00                      sub     iz,0x1                  ; SUB pose les drapeaux (DEC 16 bits non)
28922/20F913 : F2 DD F8 20 DE                   jp       ne,cv_loop
28923/20F918 : 5E                               pop     xiz
28924/20F919 : 0E                               ret
28925/20F91A :                          
28926/20F91A :                          ; ---- src/spr_cells_asm.asm
28927/20F91A :                          ; spr_cells_asm.asm - write a list of 8x8 sprite cells to the K2GE sprite table
28928/20F91A :                          ;
28929/20F91A :                          ; SUNSET RUN.  The car, the traffic and the roadside objects are all drawn as
28930/20F91A :                          ; lists of {cx, cy, ch} cells; this loop replaces three copies of the same C
28931/20F91A :                          ; loop (the hottest code of a frame).  asm900 syntax, also assembled by the
28932/20F91A :                          ; open toolchain.
28933/20F91A :                          ;
28934/20F91A :                          ; void spr_cells_asm(SprJob *j);
28935/20F91A :                          ;   (xsp+0) return address, (xsp+4) j.  Preserves XIZ (cc900 convention).
28936/20F91A :                          ;
28937/20F91A :                          
28938/20F91A : =0H                      J_CELLS  equ 0      ; const u8 *   cells, 3 bytes each: cx, cy, ch
28939/20F91A : =4H                      J_MAP    equ 4      ; const u16 *  tile per ch (when J_HASMAP != 0)
28940/20F91A : =8H                      J_BASE   equ 8      ; u16          tile = base + ch (when J_HASMAP == 0)
28941/20F91A : =0AH                     J_X      equ 10     ; s16          left edge of the cell grid
28942/20F91A : =0CH                     J_Y      equ 12     ; u8           top of the cell grid
28943/20F91A : =0DH                     J_N      equ 13     ; u8           number of cells
28944/20F91A : =0EH                     J_WM1    equ 14     ; u8           grid width - 1 (mirroring)
28945/20F91A : =0FH                     J_ATTR   equ 15     ; u8           flip bits | priority bits
28946/20F91A : =10H                     J_PAL    equ 16     ; u8           palette
28947/20F91A : =11H                     J_SPR    equ 17     ; u8           next free sprite (in/out)
28948/20F91A : =12H                     J_END    equ 18     ; u8           first sprite NOT to use
28949/20F91A : =13H                     J_FLIP   equ 19     ; u8           != 0 : mirror the cell columns
28950/20F91A : =14H                     J_HASMAP equ 20     ; u8
28951/20F91A :                          
28952/20F91A :                          
28953/20F91A :                          
28954/20F91A :                          
28955/20F91A :                          _spr_cells_asm:
28956/20F91A : 3E                               push    xiz
28957/20F91B : AF 08 26                         ld      xiz,(xsp+0x8)
28958/20F91E : A6 24                            ld      xix,(xiz+J_CELLS)
28959/20F920 : 8E 11 23                         ld      c,(xiz+J_SPR)
28960/20F923 : 8E 0D 22                         ld      b,(xiz+J_N)
28961/20F926 : CA D8                            cp      b,0x0
28962/20F928 : F2 B5 F9 20 D6                   jp      z,sc_done
28963/20F92D :                          sc_loop:
28964/20F92D : 8E 12 F3                         cp      c,(xiz+J_END)
28965/20F930 : F2 B5 F9 20 DF                   jp      nc,sc_done
28966/20F935 : 84 21                            ld      a,(xix)                 ; cx
28967/20F937 : 8E 13 3F 00                      cpb     (xiz+J_FLIP),0x0
28968/20F93B : 66 07                            jr      z,sc_noflip
28969/20F93D : C9 8D                            ld      e,a
28970/20F93F : 8E 0E 21                         ld      a,(xiz+J_WM1)
28971/20F942 : CD A1                            sub     a,e
28972/20F944 :                          sc_noflip:
28973/20F944 : D8 12                            extz    wa
28974/20F946 : D8 EE 03                         sll     0x3,wa
28975/20F949 : 9E 0A 80                         add     wa,(xiz+J_X)            ; sx
28976/20F94C : D8 8A                            ld      de,wa
28977/20F94E : DA C8 08 00                      add     de,0x8
28978/20F952 : DA CF B0 00                      cp      de,0xb0                 ; -8 <= sx <= 167
28979/20F956 : 6F 54                            jr      nc,sc_next
28980/20F958 :                                  ; HL = 0x8800 + spr * 4
28981/20F958 : CB 8F                            ld      l,c
28982/20F95A : DB 12                            extz    hl
28983/20F95C : DB EE 02                         sll     0x2,hl
28984/20F95F : DB C8 00 88                      add     hl,0x8800
28985/20F963 : EB 12                            extz    xhl
28986/20F965 : BB 02 41                         ld      (xhl+0x2),a             ; x (low byte of sx)
28987/20F968 : 8C 01 21                         ld      a,(xix+0x1)             ; cy * 8 + y
28988/20F96B : C9 EE 03                         sll     0x3,a
28989/20F96E : 8E 0C 81                         add     a,(xiz+J_Y)
28990/20F971 : BB 03 41                         ld      (xhl+0x3),a
28991/20F974 : 8C 02 25                         ld      e,(xix+0x2)             ; ch
28992/20F977 : DA 12                            extz    de
28993/20F979 : 8E 14 3F 00                      cpb     (xiz+J_HASMAP),0x0
28994/20F97D : 66 0C                            jr      z,sc_base
28995/20F97F : DA 82                            add     de,de
28996/20F981 : AE 04 25                         ld      xiy,(xiz+J_MAP)
28997/20F984 : D3 07 F4 E8 22                   ld      de,(xiy+de)
28998/20F989 : 68 03                            jr      sc_tile
28999/20F98B :                          sc_base:
29000/20F98B : 9E 08 82                         add     de,(xiz+J_BASE)
29001/20F98E :                          sc_tile:
29002/20F98E : B3 45                            ld      (xhl),e                 ; tile, low 8 bits
29003/20F990 : CC 89                            ld      a,d
29004/20F992 : C9 CC 01                         and     a,0x1
29005/20F995 : 8E 0F E1                         or      a,(xiz+J_ATTR)
29006/20F998 : BB 01 41                         ld      (xhl+0x1),a
29007/20F99B :                                  ; palette: 0x8C00 + spr
29008/20F99B : CB 8F                            ld      l,c
29009/20F99D : DB 12                            extz    hl
29010/20F99F : DB C8 00 8C                      add     hl,0x8c00
29011/20F9A3 : EB 12                            extz    xhl
29012/20F9A5 : 8E 10 21                         ld      a,(xiz+J_PAL)
29013/20F9A8 : B3 41                            ld      (xhl),a
29014/20F9AA : CB 61                            inc     0x1,c
29015/20F9AC :                          sc_next:
29016/20F9AC : EC 63                            inc     0x3,xix
29017/20F9AE : CA 69                            dec     0x1,b
29018/20F9B0 : F2 2D F9 20 DE                   jp      nz,sc_loop
29019/20F9B5 :                          sc_done:
29020/20F9B5 : BE 11 43                         ld      (xiz+J_SPR),c
29021/20F9B8 : 5E                               pop     xiz
29022/20F9B9 : 0E                               ret
