27914/20F372 :                          ; ---- src/core/ngpc_flash_asm.asm
27915/20F372 :                          
27916/20F372 :                          ;
27917/20F372 :                          ; ngpc_flash_asm.asm - Flash erase/write primitives for ngpc_flash.c
27918/20F372 :                          ;
27919/20F372 :                          ; Part of NgpCraft_base_template (MIT License)
27920/20F372 :                          ;
27921/20F372 :                          ; Two entry points, both called ONLY by ngpc_flash.c (never from an ISR):
27922/20F372 :                          ;
27923/20F372 :                          ;   _ngpc_flash_erase_asm(u32 abs_block)
27924/20F372 :                          ;       Erases one 8 KB block with the AMD erase stub extracted from StarGunner
27925/20F372 :                          ;       (hardware-validated), copied to RAM 0x6E00 and run from there.
27926/20F372 :                          ;       VECT_FLASHERS cannot erase blocks 32/33/34 (SysCall.txt p.299), so the
27927/20F372 :                          ;       erase keeps the stub.
27928/20F372 :                          ;
27929/20F372 :                          ;   _ngpc_flash_write_bios(const void *src, u32 offset, u32 pages)
27930/20F372 :                          ;       Programs pages x 256 bytes through the BIOS (VECT_FLASHWRITE, swi 1),
27931/20F372 :                          ;       the path StarGunner uses on hardware. The watchdog is refreshed right
27932/20F372 :                          ;       before and right after, as in the SDK save pattern.
27933/20F372 :                          ;
27934/20F372 :                          ; THE BLOCK IS A PARAMETER, NOT A CONSTANT. The save block sits 0x6000 below
27935/20F372 :                          ; the top of the chip, so its address depends on the cartridge size:
27936/20F372 :                          ; 0x27A000 on 4 Mbit, 0x2FA000 on 8 Mbit, 0x3FA000 on 16 Mbit. A hard-coded
27937/20F372 :                          ; 0x3FA000 erases 8 KB ELSEWHERE on a smaller chip - possibly the game code.
27938/20F372 :                          ; ngpc_flash.c reads the size the BIOS stores at 0x6C58 and refuses unknown ones.
27939/20F372 :                          ;
27940/20F372 :                          ; cc900 ABI (CALL pushes 4-byte XPC as return address):
27941/20F372 :                          ;   (xsp+0)..(xsp+3)  = return address
27942/20F372 :                          ;   (xsp+4)..(xsp+7)  = 1st parameter
27943/20F372 :                          ;   (xsp+8)..(xsp+11) = 2nd parameter
27944/20F372 :                          ;   (xsp+12)..(xsp+15)= 3rd parameter
27945/20F372 :                          ;
27946/20F372 :                          ; ===========================================================================
27947/20F372 :                          ; INTERRUPTS ARE PROHIBITED FOR THE WHOLE SEQUENCE. On hardware that is not
27948/20F372 :                          ; optional. A flash chip being programmed or erased answers reads with STATUS,
27949/20F372 :                          ; not with its contents. The stub runs from RAM for that reason, but the
27950/20F372 :                          ; interrupt handlers are still in the cartridge: an interrupt taken while the
27951/20F372 :                          ; chip is busy fetches its handler from status bits. A game taking VBlank at
27952/20F372 :                          ; 60 Hz cannot get through a 256-byte program or an 8 KB erase without one.
27953/20F372 :                          ;
27954/20F372 :                          ; AN EMULATOR WHOSE FLASH KEEPS SERVING ROM DURING THE WRITE NEVER SHOWS THIS.
27955/20F372 :                          ; Toshiba: "all interrupts are prohibited during system calls related to flash
27956/20F372 :                          ; memory management" (SysCall.txt). Hence `di` (encoded 06 07 = EI 7) on entry
27957/20F372 :                          ; and `ei 0` (06 00) on exit: level 0 is what ngpc_init() runs the game at.
27958/20F372 :                          ; ===========================================================================
27959/20F372 :                          
27960/20F372 :                          
27961/20F372 :                          
27962/20F372 : =6E00H                   FLASH_RAM       equ     0x6E00          ; RAM address for stub execution
27963/20F372 : =6EH                     FLASH_BUS_CTRL  equ     0x6E            ; I/O: flash /WE enable (0x14=on, 0xF0=off)
27964/20F372 : =6FH                     FLASH_WD        equ     0x6F            ; I/O: watchdog  (0xB1=extended, 0x4E=refresh)
27965/20F372 : =200000H                 CART_BASE       equ     0x200000        ; CS0 base address
27966/20F372 :                          
27967/20F372 :                          
27968/20F372 :                          
27969/20F372 :                          ; ===========================================================================
27970/20F372 :                          ; _ngpc_flash_erase_asm
27971/20F372 :                          ;   param 1 (xsp+4) : u32 abs_block -- ABSOLUTE address of the 8 KB block
27972/20F372 :                          ; C prototype: void ngpc_flash_erase_asm(u32 abs_block);
27973/20F372 :                          ; ===========================================================================
27974/20F372 :                          _ngpc_flash_erase_asm:
27975/20F372 :                          
27976/20F372 : 06 07                            di                              ; see the note at the top of the file
27977/20F374 : 08 6E 14                         ld      (FLASH_BUS_CTRL),0x14   ; enable /WE on cart bus
27978/20F377 : 08 6F B1                         ld      (FLASH_WD),0xB1         ; watchdog: extended mode
27979/20F37A :                          
27980/20F37A :                                  ; Copy erase stub (98 bytes) from ROM to RAM at FLASH_RAM
27981/20F37A : 39                               push    xbc                     ; preserve XBC across copy
27982/20F37B : 42 00 6E 00 00                   ld      xde,FLASH_RAM           ; destination: RAM
27983/20F380 : 43 C7 F3 20 00                   ld      xhl,_erase_stub         ; source: stub bytes in ROM
27984/20F385 : 31 62 00                         ld      bc,0x62                 ; BC = 98 bytes
27985/20F388 : 83 11                            db      0x83,0x11               ; ldir (xde+),(xhl+) -- copy BC bytes
27986/20F38A : 59                               pop     xbc                     ; restore XBC (stack back to entry)
27987/20F38B :                          
27988/20F38B :                                  ; Set up registers for stub call
27989/20F38B : 44 00 00 20 00                   ld      xix,CART_BASE           ; XIX = 0x200000 (AMD unlock base)
27990/20F390 : ED A8                            ld      xiy,0x0                 ; XIY = 0 (erase stub uses as delay counter)
27991/20F392 : C9 A8                            ld      a,0x0                   ; A = 0 (erase stub state init)
27992/20F394 : AF 04 22                         ld      xde,(xsp+4)             ; XDE = block, given by the caller
27993/20F397 :                          
27994/20F397 : 1C 00 6E                         call    FLASH_RAM               ; execute stub from RAM
27995/20F39A :                          
27996/20F39A : 08 6E F0                         ld      (FLASH_BUS_CTRL),0xF0   ; restore watchdog mode first
27997/20F39D : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; then refresh the enabled watchdog
27998/20F3A0 : 06 00                            ei      0                       ; the chip answers as memory again
27999/20F3A2 : 0E                               ret
28000/20F3A3 :                          
28001/20F3A3 :                          
28002/20F3A3 :                          ; ===========================================================================
28003/20F3A3 :                          ; _ngpc_flash_write_bios
28004/20F3A3 :                          ;   param 1 (xsp+4)  : const void *src -- source buffer, in RAM
28005/20F3A3 :                          ;   param 2 (xsp+8)  : u32 offset      -- offset INSIDE the cartridge
28006/20F3A3 :                          ;                                         (e.g. 0x1FA000 + slot*SAVE_SIZE),
28007/20F3A3 :                          ;                                         not the absolute address: XDE3 wants
28008/20F3A3 :                          ;                                         the offset.
28009/20F3A3 :                          ;   param 3 (xsp+12) : u32 pages       -- number of 256-byte units
28010/20F3A3 :                          ; C prototype: void ngpc_flash_write_bios(const void *src, u32 offset, u32 pages);
28011/20F3A3 :                          ;
28012/20F3A3 :                          ; The BIOS holds the bus itself (no manual 0x6E write). The AMD write stub used
28013/20F3A3 :                          ; before disabled the watchdog and wrote its refresh code while it was off.
28014/20F3A3 :                          ; ===========================================================================
28015/20F3A3 :                          _ngpc_flash_write_bios:
28016/20F3A3 :                          
28017/20F3A3 : 06 07                            di                              ; see the note at the top of the file
28018/20F3A5 : AF 04 23                         ld      xhl,(xsp+4)             ; 1st param: source
28019/20F3A8 : AF 08 22                         ld      xde,(xsp+8)             ; 2nd param: cartridge offset
28020/20F3AB : AF 0C 21                         ld      xbc,(xsp+12)            ; 3rd param: 256-byte pages
28021/20F3AE : E7 3C 9B                         ld      xhl3,xhl                ; bank 3: the BIOS reads its arguments there
28022/20F3B1 : E7 38 9A                         ld      xde3,xde
28023/20F3B4 : E7 34 99                         ld      xbc3,xbc
28024/20F3B7 : C7 30 A8                         ld      ra3,0                   ; CS0
28025/20F3BA : C7 31 AE                         ld      rw3,0x0006              ; VECT_FLASHWRITE
28026/20F3BD : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; watchdog refreshed RIGHT BEFORE
28027/20F3C0 : F9                               swi     1
28028/20F3C1 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; and right after
28029/20F3C4 : 06 00                            ei      0
28030/20F3C6 : 0E                               ret
28031/20F3C7 :                          
28032/20F3C7 :                          
28033/20F3C7 :                          ; ===========================================================================
28034/20F3C7 :                          ; Erase stub, extracted from StarGunner/bin/main.ngp (hardware-validated).
28035/20F3C7 :                          ; 98 bytes, file offset 0x13733. Position-independent, uses XIX for AMD cycles.
28036/20F3C7 :                          ;   AMD unlock -> reset -> unlock -> erase setup (0x80) -> unlock -> sector
28037/20F3C7 :                          ;   erase (0x30) -> poll DQ7 -> final reset/unlock -> ret
28038/20F3C7 :                          ;   Register interface: XIX=cart_base XDE=block_addr XIY=0 A=0
28039/20F3C7 :                          ; ===========================================================================
28040/20F3C7 :                          
28041/20F3C7 :                          _erase_stub:
28042/20F3C7 : F3 F1 55 55 00 AA F3 F1          db      0xF3,0xF1,0x55,0x55,0x00,0xAA, 0xF3,0xF1,0xAA,0x2A,0x00,0x55
      20F3CF : AA 2A 00 55            
28043/20F3D3 : F3 F1 55 55 00 F0 00 00          db      0xF3,0xF1,0x55,0x55,0x00,0xF0, 0x00,0x00,0xF3,0xF1,0x55,0x55
      20F3DB : F3 F1 55 55            
28044/20F3DF : 00 AA F3 F1 AA 2A 00 55          db      0x00,0xAA,0xF3,0xF1,0xAA,0x2A, 0x00,0x55,0xF3,0xF1,0x55,0x55
      20F3E7 : F3 F1 55 55            
28045/20F3EB : 00 80 F3 F1 55 55 00 AA          db      0x00,0x80,0xF3,0xF1,0x55,0x55, 0x00,0xAA,0xF3,0xF1,0xAA,0x2A
      20F3F3 : F3 F1 AA 2A            
28046/20F3F7 : 00 55 B2 00 30 82 3F FF          db      0x00,0x55,0xB2,0x00,0x30,0x82, 0x3F,0xFF,0x66,0x15,0xED,0x61
      20F3FF : 66 15 ED 61            
28047/20F403 : ED CF FF FF 1F 00 66 09          db      0xED,0xCF,0xFF,0xFF,0x1F,0x00, 0x66,0x09,0xB2,0xCD,0x66,0xED
      20F40B : B2 CD 66 ED            
28048/20F40F : 82 3F FF 66 02 21 FF F3          db      0x82,0x3F,0xFF,0x66,0x02,0x21, 0xFF,0xF3,0xF1,0x55,0x55,0x00
      20F417 : F1 55 55 00            
28049/20F41B : AA F3 F1 AA 2A 00 55 F3          db      0xAA,0xF3,0xF1,0xAA,0x2A,0x00, 0x55,0xF3,0xF1,0x55,0x55,0x00
      20F423 : F1 55 55 00            
28050/20F427 : F0 0E                            db      0xF0,0x0E
