27360/20EC8E : E8 2E 10                         ldc    dmad0,xwa
27361/20EC91 : 9F 0C 20                         ld      wa,(xsp+12)
27362/20EC94 : D8 2E 20                         ldc    dmac0,wa
27363/20EC97 : 21 09                            ld      a,DMA_MODE_SINC2
27364/20EC99 : C9 2E 22                         ldc    dmam0,a
27365/20EC9C : 0E                               ret
27366/20EC9D :                          
