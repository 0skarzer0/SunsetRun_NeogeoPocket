21979/20BBBE :                          ; ================================================================
21980/20BBBE :                          ; void id_road_shear_asm(RoadShearWalk *s);
21981/20BBBE :                          ;
21982/20BBBE :                          ; Le cisaillement de chaque tranche, en tete de id_road_write() :
21983/20BBBE :                          ;   dx = (s16)((lateral * w_lat[k]) >> 8) + curve_dx[k], borne a [min, max].
21984/20BBBE :                          ; Le C reste dans id_road.c (ID_ROAD_SHEAR_C=1). cc900 y relisait sur la pile,
21985/20BBBE :                          ; a chaque tranche, trois des cinq pointeurs et le deplacement lateral : 13 200
21986/20BBBE :                          ; cycles par tour, le plus gros bloc C restant (2026-09-19).
21987/20BBBE :                          ;
21988/20BBBE :                          ;   XIX = &id_w_lat[k]      (monte de 1)
21989/20BBBE :                          ;   XIY = &id_curve_dx[k]   (monte de 2)
21990/20BBBE :                          ;   XHL = &id_dx_max[k]     (monte de 2) ; id_dx_min[k] est a -128 (RoadClamp)
21991/20BBBE :                          ;   XBC = &id_shear[k]      (monte de 2)
21992/20BBBE :                          ;   IZ  = lateral           (xsp+0) = tranches restantes
21993/20BBBE : =0H                      S_W      equ 0      ; const u8  * id_w_lat
21994/20BBBE : =4H                      S_CV     equ 4      ; const s16 * id_curve_dx
21995/20BBBE : =8H                      S_MX     equ 8      ; const s16 * id_dx_max  (id_dx_min = id_dx_max - 128)
21996/20BBBE : =0CH                     S_SH     equ 12     ; s16 *       id_shear
21997/20BBBE : =10H                     S_LAT    equ 16     ; s16  lateral
21998/20BBBE : =12H                     S_N      equ 18     ; u16  lignes (> 0, < 256)
21999/20BBBE : =80H                     RC_MIN   equ 0x80   ; id_dx_max - id_dx_min, en octets (RoadClamp)
22000/20BBBE :                          
22001/20BBBE :                          
22002/20BBBE :                          _id_road_shear_asm:
22003/20BBBE : 3E                               push    xiz
22004/20BBBF : AF 08 20                         ld      xwa,(xsp+0x8)
22005/20BBC2 : A0 24                            ld      xix,(xwa+S_W)
22006/20BBC4 : A8 04 25                         ld      xiy,(xwa+S_CV)
22007/20BBC7 : A8 08 23                         ld      xhl,(xwa+S_MX)
22008/20BBCA : A8 0C 21                         ld      xbc,(xwa+S_SH)
22009/20BBCD : 98 10 26                         ld      iz,(xwa+S_LAT)
22010/20BBD0 : 98 12 22                         ld      de,(xwa+S_N)
22011/20BBD3 : 2A                               push    de                      ; le compteur, en (xsp)
22012/20BBD4 :                          sh_loop:
22013/20BBD4 : C5 F0 25                         ld      e,(xix+)
22014/20BBD7 : DA 12                            extz    de
22015/20BBD9 : DE 4A                            muls    xde,iz
22016/20BBDB : EA ED 08                         sra     0x8,xde                 ; (lateral * w) >> 8 on 32 bits (SUNSET RUN: |lateral| > 128)
22017/20BBDE : D5 F5 20                         ld      wa,(xiy+)
22018/20BBE1 : DA 80                            add     wa,de
22019/20BBE3 : 93 F0                            cp      wa,(xhl)
22020/20BBE5 : F2 F9 BB 20 DA                   jp       gt,sh_hi                ; dx > max
22021/20BBEA : 9B 80 F0                         cp      wa,(xhl-RC_MIN)
22022/20BBED : F2 FB BB 20 D9                   jp       ge,sh_st
22023/20BBF2 : 9B 80 20                         ld      wa,(xhl-RC_MIN)         ; dx < min
22024/20BBF5 : 1B FB BB 20                      jp       sh_st
22025/20BBF9 :                          sh_hi:
22026/20BBF9 : 93 20                            ld      wa,(xhl)
22027/20BBFB :                          sh_st:
22028/20BBFB : F5 E5 50                         ld      (xbc+),wa
22029/20BBFE : EB 62                            inc     0x2,xhl
22030/20BC00 : 87 69                            decb    0x1,(xsp)
22031/20BC02 : F2 D4 BB 20 DE                   jp       ne,sh_loop
22032/20BC07 : 4A                               pop     de
22033/20BC08 : 5E                               pop     xiz
22034/20BC09 : 0E                               ret
