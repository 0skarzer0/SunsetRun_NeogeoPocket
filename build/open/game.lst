21691/20B9C0 : D8 12                            extz    wa
21692/20B9C2 : D8 80                            add     wa,wa
21693/20B9C4 : D3 07 F4 E0 20                   ld      wa,(xiy+wa)
21694/20B9C9 : B2 50                            ld      (xde),wa
21695/20B9CB : CA 69                            dec     0x1,b                   ; huit bits : DEC pose les drapeaux
21696/20B9CD : F2 B5 B9 20 DE                   jp       ne,vw_conv
21697/20B9D2 :                          vw_conv_done:
21698/20B9D2 : AF 14 20                         ld      xwa,(xsp+F_W)
21699/20B9D5 : B8 26 43                         ld      (xwa+V_LINE),c
21700/20B9D8 :                                  ; !! PAS PAR A : A est l'octet bas de XWA, qui tient le bloc. Une
21701/20B9D8 :                                  ; premiere version faisait `ld a,(xsp+F_N)` ici et ecrivait le
21702/20B9D8 :                                  ; compteur a 0x..00+37, dans la pile.
21703/20B9D8 : 8F 09 22                         ld      b,(xsp+F_N)
21704/20B9DB : B8 25 42                         ld      (xwa+V_N),b
21705/20B9DE : BF 0C 37                         lda     xsp,(xsp+F_SIZE)
