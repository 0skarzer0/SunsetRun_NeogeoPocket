27213/20EC4A :                          ; ---- src/core/ngpc_syspatch.asm
27214/20EC4A :                          
27215/20EC4A :                          ;
27216/20EC4A :                          ; ngpc_syspatch.asm - Power-off bug patch (SYS_PATCH equivalent)
27217/20EC4A :                          ;
27218/20EC4A :                          ; Part of NgpCraft_base_template (MIT License)
27219/20EC4A :                          ;
27220/20EC4A :                          ; Reverse-engineered from system.lib (SNK Corporation, 1998).
27221/20EC4A :                          ;
27222/20EC4A :                          ; The original SYS_PATCH routine fixes a bug in the initial production
27223/20EC4A :                          ; NEOGEO POCKET system program: rapid removal/reinsertion of batteries
27224/20EC4A :                          ; could prevent the power button from shutting down the console.
27225/20EC4A :                          ;
27226/20EC4A :                          ; Condition : OS_Version (0x6F91) == 0x00  [prototype firmware only]
27227/20EC4A :                          ; Effect    : res 3, (0x6F83)              [clear undocumented sys flag]
27228/20EC4A :                          ;             ldb (0x6DA0), 0x00           [clear undocumented power flag]
27229/20EC4A :                          ;
27230/20EC4A :                          ; On all retail hardware (OS_Version >= 0x01) this is a safe no-op.
27231/20EC4A :                          ; Must be called once at startup, before enabling interrupts.
27232/20EC4A :                          ;
27233/20EC4A :                          ; Reference: MANSysPro.txt "SYS_PATCH", SysLib.txt p.6
27234/20EC4A :                          ;
27235/20EC4A :                          
27236/20EC4A :                          
27237/20EC4A :                          
27238/20EC4A :                          
27239/20EC4A :                          _ngpc_sys_patch:
27240/20EC4A :                          
27241/20EC4A :                                  ; cp (0x6F91), 0x00  [C1 91 6F 3F 00]
27242/20EC4A :                                  ; Compare OS_Version with 0. Z=1 if prototype firmware.
27243/20EC4A : C1 91 6F 3F 00                   db 0xC1, 0x91, 0x6F, 0x3F, 0x00
27244/20EC4F :                          
27245/20EC4F :                                  ; jr NZ, +9  [6E 09]
27246/20EC4F :                                  ; Retail hardware (OS_Version != 0): skip patch, fall through to ret.
27247/20EC4F : 6E 09                            db 0x6E, 0x09
27248/20EC51 :                          
27249/20EC51 :                                  ; res 3, (0x6F83)  [F1 83 6F B3]
27250/20EC51 :                                  ; Clear bit 3 of undocumented system flag (between Sys_Lever and User_Boot).
27251/20EC51 : F1 83 6F B3                      db 0xF1, 0x83, 0x6F, 0xB3
27252/20EC55 :                          
27253/20EC55 :                                  ; ldb (0x6DA0), 0x00  [F1 A0 6D 00 00]
27254/20EC55 :                                  ; Clear undocumented power state register in system RAM.
27255/20EC55 : F1 A0 6D 00 00                   db 0xF1, 0xA0, 0x6D, 0x00, 0x00
27256/20EC5A :                          
27257/20EC5A : 0E                               ret
27258/20EC5B :                          
27259/20EC5B :                          
27260/20EC5B :                          ; ---- src/core/ngpc_vramq_asm.asm
27261/20EC5B :                          ; ngpc_vramq_asm.asm - VRAM queue ASM helpers (TLCS-900/H)
27262/20EC5B :                          ;
27263/20EC5B :                          ; Part of NgpCraft_base_template (MIT License)
27264/20EC5B :                          ;
27265/20EC5B :                          ; Provides ngpc_memcpy_w() -- word-level block copy via LDIRW.
27266/20EC5B :                          ; Used by ngpc_vramq.c CMD_COPY path instead of a byte-by-byte C loop.
27267/20EC5B :                          ; dst is a near VRAM address (0x8000-0xBFFF). src can be near RAM or far ROM.
27268/20EC5B :                          ;
27269/20EC5B :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
27270/20EC5B :                          ;
27271/20EC5B :                          ; cc900 calling convention -- args passed as u32 (4 bytes each, unambiguous):
27272/20EC5B :                          ;   (xsp+0)  return address (far)   4 bytes
27273/20EC5B :                          ;   (xsp+4)  dst_addr (u32)         4 bytes  <- near VRAM address (high 16 = 0)
27274/20EC5B :                          ;   (xsp+8)  src_addr (u32)         4 bytes  <- RAM/ROM address (near or far)
27275/20EC5B :                          ;   (xsp+12) words (u32)            4 bytes  <- word count (high 16 = 0)
27276/20EC5B :                          ;
27277/20EC5B :                          ; Using u32 args avoids ambiguity: cc900 may pad u16 args to 4 bytes on stack.
27278/20EC5B :                          ; u32 args are always exactly 4 bytes, matching LD XRR, (xsp+N) reads.
27279/20EC5B :                          ;
27280/20EC5B :                          ; LDIRW guard: BC=0 at entry copies 65536 words -- skip if words==0.
27281/20EC5B :                          ; OR A, C is safe here (ALU instruction; C is not ambiguous as condition code
27282/20EC5B :                          ; in this context -- ambiguity only occurs in LD (mem), c indirect store form).
27283/20EC5B :                          
27284/20EC5B :                          
27285/20EC5B :                          
27286/20EC5B :                          
27287/20EC5B :                          
27288/20EC5B :                          ; ================================================================
27289/20EC5B :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
27290/20EC5B :                          ;
27291/20EC5B :                          ; Block-copies 'words' 16-bit words from src_addr to dst_addr via LDIRW.
27292/20EC5B :                          ; Equivalent to: while (words--) *(u16*)dst++ = *(u16*)src++;
27293/20EC5B :                          ; but uses LDIRW hardware block transfer.
27294/20EC5B :                          ;
27295/20EC5B :                          ; Call site (ngpc_vramq.c) passes near u16 addresses widened to u32:
27296/20EC5B :                          ;   ngpc_memcpy_w((u32)dst_u16, (u32)src_u16, (u32)word_count)
27297/20EC5B :                          ; So upper 16 bits of XDE/XHL are guaranteed 0. LDIRW needs upper=0. OK
27298/20EC5B :                          ; ================================================================
27299/20EC5B :                          _ngpc_memcpy_w:
27300/20EC5B :                                  ; Load XDE = dst_addr (full 32-bit; upper 16 = 0 since near address)
27301/20EC5B : AF 04 22                         ld      xde, (xsp+4)
27302/20EC5E :                          
27303/20EC5E :                                  ; Load XHL = src_addr (full 32-bit; may be near or far)
27304/20EC5E : AF 08 23                         ld      xhl, (xsp+8)
27305/20EC61 :                          
27306/20EC61 :                                  ; Load BC = words (low 16 of u32; high 16 is 0 since words <= 65535)
27307/20EC61 : 9F 0C 21                         ld      bc, (xsp+12)
27308/20EC64 :                          
27309/20EC64 :                                  ; BC=0 guard: if words==0, skip (LDIRW BC=0 copies 65536 words!)
27310/20EC64 :                                  ; OR A, C: ALU instruction -- C is register, not condition code here.
27311/20EC64 : CA 89                            ld      a, b
27312/20EC66 : CB E1                            or      a, c
27313/20EC68 : 66 02                            jr      z, memcpy_w_done
27314/20EC6A :                          
27315/20EC6A : 93 11                            ldirw                       ; block copy: BC words from XHL -> XDE
27316/20EC6C :                          
27317/20EC6C :                          memcpy_w_done:
27318/20EC6C : 0E                               ret
27319/20EC6D :                          
27320/20EC6D :                          
27321/20EC6D :                          ; ---- src/fx/ngpc_dma_prog.asm
27322/20EC6D :                          
27323/20EC6D :                          
27324/20EC6D :                          
27325/20EC6D :                          ; C prototypes:
27326/20EC6D :                          ;   void dmaN_program_asm(const u8  __far *src, volatile u8 __far *dst, u16 count);
27327/20EC6D :                          ;   void dmaN_program_u16_asm(const u16 __far *src, volatile u8 __far *dst, u16 count);
27328/20EC6D :                          ;   void dmaN_program_u32_asm(const u32 __far *src, volatile u8 __far *dst, u16 count);
27329/20EC6D :                          ;
27330/20EC6D :                          ; Notes:
27331/20EC6D :                          ; - `count` is written to DMACn directly (i.e. number of DMA "steps"/transfers,
27332/20EC6D :                          ;   not necessarily a byte count when using word/dword modes).
27333/20EC6D :                          ;
27334/20EC6D :                          ; Stack layout on entry (TLCS-900/H cc900):
27335/20EC6D :                          ;   (xsp+0)  return address (far) 4 bytes
27336/20EC6D :                          ;   (xsp+4)  src (far pointer)   4 bytes
27337/20EC6D :                          ;   (xsp+8)  dst (far pointer)   4 bytes
27338/20EC6D :                          ;   (xsp+12) count (u16)         2 bytes
27339/20EC6D :                          ;
27340/20EC6D :                          ; DMA modes (see SDK `HDMA.H`; values here are the real hex values).
27341/20EC6D : =8H                      DMA_MODE_SINC1  equ 8   ; 0x08: byte,  src++
27342/20EC6D : =9H                      DMA_MODE_SINC2  equ 9   ; 0x09: word,  src++
27343/20EC6D : =0AH                     DMA_MODE_SINC4  equ 10  ; 0x0A: dword, src++
27344/20EC6D :                          
