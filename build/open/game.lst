28190/20F665 :                          ; c900 runtime helpers (TLCS-900/H, asl syntax)
28191/20F665 :                          ; Convention: operands in XWA (left) and XBC (right); result in XWA.
28192/20F665 :                          ; May clobber XWA XBC XDE XHL XIX XIY.
28193/20F665 :                          
28194/20F665 :                          __mul32:
28195/20F665 : E8 8A                            ld      xde,xwa
28196/20F667 : E9 8B                            ld      xhl,xbc
28197/20F669 : D9 40                            mul     xwa,bc
28198/20F66B : D7 EA 8C                         ld      ix,qde
28199/20F66E : DB 44                            mul     xix,hl
28200/20F670 : D7 EE 8D                         ld      iy,qhl
28201/20F673 : DA 45                            mul     xiy,de
28202/20F675 : ED 84                            add     xix,xiy
28203/20F677 : EC EE 00                         sll     16,xix
28204/20F67A : EC 80                            add     xwa,xix
28205/20F67C : 0E                               ret
28206/20F67D :                          
28207/20F67D :                          ; unsigned 32/32: quotient XWA, remainder XHL
28208/20F67D :                          __div32u:
