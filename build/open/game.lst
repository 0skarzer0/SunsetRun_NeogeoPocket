28441/20F4FE : C9 DE                            cp      a,0x6
28442/20F500 : F2 07 F5 20 D2                   jp       le,ah_clamp_hi
28443/20F505 : C9 AE                            ld      a,0x6
28444/20F507 :                          ah_clamp_hi:
28445/20F507 : C9 CF FA                         cp      a,0xfa
28446/20F50A : F2 11 F5 20 D9                   jp       ge,ah_clamp_lo
28447/20F50F : 21 FA                            ld      a,0xfa
