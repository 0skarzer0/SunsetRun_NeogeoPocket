27722/20EE1B :                          ; ================================================================
27723/20EE1B :                          ; void id_road_shear_asm(RoadShearWalk *s);
27724/20EE1B :                          ;
27725/20EE1B :                          ; Le cisaillement de chaque tranche, en tete de id_road_write() :
27726/20EE1B :                          ;   dx = (s16)((lateral * w_lat[k]) >> 8) + curve_dx[k], borne a [min, max].
27727/20EE1B :                          ; Le C reste dans id_road.c (ID_ROAD_SHEAR_C=1). cc900 y relisait sur la pile,
27728/20EE1B :                          ; a chaque tranche, trois des cinq pointeurs et le deplacement lateral : 13 200
27729/20EE1B :                          ; cycles par tour, le plus gros bloc C restant (2026-09-19).
27730/20EE1B :                          ;
27731/20EE1B :                          ;   XIX = &id_w_lat[k]      (monte de 1)
27732/20EE1B :                          ;   XIY = &id_curve_dx[k]   (monte de 2)
27733/20EE1B :                          ;   XHL = &id_dx_max[k]     (monte de 2) ; id_dx_min[k] est a -128 (RoadClamp)
27734/20EE1B :                          ;   XBC = &id_shear[k]      (monte de 2)
27735/20EE1B :                          ;   IZ  = lateral           (xsp+0) = tranches restantes
27736/20EE1B : =0H                      S_W      equ 0      ; const u8  * id_w_lat
27737/20EE1B : =4H                      S_CV     equ 4      ; const s16 * id_curve_dx
27738/20EE1B : =8H                      S_MX     equ 8      ; const s16 * id_dx_max  (id_dx_min = id_dx_max - 128)
27739/20EE1B : =0CH                     S_SH     equ 12     ; s16 *       id_shear
27740/20EE1B : =10H                     S_LAT    equ 16     ; s16  lateral
27741/20EE1B : =12H                     S_N      equ 18     ; u16  lignes (> 0, < 256)
27742/20EE1B : =80H                     RC_MIN   equ 0x80   ; id_dx_max - id_dx_min, en octets (RoadClamp)
27743/20EE1B :                          
27744/20EE1B :                          
27745/20EE1B :                          _id_road_shear_asm:
27746/20EE1B : 3E                               push    xiz
27747/20EE1C : AF 08 20                         ld      xwa,(xsp+0x8)
27748/20EE1F : A0 24                            ld      xix,(xwa+S_W)
27749/20EE21 : A8 04 25                         ld      xiy,(xwa+S_CV)
27750/20EE24 : A8 08 23                         ld      xhl,(xwa+S_MX)
27751/20EE27 : A8 0C 21                         ld      xbc,(xwa+S_SH)
27752/20EE2A : 98 10 26                         ld      iz,(xwa+S_LAT)
27753/20EE2D : 98 12 22                         ld      de,(xwa+S_N)
27754/20EE30 : 2A                               push    de                      ; le compteur, en (xsp)
27755/20EE31 :                          sh_loop:
27756/20EE31 : C5 F0 25                         ld      e,(xix+)
27757/20EE34 : DA 12                            extz    de
27758/20EE36 : DE 4A                            muls    xde,iz
27759/20EE38 : EA ED 08                         sra     0x8,xde                 ; (lateral * w) >> 8 on 32 bits (SUNSET RUN: |lateral| > 128)
27760/20EE3B : D5 F5 20                         ld      wa,(xiy+)
27761/20EE3E : DA 80                            add     wa,de
27762/20EE40 : 93 F0                            cp      wa,(xhl)
27763/20EE42 : F2 56 EE 20 DA                   jp       gt,sh_hi                ; dx > max
27764/20EE47 : 9B 80 F0                         cp      wa,(xhl-RC_MIN)
27765/20EE4A : F2 58 EE 20 D9                   jp       ge,sh_st
27766/20EE4F : 9B 80 20                         ld      wa,(xhl-RC_MIN)         ; dx < min
27767/20EE52 : 1B 58 EE 20                      jp       sh_st
27768/20EE56 :                          sh_hi:
27769/20EE56 : 93 20                            ld      wa,(xhl)
27770/20EE58 :                          sh_st:
27771/20EE58 : F5 E5 50                         ld      (xbc+),wa
27772/20EE5B : EB 62                            inc     0x2,xhl
27773/20EE5D : 87 69                            decb    0x1,(xsp)
27774/20EE5F : F2 31 EE 20 DE                   jp       ne,sh_loop
27775/20EE64 : 4A                               pop     de
27776/20EE65 : 5E                               pop     xiz
27777/20EE66 : 0E                               ret
27778/20EE67 :                          
27779/20EE67 :                          ; ================================================================
27780/20EE67 :                          ; void id_road_curve_asm(RoadCurve *c);
27781/20EE67 :                          ;
27782/20EE67 :                          ; La double integration de id_road_frame_ahead() : la courbure de chaque
27783/20EE67 :                          ; tranche, du pare-chocs vers l'horizon, sommee deux fois -- le cap, puis le
27784/20EE67 :                          ; deplacement lateral. Le C reste dans id_road.c (ID_ROAD_CURVE_C=1).
27785/20EE67 :                          ;
27786/20EE67 :                          ;   XIX = &bend[k] (descend de 2)   XIY = &id_curve_dx[k] (descend de 2)
27787/20EE67 :                          ;   DE  = id_curve_cm               BC  = slope      HL = acc      IZ = k
27788/20EE67 : =0H                      C_BEND   equ 0      ; const s16 * &bend[lines]
27789/20EE67 : =4H                      C_OUT    equ 4      ; s16 *       &id_curve_dx[lines]
27790/20EE67 : =8H                      C_CM     equ 8      ; u16 id_curve_cm
27791/20EE67 : =0AH                     C_N      equ 10     ; u16 lignes (> 0)
27792/20EE67 :                          
27793/20EE67 :                          
27794/20EE67 :                          _id_road_curve_asm:
27795/20EE67 : 3E                               push    xiz
27796/20EE68 : AF 08 26                         ld      xiz,(xsp+0x8)
27797/20EE6B : A6 24                            ld      xix,(xiz+C_BEND)
27798/20EE6D : AE 04 25                         ld      xiy,(xiz+C_OUT)
27799/20EE70 : 9E 08 22                         ld      de,(xiz+C_CM)
27800/20EE73 : 9E 0A 26                         ld      iz,(xiz+C_N)
27801/20EE76 : D9 A8                            ld      bc,0x0
27802/20EE78 : DB A8                            ld      hl,0x0
27803/20EE7A :                                  ; (Un cache "meme virage que la tranche d'avant, meme c" a ete essaye
27804/20EE7A :                                  ; le 2026-09-19 : 71 a 76 % de tranches repetees, et ZERO cycle gagne
27805/20EE7A :                                  ; mesure -- la comparaison en memoire et le saut pris coutent ce que la
27806/20EE7A :                                  ; multiplication coutait. Retire.)
27807/20EE7A :                          cv_loop:
27808/20EE7A : EC 6A                            dec     0x2,xix
27809/20EE7C : 94 20                            ld      wa,(xix)                ; b
27810/20EE7E : D8 D8                            cp      wa,0x0
27811/20EE80 : F2 96 EE 20 D9                   jp       ge,cv_pos
27812/20EE85 : D8 07                            neg     wa                      ; mag = -b
27813/20EE87 : DA 40                            mul     xwa,de                  ; (u16)mag * cm, 16 bits gardes
27814/20EE89 : D8 C8 80 00                      add     wa,0x80
27815/20EE8D : D8 EF 08                         srl     0x8,wa                  ; c
27816/20EE90 : D8 07                            neg     wa                      ; b < 0 : -c
27817/20EE92 : 1B 9F EE 20                      jp       cv_have
27818/20EE96 :                          cv_pos:
27819/20EE96 : DA 40                            mul     xwa,de
27820/20EE98 : D8 C8 80 00                      add     wa,0x80
27821/20EE9C : D8 EF 08                         srl     0x8,wa
27822/20EE9F :                          cv_have:
27823/20EE9F : D8 81                            add     bc,wa                   ; slope += c
27824/20EEA1 : D9 83                            add     hl,bc                   ; acc += slope
27825/20EEA3 : DB 88                            ld      wa,hl
27826/20EEA5 : D8 ED 08                         sra     0x8,wa
27827/20EEA8 : ED 6A                            dec     0x2,xiy
27828/20EEAA : B5 50                            ld      (xiy),wa                ; id_curve_dx[k] = acc >> 8
27829/20EEAC : DE CA 01 00                      sub     iz,0x1                  ; SUB pose les drapeaux (DEC 16 bits non)
27830/20EEB0 : F2 7A EE 20 DE                   jp       ne,cv_loop
27831/20EEB5 : 5E                               pop     xiz
27832/20EEB6 : 0E                               ret
27833/20EEB7 :                          
27834/20EEB7 :                          ; ---- src/spr_cells_asm.asm
27835/20EEB7 :                          ; spr_cells_asm.asm - write a list of 8x8 sprite cells to the K2GE sprite table
27836/20EEB7 :                          ;
27837/20EEB7 :                          ; SUNSET RUN.  The car, the traffic and the roadside objects are all drawn as
27838/20EEB7 :                          ; lists of {cx, cy, ch} cells; this loop replaces three copies of the same C
27839/20EEB7 :                          ; loop (the hottest code of a frame).  asm900 syntax, also assembled by the
27840/20EEB7 :                          ; open toolchain.
27841/20EEB7 :                          ;
27842/20EEB7 :                          ; void spr_cells_asm(SprJob *j);
27843/20EEB7 :                          ;   (xsp+0) return address, (xsp+4) j.  Preserves XIZ (cc900 convention).
27844/20EEB7 :                          ;
27845/20EEB7 :                          
27846/20EEB7 : =0H                      J_CELLS  equ 0      ; const u8 *   cells, 3 bytes each: cx, cy, ch
27847/20EEB7 : =4H                      J_MAP    equ 4      ; const u16 *  tile per ch (when J_HASMAP != 0)
27848/20EEB7 : =8H                      J_BASE   equ 8      ; u16          tile = base + ch (when J_HASMAP == 0)
27849/20EEB7 : =0AH                     J_X      equ 10     ; s16          left edge of the cell grid
27850/20EEB7 : =0CH                     J_Y      equ 12     ; u8           top of the cell grid
27851/20EEB7 : =0DH                     J_N      equ 13     ; u8           number of cells
27852/20EEB7 : =0EH                     J_WM1    equ 14     ; u8           grid width - 1 (mirroring)
27853/20EEB7 : =0FH                     J_ATTR   equ 15     ; u8           flip bits | priority bits
27854/20EEB7 : =10H                     J_PAL    equ 16     ; u8           palette
27855/20EEB7 : =11H                     J_SPR    equ 17     ; u8           next free sprite (in/out)
27856/20EEB7 : =12H                     J_END    equ 18     ; u8           first sprite NOT to use
27857/20EEB7 : =13H                     J_FLIP   equ 19     ; u8           != 0 : mirror the cell columns
27858/20EEB7 : =14H                     J_HASMAP equ 20     ; u8
27859/20EEB7 :                          
27860/20EEB7 :                          
27861/20EEB7 :                          
27862/20EEB7 :                          
27863/20EEB7 :                          _spr_cells_asm:
27864/20EEB7 : 3E                               push    xiz
27865/20EEB8 : AF 08 26                         ld      xiz,(xsp+0x8)
27866/20EEBB : A6 24                            ld      xix,(xiz+J_CELLS)
27867/20EEBD : 8E 11 23                         ld      c,(xiz+J_SPR)
27868/20EEC0 : 8E 0D 22                         ld      b,(xiz+J_N)
27869/20EEC3 : CA D8                            cp      b,0x0
27870/20EEC5 : F2 52 EF 20 D6                   jp      z,sc_done
27871/20EECA :                          sc_loop:
27872/20EECA : 8E 12 F3                         cp      c,(xiz+J_END)
27873/20EECD : F2 52 EF 20 DF                   jp      nc,sc_done
27874/20EED2 : 84 21                            ld      a,(xix)                 ; cx
27875/20EED4 : 8E 13 3F 00                      cpb     (xiz+J_FLIP),0x0
27876/20EED8 : 66 07                            jr      z,sc_noflip
27877/20EEDA : C9 8D                            ld      e,a
27878/20EEDC : 8E 0E 21                         ld      a,(xiz+J_WM1)
27879/20EEDF : CD A1                            sub     a,e
27880/20EEE1 :                          sc_noflip:
27881/20EEE1 : D8 12                            extz    wa
27882/20EEE3 : D8 EE 03                         sll     0x3,wa
27883/20EEE6 : 9E 0A 80                         add     wa,(xiz+J_X)            ; sx
27884/20EEE9 : D8 8A                            ld      de,wa
27885/20EEEB : DA C8 08 00                      add     de,0x8
27886/20EEEF : DA CF B0 00                      cp      de,0xb0                 ; -8 <= sx <= 167
27887/20EEF3 : 6F 54                            jr      nc,sc_next
27888/20EEF5 :                                  ; HL = 0x8800 + spr * 4
27889/20EEF5 : CB 8F                            ld      l,c
27890/20EEF7 : DB 12                            extz    hl
27891/20EEF9 : DB EE 02                         sll     0x2,hl
27892/20EEFC : DB C8 00 88                      add     hl,0x8800
27893/20EF00 : EB 12                            extz    xhl
27894/20EF02 : BB 02 41                         ld      (xhl+0x2),a             ; x (low byte of sx)
27895/20EF05 : 8C 01 21                         ld      a,(xix+0x1)             ; cy * 8 + y
27896/20EF08 : C9 EE 03                         sll     0x3,a
27897/20EF0B : 8E 0C 81                         add     a,(xiz+J_Y)
27898/20EF0E : BB 03 41                         ld      (xhl+0x3),a
27899/20EF11 : 8C 02 25                         ld      e,(xix+0x2)             ; ch
27900/20EF14 : DA 12                            extz    de
27901/20EF16 : 8E 14 3F 00                      cpb     (xiz+J_HASMAP),0x0
27902/20EF1A : 66 0C                            jr      z,sc_base
27903/20EF1C : DA 82                            add     de,de
27904/20EF1E : AE 04 25                         ld      xiy,(xiz+J_MAP)
27905/20EF21 : D3 07 F4 E8 22                   ld      de,(xiy+de)
27906/20EF26 : 68 03                            jr      sc_tile
27907/20EF28 :                          sc_base:
27908/20EF28 : 9E 08 82                         add     de,(xiz+J_BASE)
27909/20EF2B :                          sc_tile:
27910/20EF2B : B3 45                            ld      (xhl),e                 ; tile, low 8 bits
27911/20EF2D : CC 89                            ld      a,d
27912/20EF2F : C9 CC 01                         and     a,0x1
27913/20EF32 : 8E 0F E1                         or      a,(xiz+J_ATTR)
27914/20EF35 : BB 01 41                         ld      (xhl+0x1),a
27915/20EF38 :                                  ; palette: 0x8C00 + spr
27916/20EF38 : CB 8F                            ld      l,c
27917/20EF3A : DB 12                            extz    hl
27918/20EF3C : DB C8 00 8C                      add     hl,0x8c00
27919/20EF40 : EB 12                            extz    xhl
27920/20EF42 : 8E 10 21                         ld      a,(xiz+J_PAL)
27921/20EF45 : B3 41                            ld      (xhl),a
27922/20EF47 : CB 61                            inc     0x1,c
27923/20EF49 :                          sc_next:
27924/20EF49 : EC 63                            inc     0x3,xix
27925/20EF4B : CA 69                            dec     0x1,b
27926/20EF4D : F2 CA EE 20 DE                   jp      nz,sc_loop
27927/20EF52 :                          sc_done:
27928/20EF52 : BE 11 43                         ld      (xiz+J_SPR),c
27929/20EF55 : 5E                               pop     xiz
27930/20EF56 : 0E                               ret
