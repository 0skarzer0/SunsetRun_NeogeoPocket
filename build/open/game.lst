27872/20EFA5 :                          
27873/20EFA5 :                          ; ================================================================
27874/20EFA5 :                          ; void id_road_shear_asm(RoadShearWalk *s);
27875/20EFA5 :                          ;
27876/20EFA5 :                          ; Le cisaillement de chaque tranche, en tete de id_road_write() :
27877/20EFA5 :                          ;   dx = (s16)((lateral * w_lat[k]) >> 8) + curve_dx[k], borne a [min, max].
27878/20EFA5 :                          ; Le C reste dans id_road.c (ID_ROAD_SHEAR_C=1). cc900 y relisait sur la pile,
27879/20EFA5 :                          ; a chaque tranche, trois des cinq pointeurs et le deplacement lateral : 13 200
27880/20EFA5 :                          ; cycles par tour, le plus gros bloc C restant (2026-09-19).
27881/20EFA5 :                          ;
27882/20EFA5 :                          ;   XIX = &id_w_lat[k]      (monte de 1)
27883/20EFA5 :                          ;   XIY = &id_curve_dx[k]   (monte de 2)
27884/20EFA5 :                          ;   XHL = &id_dx_max[k]     (monte de 2) ; id_dx_min[k] est a -128 (RoadClamp)
27885/20EFA5 :                          ;   XBC = &id_shear[k]      (monte de 2)
27886/20EFA5 :                          ;   IZ  = lateral           (xsp+0) = tranches restantes
27887/20EFA5 : =0H                      S_W      equ 0      ; const u8  * id_w_lat
27888/20EFA5 : =4H                      S_CV     equ 4      ; const s16 * id_curve_dx
27889/20EFA5 : =8H                      S_MX     equ 8      ; const s16 * id_dx_max  (id_dx_min = id_dx_max - 128)
27890/20EFA5 : =0CH                     S_SH     equ 12     ; s16 *       id_shear
27891/20EFA5 : =10H                     S_LAT    equ 16     ; s16  lateral
27892/20EFA5 : =12H                     S_N      equ 18     ; u16  lignes (> 0, < 256)
27893/20EFA5 : =80H                     RC_MIN   equ 0x80   ; id_dx_max - id_dx_min, en octets (RoadClamp)
27894/20EFA5 :                          
27895/20EFA5 :                          
27896/20EFA5 :                          _id_road_shear_asm:
27897/20EFA5 : 3E                               push    xiz
27898/20EFA6 : AF 08 20                         ld      xwa,(xsp+0x8)
27899/20EFA9 : A0 24                            ld      xix,(xwa+S_W)
27900/20EFAB : A8 04 25                         ld      xiy,(xwa+S_CV)
27901/20EFAE : A8 08 23                         ld      xhl,(xwa+S_MX)
27902/20EFB1 : A8 0C 21                         ld      xbc,(xwa+S_SH)
27903/20EFB4 : 98 10 26                         ld      iz,(xwa+S_LAT)
27904/20EFB7 : 98 12 22                         ld      de,(xwa+S_N)
27905/20EFBA : 2A                               push    de                      ; le compteur, en (xsp)
27906/20EFBB :                          sh_loop:
27907/20EFBB : C5 F0 25                         ld      e,(xix+)
27908/20EFBE : DA 12                            extz    de
27909/20EFC0 : DE 4A                            muls    xde,iz
27910/20EFC2 : EA ED 08                         sra     0x8,xde                 ; (lateral * w) >> 8 on 32 bits (SUNSET RUN: |lateral| > 128)
27911/20EFC5 : D5 F5 20                         ld      wa,(xiy+)
27912/20EFC8 : DA 80                            add     wa,de
27913/20EFCA : 93 F0                            cp      wa,(xhl)
27914/20EFCC : F2 E0 EF 20 DA                   jp       gt,sh_hi                ; dx > max
27915/20EFD1 : 9B 80 F0                         cp      wa,(xhl-RC_MIN)
27916/20EFD4 : F2 E2 EF 20 D9                   jp       ge,sh_st
27917/20EFD9 : 9B 80 20                         ld      wa,(xhl-RC_MIN)         ; dx < min
27918/20EFDC : 1B E2 EF 20                      jp       sh_st
27919/20EFE0 :                          sh_hi:
27920/20EFE0 : 93 20                            ld      wa,(xhl)
27921/20EFE2 :                          sh_st:
27922/20EFE2 : F5 E5 50                         ld      (xbc+),wa
27923/20EFE5 : EB 62                            inc     0x2,xhl
27924/20EFE7 : 87 69                            decb    0x1,(xsp)
27925/20EFE9 : F2 BB EF 20 DE                   jp       ne,sh_loop
27926/20EFEE : 4A                               pop     de
27927/20EFEF : 5E                               pop     xiz
27928/20EFF0 : 0E                               ret
27929/20EFF1 :                          
27930/20EFF1 :                          ; ================================================================
27931/20EFF1 :                          ; void id_road_curve_asm(RoadCurve *c);
27932/20EFF1 :                          ;
27933/20EFF1 :                          ; La double integration de id_road_frame_ahead() : la courbure de chaque
27934/20EFF1 :                          ; tranche, du pare-chocs vers l'horizon, sommee deux fois -- le cap, puis le
27935/20EFF1 :                          ; deplacement lateral. Le C reste dans id_road.c (ID_ROAD_CURVE_C=1).
27936/20EFF1 :                          ;
27937/20EFF1 :                          ;   XIX = &bend[k] (descend de 2)   XIY = &id_curve_dx[k] (descend de 2)
27938/20EFF1 :                          ;   DE  = id_curve_cm               BC  = slope      HL = acc      IZ = k
27939/20EFF1 : =0H                      C_BEND   equ 0      ; const s16 * &bend[lines]
27940/20EFF1 : =4H                      C_OUT    equ 4      ; s16 *       &id_curve_dx[lines]
27941/20EFF1 : =8H                      C_CM     equ 8      ; u16 id_curve_cm
27942/20EFF1 : =0AH                     C_N      equ 10     ; u16 lignes (> 0)
27943/20EFF1 :                          
27944/20EFF1 :                          
27945/20EFF1 :                          _id_road_curve_asm:
27946/20EFF1 : 3E                               push    xiz
27947/20EFF2 : AF 08 26                         ld      xiz,(xsp+0x8)
27948/20EFF5 : A6 24                            ld      xix,(xiz+C_BEND)
27949/20EFF7 : AE 04 25                         ld      xiy,(xiz+C_OUT)
27950/20EFFA : 9E 08 22                         ld      de,(xiz+C_CM)
27951/20EFFD : 9E 0A 26                         ld      iz,(xiz+C_N)
27952/20F000 : D9 A8                            ld      bc,0x0
27953/20F002 : DB A8                            ld      hl,0x0
27954/20F004 :                                  ; (Un cache "meme virage que la tranche d'avant, meme c" a ete essaye
27955/20F004 :                                  ; le 2026-09-19 : 71 a 76 % de tranches repetees, et ZERO cycle gagne
27956/20F004 :                                  ; mesure -- la comparaison en memoire et le saut pris coutent ce que la
27957/20F004 :                                  ; multiplication coutait. Retire.)
27958/20F004 :                          cv_loop:
27959/20F004 : EC 6A                            dec     0x2,xix
27960/20F006 : 94 20                            ld      wa,(xix)                ; b
27961/20F008 : D8 D8                            cp      wa,0x0
27962/20F00A : F2 20 F0 20 D9                   jp       ge,cv_pos
27963/20F00F : D8 07                            neg     wa                      ; mag = -b
27964/20F011 : DA 40                            mul     xwa,de                  ; (u16)mag * cm, 16 bits gardes
27965/20F013 : D8 C8 80 00                      add     wa,0x80
27966/20F017 : D8 EF 08                         srl     0x8,wa                  ; c
27967/20F01A : D8 07                            neg     wa                      ; b < 0 : -c
27968/20F01C : 1B 29 F0 20                      jp       cv_have
27969/20F020 :                          cv_pos:
27970/20F020 : DA 40                            mul     xwa,de
27971/20F022 : D8 C8 80 00                      add     wa,0x80
27972/20F026 : D8 EF 08                         srl     0x8,wa
27973/20F029 :                          cv_have:
27974/20F029 : D8 81                            add     bc,wa                   ; slope += c
27975/20F02B : D9 83                            add     hl,bc                   ; acc += slope
27976/20F02D : DB 88                            ld      wa,hl
27977/20F02F : D8 ED 08                         sra     0x8,wa
27978/20F032 : ED 6A                            dec     0x2,xiy
27979/20F034 : B5 50                            ld      (xiy),wa                ; id_curve_dx[k] = acc >> 8
27980/20F036 : DE CA 01 00                      sub     iz,0x1                  ; SUB pose les drapeaux (DEC 16 bits non)
27981/20F03A : F2 04 F0 20 DE                   jp       ne,cv_loop
27982/20F03F : 5E                               pop     xiz
27983/20F040 : 0E                               ret
27984/20F041 :                          
27985/20F041 :                          ; ---- src/spr_cells_asm.asm
27986/20F041 :                          ; spr_cells_asm.asm - write a list of 8x8 sprite cells to the K2GE sprite table
27987/20F041 :                          ;
27988/20F041 :                          ; SUNSET RUN.  The car, the traffic and the roadside objects are all drawn as
27989/20F041 :                          ; lists of {cx, cy, ch} cells; this loop replaces three copies of the same C
27990/20F041 :                          ; loop (the hottest code of a frame).  asm900 syntax, also assembled by the
27991/20F041 :                          ; open toolchain.
27992/20F041 :                          ;
27993/20F041 :                          ; void spr_cells_asm(SprJob *j);
27994/20F041 :                          ;   (xsp+0) return address, (xsp+4) j.  Preserves XIZ (cc900 convention).
27995/20F041 :                          ;
27996/20F041 :                          
27997/20F041 : =0H                      J_CELLS  equ 0      ; const u8 *   cells, 3 bytes each: cx, cy, ch
27998/20F041 : =4H                      J_MAP    equ 4      ; const u16 *  tile per ch (when J_HASMAP != 0)
27999/20F041 : =8H                      J_BASE   equ 8      ; u16          tile = base + ch (when J_HASMAP == 0)
28000/20F041 : =0AH                     J_X      equ 10     ; s16          left edge of the cell grid
28001/20F041 : =0CH                     J_Y      equ 12     ; u8           top of the cell grid
28002/20F041 : =0DH                     J_N      equ 13     ; u8           number of cells
28003/20F041 : =0EH                     J_WM1    equ 14     ; u8           grid width - 1 (mirroring)
28004/20F041 : =0FH                     J_ATTR   equ 15     ; u8           flip bits | priority bits
28005/20F041 : =10H                     J_PAL    equ 16     ; u8           palette
28006/20F041 : =11H                     J_SPR    equ 17     ; u8           next free sprite (in/out)
28007/20F041 : =12H                     J_END    equ 18     ; u8           first sprite NOT to use
28008/20F041 : =13H                     J_FLIP   equ 19     ; u8           != 0 : mirror the cell columns
28009/20F041 : =14H                     J_HASMAP equ 20     ; u8
28010/20F041 :                          
28011/20F041 :                          
28012/20F041 :                          
28013/20F041 :                          
28014/20F041 :                          _spr_cells_asm:
28015/20F041 : 3E                               push    xiz
28016/20F042 : AF 08 26                         ld      xiz,(xsp+0x8)
28017/20F045 : A6 24                            ld      xix,(xiz+J_CELLS)
28018/20F047 : 8E 11 23                         ld      c,(xiz+J_SPR)
28019/20F04A : 8E 0D 22                         ld      b,(xiz+J_N)
28020/20F04D : CA D8                            cp      b,0x0
28021/20F04F : F2 DC F0 20 D6                   jp      z,sc_done
28022/20F054 :                          sc_loop:
28023/20F054 : 8E 12 F3                         cp      c,(xiz+J_END)
28024/20F057 : F2 DC F0 20 DF                   jp      nc,sc_done
28025/20F05C : 84 21                            ld      a,(xix)                 ; cx
28026/20F05E : 8E 13 3F 00                      cpb     (xiz+J_FLIP),0x0
28027/20F062 : 66 07                            jr      z,sc_noflip
28028/20F064 : C9 8D                            ld      e,a
28029/20F066 : 8E 0E 21                         ld      a,(xiz+J_WM1)
28030/20F069 : CD A1                            sub     a,e
28031/20F06B :                          sc_noflip:
28032/20F06B : D8 12                            extz    wa
28033/20F06D : D8 EE 03                         sll     0x3,wa
28034/20F070 : 9E 0A 80                         add     wa,(xiz+J_X)            ; sx
28035/20F073 : D8 8A                            ld      de,wa
28036/20F075 : DA C8 08 00                      add     de,0x8
28037/20F079 : DA CF B0 00                      cp      de,0xb0                 ; -8 <= sx <= 167
28038/20F07D : 6F 54                            jr      nc,sc_next
28039/20F07F :                                  ; HL = 0x8800 + spr * 4
28040/20F07F : CB 8F                            ld      l,c
28041/20F081 : DB 12                            extz    hl
28042/20F083 : DB EE 02                         sll     0x2,hl
28043/20F086 : DB C8 00 88                      add     hl,0x8800
28044/20F08A : EB 12                            extz    xhl
28045/20F08C : BB 02 41                         ld      (xhl+0x2),a             ; x (low byte of sx)
28046/20F08F : 8C 01 21                         ld      a,(xix+0x1)             ; cy * 8 + y
28047/20F092 : C9 EE 03                         sll     0x3,a
28048/20F095 : 8E 0C 81                         add     a,(xiz+J_Y)
28049/20F098 : BB 03 41                         ld      (xhl+0x3),a
28050/20F09B : 8C 02 25                         ld      e,(xix+0x2)             ; ch
28051/20F09E : DA 12                            extz    de
28052/20F0A0 : 8E 14 3F 00                      cpb     (xiz+J_HASMAP),0x0
28053/20F0A4 : 66 0C                            jr      z,sc_base
28054/20F0A6 : DA 82                            add     de,de
28055/20F0A8 : AE 04 25                         ld      xiy,(xiz+J_MAP)
28056/20F0AB : D3 07 F4 E8 22                   ld      de,(xiy+de)
28057/20F0B0 : 68 03                            jr      sc_tile
28058/20F0B2 :                          sc_base:
28059/20F0B2 : 9E 08 82                         add     de,(xiz+J_BASE)
28060/20F0B5 :                          sc_tile:
28061/20F0B5 : B3 45                            ld      (xhl),e                 ; tile, low 8 bits
28062/20F0B7 : CC 89                            ld      a,d
28063/20F0B9 : C9 CC 01                         and     a,0x1
28064/20F0BC : 8E 0F E1                         or      a,(xiz+J_ATTR)
28065/20F0BF : BB 01 41                         ld      (xhl+0x1),a
28066/20F0C2 :                                  ; palette: 0x8C00 + spr
28067/20F0C2 : CB 8F                            ld      l,c
28068/20F0C4 : DB 12                            extz    hl
28069/20F0C6 : DB C8 00 8C                      add     hl,0x8c00
28070/20F0CA : EB 12                            extz    xhl
28071/20F0CC : 8E 10 21                         ld      a,(xiz+J_PAL)
28072/20F0CF : B3 41                            ld      (xhl),a
28073/20F0D1 : CB 61                            inc     0x1,c
28074/20F0D3 :                          sc_next:
28075/20F0D3 : EC 63                            inc     0x3,xix
28076/20F0D5 : CA 69                            dec     0x1,b
28077/20F0D7 : F2 54 F0 20 DE                   jp      nz,sc_loop
28078/20F0DC :                          sc_done:
28079/20F0DC : BE 11 43                         ld      (xiz+J_SPR),c
28080/20F0DF : 5E                               pop     xiz
28081/20F0E0 : 0E                               ret
