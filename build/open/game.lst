27676/20EDEC : E9 69                            dec     0x1,xbc
27677/20EDEE :                                  ; want = ahead[k] - walked, et walked est ahead[k+1] : la tranche
27678/20EDEE :                                  ; d'avant, deux octets plus haut dans le meme tableau
27679/20EDEE : 94 20                            ld      wa,(xix)
27680/20EDF0 : 9C 02 A0                         sub     wa,(xix+0x2)
27681/20EDF3 :                          _id_road_ahead_asm__L2:
27682/20EDF3 :                          ah_want:
27683/20EDF3 :                                  ; LE CAS COURANT SANS MEMOIRE : into += want, et si ca reste dans le
27684/20EDF3 :                                  ; segment, c'est fini. (u16)(into + want) >= span se lit sur DE lui-meme.
27685/20EDF3 : D8 82                            add     de,wa
