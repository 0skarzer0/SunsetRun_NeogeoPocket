27002/20EB0B :                          ; c900 runtime helpers (TLCS-900/H, asl syntax)
27003/20EB0B :                          ; Convention: operands in XWA (left) and XBC (right); result in XWA.
27004/20EB0B :                          ; May clobber XWA XBC XDE XHL XIX XIY.
27005/20EB0B :                          
27006/20EB0B :                          __mul32:
27007/20EB0B : E8 8A                            ld      xde,xwa
27008/20EB0D : E9 8B                            ld      xhl,xbc
27009/20EB0F : D9 40                            mul     xwa,bc
27010/20EB11 : D7 EA 8C                         ld      ix,qde
27011/20EB14 : DB 44                            mul     xix,hl
27012/20EB16 : D7 EE 8D                         ld      iy,qhl
27013/20EB19 : DA 45                            mul     xiy,de
27014/20EB1B : ED 84                            add     xix,xiy
27015/20EB1D : EC EE 00                         sll     16,xix
27016/20EB20 : EC 80                            add     xwa,xix
27017/20EB22 : 0E                               ret
27018/20EB23 :                          
27019/20EB23 :                          ; unsigned 32/32: quotient XWA, remainder XHL
27020/20EB23 :                          __div32u:
27021/20EB23 : EB A8                            ld      xhl,0
27022/20EB25 : 25 20                            ld      e,32
27023/20EB27 :                          __div32u_loop:
27024/20EB27 : E8 EE 01                         sll     1,xwa
27025/20EB2A : EB EA 01                         rl      1,xhl
27026/20EB2D : E9 F3                            cp      xhl,xbc
27027/20EB2F : 67 04                            jr      ult,__div32u_skip
27028/20EB31 : E9 A3                            sub     xhl,xbc
27029/20EB33 : E8 61                            inc     1,xwa
27030/20EB35 :                          __div32u_skip:
27031/20EB35 : CD 1C EF                         djnz    e,__div32u_loop
27032/20EB38 : 0E                               ret
27033/20EB39 :                          
