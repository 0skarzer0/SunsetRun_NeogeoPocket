22175/20BCDF : DB C8 00 8C                      add     hl,0x8c00
22176/20BCE3 : EB 12                            extz    xhl
22177/20BCE5 : 8E 10 21                         ld      a,(xiz+J_PAL)
22178/20BCE8 : B3 41                            ld      (xhl),a
22179/20BCEA : CB 61                            inc     0x1,c
22180/20BCEC :                          sc_next:
22181/20BCEC : EC 63                            inc     0x3,xix
22182/20BCEE : CA 69                            dec     0x1,b
22183/20BCF0 : F2 6D BC 20 DE                   jp      nz,sc_loop
22184/20BCF5 :                          sc_done:
22185/20BCF5 : BE 11 43                         ld      (xiz+J_SPR),c
22186/20BCF8 : 5E                               pop     xiz
22187/20BCF9 : 0E                               ret
