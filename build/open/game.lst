27975/20F09F :                          ; ================================================================
27976/20F09F :                          ; void id_road_shear_asm(RoadShearWalk *s);
27977/20F09F :                          ;
27978/20F09F :                          ; Le cisaillement de chaque tranche, en tete de id_road_write() :
27979/20F09F :                          ;   dx = (s16)((lateral * w_lat[k]) >> 8) + curve_dx[k], borne a [min, max].
27980/20F09F :                          ; Le C reste dans id_road.c (ID_ROAD_SHEAR_C=1). cc900 y relisait sur la pile,
27981/20F09F :                          ; a chaque tranche, trois des cinq pointeurs et le deplacement lateral : 13 200
27982/20F09F :                          ; cycles par tour, le plus gros bloc C restant (2026-09-19).
27983/20F09F :                          ;
27984/20F09F :                          ;   XIX = &id_w_lat[k]      (monte de 1)
27985/20F09F :                          ;   XIY = &id_curve_dx[k]   (monte de 2)
27986/20F09F :                          ;   XHL = &id_dx_max[k]     (monte de 2) ; id_dx_min[k] est a -128 (RoadClamp)
27987/20F09F :                          ;   XBC = &id_shear[k]      (monte de 2)
27988/20F09F :                          ;   IZ  = lateral           (xsp+0) = tranches restantes
27989/20F09F : =0H                      S_W      equ 0      ; const u8  * id_w_lat
27990/20F09F : =4H                      S_CV     equ 4      ; const s16 * id_curve_dx
27991/20F09F : =8H                      S_MX     equ 8      ; const s16 * id_dx_max  (id_dx_min = id_dx_max - 128)
27992/20F09F : =0CH                     S_SH     equ 12     ; s16 *       id_shear
27993/20F09F : =10H                     S_LAT    equ 16     ; s16  lateral
27994/20F09F : =12H                     S_N      equ 18     ; u16  lignes (> 0, < 256)
27995/20F09F : =80H                     RC_MIN   equ 0x80   ; id_dx_max - id_dx_min, en octets (RoadClamp)
27996/20F09F :                          
27997/20F09F :                          
27998/20F09F :                          _id_road_shear_asm:
27999/20F09F : 3E                               push    xiz
28000/20F0A0 : AF 08 20                         ld      xwa,(xsp+0x8)
28001/20F0A3 : A0 24                            ld      xix,(xwa+S_W)
28002/20F0A5 : A8 04 25                         ld      xiy,(xwa+S_CV)
28003/20F0A8 : A8 08 23                         ld      xhl,(xwa+S_MX)
28004/20F0AB : A8 0C 21                         ld      xbc,(xwa+S_SH)
28005/20F0AE : 98 10 26                         ld      iz,(xwa+S_LAT)
28006/20F0B1 : 98 12 22                         ld      de,(xwa+S_N)
28007/20F0B4 : 2A                               push    de                      ; le compteur, en (xsp)
28008/20F0B5 :                          sh_loop:
28009/20F0B5 : C5 F0 25                         ld      e,(xix+)
28010/20F0B8 : DA 12                            extz    de
28011/20F0BA : DE 4A                            muls    xde,iz
28012/20F0BC : EA ED 08                         sra     0x8,xde                 ; (lateral * w) >> 8 on 32 bits (SUNSET RUN: |lateral| > 128)
28013/20F0BF : D5 F5 20                         ld      wa,(xiy+)
28014/20F0C2 : DA 80                            add     wa,de
28015/20F0C4 : 93 F0                            cp      wa,(xhl)
28016/20F0C6 : F2 DA F0 20 DA                   jp       gt,sh_hi                ; dx > max
28017/20F0CB : 9B 80 F0                         cp      wa,(xhl-RC_MIN)
28018/20F0CE : F2 DC F0 20 D9                   jp       ge,sh_st
28019/20F0D3 : 9B 80 20                         ld      wa,(xhl-RC_MIN)         ; dx < min
28020/20F0D6 : 1B DC F0 20                      jp       sh_st
28021/20F0DA :                          sh_hi:
28022/20F0DA : 93 20                            ld      wa,(xhl)
28023/20F0DC :                          sh_st:
28024/20F0DC : F5 E5 50                         ld      (xbc+),wa
28025/20F0DF : EB 62                            inc     0x2,xhl
28026/20F0E1 : 87 69                            decb    0x1,(xsp)
28027/20F0E3 : F2 B5 F0 20 DE                   jp       ne,sh_loop
28028/20F0E8 : 4A                               pop     de
28029/20F0E9 : 5E                               pop     xiz
28030/20F0EA : 0E                               ret
28031/20F0EB :                          
28032/20F0EB :                          ; ================================================================
28033/20F0EB :                          ; void id_road_curve_asm(RoadCurve *c);
28034/20F0EB :                          ;
28035/20F0EB :                          ; La double integration de id_road_frame_ahead() : la courbure de chaque
28036/20F0EB :                          ; tranche, du pare-chocs vers l'horizon, sommee deux fois -- le cap, puis le
28037/20F0EB :                          ; deplacement lateral. Le C reste dans id_road.c (ID_ROAD_CURVE_C=1).
28038/20F0EB :                          ;
28039/20F0EB :                          ;   XIX = &bend[k] (descend de 2)   XIY = &id_curve_dx[k] (descend de 2)
28040/20F0EB :                          ;   DE  = id_curve_cm               BC  = slope      HL = acc      IZ = k
28041/20F0EB : =0H                      C_BEND   equ 0      ; const s16 * &bend[lines]
28042/20F0EB : =4H                      C_OUT    equ 4      ; s16 *       &id_curve_dx[lines]
28043/20F0EB : =8H                      C_CM     equ 8      ; u16 id_curve_cm
28044/20F0EB : =0AH                     C_N      equ 10     ; u16 lignes (> 0)
28045/20F0EB :                          
28046/20F0EB :                          
28047/20F0EB :                          _id_road_curve_asm:
28048/20F0EB : 3E                               push    xiz
28049/20F0EC : AF 08 26                         ld      xiz,(xsp+0x8)
28050/20F0EF : A6 24                            ld      xix,(xiz+C_BEND)
28051/20F0F1 : AE 04 25                         ld      xiy,(xiz+C_OUT)
28052/20F0F4 : 9E 08 22                         ld      de,(xiz+C_CM)
28053/20F0F7 : 9E 0A 26                         ld      iz,(xiz+C_N)
28054/20F0FA : D9 A8                            ld      bc,0x0
28055/20F0FC : DB A8                            ld      hl,0x0
28056/20F0FE :                                  ; (Un cache "meme virage que la tranche d'avant, meme c" a ete essaye
28057/20F0FE :                                  ; le 2026-09-19 : 71 a 76 % de tranches repetees, et ZERO cycle gagne
28058/20F0FE :                                  ; mesure -- la comparaison en memoire et le saut pris coutent ce que la
28059/20F0FE :                                  ; multiplication coutait. Retire.)
28060/20F0FE :                          cv_loop:
28061/20F0FE : EC 6A                            dec     0x2,xix
28062/20F100 : 94 20                            ld      wa,(xix)                ; b
28063/20F102 : D8 D8                            cp      wa,0x0
28064/20F104 : F2 1A F1 20 D9                   jp       ge,cv_pos
28065/20F109 : D8 07                            neg     wa                      ; mag = -b
28066/20F10B : DA 40                            mul     xwa,de                  ; (u16)mag * cm, 16 bits gardes
28067/20F10D : D8 C8 80 00                      add     wa,0x80
28068/20F111 : D8 EF 08                         srl     0x8,wa                  ; c
28069/20F114 : D8 07                            neg     wa                      ; b < 0 : -c
28070/20F116 : 1B 23 F1 20                      jp       cv_have
28071/20F11A :                          cv_pos:
28072/20F11A : DA 40                            mul     xwa,de
28073/20F11C : D8 C8 80 00                      add     wa,0x80
28074/20F120 : D8 EF 08                         srl     0x8,wa
28075/20F123 :                          cv_have:
28076/20F123 : D8 81                            add     bc,wa                   ; slope += c
28077/20F125 : D9 83                            add     hl,bc                   ; acc += slope
28078/20F127 : DB 88                            ld      wa,hl
28079/20F129 : D8 ED 08                         sra     0x8,wa
28080/20F12C : ED 6A                            dec     0x2,xiy
28081/20F12E : B5 50                            ld      (xiy),wa                ; id_curve_dx[k] = acc >> 8
28082/20F130 : DE CA 01 00                      sub     iz,0x1                  ; SUB pose les drapeaux (DEC 16 bits non)
28083/20F134 : F2 FE F0 20 DE                   jp       ne,cv_loop
28084/20F139 : 5E                               pop     xiz
28085/20F13A : 0E                               ret
28086/20F13B :                          
28087/20F13B :                          ; ---- src/spr_cells_asm.asm
28088/20F13B :                          ; spr_cells_asm.asm - write a list of 8x8 sprite cells to the K2GE sprite table
28089/20F13B :                          ;
28090/20F13B :                          ; SUNSET RUN.  The car, the traffic and the roadside objects are all drawn as
28091/20F13B :                          ; lists of {cx, cy, ch} cells; this loop replaces three copies of the same C
28092/20F13B :                          ; loop (the hottest code of a frame).  asm900 syntax, also assembled by the
28093/20F13B :                          ; open toolchain.
28094/20F13B :                          ;
28095/20F13B :                          ; void spr_cells_asm(SprJob *j);
28096/20F13B :                          ;   (xsp+0) return address, (xsp+4) j.  Preserves XIZ (cc900 convention).
28097/20F13B :                          ;
28098/20F13B :                          
28099/20F13B : =0H                      J_CELLS  equ 0      ; const u8 *   cells, 3 bytes each: cx, cy, ch
28100/20F13B : =4H                      J_MAP    equ 4      ; const u16 *  tile per ch (when J_HASMAP != 0)
28101/20F13B : =8H                      J_BASE   equ 8      ; u16          tile = base + ch (when J_HASMAP == 0)
28102/20F13B : =0AH                     J_X      equ 10     ; s16          left edge of the cell grid
28103/20F13B : =0CH                     J_Y      equ 12     ; u8           top of the cell grid
28104/20F13B : =0DH                     J_N      equ 13     ; u8           number of cells
28105/20F13B : =0EH                     J_WM1    equ 14     ; u8           grid width - 1 (mirroring)
28106/20F13B : =0FH                     J_ATTR   equ 15     ; u8           flip bits | priority bits
28107/20F13B : =10H                     J_PAL    equ 16     ; u8           palette
28108/20F13B : =11H                     J_SPR    equ 17     ; u8           next free sprite (in/out)
28109/20F13B : =12H                     J_END    equ 18     ; u8           first sprite NOT to use
28110/20F13B : =13H                     J_FLIP   equ 19     ; u8           != 0 : mirror the cell columns
28111/20F13B : =14H                     J_HASMAP equ 20     ; u8
28112/20F13B :                          
28113/20F13B :                          
28114/20F13B :                          
28115/20F13B :                          
28116/20F13B :                          _spr_cells_asm:
28117/20F13B : 3E                               push    xiz
28118/20F13C : AF 08 26                         ld      xiz,(xsp+0x8)
28119/20F13F : A6 24                            ld      xix,(xiz+J_CELLS)
28120/20F141 : 8E 11 23                         ld      c,(xiz+J_SPR)
28121/20F144 : 8E 0D 22                         ld      b,(xiz+J_N)
28122/20F147 : CA D8                            cp      b,0x0
28123/20F149 : F2 D6 F1 20 D6                   jp      z,sc_done
28124/20F14E :                          sc_loop:
28125/20F14E : 8E 12 F3                         cp      c,(xiz+J_END)
28126/20F151 : F2 D6 F1 20 DF                   jp      nc,sc_done
28127/20F156 : 84 21                            ld      a,(xix)                 ; cx
28128/20F158 : 8E 13 3F 00                      cpb     (xiz+J_FLIP),0x0
28129/20F15C : 66 07                            jr      z,sc_noflip
28130/20F15E : C9 8D                            ld      e,a
28131/20F160 : 8E 0E 21                         ld      a,(xiz+J_WM1)
