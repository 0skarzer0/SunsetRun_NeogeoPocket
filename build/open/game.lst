24593/20D312 : AF 08 20                         ld      xwa,(xsp+8)
24594/20D315 : E8 2E 10                         ldc    dmad0,xwa
24595/20D318 : 9F 0C 20                         ld      wa,(xsp+12)
24596/20D31B : D8 2E 20                         ldc    dmac0,wa
24597/20D31E : 21 09                            ld      a,DMA_MODE_SINC2
24598/20D320 : C9 2E 22                         ldc    dmam0,a
24599/20D323 : 0E                               ret
