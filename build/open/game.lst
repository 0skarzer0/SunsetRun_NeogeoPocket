28317/20F56C :                          ; id_road_asm.asm - la marche par tranches de id_road_write(), en assembleur
28318/20F56C :                          ;
28319/20F56C :                          ; POURQUOI EN ASSEMBLEUR. Profil de la ROM livree (tools/profil_course.py,
28320/20F56C :                          ; temporisation de la cartouche comprise) : cette boucle etait le plus gros
28321/20F56C :                          ; poste du tour de course. cc900 n'y gardait pas ses valeurs en registres --
28322/20F56C :                          ; tout allait sur la pile -- et relisait chaque adresse de table par une
28323/20F56C :                          ; instruction de cinq octets, cinquante-six fois par trame. Sur cette machine
28324/20F56C :                          ; chaque octet d'instruction se lit dans la cartouche.
28325/20F56C :                          ;
28326/20F56C :                          ; LE CALCUL EST CELUI DU C, A L'OCTET PRES : la version C est gardee dans
28327/20F56C :                          ; id_road.c (ID_ROAD_WALK_C=1) et tools/equivalence.py compare, tour de boucle
28328/20F56C :                          ; par tour de boucle, la RAM de cette ROM a celle de la ROM d'origine sur les
28329/20F56C :                          ; dix circuits.
28330/20F56C :                          ;
28331/20F56C :                          ; !! SEULEMENT DES FORMES QUE cc900 EMET DEJA. Les pieges materiel connus de ce
28332/20F56C :                          ; processeur (docs du projet, fiches) venaient d'encodages que Toshiba n'emet
28333/20F56C :                          ; pas. `python tools/formes_asm.py` verifie chaque instruction de ce fichier
28334/20F56C :                          ; contre le code que cc900 genere pour ce projet (build/prof_asm/*.asm).
28335/20F56C :                          ;
28336/20F56C :                          ; void id_road_walk_asm(RoadWalk *w);
28337/20F56C :                          ;
28338/20F56C :                          ;   (xsp+0) adresse de retour, 4 octets ; (xsp+4) w.
28339/20F56C :                          ;   cc900 : seul XIZ doit etre preserve (ses fonctions le poussent quand elles
28340/20F56C :                          ;   s'en servent) ; XWA XBC XDE XHL XIX XIY sont a l'appele.
28341/20F56C :                          ;
28342/20F56C :                          ; SECONDE ECRITURE (2026-09-19). La premiere relisait dans le bloc, a chaque
28343/20F56C :                          ; tranche, sept pointeurs de table et l'accumulateur : 44 500 cycles par tour.
28344/20F56C :                          ; Celle-ci tient toute la marche en registres :
28345/20F56C :                          ;
28346/20F56C :                          ;   XIX = &id_line_of[k]   (descend de 1)   la pente a +SL_GRADE, la bande a +SL_BANDI
28347/20F56C :                          ;   XIY = &id_shear[k]     (descend de 2)
28348/20F56C :                          ;   XHL = &xy[ligne]       (descend de 2 par ligne ecrite)
28349/20F56C :                          ;   XDE = &bande[ligne]    (descend de 2 par ligne ecrite)
28350/20F56C :                          ;   B   = l'accumulateur   C = la ligne courante (>= top : tient sur un octet)
28351/20F56C :                          ;   XIZ = &hill_rate[20]   (la cadence, indice signe)
28352/20F56C :                          ;
28353/20F56C :                          ; Les valeurs fixes du bloc sont RECOPIEES sur la pile de la routine (F_*) et
28354/20F56C :                          ; lues par (xsp+d) : c'est ce qui libere XIZ pour la table des cadences.
28355/20F56C :                          ;
28356/20F56C :                          ; LES DEUX RETENUES SANS SEIZE BITS. c = (acc + 2 rate) >> 8 et le nouvel
28357/20F56C :                          ; accumulateur est l'octet bas : c'est exactement le nombre de retenues de deux
28358/20F56C :                          ; additions de `rate` sur huit bits, et l'octet restant.
28359/20F56C :                          ;
28360/20F56C :                          ; LA LIGNE Y. (u8)((row >> 8) - (u8)(scr - plane0)) = (row >> 8) + plane0 - scr
28361/20F56C :                          ; modulo 256 : les deux formes rendent le meme octet.
28362/20F56C :                          ;
28363/20F56C :                          ; LA COULEUR DE BANDE EN DEUX TEMPS. band_col[lut[id_bandi[k]]] demande deux
28364/20F56C :                          ; pointeurs de table et la marche n'a plus de registre. Elle pose donc l'INDICE
28365/20F56C :                          ; id_bandi[k] dans l'octet bas de l'entree du tampon de couleur, et une passe
28366/20F56C :                          ; courte, apres elle, le convertit sur les seules lignes ecrites. Aucun octet de
28367/20F56C :                          ; RAM de plus : la pile n'en a pas a donner (voir RoadSlices dans id_road.c).
28368/20F56C :                          ;
28369/20F56C :                          
28370/20F56C :                          ; Le bloc RoadWalk (id_road.c ; sa TAILLE y est VERIFIEE a la compilation) :
28371/20F56C : =0H                      V_XY      equ 0     ; u16 * &xy[road_bottom]
28372/20F56C : =4H                      V_BAND    equ 4     ; u16 * &bandcol[road_bottom]
28373/20F56C : =8H                      V_SL      equ 8     ; u8  * &id_line_of[lines]   (juste APRES la fin)
28374/20F56C : =0CH                     V_SH      equ 12    ; s16 * &id_shear[lines]     (juste APRES la fin)
28375/20F56C : =10H                     V_RTAB    equ 16    ; u8  * &hill_rate[20]
28376/20F56C : =14H                     V_LUT     equ 20    ; u8  * ligne de band_lut de cette trame
28377/20F56C : =18H                     V_BCOL    equ 24    ; u16 * band_col
28378/20F56C : =1CH                     V_ROW     equ 28    ; u16  row_fx     (8.8)
28379/20F56C : =1EH                     V_STEP    equ 30    ; u16  step_fx
28380/20F56C : =20H                     V_HALF    equ 32    ; u16  (u16)step_fx >> 1
28381/20F56C : =22H                     V_TOP     equ 34    ; u8   top_limit        } recopies d'un mot
28382/20F56C : =23H                     V_PLANE0  equ 35    ; u8   road_plane0      }
28383/20F56C : =24H                     V_BASEX   equ 36    ; u8   road_base_x      } recopies d'un mot
28384/20F56C : =25H                     V_N       equ 37    ; u8   entree : lines ; sortie : k + 1
28385/20F56C : =26H                     V_LINE    equ 38    ; u8   entree : road_bottom ; sortie : la ligne a l'arret
28386/20F56C :                          ; Les tableaux voisins de id_line_of (RoadSlices dans id_road.c) :
28387/20F56C : =40H                     SL_GRADE  equ 64    ; id_grade[k] = id_line_of[k] + 64
28388/20F56C : =80H                     SL_BANDI  equ 128   ; id_bandi[k] = id_line_of[k] + 128
28389/20F56C :                          ; Le cadre de la routine, sous la sauvegarde de XIZ :
28390/20F56C : =0H                      F_ROW     equ 0     ; u16  row_fx (modifie)
28391/20F56C : =2H                      F_STEP    equ 2
28392/20F56C : =4H                      F_HALF    equ 4
28393/20F56C : =6H                      F_TOP     equ 6
28394/20F56C : =7H                      F_PLANE0  equ 7
28395/20F56C : =8H                      F_BASEX   equ 8
28396/20F56C : =9H                      F_N       equ 9     ; le compteur de tranches
28397/20F56C : =0AH                     F_BOT     equ 10    ; road_bottom
28398/20F56C : =0CH                     F_SIZE    equ 12
28399/20F56C : =14H                     F_W       equ 20    ; w : F_SIZE + XIZ (4) + adresse de retour (4)
28400/20F56C :                          
28401/20F56C :                          
28402/20F56C :                          
28403/20F56C :                          
28404/20F56C :                          _id_road_walk_asm:
28405/20F56C : 3E                               push    xiz
28406/20F56D : AF 08 20                         ld      xwa,(xsp+0x8)           ; w
28407/20F570 : BF F4 37                         lda     xsp,(xsp-F_SIZE)
28408/20F573 : 98 1C 21                         ld      bc,(xwa+V_ROW)
28409/20F576 : B7 51                            ld      (xsp+F_ROW),bc
28410/20F578 : 98 1E 21                         ld      bc,(xwa+V_STEP)
28411/20F57B : BF 02 51                         ld      (xsp+F_STEP),bc
28412/20F57E : 98 20 21                         ld      bc,(xwa+V_HALF)
28413/20F581 : BF 04 51                         ld      (xsp+F_HALF),bc
28414/20F584 : 98 22 21                         ld      bc,(xwa+V_TOP)          ; top et plane0
28415/20F587 : BF 06 51                         ld      (xsp+F_TOP),bc
28416/20F58A : 98 24 21                         ld      bc,(xwa+V_BASEX)        ; base_x et le compteur
28417/20F58D : BF 08 51                         ld      (xsp+F_BASEX),bc
28418/20F590 : 88 26 23                         ld      c,(xwa+V_LINE)          ; la ligne : road_bottom, >= top (le C le verifie)
28419/20F593 : BF 0A 43                         ld      (xsp+F_BOT),c
28420/20F596 : A0 23                            ld      xhl,(xwa+V_XY)
28421/20F598 : A8 04 22                         ld      xde,(xwa+V_BAND)
28422/20F59B : A8 08 24                         ld      xix,(xwa+V_SL)
28423/20F59E : A8 0C 25                         ld      xiy,(xwa+V_SH)
28424/20F5A1 : A8 10 26                         ld      xiz,(xwa+V_RTAB)
28425/20F5A4 : CA A8                            ld      b,0x0                   ; l'accumulateur part de zero, CHAQUE trame
28426/20F5A6 :                          
28427/20F5A6 :                          vw_slice:
28428/20F5A6 : EC 69                            dec     0x1,xix
28429/20F5A8 : ED 6A                            dec     0x2,xiy
28430/20F5AA :                                  ; ou va la tranche : id_line_of[k] = max(ligne, top) = la ligne, puisque
28431/20F5AA :                                  ; la marche s'arrete des qu'elle passe sous top
28432/20F5AA : B4 43                            ld      (xix),c
28433/20F5AC :                                  ; ---- la cadence : hill_rate[20 + id_grade[k]]
28434/20F5AC : 8C 40 21                         ld      a,(xix+SL_GRADE)
28435/20F5AF : D8 13                            exts    wa
28436/20F5B1 : C3 07 F8 E0 21                   ld      a,(xiz+wa)
28437/20F5B6 : C9 88                            ld      w,a
28438/20F5B8 :                                  ; ---- les deux retenues : A = acc + rate + rate, sur huit bits
28439/20F5B8 : CA 89                            ld      a,b
28440/20F5BA : C8 81                            add     a,w
28441/20F5BC : F2 CE F5 20 D7                   jp       ult,vw_c1               ; premiere retenue
28442/20F5C1 : C8 81                            add     a,w
28443/20F5C3 : F2 D5 F5 20 D7                   jp       ult,vw_one              ; une seule retenue : une ligne
28444/20F5C8 : C9 8A                            ld      b,a                     ; aucune : la tranche ne prend pas de ligne
28445/20F5CA : 1B 4B F6 20                      jp       vw_next
28446/20F5CE :                          vw_c1:
28447/20F5CE : C8 81                            add     a,w
28448/20F5D0 : F2 F9 F5 20 D7                   jp       ult,vw_two              ; deux retenues : deux lignes
28449/20F5D5 :                          vw_one:
28450/20F5D5 : C9 8A                            ld      b,a
28451/20F5D7 :                                  ; ---- une ligne, a la rangee de la tranche
28452/20F5D7 : 8F 01 21                         ld      a,(xsp+F_ROW+1)         ; (u8)(row_fx >> 8)
28453/20F5DA : 8F 07 81                         add     a,(xsp+F_PLANE0)
28454/20F5DD : CB A1                            sub     a,c
28455/20F5DF : C9 88                            ld      w,a
28456/20F5E1 : 85 21                            ld      a,(xiy)                 ; (u8)dx
28457/20F5E3 : 8F 08 81                         add     a,(xsp+F_BASEX)
28458/20F5E6 : B3 50                            ld      (xhl),wa
28459/20F5E8 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)        ; l'indice de bande, converti plus bas
28460/20F5ED : B2 41                            ld      (xde),a
28461/20F5EF : EB 6A                            dec     0x2,xhl
28462/20F5F1 : EA 6A                            dec     0x2,xde
28463/20F5F3 : CB 69                            dec     0x1,c
28464/20F5F5 : 1B 4B F6 20                      jp       vw_next
28465/20F5F9 :                          
28466/20F5F9 :                          vw_two:
28467/20F5F9 : C9 8A                            ld      b,a
28468/20F5FB :                                  ; ---- premiere ligne, a la rangee de la tranche
28469/20F5FB : 8F 01 21                         ld      a,(xsp+F_ROW+1)
28470/20F5FE : 8F 07 81                         add     a,(xsp+F_PLANE0)
28471/20F601 : CB A1                            sub     a,c
28472/20F603 : C9 88                            ld      w,a
28473/20F605 : 85 21                            ld      a,(xiy)
28474/20F607 : 8F 08 81                         add     a,(xsp+F_BASEX)
28475/20F60A : B3 50                            ld      (xhl),wa
28476/20F60C : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
28477/20F611 : B2 41                            ld      (xde),a
28478/20F613 : EB 6A                            dec     0x2,xhl
28479/20F615 : EA 6A                            dec     0x2,xde
28480/20F617 : CB 69                            dec     0x1,c
28481/20F619 :                                  ; ---- seconde ligne, seulement si elle reste sur l'ecran, a mi-marche
28482/20F619 : 8F 06 F3                         cp      c,(xsp+F_TOP)
28483/20F61C : F2 4B F6 20 D7                   jp       ult,vw_next
28484/20F621 : 97 20                            ld      wa,(xsp+F_ROW)
28485/20F623 : 9F 04 F0                         cp      wa,(xsp+F_HALF)
28486/20F626 : F2 2E F6 20 D3                   jp       ule,vw_mid              ; row_fx <= half : pas sous la rangee 0
28487/20F62B : 9F 04 A0                         sub     wa,(xsp+F_HALF)
28488/20F62E :                          vw_mid:
28489/20F62E : C8 89                            ld      a,w                     ; (u8)(mid >> 8)
28490/20F630 : 8F 07 81                         add     a,(xsp+F_PLANE0)
28491/20F633 : CB A1                            sub     a,c
28492/20F635 : C9 88                            ld      w,a
28493/20F637 : 85 21                            ld      a,(xiy)
28494/20F639 : 8F 08 81                         add     a,(xsp+F_BASEX)
28495/20F63C : B3 50                            ld      (xhl),wa
28496/20F63E : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
28497/20F643 : B2 41                            ld      (xde),a
28498/20F645 : EB 6A                            dec     0x2,xhl
28499/20F647 : EA 6A                            dec     0x2,xde
28500/20F649 : CB 69                            dec     0x1,c
28501/20F64B :                          
28502/20F64B :                          vw_next:
28503/20F64B :                                  ; TOUJOURS, meme pour une tranche qui n'a pris aucune ligne
28504/20F64B : 9F 02 20                         ld      wa,(xsp+F_STEP)
28505/20F64E : 97 A8                            sub     (xsp+F_ROW),wa
28506/20F650 : 8F 06 F3                         cp      c,(xsp+F_TOP)
28507/20F653 : F2 60 F6 20 D7                   jp       ult,vw_done             ; plus d'ecran : le compteur reste k + 1
28508/20F658 : 8F 09 69                         decb    0x1,(xsp+F_N)
28509/20F65B : F2 A6 F5 20 DE                   jp       ne,vw_slice             ; au bout : 0, soit k = -1
28510/20F660 :                          
28511/20F660 :                          vw_done:
28512/20F660 :                                  ; ---- les indices de bande deviennent des couleurs, lignes C+1..bas.
28513/20F660 :                                  ; XDE pointe l'entree de la ligne C (la prochaine qu'on aurait ecrite).
28514/20F660 : 8F 0A 21                         ld      a,(xsp+F_BOT)
28515/20F663 : CB A1                            sub     a,c
28516/20F665 : F2 92 F6 20 D6                   jp       eq,vw_conv_done         ; aucune ligne ecrite
28517/20F66A : C9 8A                            ld      b,a
28518/20F66C : AF 14 20                         ld      xwa,(xsp+F_W)
28519/20F66F : A8 14 24                         ld      xix,(xwa+V_LUT)
28520/20F672 : A8 18 25                         ld      xiy,(xwa+V_BCOL)
28521/20F675 :                          vw_conv:
28522/20F675 : EA 62                            inc     0x2,xde
28523/20F677 : 82 21                            ld      a,(xde)
28524/20F679 : D8 12                            extz    wa
28525/20F67B : C3 07 F0 E0 21                   ld      a,(xix+wa)
28526/20F680 : D8 12                            extz    wa
28527/20F682 : D8 80                            add     wa,wa
28528/20F684 : D3 07 F4 E0 20                   ld      wa,(xiy+wa)
28529/20F689 : B2 50                            ld      (xde),wa
28530/20F68B : CA 69                            dec     0x1,b                   ; huit bits : DEC pose les drapeaux
28531/20F68D : F2 75 F6 20 DE                   jp       ne,vw_conv
28532/20F692 :                          vw_conv_done:
28533/20F692 : AF 14 20                         ld      xwa,(xsp+F_W)
28534/20F695 : B8 26 43                         ld      (xwa+V_LINE),c
28535/20F698 :                                  ; !! PAS PAR A : A est l'octet bas de XWA, qui tient le bloc. Une
28536/20F698 :                                  ; premiere version faisait `ld a,(xsp+F_N)` ici et ecrivait le
28537/20F698 :                                  ; compteur a 0x..00+37, dans la pile.
28538/20F698 : 8F 09 22                         ld      b,(xsp+F_N)
28539/20F69B : B8 25 42                         ld      (xwa+V_N),b
28540/20F69E : BF 0C 37                         lda     xsp,(xsp+F_SIZE)
28541/20F6A1 : 5E                               pop     xiz
28542/20F6A2 : 0E                               ret
28543/20F6A3 :                          
28544/20F6A3 :                          ; ================================================================
28545/20F6A3 :                          ; void id_road_ahead_asm(RoadAhead *a);
28546/20F6A3 :                          ;
28547/20F6A3 :                          ; build_road_ahead() de main.c : pour chaque tranche, du pare-chocs vers
28548/20F6A3 :                          ; l'horizon, avancer sur le profil jusqu'a la distance que la tranche regarde,
28549/20F6A3 :                          ; puis rendre le virage et la pente a cette distance, joints arrondis. La
28550/20F6A3 :                          ; version C reste dans main.c (ID_ROAD_AHEAD_C=1) ; tools/equivalence.py prouve
28551/20F6A3 :                          ; que les deux rendent la meme RAM, tour par tour, sur les dix circuits.
28552/20F6A3 :                          ;
28553/20F6A3 :                          ; Registres pendant la boucle :
28554/20F6A3 :                          ;   XIX = &ahead[k]            (descend de 2)
28555/20F6A3 :                          ;   XHL = &road_bend[k]        (descend de 2)
28556/20F6A3 :                          ;   XBC = &id_grade[k]         (descend de 1 ; id_road_grade_buf)
28557/20F6A3 :                          ;   XIY = sc, le segment courant
28558/20F6A3 :                          ;   DE  = into, la position dans ce segment
28559/20F6A3 :                          ;   XIZ = le bloc (ci-dessous)
28560/20F6A3 :                          ;
28561/20F6A3 :                          ; SECONDE ECRITURE (2026-09-19) : DEUX CACHES PAR SEGMENT, valables un appel.
28562/20F6A3 :                          ; Profil par bloc : le fondu aux jonctions coutait 10 000 cycles par tour et la
28563/20F6A3 :                          ; borne de pente + grade_tab 8 000, refaits a CHAQUE tranche alors qu'ils ne
28564/20F6A3 :                          ; dependent que du SEGMENT tant qu'on y reste :
28565/20F6A3 :                          ;   - la pente a plat d'un segment, bornee et convertie, est la meme pour
28566/20F6A3 :                          ;     toutes ses tranches (cle A_FKEY) ;
28567/20F6A3 :                          ;   - un fondu melange le segment courant et un voisin avec un poids w : les
28568/20F6A3 :                          ;     deux ecarts (voisin - courant, virage et pente) ne dependent que du
28569/20F6A3 :                          ;     segment et du cote (cles A_NKEY, A_PKEY). Il ne reste par tranche que les
28570/20F6A3 :                          ;     deux multiplications, et la seconde saute quand les deux pentes sont
28571/20F6A3 :                          ;     egales -- le cas de toute route plate.
28572/20F6A3 :                          ; Les cles sont le numero du segment ; 0xFF = vide (track_len est un u8, un
28573/20F6A3 :                          ; numero vaut au plus 254). Le C les vide avant chaque appel.
28574/20F6A3 :                          ;
28575/20F6A3 :                          ; Le bloc RoadAhead (main.c ; taille VERIFIEE a la compilation) :
28576/20F6A3 : =0H                      A_AHEAD  equ 0      ; const u16 * &ahead[lines]            (juste APRES la fin)
28577/20F6A3 : =4H                      A_BEND   equ 4      ; s16 *       &road_bend[lines]
28578/20F6A3 : =8H                      A_GL     equ 8      ; s8 *        &id_grade[lines]
28579/20F6A3 : =0CH                     A_SEG    equ 12     ; const Segment * track_seg
28580/20F6A3 : =10H                     A_GTAB   equ 16     ; const s8 *  &grade_tab[HILL_SLOPE_MAX]  (indice signe)
28581/20F6A3 : =14H                     A_SC     equ 20     ; const Segment * &track_seg[seg_index]
28582/20F6A3 : =18H                     A_INTO   equ 24     ; u16 seg_pos
28583/20F6A3 : =1AH                     A_W      equ 26     ; u16 want (temporaire, traversee de segments)
28584/20F6A3 : =1CH                     A_K      equ 28     ; u8  lignes (> 0)
28585/20F6A3 : =1DH                     A_CUR    equ 29     ; u8  seg_index
28586/20F6A3 : =1EH                     A_LEN    equ 30     ; u8  track_len
28587/20F6A3 : =1FH                     A_FKEY   equ 31     ; u8  segment de la pente a plat en cache (0xFF = vide)
28588/20F6A3 : =20H                     A_FG     equ 32     ; s8  cette pente, bornee et convertie
28589/20F6A3 : =21H                     A_NKEY   equ 33     ; u8  segment du fondu vers le SUIVANT en cache
28590/20F6A3 : =22H                     A_PKEY   equ 34     ; u8  ... vers le PRECEDENT
28591/20F6A3 : =24H                     A_NDB    equ 36     ; s16 suivant->bend - bend
28592/20F6A3 : =26H                     A_NDP    equ 38     ; s16 suivant->slope - slope
28593/20F6A3 : =28H                     A_PDB    equ 40     ; s16 precedent->bend - bend
28594/20F6A3 : =2AH                     A_PDP    equ 42     ; s16 precedent->slope - slope
28595/20F6A3 :                          ; Segment : span u16 +0, bend s16 +2, slope s8 +4, six octets.
28596/20F6A3 :                          
28597/20F6A3 :                          
28598/20F6A3 :                          _id_road_ahead_asm:
28599/20F6A3 : 3E                               push    xiz
28600/20F6A4 : AF 08 26                         ld      xiz,(xsp+0x8)
28601/20F6A7 : A6 24                            ld      xix,(xiz+A_AHEAD)
28602/20F6A9 : AE 04 23                         ld      xhl,(xiz+A_BEND)
28603/20F6AC : AE 08 21                         ld      xbc,(xiz+A_GL)
28604/20F6AF : AE 14 25                         ld      xiy,(xiz+A_SC)
28605/20F6B2 : 9E 18 22                         ld      de,(xiz+A_INTO)
28606/20F6B5 :                                  ; la PREMIERE tranche : walked vaut 0
28607/20F6B5 : EC 6A                            dec     0x2,xix
28608/20F6B7 : EB 6A                            dec     0x2,xhl
