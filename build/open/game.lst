26822/20E90F :                          ; ---- src/core/ngpc_flash_asm.asm
26823/20E90F :                          
26824/20E90F :                          ;
26825/20E90F :                          ; ngpc_flash_asm.asm - Flash erase/write primitives for ngpc_flash.c
26826/20E90F :                          ;
26827/20E90F :                          ; Part of NgpCraft_base_template (MIT License)
26828/20E90F :                          ;
26829/20E90F :                          ; Two entry points, both called ONLY by ngpc_flash.c (never from an ISR):
26830/20E90F :                          ;
26831/20E90F :                          ;   _ngpc_flash_erase_asm(u32 abs_block)
26832/20E90F :                          ;       Erases one 8 KB block with the AMD erase stub extracted from StarGunner
26833/20E90F :                          ;       (hardware-validated), copied to RAM 0x6E00 and run from there.
26834/20E90F :                          ;       VECT_FLASHERS cannot erase blocks 32/33/34 (SysCall.txt p.299), so the
26835/20E90F :                          ;       erase keeps the stub.
26836/20E90F :                          ;
26837/20E90F :                          ;   _ngpc_flash_write_bios(const void *src, u32 offset, u32 pages)
26838/20E90F :                          ;       Programs pages x 256 bytes through the BIOS (VECT_FLASHWRITE, swi 1),
26839/20E90F :                          ;       the path StarGunner uses on hardware. The watchdog is refreshed right
26840/20E90F :                          ;       before and right after, as in the SDK save pattern.
26841/20E90F :                          ;
26842/20E90F :                          ; THE BLOCK IS A PARAMETER, NOT A CONSTANT. The save block sits 0x6000 below
26843/20E90F :                          ; the top of the chip, so its address depends on the cartridge size:
26844/20E90F :                          ; 0x27A000 on 4 Mbit, 0x2FA000 on 8 Mbit, 0x3FA000 on 16 Mbit. A hard-coded
26845/20E90F :                          ; 0x3FA000 erases 8 KB ELSEWHERE on a smaller chip - possibly the game code.
26846/20E90F :                          ; ngpc_flash.c reads the size the BIOS stores at 0x6C58 and refuses unknown ones.
26847/20E90F :                          ;
26848/20E90F :                          ; cc900 ABI (CALL pushes 4-byte XPC as return address):
26849/20E90F :                          ;   (xsp+0)..(xsp+3)  = return address
26850/20E90F :                          ;   (xsp+4)..(xsp+7)  = 1st parameter
26851/20E90F :                          ;   (xsp+8)..(xsp+11) = 2nd parameter
26852/20E90F :                          ;   (xsp+12)..(xsp+15)= 3rd parameter
26853/20E90F :                          ;
26854/20E90F :                          ; ===========================================================================
26855/20E90F :                          ; INTERRUPTS ARE PROHIBITED FOR THE WHOLE SEQUENCE. On hardware that is not
26856/20E90F :                          ; optional. A flash chip being programmed or erased answers reads with STATUS,
26857/20E90F :                          ; not with its contents. The stub runs from RAM for that reason, but the
26858/20E90F :                          ; interrupt handlers are still in the cartridge: an interrupt taken while the
26859/20E90F :                          ; chip is busy fetches its handler from status bits. A game taking VBlank at
26860/20E90F :                          ; 60 Hz cannot get through a 256-byte program or an 8 KB erase without one.
26861/20E90F :                          ;
26862/20E90F :                          ; AN EMULATOR WHOSE FLASH KEEPS SERVING ROM DURING THE WRITE NEVER SHOWS THIS.
26863/20E90F :                          ; Toshiba: "all interrupts are prohibited during system calls related to flash
26864/20E90F :                          ; memory management" (SysCall.txt). Hence `di` (encoded 06 07 = EI 7) on entry
26865/20E90F :                          ; and `ei 0` (06 00) on exit: level 0 is what ngpc_init() runs the game at.
26866/20E90F :                          ; ===========================================================================
26867/20E90F :                          
26868/20E90F :                          
26869/20E90F :                          
26870/20E90F : =6E00H                   FLASH_RAM       equ     0x6E00          ; RAM address for stub execution
26871/20E90F : =6EH                     FLASH_BUS_CTRL  equ     0x6E            ; I/O: flash /WE enable (0x14=on, 0xF0=off)
26872/20E90F : =6FH                     FLASH_WD        equ     0x6F            ; I/O: watchdog  (0xB1=extended, 0x4E=refresh)
26873/20E90F : =200000H                 CART_BASE       equ     0x200000        ; CS0 base address
26874/20E90F :                          
26875/20E90F :                          
26876/20E90F :                          
26877/20E90F :                          ; ===========================================================================
26878/20E90F :                          ; _ngpc_flash_erase_asm
26879/20E90F :                          ;   param 1 (xsp+4) : u32 abs_block -- ABSOLUTE address of the 8 KB block
26880/20E90F :                          ; C prototype: void ngpc_flash_erase_asm(u32 abs_block);
26881/20E90F :                          ; ===========================================================================
26882/20E90F :                          _ngpc_flash_erase_asm:
26883/20E90F :                          
26884/20E90F : 06 07                            di                              ; see the note at the top of the file
26885/20E911 : 08 6E 14                         ld      (FLASH_BUS_CTRL),0x14   ; enable /WE on cart bus
26886/20E914 : 08 6F B1                         ld      (FLASH_WD),0xB1         ; watchdog: extended mode
26887/20E917 :                          
26888/20E917 :                                  ; Copy erase stub (98 bytes) from ROM to RAM at FLASH_RAM
26889/20E917 : 39                               push    xbc                     ; preserve XBC across copy
26890/20E918 : 42 00 6E 00 00                   ld      xde,FLASH_RAM           ; destination: RAM
26891/20E91D : 43 64 E9 20 00                   ld      xhl,_erase_stub         ; source: stub bytes in ROM
26892/20E922 : 31 62 00                         ld      bc,0x62                 ; BC = 98 bytes
26893/20E925 : 83 11                            db      0x83,0x11               ; ldir (xde+),(xhl+) -- copy BC bytes
26894/20E927 : 59                               pop     xbc                     ; restore XBC (stack back to entry)
26895/20E928 :                          
26896/20E928 :                                  ; Set up registers for stub call
26897/20E928 : 44 00 00 20 00                   ld      xix,CART_BASE           ; XIX = 0x200000 (AMD unlock base)
26898/20E92D : ED A8                            ld      xiy,0x0                 ; XIY = 0 (erase stub uses as delay counter)
26899/20E92F : C9 A8                            ld      a,0x0                   ; A = 0 (erase stub state init)
26900/20E931 : AF 04 22                         ld      xde,(xsp+4)             ; XDE = block, given by the caller
26901/20E934 :                          
26902/20E934 : 1C 00 6E                         call    FLASH_RAM               ; execute stub from RAM
26903/20E937 :                          
26904/20E937 : 08 6E F0                         ld      (FLASH_BUS_CTRL),0xF0   ; restore watchdog mode first
26905/20E93A : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; then refresh the enabled watchdog
26906/20E93D : 06 00                            ei      0                       ; the chip answers as memory again
26907/20E93F : 0E                               ret
26908/20E940 :                          
26909/20E940 :                          
26910/20E940 :                          ; ===========================================================================
26911/20E940 :                          ; _ngpc_flash_write_bios
26912/20E940 :                          ;   param 1 (xsp+4)  : const void *src -- source buffer, in RAM
26913/20E940 :                          ;   param 2 (xsp+8)  : u32 offset      -- offset INSIDE the cartridge
26914/20E940 :                          ;                                         (e.g. 0x1FA000 + slot*SAVE_SIZE),
26915/20E940 :                          ;                                         not the absolute address: XDE3 wants
26916/20E940 :                          ;                                         the offset.
26917/20E940 :                          ;   param 3 (xsp+12) : u32 pages       -- number of 256-byte units
26918/20E940 :                          ; C prototype: void ngpc_flash_write_bios(const void *src, u32 offset, u32 pages);
26919/20E940 :                          ;
26920/20E940 :                          ; The BIOS holds the bus itself (no manual 0x6E write). The AMD write stub used
26921/20E940 :                          ; before disabled the watchdog and wrote its refresh code while it was off.
26922/20E940 :                          ; ===========================================================================
26923/20E940 :                          _ngpc_flash_write_bios:
26924/20E940 :                          
26925/20E940 : 06 07                            di                              ; see the note at the top of the file
26926/20E942 : AF 04 23                         ld      xhl,(xsp+4)             ; 1st param: source
26927/20E945 : AF 08 22                         ld      xde,(xsp+8)             ; 2nd param: cartridge offset
26928/20E948 : AF 0C 21                         ld      xbc,(xsp+12)            ; 3rd param: 256-byte pages
26929/20E94B : E7 3C 9B                         ld      xhl3,xhl                ; bank 3: the BIOS reads its arguments there
26930/20E94E : E7 38 9A                         ld      xde3,xde
26931/20E951 : E7 34 99                         ld      xbc3,xbc
26932/20E954 : C7 30 A8                         ld      ra3,0                   ; CS0
26933/20E957 : C7 31 AE                         ld      rw3,0x0006              ; VECT_FLASHWRITE
26934/20E95A : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; watchdog refreshed RIGHT BEFORE
26935/20E95D : F9                               swi     1
26936/20E95E : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; and right after
26937/20E961 : 06 00                            ei      0
26938/20E963 : 0E                               ret
26939/20E964 :                          
26940/20E964 :                          
26941/20E964 :                          ; ===========================================================================
26942/20E964 :                          ; Erase stub, extracted from StarGunner/bin/main.ngp (hardware-validated).
26943/20E964 :                          ; 98 bytes, file offset 0x13733. Position-independent, uses XIX for AMD cycles.
26944/20E964 :                          ;   AMD unlock -> reset -> unlock -> erase setup (0x80) -> unlock -> sector
26945/20E964 :                          ;   erase (0x30) -> poll DQ7 -> final reset/unlock -> ret
26946/20E964 :                          ;   Register interface: XIX=cart_base XDE=block_addr XIY=0 A=0
26947/20E964 :                          ; ===========================================================================
26948/20E964 :                          
26949/20E964 :                          _erase_stub:
26950/20E964 : F3 F1 55 55 00 AA F3 F1          db      0xF3,0xF1,0x55,0x55,0x00,0xAA, 0xF3,0xF1,0xAA,0x2A,0x00,0x55
      20E96C : AA 2A 00 55            
26951/20E970 : F3 F1 55 55 00 F0 00 00          db      0xF3,0xF1,0x55,0x55,0x00,0xF0, 0x00,0x00,0xF3,0xF1,0x55,0x55
      20E978 : F3 F1 55 55            
26952/20E97C : 00 AA F3 F1 AA 2A 00 55          db      0x00,0xAA,0xF3,0xF1,0xAA,0x2A, 0x00,0x55,0xF3,0xF1,0x55,0x55
      20E984 : F3 F1 55 55            
26953/20E988 : 00 80 F3 F1 55 55 00 AA          db      0x00,0x80,0xF3,0xF1,0x55,0x55, 0x00,0xAA,0xF3,0xF1,0xAA,0x2A
      20E990 : F3 F1 AA 2A            
26954/20E994 : 00 55 B2 00 30 82 3F FF          db      0x00,0x55,0xB2,0x00,0x30,0x82, 0x3F,0xFF,0x66,0x15,0xED,0x61
      20E99C : 66 15 ED 61            
26955/20E9A0 : ED CF FF FF 1F 00 66 09          db      0xED,0xCF,0xFF,0xFF,0x1F,0x00, 0x66,0x09,0xB2,0xCD,0x66,0xED
      20E9A8 : B2 CD 66 ED            
26956/20E9AC : 82 3F FF 66 02 21 FF F3          db      0x82,0x3F,0xFF,0x66,0x02,0x21, 0xFF,0xF3,0xF1,0x55,0x55,0x00
      20E9B4 : F1 55 55 00            
26957/20E9B8 : AA F3 F1 AA 2A 00 55 F3          db      0xAA,0xF3,0xF1,0xAA,0x2A,0x00, 0x55,0xF3,0xF1,0x55,0x55,0x00
      20E9C0 : F1 55 55 00            
26958/20E9C4 : F0 0E                            db      0xF0,0x0E
26959/20E9C6 :                          
26960/20E9C6 :                          ; ---- src/core/ngpc_syspatch.asm
26961/20E9C6 :                          
26962/20E9C6 :                          ;
26963/20E9C6 :                          ; ngpc_syspatch.asm - Power-off bug patch (SYS_PATCH equivalent)
26964/20E9C6 :                          ;
26965/20E9C6 :                          ; Part of NgpCraft_base_template (MIT License)
26966/20E9C6 :                          ;
26967/20E9C6 :                          ; Reverse-engineered from system.lib (SNK Corporation, 1998).
26968/20E9C6 :                          ;
26969/20E9C6 :                          ; The original SYS_PATCH routine fixes a bug in the initial production
26970/20E9C6 :                          ; NEOGEO POCKET system program: rapid removal/reinsertion of batteries
26971/20E9C6 :                          ; could prevent the power button from shutting down the console.
26972/20E9C6 :                          ;
26973/20E9C6 :                          ; Condition : OS_Version (0x6F91) == 0x00  [prototype firmware only]
26974/20E9C6 :                          ; Effect    : res 3, (0x6F83)              [clear undocumented sys flag]
26975/20E9C6 :                          ;             ldb (0x6DA0), 0x00           [clear undocumented power flag]
26976/20E9C6 :                          ;
26977/20E9C6 :                          ; On all retail hardware (OS_Version >= 0x01) this is a safe no-op.
26978/20E9C6 :                          ; Must be called once at startup, before enabling interrupts.
26979/20E9C6 :                          ;
26980/20E9C6 :                          ; Reference: MANSysPro.txt "SYS_PATCH", SysLib.txt p.6
26981/20E9C6 :                          ;
26982/20E9C6 :                          
26983/20E9C6 :                          
26984/20E9C6 :                          
26985/20E9C6 :                          
26986/20E9C6 :                          _ngpc_sys_patch:
26987/20E9C6 :                          
26988/20E9C6 :                                  ; cp (0x6F91), 0x00  [C1 91 6F 3F 00]
26989/20E9C6 :                                  ; Compare OS_Version with 0. Z=1 if prototype firmware.
26990/20E9C6 : C1 91 6F 3F 00                   db 0xC1, 0x91, 0x6F, 0x3F, 0x00
26991/20E9CB :                          
26992/20E9CB :                                  ; jr NZ, +9  [6E 09]
26993/20E9CB :                                  ; Retail hardware (OS_Version != 0): skip patch, fall through to ret.
26994/20E9CB : 6E 09                            db 0x6E, 0x09
26995/20E9CD :                          
26996/20E9CD :                                  ; res 3, (0x6F83)  [F1 83 6F B3]
26997/20E9CD :                                  ; Clear bit 3 of undocumented system flag (between Sys_Lever and User_Boot).
26998/20E9CD : F1 83 6F B3                      db 0xF1, 0x83, 0x6F, 0xB3
26999/20E9D1 :                          
27000/20E9D1 :                                  ; ldb (0x6DA0), 0x00  [F1 A0 6D 00 00]
27001/20E9D1 :                                  ; Clear undocumented power state register in system RAM.
27002/20E9D1 : F1 A0 6D 00 00                   db 0xF1, 0xA0, 0x6D, 0x00, 0x00
27003/20E9D6 :                          
27004/20E9D6 : 0E                               ret
27005/20E9D7 :                          
27006/20E9D7 :                          
27007/20E9D7 :                          ; ---- src/core/ngpc_vramq_asm.asm
27008/20E9D7 :                          ; ngpc_vramq_asm.asm - VRAM queue ASM helpers (TLCS-900/H)
27009/20E9D7 :                          ;
27010/20E9D7 :                          ; Part of NgpCraft_base_template (MIT License)
27011/20E9D7 :                          ;
27012/20E9D7 :                          ; Provides ngpc_memcpy_w() -- word-level block copy via LDIRW.
27013/20E9D7 :                          ; Used by ngpc_vramq.c CMD_COPY path instead of a byte-by-byte C loop.
27014/20E9D7 :                          ; dst is a near VRAM address (0x8000-0xBFFF). src can be near RAM or far ROM.
27015/20E9D7 :                          ;
27016/20E9D7 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
27017/20E9D7 :                          ;
27018/20E9D7 :                          ; cc900 calling convention -- args passed as u32 (4 bytes each, unambiguous):
27019/20E9D7 :                          ;   (xsp+0)  return address (far)   4 bytes
27020/20E9D7 :                          ;   (xsp+4)  dst_addr (u32)         4 bytes  <- near VRAM address (high 16 = 0)
27021/20E9D7 :                          ;   (xsp+8)  src_addr (u32)         4 bytes  <- RAM/ROM address (near or far)
27022/20E9D7 :                          ;   (xsp+12) words (u32)            4 bytes  <- word count (high 16 = 0)
27023/20E9D7 :                          ;
27024/20E9D7 :                          ; Using u32 args avoids ambiguity: cc900 may pad u16 args to 4 bytes on stack.
27025/20E9D7 :                          ; u32 args are always exactly 4 bytes, matching LD XRR, (xsp+N) reads.
27026/20E9D7 :                          ;
27027/20E9D7 :                          ; LDIRW guard: BC=0 at entry copies 65536 words -- skip if words==0.
27028/20E9D7 :                          ; OR A, C is safe here (ALU instruction; C is not ambiguous as condition code
27029/20E9D7 :                          ; in this context -- ambiguity only occurs in LD (mem), c indirect store form).
27030/20E9D7 :                          
27031/20E9D7 :                          
27032/20E9D7 :                          
27033/20E9D7 :                          
27034/20E9D7 :                          
27035/20E9D7 :                          ; ================================================================
27036/20E9D7 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
27037/20E9D7 :                          ;
27038/20E9D7 :                          ; Block-copies 'words' 16-bit words from src_addr to dst_addr via LDIRW.
27039/20E9D7 :                          ; Equivalent to: while (words--) *(u16*)dst++ = *(u16*)src++;
27040/20E9D7 :                          ; but uses LDIRW hardware block transfer.
27041/20E9D7 :                          ;
27042/20E9D7 :                          ; Call site (ngpc_vramq.c) passes near u16 addresses widened to u32:
27043/20E9D7 :                          ;   ngpc_memcpy_w((u32)dst_u16, (u32)src_u16, (u32)word_count)
27044/20E9D7 :                          ; So upper 16 bits of XDE/XHL are guaranteed 0. LDIRW needs upper=0. OK
27045/20E9D7 :                          ; ================================================================
27046/20E9D7 :                          _ngpc_memcpy_w:
27047/20E9D7 :                                  ; Load XDE = dst_addr (full 32-bit; upper 16 = 0 since near address)
27048/20E9D7 : AF 04 22                         ld      xde, (xsp+4)
27049/20E9DA :                          
27050/20E9DA :                                  ; Load XHL = src_addr (full 32-bit; may be near or far)
27051/20E9DA : AF 08 23                         ld      xhl, (xsp+8)
27052/20E9DD :                          
27053/20E9DD :                                  ; Load BC = words (low 16 of u32; high 16 is 0 since words <= 65535)
27054/20E9DD : 9F 0C 21                         ld      bc, (xsp+12)
27055/20E9E0 :                          
27056/20E9E0 :                                  ; BC=0 guard: if words==0, skip (LDIRW BC=0 copies 65536 words!)
27057/20E9E0 :                                  ; OR A, C: ALU instruction -- C is register, not condition code here.
27058/20E9E0 : CA 89                            ld      a, b
27059/20E9E2 : CB E1                            or      a, c
27060/20E9E4 : 66 02                            jr      z, memcpy_w_done
27061/20E9E6 :                          
27062/20E9E6 : 93 11                            ldirw                       ; block copy: BC words from XHL -> XDE
27063/20E9E8 :                          
27064/20E9E8 :                          memcpy_w_done:
27065/20E9E8 : 0E                               ret
27066/20E9E9 :                          
27067/20E9E9 :                          
27068/20E9E9 :                          ; ---- src/fx/ngpc_dma_prog.asm
27069/20E9E9 :                          
27070/20E9E9 :                          
27071/20E9E9 :                          
27072/20E9E9 :                          ; C prototypes:
27073/20E9E9 :                          ;   void dmaN_program_asm(const u8  __far *src, volatile u8 __far *dst, u16 count);
27074/20E9E9 :                          ;   void dmaN_program_u16_asm(const u16 __far *src, volatile u8 __far *dst, u16 count);
27075/20E9E9 :                          ;   void dmaN_program_u32_asm(const u32 __far *src, volatile u8 __far *dst, u16 count);
27076/20E9E9 :                          ;
27077/20E9E9 :                          ; Notes:
27078/20E9E9 :                          ; - `count` is written to DMACn directly (i.e. number of DMA "steps"/transfers,
27079/20E9E9 :                          ;   not necessarily a byte count when using word/dword modes).
27080/20E9E9 :                          ;
27081/20E9E9 :                          ; Stack layout on entry (TLCS-900/H cc900):
27082/20E9E9 :                          ;   (xsp+0)  return address (far) 4 bytes
27083/20E9E9 :                          ;   (xsp+4)  src (far pointer)   4 bytes
27084/20E9E9 :                          ;   (xsp+8)  dst (far pointer)   4 bytes
27085/20E9E9 :                          ;   (xsp+12) count (u16)         2 bytes
27086/20E9E9 :                          ;
27087/20E9E9 :                          ; DMA modes (see SDK `HDMA.H`; values here are the real hex values).
27088/20E9E9 : =8H                      DMA_MODE_SINC1  equ 8   ; 0x08: byte,  src++
27089/20E9E9 : =9H                      DMA_MODE_SINC2  equ 9   ; 0x09: word,  src++
27090/20E9E9 : =0AH                     DMA_MODE_SINC4  equ 10  ; 0x0A: dword, src++
27091/20E9E9 :                          
27092/20E9E9 :                          _dma0_program_asm:
27093/20E9E9 : AF 04 20                         ld      xwa,(xsp+4)
27094/20E9EC : E8 2E 00                         ldc    dmas0,xwa
27095/20E9EF : AF 08 20                         ld      xwa,(xsp+8)
27096/20E9F2 : E8 2E 10                         ldc    dmad0,xwa
27097/20E9F5 : 9F 0C 20                         ld      wa,(xsp+12)
27098/20E9F8 : D8 2E 20                         ldc    dmac0,wa
27099/20E9FB : 21 08                            ld      a,DMA_MODE_SINC1
27100/20E9FD : C9 2E 22                         ldc    dmam0,a
27101/20EA00 : 0E                               ret
27102/20EA01 :                          
27103/20EA01 :                          _dma0_program_u16_asm:
27104/20EA01 : AF 04 20                         ld      xwa,(xsp+4)
27105/20EA04 : E8 2E 00                         ldc    dmas0,xwa
27106/20EA07 : AF 08 20                         ld      xwa,(xsp+8)
27107/20EA0A : E8 2E 10                         ldc    dmad0,xwa
27108/20EA0D : 9F 0C 20                         ld      wa,(xsp+12)
27109/20EA10 : D8 2E 20                         ldc    dmac0,wa
27110/20EA13 : 21 09                            ld      a,DMA_MODE_SINC2
27111/20EA15 : C9 2E 22                         ldc    dmam0,a
27112/20EA18 : 0E                               ret
27113/20EA19 :                          
27114/20EA19 :                          _dma0_program_u32_asm:
27115/20EA19 : AF 04 20                         ld      xwa,(xsp+4)
27116/20EA1C : E8 2E 00                         ldc    dmas0,xwa
27117/20EA1F : AF 08 20                         ld      xwa,(xsp+8)
27118/20EA22 : E8 2E 10                         ldc    dmad0,xwa
27119/20EA25 : 9F 0C 20                         ld      wa,(xsp+12)
27120/20EA28 : D8 2E 20                         ldc    dmac0,wa
27121/20EA2B : 21 0A                            ld      a,DMA_MODE_SINC4
27122/20EA2D : C9 2E 22                         ldc    dmam0,a
27123/20EA30 : 0E                               ret
27124/20EA31 :                          
27125/20EA31 :                          _dma1_program_asm:
27126/20EA31 : AF 04 20                         ld      xwa,(xsp+4)
27127/20EA34 : E8 2E 04                         ldc    dmas1,xwa
27128/20EA37 : AF 08 20                         ld      xwa,(xsp+8)
27129/20EA3A : E8 2E 14                         ldc    dmad1,xwa
27130/20EA3D : 9F 0C 20                         ld      wa,(xsp+12)
27131/20EA40 : D8 2E 24                         ldc    dmac1,wa
27132/20EA43 : 21 08                            ld      a,DMA_MODE_SINC1
27133/20EA45 : C9 2E 26                         ldc    dmam1,a
27134/20EA48 : 0E                               ret
27135/20EA49 :                          
27136/20EA49 :                          _dma1_program_u16_asm:
27137/20EA49 : AF 04 20                         ld      xwa,(xsp+4)
27138/20EA4C : E8 2E 04                         ldc    dmas1,xwa
27139/20EA4F : AF 08 20                         ld      xwa,(xsp+8)
27140/20EA52 : E8 2E 14                         ldc    dmad1,xwa
27141/20EA55 : 9F 0C 20                         ld      wa,(xsp+12)
27142/20EA58 : D8 2E 24                         ldc    dmac1,wa
27143/20EA5B : 21 09                            ld      a,DMA_MODE_SINC2
