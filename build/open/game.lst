29276/20FC95 :                          ; ================================================================
29277/20FC95 :                          ; void id_road_wide_asm(RoadWide *w);   (SUNSET RUN)
29278/20FC95 :                          ;
29279/20FC95 :                          ; wide_rows() of id_road.c: from the bottom row up, the near rows whose plain
29280/20FC95 :                          ; copy would wrap around the 256 px map take the copy stored VSHIFT px to
29281/20FC95 :                          ; that side instead.  Stops at the first row outside the wide source rows.
29282/20FC95 :                          ;
29283/20FC95 :                          ;   XIX = &xy[scr] (descend de 2)   XIY = id_route_lim0
29284/20FC95 :                          ;   C = scr - plane0 (descend)      B = rows left
29285/20FC95 :                          ;   D = threshold of the negative side (0x90, 0x71 if lateral < 0)
29286/20FC95 :                          ;   E = base_x                      W = lim of the row
29287/20FC95 : =0H                      W_XY     equ 0      ; u16 *    &xy[road_bottom]
29288/20FC95 : =4H                      W_LIM    equ 4      ; const u8 * id_route_lim0
29289/20FC95 : =8H                      W_K      equ 8      ; u8 road_bottom - plane0
29290/20FC95 : =9H                      W_N      equ 9      ; u8 rows (> 0)
29291/20FC95 : =0AH                     W_T      equ 10     ; u8 0x90 / 0x71
29292/20FC95 : =0BH                     W_BX     equ 11     ; u8 base_x
29293/20FC95 : =30H                     WIDE0    equ 48
29294/20FC95 : =58H                     WIDE_END equ 88
29295/20FC95 : =28H                     VROWS    equ 40
29296/20FC95 : =60H                     VSHIFT   equ 96
29297/20FC95 :                          
29298/20FC95 :                          
29299/20FC95 :                          _id_road_wide_asm:
29300/20FC95 : AF 04 20                         ld      xwa,(xsp+0x4)
29301/20FC98 : A0 24                            ld      xix,(xwa+W_XY)
29302/20FC9A : A8 04 25                         ld      xiy,(xwa+W_LIM)
29303/20FC9D : 98 08 21                         ld      bc,(xwa+W_K)            ; C = k, B = n
29304/20FCA0 : 98 0A 22                         ld      de,(xwa+W_T)            ; E = threshold, D = base_x
29305/20FCA3 : CD 89                            ld      a,e
29306/20FCA5 : CC 8D                            ld      e,d
29307/20FCA7 : C9 8C                            ld      d,a                     ; D = threshold, E = base_x
29308/20FCA9 :                          wd_loop:
29309/20FCA9 : 94 23                            ld      hl,(xix)                ; H = y, L = x
29310/20FCAB : CE 89                            ld      a,h
29311/20FCAD : CB 81                            add     a,c                     ; j = y + scr - plane0
29312/20FCAF : C9 CF 30                         cp      a,WIDE0
29313/20FCB2 : 67 3A                            jr      c,wd_out
29314/20FCB4 : C9 CF 58                         cp      a,WIDE_END
29315/20FCB7 : 6F 35                            jr      nc,wd_out
29316/20FCB9 : D8 12                            extz    wa
29317/20FCBB : C3 07 F4 E0 21                   ld      a,(xiy+wa)
29318/20FCC0 : C9 88                            ld      w,a                     ; lim
29319/20FCC2 : CF 89                            ld      a,l
29320/20FCC4 : CD A1                            sub     a,e                     ; d = x - base_x
29321/20FCC6 : CC F1                            cp      a,d
29322/20FCC8 : 6F 0E                            jr      nc,wd_neg
29323/20FCCA : C8 F1                            cp      a,w
29324/20FCCC : 67 18                            jr      c,wd_next
29325/20FCCE : CE C8 28                         add     h,VROWS
29326/20FCD1 : CF CA 60                         sub     l,VSHIFT
29327/20FCD4 : B4 53                            ld      (xix),hl
29328/20FCD6 : 68 0E                            jr      wd_next
29329/20FCD8 :                          wd_neg:
29330/20FCD8 : C9 07                            neg     a                       ; |dx|
29331/20FCDA : C8 F1                            cp      a,w
29332/20FCDC : 67 08                            jr      c,wd_next
29333/20FCDE : CE C8 50                         add     h,2*VROWS
29334/20FCE1 : CF C8 60                         add     l,VSHIFT
29335/20FCE4 : B4 53                            ld      (xix),hl
29336/20FCE6 :                          wd_next:
29337/20FCE6 : EC 6A                            dec     0x2,xix
29338/20FCE8 : CB 69                            dec     0x1,c
29339/20FCEA : CA 69                            dec     0x1,b
29340/20FCEC : 6E BB                            jr      nz,wd_loop
29341/20FCEE :                          wd_out:
29342/20FCEE : 0E                               ret
