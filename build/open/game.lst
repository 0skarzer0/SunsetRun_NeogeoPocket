28188/20F455 : E8 2E 10                         ldc    dmad0,xwa
28189/20F458 : 9F 0C 20                         ld      wa,(xsp+12)
28190/20F45B : D8 2E 20                         ldc    dmac0,wa
28191/20F45E : 21 08                            ld      a,DMA_MODE_SINC1
28192/20F460 : C9 2E 22                         ldc    dmam0,a
28193/20F463 : 0E                               ret
