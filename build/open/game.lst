29344/20FCEF :                          ; ---- src/spr_cells_asm.asm
29345/20FCEF :                          ; spr_cells_asm.asm - write a list of 8x8 sprite cells to the K2GE sprite table
29346/20FCEF :                          ;
29347/20FCEF :                          ; SUNSET RUN.  The car, the traffic and the roadside objects are all drawn as
29348/20FCEF :                          ; lists of {cx, cy, ch} cells; this loop replaces three copies of the same C
29349/20FCEF :                          ; loop (the hottest code of a frame).  asm900 syntax, also assembled by the
29350/20FCEF :                          ; open toolchain.
29351/20FCEF :                          ;
29352/20FCEF :                          ; void spr_cells_asm(SprJob *j);
29353/20FCEF :                          ;   (xsp+0) return address, (xsp+4) j.  Preserves XIZ (cc900 convention).
29354/20FCEF :                          ;
29355/20FCEF :                          
29356/20FCEF : =0H                      J_CELLS  equ 0      ; const u8 *   cells, 3 bytes each: cx, cy, ch
29357/20FCEF : =4H                      J_MAP    equ 4      ; const u16 *  tile per ch (when J_HASMAP != 0)
29358/20FCEF : =8H                      J_BASE   equ 8      ; u16          tile = base + ch (when J_HASMAP == 0)
29359/20FCEF : =0AH                     J_X      equ 10     ; s16          left edge of the cell grid
29360/20FCEF : =0CH                     J_Y      equ 12     ; u8           top of the cell grid
29361/20FCEF : =0DH                     J_N      equ 13     ; u8           number of cells
29362/20FCEF : =0EH                     J_WM1    equ 14     ; u8           grid width - 1 (mirroring)
29363/20FCEF : =0FH                     J_ATTR   equ 15     ; u8           flip bits | priority bits
29364/20FCEF : =10H                     J_PAL    equ 16     ; u8           palette
29365/20FCEF : =11H                     J_SPR    equ 17     ; u8           next free sprite (in/out)
29366/20FCEF : =12H                     J_END    equ 18     ; u8           first sprite NOT to use
29367/20FCEF : =13H                     J_FLIP   equ 19     ; u8           != 0 : mirror the cell columns
29368/20FCEF : =14H                     J_HASMAP equ 20     ; u8
29369/20FCEF :                          
29370/20FCEF :                          
29371/20FCEF :                          
29372/20FCEF :                          
29373/20FCEF :                          _spr_cells_asm:
29374/20FCEF : 3E                               push    xiz
29375/20FCF0 : AF 08 26                         ld      xiz,(xsp+0x8)
29376/20FCF3 : A6 24                            ld      xix,(xiz+J_CELLS)
29377/20FCF5 : 8E 11 23                         ld      c,(xiz+J_SPR)
29378/20FCF8 : 8E 0D 22                         ld      b,(xiz+J_N)
29379/20FCFB : CA D8                            cp      b,0x0
29380/20FCFD : F2 8A FD 20 D6                   jp      z,sc_done
29381/20FD02 :                          sc_loop:
29382/20FD02 : 8E 12 F3                         cp      c,(xiz+J_END)
29383/20FD05 : F2 8A FD 20 DF                   jp      nc,sc_done
29384/20FD0A : 84 21                            ld      a,(xix)                 ; cx
29385/20FD0C : 8E 13 3F 00                      cpb     (xiz+J_FLIP),0x0
29386/20FD10 : 66 07                            jr      z,sc_noflip
29387/20FD12 : C9 8D                            ld      e,a
29388/20FD14 : 8E 0E 21                         ld      a,(xiz+J_WM1)
29389/20FD17 : CD A1                            sub     a,e
29390/20FD19 :                          sc_noflip:
29391/20FD19 : D8 12                            extz    wa
29392/20FD1B : D8 EE 03                         sll     0x3,wa
29393/20FD1E : 9E 0A 80                         add     wa,(xiz+J_X)            ; sx
29394/20FD21 : D8 8A                            ld      de,wa
29395/20FD23 : DA C8 08 00                      add     de,0x8
29396/20FD27 : DA CF B0 00                      cp      de,0xb0                 ; -8 <= sx <= 167
29397/20FD2B : 6F 54                            jr      nc,sc_next
29398/20FD2D :                                  ; HL = 0x8800 + spr * 4
29399/20FD2D : CB 8F                            ld      l,c
29400/20FD2F : DB 12                            extz    hl
29401/20FD31 : DB EE 02                         sll     0x2,hl
29402/20FD34 : DB C8 92 46                      add     hl,_spr_shadow          ; RAM copy, sent to 0x8800 in VBlank
29403/20FD38 : EB 12                            extz    xhl
29404/20FD3A : BB 02 41                         ld      (xhl+0x2),a             ; x (low byte of sx)
29405/20FD3D : 8C 01 21                         ld      a,(xix+0x1)             ; cy * 8 + y
29406/20FD40 : C9 EE 03                         sll     0x3,a
29407/20FD43 : 8E 0C 81                         add     a,(xiz+J_Y)
29408/20FD46 : BB 03 41                         ld      (xhl+0x3),a
29409/20FD49 : 8C 02 25                         ld      e,(xix+0x2)             ; ch
29410/20FD4C : DA 12                            extz    de
29411/20FD4E : 8E 14 3F 00                      cpb     (xiz+J_HASMAP),0x0
29412/20FD52 : 66 0C                            jr      z,sc_base
29413/20FD54 : DA 82                            add     de,de
29414/20FD56 : AE 04 25                         ld      xiy,(xiz+J_MAP)
29415/20FD59 : D3 07 F4 E8 22                   ld      de,(xiy+de)
29416/20FD5E : 68 03                            jr      sc_tile
29417/20FD60 :                          sc_base:
29418/20FD60 : 9E 08 82                         add     de,(xiz+J_BASE)
29419/20FD63 :                          sc_tile:
29420/20FD63 : B3 45                            ld      (xhl),e                 ; tile, low 8 bits
29421/20FD65 : CC 89                            ld      a,d
29422/20FD67 : C9 CC 01                         and     a,0x1
29423/20FD6A : 8E 0F E1                         or      a,(xiz+J_ATTR)
29424/20FD6D : BB 01 41                         ld      (xhl+0x1),a
29425/20FD70 :                                  ; palette: 0x8C00 + spr
29426/20FD70 : CB 8F                            ld      l,c
29427/20FD72 : DB 12                            extz    hl
29428/20FD74 : DB C8 92 47                      add     hl,_spr_pal_shadow      ; RAM copy of 0x8C00
29429/20FD78 : EB 12                            extz    xhl
29430/20FD7A : 8E 10 21                         ld      a,(xiz+J_PAL)
29431/20FD7D : B3 41                            ld      (xhl),a
29432/20FD7F : CB 61                            inc     0x1,c
29433/20FD81 :                          sc_next:
29434/20FD81 : EC 63                            inc     0x3,xix
29435/20FD83 : CA 69                            dec     0x1,b
29436/20FD85 : F2 02 FD 20 DE                   jp      nz,sc_loop
29437/20FD8A :                          sc_done:
29438/20FD8A : BE 11 43                         ld      (xiz+J_SPR),c
29439/20FD8D : 5E                               pop     xiz
29440/20FD8E : 0E                               ret
