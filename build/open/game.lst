27698/20EE11 : 9E 1A A8                         sub     (xiz+A_W),wa            ;  `sub wa,(xiy)` n'en etait pas une)
27699/20EE14 : 8E 1D 21                         ld      a,(xiz+A_CUR)           ; le voisin SANS modulo
27700/20EE17 : C9 61                            inc     0x1,a
27701/20EE19 : 8E 1E F1                         cp      a,(xiz+A_LEN)
