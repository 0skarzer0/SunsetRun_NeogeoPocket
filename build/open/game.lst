28309/20F3CC : D8 CF 80 00                      cp      wa,0x80
28310/20F3D0 : F2 38 F4 20 DF                   jp       uge,ah_prev             ; pas (rem < BEND_HALF)
28311/20F3D5 : D8 07                            neg     wa                      ; w = BEND_HALF - rem
28312/20F3D7 : D8 C8 80 00                      add     wa,0x80
28313/20F3DB : 3A                               push    xde
28314/20F3DC : D8 8A                            ld      de,wa                   ; DE = w pendant le fondu
28315/20F3DE : 8E 1D 21                         ld      a,(xiz+A_CUR)
28316/20F3E1 : 8E 21 F1                         cp      a,(xiz+A_NKEY)
28317/20F3E4 : F2 24 F4 20 D6                   jp       eq,ah_nhit
28318/20F3E9 :                                  ; ---- les ecarts vers le SUIVANT, une fois par segment
28319/20F3E9 : BE 21 41                         ld      (xiz+A_NKEY),a
28320/20F3EC : C9 61                            inc     0x1,a                   ; other = cursor + 1, sans modulo
28321/20F3EE : 8E 1E F1                         cp      a,(xiz+A_LEN)
28322/20F3F1 : F2 F8 F3 20 D7                   jp       ult,ah_nseg
28323/20F3F6 : C9 A8                            ld      a,0x0
28324/20F3F8 :                          ah_nseg:
28325/20F3F8 : D8 12                            extz    wa
28326/20F3FA : D8 09 06 00                      muls    xwa,0x6
28327/20F3FE : 3D                               push    xiy
28328/20F3FF : AE 0C 25                         ld      xiy,(xiz+A_SEG)
28329/20F402 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa); XIY = sn
28330/20F407 : 9D 02 20                         ld      wa,(xiy+0x2)
28331/20F40A : BE 24 50                         ld      (xiz+A_NDB),wa
28332/20F40D : 8D 04 21                         ld      a,(xiy+0x4)
28333/20F410 : D8 13                            exts    wa
28334/20F412 : BE 26 50                         ld      (xiz+A_NDP),wa
28335/20F415 : 5D                               pop     xiy                     ; XIY = sc
28336/20F416 : 9D 02 20                         ld      wa,(xiy+0x2)
28337/20F419 : 9E 24 A8                         sub     (xiz+A_NDB),wa          ; (s16)(sn->bend - b)
28338/20F41C : 8D 04 21                         ld      a,(xiy+0x4)
28339/20F41F : D8 13                            exts    wa
28340/20F421 : 9E 26 A8                         sub     (xiz+A_NDP),wa          ; (s16)sn->slope - p
28341/20F424 :                          _id_road_ahead_asm__L5:
28342/20F424 :                          ah_nhit:
28343/20F424 :                                  ; road_bend[k] = b + (s16)(((s16)(sn->bend - b) * (s16)w) >> 8)
28344/20F424 : 9E 24 20                         ld      wa,(xiz+A_NDB)
28345/20F427 : DA 48                            muls    xwa,de
28346/20F429 : D8 ED 08                         sra     0x8,wa
28347/20F42C : 9D 02 80                         add     wa,(xiy+0x2)
28348/20F42F : B3 50                            ld      (xhl),wa
28349/20F431 : 9E 26 20                         ld      wa,(xiz+A_NDP)
28350/20F434 : 1B A2 F4 20                      jp       ah_blend_slope
28351/20F438 :                          
28352/20F438 :                          _id_road_ahead_asm__L6:
28353/20F438 :                          ah_prev:
28354/20F438 : DA CF 80 00                      cp      de,0x80
28355/20F43C : F2 BB F4 20 DF                   jp       uge,ah_flat             ; loin des deux joints : le cas courant
28356/20F441 : DA 88                            ld      wa,de                   ; w = BEND_HALF - into
28357/20F443 : D8 07                            neg     wa
28358/20F445 : D8 C8 80 00                      add     wa,0x80
28359/20F449 : 3A                               push    xde
28360/20F44A : D8 8A                            ld      de,wa                   ; DE = w pendant le fondu
28361/20F44C : 8E 1D 21                         ld      a,(xiz+A_CUR)
28362/20F44F : 8E 22 F1                         cp      a,(xiz+A_PKEY)
28363/20F452 : F2 92 F4 20 D6                   jp       eq,ah_phit
28364/20F457 :                                  ; ---- les ecarts vers le PRECEDENT, une fois par segment
28365/20F457 : BE 22 41                         ld      (xiz+A_PKEY),a
28366/20F45A : C9 D8                            cp      a,0x0                   ; other = cursor ? cursor - 1 : len - 1
28367/20F45C : F2 64 F4 20 DE                   jp       ne,ah_prev_dec
28368/20F461 : 8E 1E 21                         ld      a,(xiz+A_LEN)
28369/20F464 :                          ah_prev_dec:
28370/20F464 : C9 69                            dec     0x1,a
28371/20F466 : D8 12                            extz    wa
28372/20F468 : D8 09 06 00                      muls    xwa,0x6
28373/20F46C : 3D                               push    xiy
28374/20F46D : AE 0C 25                         ld      xiy,(xiz+A_SEG)
28375/20F470 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa); XIY = sn
28376/20F475 : 9D 02 20                         ld      wa,(xiy+0x2)
28377/20F478 : BE 28 50                         ld      (xiz+A_PDB),wa
28378/20F47B : 8D 04 21                         ld      a,(xiy+0x4)
28379/20F47E : D8 13                            exts    wa
28380/20F480 : BE 2A 50                         ld      (xiz+A_PDP),wa
28381/20F483 : 5D                               pop     xiy                     ; XIY = sc
28382/20F484 : 9D 02 20                         ld      wa,(xiy+0x2)
28383/20F487 : 9E 28 A8                         sub     (xiz+A_PDB),wa
28384/20F48A : 8D 04 21                         ld      a,(xiy+0x4)
28385/20F48D : D8 13                            exts    wa
28386/20F48F : 9E 2A A8                         sub     (xiz+A_PDP),wa
28387/20F492 :                          _id_road_ahead_asm__L7:
28388/20F492 :                          ah_phit:
28389/20F492 : 9E 28 20                         ld      wa,(xiz+A_PDB)
28390/20F495 : DA 48                            muls    xwa,de
28391/20F497 : D8 ED 08                         sra     0x8,wa
28392/20F49A : 9D 02 80                         add     wa,(xiy+0x2)
28393/20F49D : B3 50                            ld      (xhl),wa
28394/20F49F : 9E 2A 20                         ld      wa,(xiz+A_PDP)
28395/20F4A2 :                          ah_blend_slope:
28396/20F4A2 :                                  ; sl = (s8)(p + (s16)(((s16)(sn->slope - p) * (s16)w) >> 8))
28397/20F4A2 : D8 D8                            cp      wa,0x0
28398/20F4A4 : F2 B6 F4 20 D6                   jp       eq,ah_blend_flat        ; meme pente des deux cotes : sl = p
28399/20F4A9 : DA 48                            muls    xwa,de
28400/20F4AB : D8 ED 08                         sra     0x8,wa
28401/20F4AE : 8D 04 81                         add     a,(xiy+0x4)             ; (s8) : l'octet bas de la somme suffit
28402/20F4B1 : 5A                               pop     xde
28403/20F4B2 : 1B FE F4 20                      jp       ah_clamp
28404/20F4B6 :                          ah_blend_flat:
28405/20F4B6 : 5A                               pop     xde
28406/20F4B7 : 1B C0 F4 20                      jp       ah_grade_flat
28407/20F4BB :                          
28408/20F4BB :                          _id_road_ahead_asm__L8:
28409/20F4BB :                          ah_flat:
28410/20F4BB : 9D 02 20                         ld      wa,(xiy+0x2)            ; road_bend[k] = b
28411/20F4BE : B3 50                            ld      (xhl),wa
28412/20F4C0 :                          ah_grade_flat:
