27561/20F01D :                          ; ---- src/core/ngpc_flash_asm.asm
27562/20F01D :                          
27563/20F01D :                          ;
27564/20F01D :                          ; ngpc_flash_asm.asm - Flash erase/write primitives for ngpc_flash.c
27565/20F01D :                          ;
27566/20F01D :                          ; Part of NgpCraft_base_template (MIT License)
27567/20F01D :                          ;
27568/20F01D :                          ; Two entry points, both called ONLY by ngpc_flash.c (never from an ISR):
27569/20F01D :                          ;
27570/20F01D :                          ;   _ngpc_flash_erase_asm(u32 abs_block)
27571/20F01D :                          ;       Erases one 8 KB block with the AMD erase stub extracted from StarGunner
27572/20F01D :                          ;       (hardware-validated), copied to RAM 0x6E00 and run from there.
27573/20F01D :                          ;       VECT_FLASHERS cannot erase blocks 32/33/34 (SysCall.txt p.299), so the
27574/20F01D :                          ;       erase keeps the stub.
27575/20F01D :                          ;
27576/20F01D :                          ;   _ngpc_flash_write_bios(const void *src, u32 offset, u32 pages)
27577/20F01D :                          ;       Programs pages x 256 bytes through the BIOS (VECT_FLASHWRITE, swi 1),
27578/20F01D :                          ;       the path StarGunner uses on hardware. The watchdog is refreshed right
27579/20F01D :                          ;       before and right after, as in the SDK save pattern.
27580/20F01D :                          ;
27581/20F01D :                          ; THE BLOCK IS A PARAMETER, NOT A CONSTANT. The save block sits 0x6000 below
27582/20F01D :                          ; the top of the chip, so its address depends on the cartridge size:
27583/20F01D :                          ; 0x27A000 on 4 Mbit, 0x2FA000 on 8 Mbit, 0x3FA000 on 16 Mbit. A hard-coded
27584/20F01D :                          ; 0x3FA000 erases 8 KB ELSEWHERE on a smaller chip - possibly the game code.
27585/20F01D :                          ; ngpc_flash.c reads the size the BIOS stores at 0x6C58 and refuses unknown ones.
27586/20F01D :                          ;
27587/20F01D :                          ; cc900 ABI (CALL pushes 4-byte XPC as return address):
27588/20F01D :                          ;   (xsp+0)..(xsp+3)  = return address
27589/20F01D :                          ;   (xsp+4)..(xsp+7)  = 1st parameter
27590/20F01D :                          ;   (xsp+8)..(xsp+11) = 2nd parameter
27591/20F01D :                          ;   (xsp+12)..(xsp+15)= 3rd parameter
27592/20F01D :                          ;
27593/20F01D :                          ; ===========================================================================
27594/20F01D :                          ; INTERRUPTS ARE PROHIBITED FOR THE WHOLE SEQUENCE. On hardware that is not
27595/20F01D :                          ; optional. A flash chip being programmed or erased answers reads with STATUS,
27596/20F01D :                          ; not with its contents. The stub runs from RAM for that reason, but the
27597/20F01D :                          ; interrupt handlers are still in the cartridge: an interrupt taken while the
27598/20F01D :                          ; chip is busy fetches its handler from status bits. A game taking VBlank at
27599/20F01D :                          ; 60 Hz cannot get through a 256-byte program or an 8 KB erase without one.
27600/20F01D :                          ;
27601/20F01D :                          ; AN EMULATOR WHOSE FLASH KEEPS SERVING ROM DURING THE WRITE NEVER SHOWS THIS.
27602/20F01D :                          ; Toshiba: "all interrupts are prohibited during system calls related to flash
27603/20F01D :                          ; memory management" (SysCall.txt). Hence `di` (encoded 06 07 = EI 7) on entry
27604/20F01D :                          ; and `ei 0` (06 00) on exit: level 0 is what ngpc_init() runs the game at.
27605/20F01D :                          ; ===========================================================================
27606/20F01D :                          
27607/20F01D :                          
27608/20F01D :                          
27609/20F01D : =6E00H                   FLASH_RAM       equ     0x6E00          ; RAM address for stub execution
27610/20F01D : =6EH                     FLASH_BUS_CTRL  equ     0x6E            ; I/O: flash /WE enable (0x14=on, 0xF0=off)
27611/20F01D : =6FH                     FLASH_WD        equ     0x6F            ; I/O: watchdog  (0xB1=extended, 0x4E=refresh)
27612/20F01D : =200000H                 CART_BASE       equ     0x200000        ; CS0 base address
27613/20F01D :                          
27614/20F01D :                          
27615/20F01D :                          
27616/20F01D :                          ; ===========================================================================
27617/20F01D :                          ; _ngpc_flash_erase_asm
27618/20F01D :                          ;   param 1 (xsp+4) : u32 abs_block -- ABSOLUTE address of the 8 KB block
27619/20F01D :                          ; C prototype: void ngpc_flash_erase_asm(u32 abs_block);
27620/20F01D :                          ; ===========================================================================
27621/20F01D :                          _ngpc_flash_erase_asm:
27622/20F01D :                          
27623/20F01D : 06 07                            di                              ; see the note at the top of the file
27624/20F01F : 08 6E 14                         ld      (FLASH_BUS_CTRL),0x14   ; enable /WE on cart bus
27625/20F022 : 08 6F B1                         ld      (FLASH_WD),0xB1         ; watchdog: extended mode
27626/20F025 :                          
27627/20F025 :                                  ; Copy erase stub (98 bytes) from ROM to RAM at FLASH_RAM
27628/20F025 : 39                               push    xbc                     ; preserve XBC across copy
27629/20F026 : 42 00 6E 00 00                   ld      xde,FLASH_RAM           ; destination: RAM
27630/20F02B : 43 72 F0 20 00                   ld      xhl,_erase_stub         ; source: stub bytes in ROM
27631/20F030 : 31 62 00                         ld      bc,0x62                 ; BC = 98 bytes
27632/20F033 : 83 11                            db      0x83,0x11               ; ldir (xde+),(xhl+) -- copy BC bytes
27633/20F035 : 59                               pop     xbc                     ; restore XBC (stack back to entry)
27634/20F036 :                          
27635/20F036 :                                  ; Set up registers for stub call
27636/20F036 : 44 00 00 20 00                   ld      xix,CART_BASE           ; XIX = 0x200000 (AMD unlock base)
27637/20F03B : ED A8                            ld      xiy,0x0                 ; XIY = 0 (erase stub uses as delay counter)
27638/20F03D : C9 A8                            ld      a,0x0                   ; A = 0 (erase stub state init)
27639/20F03F : AF 04 22                         ld      xde,(xsp+4)             ; XDE = block, given by the caller
27640/20F042 :                          
27641/20F042 : 1C 00 6E                         call    FLASH_RAM               ; execute stub from RAM
27642/20F045 :                          
27643/20F045 : 08 6E F0                         ld      (FLASH_BUS_CTRL),0xF0   ; restore watchdog mode first
27644/20F048 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; then refresh the enabled watchdog
27645/20F04B : 06 00                            ei      0                       ; the chip answers as memory again
27646/20F04D : 0E                               ret
27647/20F04E :                          
27648/20F04E :                          
27649/20F04E :                          ; ===========================================================================
27650/20F04E :                          ; _ngpc_flash_write_bios
27651/20F04E :                          ;   param 1 (xsp+4)  : const void *src -- source buffer, in RAM
27652/20F04E :                          ;   param 2 (xsp+8)  : u32 offset      -- offset INSIDE the cartridge
27653/20F04E :                          ;                                         (e.g. 0x1FA000 + slot*SAVE_SIZE),
27654/20F04E :                          ;                                         not the absolute address: XDE3 wants
27655/20F04E :                          ;                                         the offset.
27656/20F04E :                          ;   param 3 (xsp+12) : u32 pages       -- number of 256-byte units
27657/20F04E :                          ; C prototype: void ngpc_flash_write_bios(const void *src, u32 offset, u32 pages);
27658/20F04E :                          ;
27659/20F04E :                          ; The BIOS holds the bus itself (no manual 0x6E write). The AMD write stub used
27660/20F04E :                          ; before disabled the watchdog and wrote its refresh code while it was off.
27661/20F04E :                          ; ===========================================================================
27662/20F04E :                          _ngpc_flash_write_bios:
27663/20F04E :                          
27664/20F04E : 06 07                            di                              ; see the note at the top of the file
27665/20F050 : AF 04 23                         ld      xhl,(xsp+4)             ; 1st param: source
27666/20F053 : AF 08 22                         ld      xde,(xsp+8)             ; 2nd param: cartridge offset
27667/20F056 : AF 0C 21                         ld      xbc,(xsp+12)            ; 3rd param: 256-byte pages
27668/20F059 : E7 3C 9B                         ld      xhl3,xhl                ; bank 3: the BIOS reads its arguments there
27669/20F05C : E7 38 9A                         ld      xde3,xde
27670/20F05F : E7 34 99                         ld      xbc3,xbc
27671/20F062 : C7 30 A8                         ld      ra3,0                   ; CS0
27672/20F065 : C7 31 AE                         ld      rw3,0x0006              ; VECT_FLASHWRITE
27673/20F068 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; watchdog refreshed RIGHT BEFORE
27674/20F06B : F9                               swi     1
27675/20F06C : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; and right after
27676/20F06F : 06 00                            ei      0
27677/20F071 : 0E                               ret
27678/20F072 :                          
27679/20F072 :                          
27680/20F072 :                          ; ===========================================================================
27681/20F072 :                          ; Erase stub, extracted from StarGunner/bin/main.ngp (hardware-validated).
27682/20F072 :                          ; 98 bytes, file offset 0x13733. Position-independent, uses XIX for AMD cycles.
27683/20F072 :                          ;   AMD unlock -> reset -> unlock -> erase setup (0x80) -> unlock -> sector
27684/20F072 :                          ;   erase (0x30) -> poll DQ7 -> final reset/unlock -> ret
27685/20F072 :                          ;   Register interface: XIX=cart_base XDE=block_addr XIY=0 A=0
27686/20F072 :                          ; ===========================================================================
27687/20F072 :                          
27688/20F072 :                          _erase_stub:
27689/20F072 : F3 F1 55 55 00 AA F3 F1          db      0xF3,0xF1,0x55,0x55,0x00,0xAA, 0xF3,0xF1,0xAA,0x2A,0x00,0x55
      20F07A : AA 2A 00 55            
27690/20F07E : F3 F1 55 55 00 F0 00 00          db      0xF3,0xF1,0x55,0x55,0x00,0xF0, 0x00,0x00,0xF3,0xF1,0x55,0x55
      20F086 : F3 F1 55 55            
27691/20F08A : 00 AA F3 F1 AA 2A 00 55          db      0x00,0xAA,0xF3,0xF1,0xAA,0x2A, 0x00,0x55,0xF3,0xF1,0x55,0x55
      20F092 : F3 F1 55 55            
27692/20F096 : 00 80 F3 F1 55 55 00 AA          db      0x00,0x80,0xF3,0xF1,0x55,0x55, 0x00,0xAA,0xF3,0xF1,0xAA,0x2A
      20F09E : F3 F1 AA 2A            
27693/20F0A2 : 00 55 B2 00 30 82 3F FF          db      0x00,0x55,0xB2,0x00,0x30,0x82, 0x3F,0xFF,0x66,0x15,0xED,0x61
      20F0AA : 66 15 ED 61            
27694/20F0AE : ED CF FF FF 1F 00 66 09          db      0xED,0xCF,0xFF,0xFF,0x1F,0x00, 0x66,0x09,0xB2,0xCD,0x66,0xED
      20F0B6 : B2 CD 66 ED            
27695/20F0BA : 82 3F FF 66 02 21 FF F3          db      0x82,0x3F,0xFF,0x66,0x02,0x21, 0xFF,0xF3,0xF1,0x55,0x55,0x00
      20F0C2 : F1 55 55 00            
27696/20F0C6 : AA F3 F1 AA 2A 00 55 F3          db      0xAA,0xF3,0xF1,0xAA,0x2A,0x00, 0x55,0xF3,0xF1,0x55,0x55,0x00
      20F0CE : F1 55 55 00            
27697/20F0D2 : F0 0E                            db      0xF0,0x0E
27698/20F0D4 :                          
27699/20F0D4 :                          ; ---- src/core/ngpc_syspatch.asm
27700/20F0D4 :                          
27701/20F0D4 :                          ;
27702/20F0D4 :                          ; ngpc_syspatch.asm - Power-off bug patch (SYS_PATCH equivalent)
27703/20F0D4 :                          ;
27704/20F0D4 :                          ; Part of NgpCraft_base_template (MIT License)
27705/20F0D4 :                          ;
27706/20F0D4 :                          ; Reverse-engineered from system.lib (SNK Corporation, 1998).
27707/20F0D4 :                          ;
27708/20F0D4 :                          ; The original SYS_PATCH routine fixes a bug in the initial production
27709/20F0D4 :                          ; NEOGEO POCKET system program: rapid removal/reinsertion of batteries
27710/20F0D4 :                          ; could prevent the power button from shutting down the console.
27711/20F0D4 :                          ;
27712/20F0D4 :                          ; Condition : OS_Version (0x6F91) == 0x00  [prototype firmware only]
27713/20F0D4 :                          ; Effect    : res 3, (0x6F83)              [clear undocumented sys flag]
27714/20F0D4 :                          ;             ldb (0x6DA0), 0x00           [clear undocumented power flag]
27715/20F0D4 :                          ;
27716/20F0D4 :                          ; On all retail hardware (OS_Version >= 0x01) this is a safe no-op.
27717/20F0D4 :                          ; Must be called once at startup, before enabling interrupts.
27718/20F0D4 :                          ;
27719/20F0D4 :                          ; Reference: MANSysPro.txt "SYS_PATCH", SysLib.txt p.6
27720/20F0D4 :                          ;
27721/20F0D4 :                          
27722/20F0D4 :                          
27723/20F0D4 :                          
27724/20F0D4 :                          
27725/20F0D4 :                          _ngpc_sys_patch:
27726/20F0D4 :                          
27727/20F0D4 :                                  ; cp (0x6F91), 0x00  [C1 91 6F 3F 00]
27728/20F0D4 :                                  ; Compare OS_Version with 0. Z=1 if prototype firmware.
27729/20F0D4 : C1 91 6F 3F 00                   db 0xC1, 0x91, 0x6F, 0x3F, 0x00
27730/20F0D9 :                          
27731/20F0D9 :                                  ; jr NZ, +9  [6E 09]
27732/20F0D9 :                                  ; Retail hardware (OS_Version != 0): skip patch, fall through to ret.
27733/20F0D9 : 6E 09                            db 0x6E, 0x09
27734/20F0DB :                          
27735/20F0DB :                                  ; res 3, (0x6F83)  [F1 83 6F B3]
27736/20F0DB :                                  ; Clear bit 3 of undocumented system flag (between Sys_Lever and User_Boot).
27737/20F0DB : F1 83 6F B3                      db 0xF1, 0x83, 0x6F, 0xB3
27738/20F0DF :                          
27739/20F0DF :                                  ; ldb (0x6DA0), 0x00  [F1 A0 6D 00 00]
27740/20F0DF :                                  ; Clear undocumented power state register in system RAM.
27741/20F0DF : F1 A0 6D 00 00                   db 0xF1, 0xA0, 0x6D, 0x00, 0x00
27742/20F0E4 :                          
27743/20F0E4 : 0E                               ret
27744/20F0E5 :                          
27745/20F0E5 :                          
27746/20F0E5 :                          ; ---- src/core/ngpc_vramq_asm.asm
27747/20F0E5 :                          ; ngpc_vramq_asm.asm - VRAM queue ASM helpers (TLCS-900/H)
27748/20F0E5 :                          ;
27749/20F0E5 :                          ; Part of NgpCraft_base_template (MIT License)
27750/20F0E5 :                          ;
27751/20F0E5 :                          ; Provides ngpc_memcpy_w() -- word-level block copy via LDIRW.
27752/20F0E5 :                          ; Used by ngpc_vramq.c CMD_COPY path instead of a byte-by-byte C loop.
27753/20F0E5 :                          ; dst is a near VRAM address (0x8000-0xBFFF). src can be near RAM or far ROM.
27754/20F0E5 :                          ;
27755/20F0E5 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
27756/20F0E5 :                          ;
27757/20F0E5 :                          ; cc900 calling convention -- args passed as u32 (4 bytes each, unambiguous):
27758/20F0E5 :                          ;   (xsp+0)  return address (far)   4 bytes
27759/20F0E5 :                          ;   (xsp+4)  dst_addr (u32)         4 bytes  <- near VRAM address (high 16 = 0)
27760/20F0E5 :                          ;   (xsp+8)  src_addr (u32)         4 bytes  <- RAM/ROM address (near or far)
27761/20F0E5 :                          ;   (xsp+12) words (u32)            4 bytes  <- word count (high 16 = 0)
27762/20F0E5 :                          ;
27763/20F0E5 :                          ; Using u32 args avoids ambiguity: cc900 may pad u16 args to 4 bytes on stack.
27764/20F0E5 :                          ; u32 args are always exactly 4 bytes, matching LD XRR, (xsp+N) reads.
27765/20F0E5 :                          ;
27766/20F0E5 :                          ; LDIRW guard: BC=0 at entry copies 65536 words -- skip if words==0.
27767/20F0E5 :                          ; OR A, C is safe here (ALU instruction; C is not ambiguous as condition code
27768/20F0E5 :                          ; in this context -- ambiguity only occurs in LD (mem), c indirect store form).
27769/20F0E5 :                          
27770/20F0E5 :                          
27771/20F0E5 :                          
27772/20F0E5 :                          
27773/20F0E5 :                          
27774/20F0E5 :                          ; ================================================================
27775/20F0E5 :                          ; void ngpc_memcpy_w(u32 dst_addr, u32 src_addr, u32 words)
27776/20F0E5 :                          ;
27777/20F0E5 :                          ; Block-copies 'words' 16-bit words from src_addr to dst_addr via LDIRW.
27778/20F0E5 :                          ; Equivalent to: while (words--) *(u16*)dst++ = *(u16*)src++;
27779/20F0E5 :                          ; but uses LDIRW hardware block transfer.
27780/20F0E5 :                          ;
27781/20F0E5 :                          ; Call site (ngpc_vramq.c) passes near u16 addresses widened to u32:
27782/20F0E5 :                          ;   ngpc_memcpy_w((u32)dst_u16, (u32)src_u16, (u32)word_count)
27783/20F0E5 :                          ; So upper 16 bits of XDE/XHL are guaranteed 0. LDIRW needs upper=0. OK
27784/20F0E5 :                          ; ================================================================
27785/20F0E5 :                          _ngpc_memcpy_w:
27786/20F0E5 :                                  ; Load XDE = dst_addr (full 32-bit; upper 16 = 0 since near address)
27787/20F0E5 : AF 04 22                         ld      xde, (xsp+4)
27788/20F0E8 :                          
27789/20F0E8 :                                  ; Load XHL = src_addr (full 32-bit; may be near or far)
27790/20F0E8 : AF 08 23                         ld      xhl, (xsp+8)
27791/20F0EB :                          
27792/20F0EB :                                  ; Load BC = words (low 16 of u32; high 16 is 0 since words <= 65535)
27793/20F0EB : 9F 0C 21                         ld      bc, (xsp+12)
27794/20F0EE :                          
27795/20F0EE :                                  ; BC=0 guard: if words==0, skip (LDIRW BC=0 copies 65536 words!)
27796/20F0EE :                                  ; OR A, C: ALU instruction -- C is register, not condition code here.
27797/20F0EE : CA 89                            ld      a, b
27798/20F0F0 : CB E1                            or      a, c
27799/20F0F2 : 66 02                            jr      z, memcpy_w_done
27800/20F0F4 :                          
27801/20F0F4 : 93 11                            ldirw                       ; block copy: BC words from XHL -> XDE
27802/20F0F6 :                          
27803/20F0F6 :                          memcpy_w_done:
27804/20F0F6 : 0E                               ret
27805/20F0F7 :                          
27806/20F0F7 :                          
27807/20F0F7 :                          ; ---- src/fx/ngpc_dma_prog.asm
27808/20F0F7 :                          
27809/20F0F7 :                          
27810/20F0F7 :                          
27811/20F0F7 :                          ; C prototypes:
27812/20F0F7 :                          ;   void dmaN_program_asm(const u8  __far *src, volatile u8 __far *dst, u16 count);
27813/20F0F7 :                          ;   void dmaN_program_u16_asm(const u16 __far *src, volatile u8 __far *dst, u16 count);
27814/20F0F7 :                          ;   void dmaN_program_u32_asm(const u32 __far *src, volatile u8 __far *dst, u16 count);
27815/20F0F7 :                          ;
27816/20F0F7 :                          ; Notes:
27817/20F0F7 :                          ; - `count` is written to DMACn directly (i.e. number of DMA "steps"/transfers,
27818/20F0F7 :                          ;   not necessarily a byte count when using word/dword modes).
27819/20F0F7 :                          ;
27820/20F0F7 :                          ; Stack layout on entry (TLCS-900/H cc900):
27821/20F0F7 :                          ;   (xsp+0)  return address (far) 4 bytes
27822/20F0F7 :                          ;   (xsp+4)  src (far pointer)   4 bytes
27823/20F0F7 :                          ;   (xsp+8)  dst (far pointer)   4 bytes
27824/20F0F7 :                          ;   (xsp+12) count (u16)         2 bytes
27825/20F0F7 :                          ;
27826/20F0F7 :                          ; DMA modes (see SDK `HDMA.H`; values here are the real hex values).
27827/20F0F7 : =8H                      DMA_MODE_SINC1  equ 8   ; 0x08: byte,  src++
27828/20F0F7 : =9H                      DMA_MODE_SINC2  equ 9   ; 0x09: word,  src++
27829/20F0F7 : =0AH                     DMA_MODE_SINC4  equ 10  ; 0x0A: dword, src++
27830/20F0F7 :                          
27831/20F0F7 :                          _dma0_program_asm:
27832/20F0F7 : AF 04 20                         ld      xwa,(xsp+4)
27833/20F0FA : E8 2E 00                         ldc    dmas0,xwa
27834/20F0FD : AF 08 20                         ld      xwa,(xsp+8)
27835/20F100 : E8 2E 10                         ldc    dmad0,xwa
27836/20F103 : 9F 0C 20                         ld      wa,(xsp+12)
27837/20F106 : D8 2E 20                         ldc    dmac0,wa
27838/20F109 : 21 08                            ld      a,DMA_MODE_SINC1
27839/20F10B : C9 2E 22                         ldc    dmam0,a
27840/20F10E : 0E                               ret
27841/20F10F :                          
27842/20F10F :                          _dma0_program_u16_asm:
27843/20F10F : AF 04 20                         ld      xwa,(xsp+4)
27844/20F112 : E8 2E 00                         ldc    dmas0,xwa
27845/20F115 : AF 08 20                         ld      xwa,(xsp+8)
27846/20F118 : E8 2E 10                         ldc    dmad0,xwa
27847/20F11B : 9F 0C 20                         ld      wa,(xsp+12)
27848/20F11E : D8 2E 20                         ldc    dmac0,wa
27849/20F121 : 21 09                            ld      a,DMA_MODE_SINC2
27850/20F123 : C9 2E 22                         ldc    dmam0,a
27851/20F126 : 0E                               ret
27852/20F127 :                          
27853/20F127 :                          _dma0_program_u32_asm:
27854/20F127 : AF 04 20                         ld      xwa,(xsp+4)
27855/20F12A : E8 2E 00                         ldc    dmas0,xwa
27856/20F12D : AF 08 20                         ld      xwa,(xsp+8)
27857/20F130 : E8 2E 10                         ldc    dmad0,xwa
27858/20F133 : 9F 0C 20                         ld      wa,(xsp+12)
27859/20F136 : D8 2E 20                         ldc    dmac0,wa
27860/20F139 : 21 0A                            ld      a,DMA_MODE_SINC4
27861/20F13B : C9 2E 22                         ldc    dmam0,a
27862/20F13E : 0E                               ret
27863/20F13F :                          
27864/20F13F :                          _dma1_program_asm:
27865/20F13F : AF 04 20                         ld      xwa,(xsp+4)
27866/20F142 : E8 2E 04                         ldc    dmas1,xwa
27867/20F145 : AF 08 20                         ld      xwa,(xsp+8)
27868/20F148 : E8 2E 14                         ldc    dmad1,xwa
27869/20F14B : 9F 0C 20                         ld      wa,(xsp+12)
27870/20F14E : D8 2E 24                         ldc    dmac1,wa
27871/20F151 : 21 08                            ld      a,DMA_MODE_SINC1
27872/20F153 : C9 2E 26                         ldc    dmam1,a
27873/20F156 : 0E                               ret
27874/20F157 :                          
27875/20F157 :                          _dma1_program_u16_asm:
27876/20F157 : AF 04 20                         ld      xwa,(xsp+4)
27877/20F15A : E8 2E 04                         ldc    dmas1,xwa
27878/20F15D : AF 08 20                         ld      xwa,(xsp+8)
27879/20F160 : E8 2E 14                         ldc    dmad1,xwa
27880/20F163 : 9F 0C 20                         ld      wa,(xsp+12)
27881/20F166 : D8 2E 24                         ldc    dmac1,wa
27882/20F169 : 21 09                            ld      a,DMA_MODE_SINC2
27883/20F16B : C9 2E 26                         ldc    dmam1,a
