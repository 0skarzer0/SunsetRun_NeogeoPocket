27269/20EBAC : E8 2E 10                         ldc    dmad0,xwa
27270/20EBAF : 9F 0C 20                         ld      wa,(xsp+12)
27271/20EBB2 : D8 2E 20                         ldc    dmac0,wa
27272/20EBB5 : 21 0A                            ld      a,DMA_MODE_SINC4
27273/20EBB7 : C9 2E 22                         ldc    dmam0,a
27274/20EBBA : 0E                               ret
