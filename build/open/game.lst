21612/20B90E : C8 81                            add     a,w
21613/20B910 : F2 39 B9 20 D7                   jp       ult,vw_two              ; deux retenues : deux lignes
21614/20B915 :                          vw_one:
21615/20B915 : C9 8A                            ld      b,a
21616/20B917 :                                  ; ---- une ligne, a la rangee de la tranche
21617/20B917 : 8F 01 21                         ld      a,(xsp+F_ROW+1)         ; (u8)(row_fx >> 8)
21618/20B91A : 8F 07 81                         add     a,(xsp+F_PLANE0)
21619/20B91D : CB A1                            sub     a,c
21620/20B91F : C9 88                            ld      w,a
21621/20B921 : 85 21                            ld      a,(xiy)                 ; (u8)dx
21622/20B923 : 8F 08 81                         add     a,(xsp+F_BASEX)
21623/20B926 : B3 50                            ld      (xhl),wa
21624/20B928 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)        ; l'indice de bande, converti plus bas
21625/20B92D : B2 41                            ld      (xde),a
21626/20B92F : EB 6A                            dec     0x2,xhl
21627/20B931 : EA 6A                            dec     0x2,xde
21628/20B933 : CB 69                            dec     0x1,c
21629/20B935 : 1B 8B B9 20                      jp       vw_next
21630/20B939 :                          
21631/20B939 :                          vw_two:
21632/20B939 : C9 8A                            ld      b,a
21633/20B93B :                                  ; ---- premiere ligne, a la rangee de la tranche
21634/20B93B : 8F 01 21                         ld      a,(xsp+F_ROW+1)
21635/20B93E : 8F 07 81                         add     a,(xsp+F_PLANE0)
21636/20B941 : CB A1                            sub     a,c
21637/20B943 : C9 88                            ld      w,a
21638/20B945 : 85 21                            ld      a,(xiy)
21639/20B947 : 8F 08 81                         add     a,(xsp+F_BASEX)
21640/20B94A : B3 50                            ld      (xhl),wa
21641/20B94C : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
21642/20B951 : B2 41                            ld      (xde),a
21643/20B953 : EB 6A                            dec     0x2,xhl
21644/20B955 : EA 6A                            dec     0x2,xde
21645/20B957 : CB 69                            dec     0x1,c
21646/20B959 :                                  ; ---- seconde ligne, seulement si elle reste sur l'ecran, a mi-marche
21647/20B959 : 8F 06 F3                         cp      c,(xsp+F_TOP)
21648/20B95C : F2 8B B9 20 D7                   jp       ult,vw_next
21649/20B961 : 97 20                            ld      wa,(xsp+F_ROW)
21650/20B963 : 9F 04 F0                         cp      wa,(xsp+F_HALF)
21651/20B966 : F2 6E B9 20 D3                   jp       ule,vw_mid              ; row_fx <= half : pas sous la rangee 0
21652/20B96B : 9F 04 A0                         sub     wa,(xsp+F_HALF)
21653/20B96E :                          vw_mid:
21654/20B96E : C8 89                            ld      a,w                     ; (u8)(mid >> 8)
21655/20B970 : 8F 07 81                         add     a,(xsp+F_PLANE0)
21656/20B973 : CB A1                            sub     a,c
21657/20B975 : C9 88                            ld      w,a
21658/20B977 : 85 21                            ld      a,(xiy)
21659/20B979 : 8F 08 81                         add     a,(xsp+F_BASEX)
21660/20B97C : B3 50                            ld      (xhl),wa
21661/20B97E : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
21662/20B983 : B2 41                            ld      (xde),a
21663/20B985 : EB 6A                            dec     0x2,xhl
21664/20B987 : EA 6A                            dec     0x2,xde
21665/20B989 : CB 69                            dec     0x1,c
21666/20B98B :                          
21667/20B98B :                          vw_next:
21668/20B98B :                                  ; TOUJOURS, meme pour une tranche qui n'a pris aucune ligne
21669/20B98B : 9F 02 20                         ld      wa,(xsp+F_STEP)
21670/20B98E : 97 A8                            sub     (xsp+F_ROW),wa
21671/20B990 : 8F 06 F3                         cp      c,(xsp+F_TOP)
21672/20B993 : F2 A0 B9 20 D7                   jp       ult,vw_done             ; plus d'ecran : le compteur reste k + 1
21673/20B998 : 8F 09 69                         decb    0x1,(xsp+F_N)
21674/20B99B : F2 E6 B8 20 DE                   jp       ne,vw_slice             ; au bout : 0, soit k = -1
21675/20B9A0 :                          
21676/20B9A0 :                          vw_done:
21677/20B9A0 :                                  ; ---- les indices de bande deviennent des couleurs, lignes C+1..bas.
21678/20B9A0 :                                  ; XDE pointe l'entree de la ligne C (la prochaine qu'on aurait ecrite).
21679/20B9A0 : 8F 0A 21                         ld      a,(xsp+F_BOT)
21680/20B9A3 : CB A1                            sub     a,c
21681/20B9A5 : F2 D2 B9 20 D6                   jp       eq,vw_conv_done         ; aucune ligne ecrite
21682/20B9AA : C9 8A                            ld      b,a
