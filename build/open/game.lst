21447/20B864 :                          
21448/20B864 :                          _dma3_program_asm:
21449/20B864 : AF 04 20                         ld      xwa,(xsp+4)
21450/20B867 : E8 2E 0C                         ldc    dmas3,xwa
21451/20B86A : AF 08 20                         ld      xwa,(xsp+8)
21452/20B86D : E8 2E 1C                         ldc    dmad3,xwa
