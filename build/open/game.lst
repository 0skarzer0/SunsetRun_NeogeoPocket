22091/20BC5A :                          ; ---- src/spr_cells_asm.asm
22092/20BC5A :                          ; spr_cells_asm.asm - write a list of 8x8 sprite cells to the K2GE sprite table
22093/20BC5A :                          ;
22094/20BC5A :                          ; SUNSET RUN.  The car, the traffic and the roadside objects are all drawn as
22095/20BC5A :                          ; lists of {cx, cy, ch} cells; this loop replaces three copies of the same C
22096/20BC5A :                          ; loop (the hottest code of a frame).  asm900 syntax, also assembled by the
22097/20BC5A :                          ; open toolchain.
22098/20BC5A :                          ;
22099/20BC5A :                          ; void spr_cells_asm(SprJob *j);
22100/20BC5A :                          ;   (xsp+0) return address, (xsp+4) j.  Preserves XIZ (cc900 convention).
22101/20BC5A :                          ;
22102/20BC5A :                          
22103/20BC5A : =0H                      J_CELLS  equ 0      ; const u8 *   cells, 3 bytes each: cx, cy, ch
22104/20BC5A : =4H                      J_MAP    equ 4      ; const u16 *  tile per ch (when J_HASMAP != 0)
22105/20BC5A : =8H                      J_BASE   equ 8      ; u16          tile = base + ch (when J_HASMAP == 0)
22106/20BC5A : =0AH                     J_X      equ 10     ; s16          left edge of the cell grid
22107/20BC5A : =0CH                     J_Y      equ 12     ; u8           top of the cell grid
22108/20BC5A : =0DH                     J_N      equ 13     ; u8           number of cells
22109/20BC5A : =0EH                     J_WM1    equ 14     ; u8           grid width - 1 (mirroring)
22110/20BC5A : =0FH                     J_ATTR   equ 15     ; u8           flip bits | priority bits
22111/20BC5A : =10H                     J_PAL    equ 16     ; u8           palette
22112/20BC5A : =11H                     J_SPR    equ 17     ; u8           next free sprite (in/out)
22113/20BC5A : =12H                     J_END    equ 18     ; u8           first sprite NOT to use
22114/20BC5A : =13H                     J_FLIP   equ 19     ; u8           != 0 : mirror the cell columns
22115/20BC5A : =14H                     J_HASMAP equ 20     ; u8
22116/20BC5A :                          
22117/20BC5A :                          
22118/20BC5A :                          
22119/20BC5A :                          
22120/20BC5A :                          _spr_cells_asm:
22121/20BC5A : 3E                               push    xiz
22122/20BC5B : AF 08 26                         ld      xiz,(xsp+0x8)
22123/20BC5E : A6 24                            ld      xix,(xiz+J_CELLS)
22124/20BC60 : 8E 11 23                         ld      c,(xiz+J_SPR)
22125/20BC63 : 8E 0D 22                         ld      b,(xiz+J_N)
22126/20BC66 : CA D8                            cp      b,0x0
22127/20BC68 : F2 F5 BC 20 D6                   jp      z,sc_done
22128/20BC6D :                          sc_loop:
