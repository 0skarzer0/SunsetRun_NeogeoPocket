27669/20EDAD :                          _id_road_ahead_asm__L8:
27670/20EDAD :                          ah_flat:
27671/20EDAD : 9D 02 20                         ld      wa,(xiy+0x2)            ; road_bend[k] = b
27672/20EDB0 : B3 50                            ld      (xhl),wa
27673/20EDB2 :                          ah_grade_flat:
27674/20EDB2 :                                  ; la pente du segment, bornee et convertie UNE fois par segment
27675/20EDB2 : 8E 1D 21                         ld      a,(xiz+A_CUR)
27676/20EDB5 : 8E 1F F1                         cp      a,(xiz+A_FKEY)
27677/20EDB8 : F2 C4 ED 20 DE                   jp       ne,ah_fmiss
