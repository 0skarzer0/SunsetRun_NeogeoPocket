27708/20EE2C : AE 0C 25                         ld      xiy,(xiz+A_SEG)
27709/20EE2F : F3 07 F4 E0 35                   lda     xiy,(xiy+wa)
27710/20EE34 : DA A8                            ld      de,0x0
27711/20EE36 : 1B 01 EE 20                      jp       ah_seg
27712/20EE3A :                          ah_seg_last:
27713/20EE3A : 9E 1A 82                         add     de,(xiz+A_W)            ; into += want
27714/20EE3D :                          _id_road_ahead_asm__L4:
27715/20EE3D :                          ah_seg_ok:
27716/20EE3D :                                  ; rem = span - into
