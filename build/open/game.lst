27075/20EB93 :                          ; ---- src/core/ngpc_flash_asm.asm
27076/20EB93 :                          
27077/20EB93 :                          ;
27078/20EB93 :                          ; ngpc_flash_asm.asm - Flash erase/write primitives for ngpc_flash.c
27079/20EB93 :                          ;
27080/20EB93 :                          ; Part of NgpCraft_base_template (MIT License)
27081/20EB93 :                          ;
27082/20EB93 :                          ; Two entry points, both called ONLY by ngpc_flash.c (never from an ISR):
27083/20EB93 :                          ;
27084/20EB93 :                          ;   _ngpc_flash_erase_asm(u32 abs_block)
27085/20EB93 :                          ;       Erases one 8 KB block with the AMD erase stub extracted from StarGunner
27086/20EB93 :                          ;       (hardware-validated), copied to RAM 0x6E00 and run from there.
27087/20EB93 :                          ;       VECT_FLASHERS cannot erase blocks 32/33/34 (SysCall.txt p.299), so the
27088/20EB93 :                          ;       erase keeps the stub.
27089/20EB93 :                          ;
27090/20EB93 :                          ;   _ngpc_flash_write_bios(const void *src, u32 offset, u32 pages)
27091/20EB93 :                          ;       Programs pages x 256 bytes through the BIOS (VECT_FLASHWRITE, swi 1),
27092/20EB93 :                          ;       the path StarGunner uses on hardware. The watchdog is refreshed right
27093/20EB93 :                          ;       before and right after, as in the SDK save pattern.
27094/20EB93 :                          ;
27095/20EB93 :                          ; THE BLOCK IS A PARAMETER, NOT A CONSTANT. The save block sits 0x6000 below
27096/20EB93 :                          ; the top of the chip, so its address depends on the cartridge size:
27097/20EB93 :                          ; 0x27A000 on 4 Mbit, 0x2FA000 on 8 Mbit, 0x3FA000 on 16 Mbit. A hard-coded
27098/20EB93 :                          ; 0x3FA000 erases 8 KB ELSEWHERE on a smaller chip - possibly the game code.
27099/20EB93 :                          ; ngpc_flash.c reads the size the BIOS stores at 0x6C58 and refuses unknown ones.
27100/20EB93 :                          ;
27101/20EB93 :                          ; cc900 ABI (CALL pushes 4-byte XPC as return address):
27102/20EB93 :                          ;   (xsp+0)..(xsp+3)  = return address
27103/20EB93 :                          ;   (xsp+4)..(xsp+7)  = 1st parameter
27104/20EB93 :                          ;   (xsp+8)..(xsp+11) = 2nd parameter
27105/20EB93 :                          ;   (xsp+12)..(xsp+15)= 3rd parameter
27106/20EB93 :                          ;
27107/20EB93 :                          ; ===========================================================================
27108/20EB93 :                          ; INTERRUPTS ARE PROHIBITED FOR THE WHOLE SEQUENCE. On hardware that is not
27109/20EB93 :                          ; optional. A flash chip being programmed or erased answers reads with STATUS,
27110/20EB93 :                          ; not with its contents. The stub runs from RAM for that reason, but the
27111/20EB93 :                          ; interrupt handlers are still in the cartridge: an interrupt taken while the
27112/20EB93 :                          ; chip is busy fetches its handler from status bits. A game taking VBlank at
27113/20EB93 :                          ; 60 Hz cannot get through a 256-byte program or an 8 KB erase without one.
27114/20EB93 :                          ;
27115/20EB93 :                          ; AN EMULATOR WHOSE FLASH KEEPS SERVING ROM DURING THE WRITE NEVER SHOWS THIS.
27116/20EB93 :                          ; Toshiba: "all interrupts are prohibited during system calls related to flash
27117/20EB93 :                          ; memory management" (SysCall.txt). Hence `di` (encoded 06 07 = EI 7) on entry
27118/20EB93 :                          ; and `ei 0` (06 00) on exit: level 0 is what ngpc_init() runs the game at.
27119/20EB93 :                          ; ===========================================================================
27120/20EB93 :                          
27121/20EB93 :                          
27122/20EB93 :                          
27123/20EB93 : =6E00H                   FLASH_RAM       equ     0x6E00          ; RAM address for stub execution
27124/20EB93 : =6EH                     FLASH_BUS_CTRL  equ     0x6E            ; I/O: flash /WE enable (0x14=on, 0xF0=off)
27125/20EB93 : =6FH                     FLASH_WD        equ     0x6F            ; I/O: watchdog  (0xB1=extended, 0x4E=refresh)
27126/20EB93 : =200000H                 CART_BASE       equ     0x200000        ; CS0 base address
27127/20EB93 :                          
27128/20EB93 :                          
27129/20EB93 :                          
27130/20EB93 :                          ; ===========================================================================
27131/20EB93 :                          ; _ngpc_flash_erase_asm
27132/20EB93 :                          ;   param 1 (xsp+4) : u32 abs_block -- ABSOLUTE address of the 8 KB block
27133/20EB93 :                          ; C prototype: void ngpc_flash_erase_asm(u32 abs_block);
27134/20EB93 :                          ; ===========================================================================
27135/20EB93 :                          _ngpc_flash_erase_asm:
27136/20EB93 :                          
27137/20EB93 : 06 07                            di                              ; see the note at the top of the file
27138/20EB95 : 08 6E 14                         ld      (FLASH_BUS_CTRL),0x14   ; enable /WE on cart bus
27139/20EB98 : 08 6F B1                         ld      (FLASH_WD),0xB1         ; watchdog: extended mode
27140/20EB9B :                          
27141/20EB9B :                                  ; Copy erase stub (98 bytes) from ROM to RAM at FLASH_RAM
27142/20EB9B : 39                               push    xbc                     ; preserve XBC across copy
27143/20EB9C : 42 00 6E 00 00                   ld      xde,FLASH_RAM           ; destination: RAM
27144/20EBA1 : 43 E8 EB 20 00                   ld      xhl,_erase_stub         ; source: stub bytes in ROM
27145/20EBA6 : 31 62 00                         ld      bc,0x62                 ; BC = 98 bytes
27146/20EBA9 : 83 11                            db      0x83,0x11               ; ldir (xde+),(xhl+) -- copy BC bytes
27147/20EBAB : 59                               pop     xbc                     ; restore XBC (stack back to entry)
27148/20EBAC :                          
27149/20EBAC :                                  ; Set up registers for stub call
27150/20EBAC : 44 00 00 20 00                   ld      xix,CART_BASE           ; XIX = 0x200000 (AMD unlock base)
27151/20EBB1 : ED A8                            ld      xiy,0x0                 ; XIY = 0 (erase stub uses as delay counter)
27152/20EBB3 : C9 A8                            ld      a,0x0                   ; A = 0 (erase stub state init)
27153/20EBB5 : AF 04 22                         ld      xde,(xsp+4)             ; XDE = block, given by the caller
27154/20EBB8 :                          
27155/20EBB8 : 1C 00 6E                         call    FLASH_RAM               ; execute stub from RAM
27156/20EBBB :                          
27157/20EBBB : 08 6E F0                         ld      (FLASH_BUS_CTRL),0xF0   ; restore watchdog mode first
27158/20EBBE : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; then refresh the enabled watchdog
27159/20EBC1 : 06 00                            ei      0                       ; the chip answers as memory again
27160/20EBC3 : 0E                               ret
27161/20EBC4 :                          
27162/20EBC4 :                          
27163/20EBC4 :                          ; ===========================================================================
27164/20EBC4 :                          ; _ngpc_flash_write_bios
27165/20EBC4 :                          ;   param 1 (xsp+4)  : const void *src -- source buffer, in RAM
27166/20EBC4 :                          ;   param 2 (xsp+8)  : u32 offset      -- offset INSIDE the cartridge
27167/20EBC4 :                          ;                                         (e.g. 0x1FA000 + slot*SAVE_SIZE),
27168/20EBC4 :                          ;                                         not the absolute address: XDE3 wants
27169/20EBC4 :                          ;                                         the offset.
27170/20EBC4 :                          ;   param 3 (xsp+12) : u32 pages       -- number of 256-byte units
27171/20EBC4 :                          ; C prototype: void ngpc_flash_write_bios(const void *src, u32 offset, u32 pages);
27172/20EBC4 :                          ;
27173/20EBC4 :                          ; The BIOS holds the bus itself (no manual 0x6E write). The AMD write stub used
27174/20EBC4 :                          ; before disabled the watchdog and wrote its refresh code while it was off.
27175/20EBC4 :                          ; ===========================================================================
27176/20EBC4 :                          _ngpc_flash_write_bios:
27177/20EBC4 :                          
27178/20EBC4 : 06 07                            di                              ; see the note at the top of the file
27179/20EBC6 : AF 04 23                         ld      xhl,(xsp+4)             ; 1st param: source
27180/20EBC9 : AF 08 22                         ld      xde,(xsp+8)             ; 2nd param: cartridge offset
27181/20EBCC : AF 0C 21                         ld      xbc,(xsp+12)            ; 3rd param: 256-byte pages
27182/20EBCF : E7 3C 9B                         ld      xhl3,xhl                ; bank 3: the BIOS reads its arguments there
27183/20EBD2 : E7 38 9A                         ld      xde3,xde
27184/20EBD5 : E7 34 99                         ld      xbc3,xbc
27185/20EBD8 : C7 30 A8                         ld      ra3,0                   ; CS0
27186/20EBDB : C7 31 AE                         ld      rw3,0x0006              ; VECT_FLASHWRITE
27187/20EBDE : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; watchdog refreshed RIGHT BEFORE
27188/20EBE1 : F9                               swi     1
27189/20EBE2 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; and right after
27190/20EBE5 : 06 00                            ei      0
27191/20EBE7 : 0E                               ret
