28535/20F7CA : E8 2E 00                         ldc    dmas0,xwa
28536/20F7CD : AF 08 20                         ld      xwa,(xsp+8)
28537/20F7D0 : E8 2E 10                         ldc    dmad0,xwa
28538/20F7D3 : 9F 0C 20                         ld      wa,(xsp+12)
28539/20F7D6 : D8 2E 20                         ldc    dmac0,wa
28540/20F7D9 : 21 08                            ld      a,DMA_MODE_SINC1
28541/20F7DB : C9 2E 22                         ldc    dmam0,a
28542/20F7DE : 0E                               ret
28543/20F7DF :                          
