22036/20BC0A :                          ; ================================================================
22037/20BC0A :                          ; void id_road_curve_asm(RoadCurve *c);
22038/20BC0A :                          ;
22039/20BC0A :                          ; La double integration de id_road_frame_ahead() : la courbure de chaque
22040/20BC0A :                          ; tranche, du pare-chocs vers l'horizon, sommee deux fois -- le cap, puis le
22041/20BC0A :                          ; deplacement lateral. Le C reste dans id_road.c (ID_ROAD_CURVE_C=1).
22042/20BC0A :                          ;
22043/20BC0A :                          ;   XIX = &bend[k] (descend de 2)   XIY = &id_curve_dx[k] (descend de 2)
22044/20BC0A :                          ;   DE  = id_curve_cm               BC  = slope      HL = acc      IZ = k
22045/20BC0A : =0H                      C_BEND   equ 0      ; const s16 * &bend[lines]
22046/20BC0A : =4H                      C_OUT    equ 4      ; s16 *       &id_curve_dx[lines]
22047/20BC0A : =8H                      C_CM     equ 8      ; u16 id_curve_cm
22048/20BC0A : =0AH                     C_N      equ 10     ; u16 lignes (> 0)
22049/20BC0A :                          
22050/20BC0A :                          
22051/20BC0A :                          _id_road_curve_asm:
22052/20BC0A : 3E                               push    xiz
22053/20BC0B : AF 08 26                         ld      xiz,(xsp+0x8)
22054/20BC0E : A6 24                            ld      xix,(xiz+C_BEND)
22055/20BC10 : AE 04 25                         ld      xiy,(xiz+C_OUT)
22056/20BC13 : 9E 08 22                         ld      de,(xiz+C_CM)
22057/20BC16 : 9E 0A 26                         ld      iz,(xiz+C_N)
22058/20BC19 : D9 A8                            ld      bc,0x0
22059/20BC1B : DB A8                            ld      hl,0x0
22060/20BC1D :                                  ; (Un cache "meme virage que la tranche d'avant, meme c" a ete essaye
22061/20BC1D :                                  ; le 2026-09-19 : 71 a 76 % de tranches repetees, et ZERO cycle gagne
22062/20BC1D :                                  ; mesure -- la comparaison en memoire et le saut pris coutent ce que la
22063/20BC1D :                                  ; multiplication coutait. Retire.)
22064/20BC1D :                          cv_loop:
22065/20BC1D : EC 6A                            dec     0x2,xix
22066/20BC1F : 94 20                            ld      wa,(xix)                ; b
22067/20BC21 : D8 D8                            cp      wa,0x0
22068/20BC23 : F2 39 BC 20 D9                   jp       ge,cv_pos
22069/20BC28 : D8 07                            neg     wa                      ; mag = -b
22070/20BC2A : DA 40                            mul     xwa,de                  ; (u16)mag * cm, 16 bits gardes
22071/20BC2C : D8 C8 80 00                      add     wa,0x80
22072/20BC30 : D8 EF 08                         srl     0x8,wa                  ; c
22073/20BC33 : D8 07                            neg     wa                      ; b < 0 : -c
22074/20BC35 : 1B 42 BC 20                      jp       cv_have
22075/20BC39 :                          cv_pos:
22076/20BC39 : DA 40                            mul     xwa,de
22077/20BC3B : D8 C8 80 00                      add     wa,0x80
22078/20BC3F : D8 EF 08                         srl     0x8,wa
22079/20BC42 :                          cv_have:
22080/20BC42 : D8 81                            add     bc,wa                   ; slope += c
22081/20BC44 : D9 83                            add     hl,bc                   ; acc += slope
22082/20BC46 : DB 88                            ld      wa,hl
22083/20BC48 : D8 ED 08                         sra     0x8,wa
22084/20BC4B : ED 6A                            dec     0x2,xiy
22085/20BC4D : B5 50                            ld      (xiy),wa                ; id_curve_dx[k] = acc >> 8
22086/20BC4F : DE CA 01 00                      sub     iz,0x1                  ; SUB pose les drapeaux (DEC 16 bits non)
22087/20BC53 : F2 1D BC 20 DE                   jp       ne,cv_loop
22088/20BC58 : 5E                               pop     xiz
22089/20BC59 : 0E                               ret
