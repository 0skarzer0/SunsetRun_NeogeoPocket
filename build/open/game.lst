22131/20BC75 : 84 21                            ld      a,(xix)                 ; cx
22132/20BC77 : 8E 13 3F 00                      cpb     (xiz+J_FLIP),0x0
22133/20BC7B : 66 07                            jr      z,sc_noflip
22134/20BC7D : C9 8D                            ld      e,a
22135/20BC7F : 8E 0E 21                         ld      a,(xiz+J_WM1)
22136/20BC82 : CD A1                            sub     a,e
22137/20BC84 :                          sc_noflip:
22138/20BC84 : D8 12                            extz    wa
22139/20BC86 : D8 EE 03                         sll     0x3,wa
22140/20BC89 : 9E 0A 80                         add     wa,(xiz+J_X)            ; sx
22141/20BC8C : D8 8A                            ld      de,wa
22142/20BC8E : DA C8 08 00                      add     de,0x8
22143/20BC92 : DA CF B0 00                      cp      de,0xb0                 ; -8 <= sx <= 167
22144/20BC96 : 6F 54                            jr      nc,sc_next
22145/20BC98 :                                  ; HL = 0x8800 + spr * 4
22146/20BC98 : CB 8F                            ld      l,c
22147/20BC9A : DB 12                            extz    hl
22148/20BC9C : DB EE 02                         sll     0x2,hl
22149/20BC9F : DB C8 00 88                      add     hl,0x8800
22150/20BCA3 : EB 12                            extz    xhl
22151/20BCA5 : BB 02 41                         ld      (xhl+0x2),a             ; x (low byte of sx)
22152/20BCA8 : 8C 01 21                         ld      a,(xix+0x1)             ; cy * 8 + y
22153/20BCAB : C9 EE 03                         sll     0x3,a
22154/20BCAE : 8E 0C 81                         add     a,(xiz+J_Y)
22155/20BCB1 : BB 03 41                         ld      (xhl+0x3),a
22156/20BCB4 : 8C 02 25                         ld      e,(xix+0x2)             ; ch
22157/20BCB7 : DA 12                            extz    de
22158/20BCB9 : 8E 14 3F 00                      cpb     (xiz+J_HASMAP),0x0
22159/20BCBD : 66 0C                            jr      z,sc_base
22160/20BCBF : DA 82                            add     de,de
22161/20BCC1 : AE 04 25                         ld      xiy,(xiz+J_MAP)
22162/20BCC4 : D3 07 F4 E8 22                   ld      de,(xiy+de)
22163/20BCC9 : 68 03                            jr      sc_tile
22164/20BCCB :                          sc_base:
22165/20BCCB : 9E 08 82                         add     de,(xiz+J_BASE)
22166/20BCCE :                          sc_tile:
22167/20BCCE : B3 45                            ld      (xhl),e                 ; tile, low 8 bits
22168/20BCD0 : CC 89                            ld      a,d
22169/20BCD2 : C9 CC 01                         and     a,0x1
22170/20BCD5 : 8E 0F E1                         or      a,(xiz+J_ATTR)
