25209/20D726 :                          ; ================================================================
25210/20D726 :                          ; void id_road_shear_asm(RoadShearWalk *s);
25211/20D726 :                          ;
25212/20D726 :                          ; Le cisaillement de chaque tranche, en tete de id_road_write() :
25213/20D726 :                          ;   dx = (s16)((lateral * w_lat[k]) >> 8) + curve_dx[k], borne a [min, max].
25214/20D726 :                          ; Le C reste dans id_road.c (ID_ROAD_SHEAR_C=1). cc900 y relisait sur la pile,
25215/20D726 :                          ; a chaque tranche, trois des cinq pointeurs et le deplacement lateral : 13 200
25216/20D726 :                          ; cycles par tour, le plus gros bloc C restant (2026-09-19).
25217/20D726 :                          ;
25218/20D726 :                          ;   XIX = &id_w_lat[k]      (monte de 1)
25219/20D726 :                          ;   XIY = &id_curve_dx[k]   (monte de 2)
25220/20D726 :                          ;   XHL = &id_dx_max[k]     (monte de 2) ; id_dx_min[k] est a -128 (RoadClamp)
25221/20D726 :                          ;   XBC = &id_shear[k]      (monte de 2)
25222/20D726 :                          ;   IZ  = lateral           (xsp+0) = tranches restantes
25223/20D726 : =0H                      S_W      equ 0      ; const u8  * id_w_lat
25224/20D726 : =4H                      S_CV     equ 4      ; const s16 * id_curve_dx
25225/20D726 : =8H                      S_MX     equ 8      ; const s16 * id_dx_max  (id_dx_min = id_dx_max - 128)
25226/20D726 : =0CH                     S_SH     equ 12     ; s16 *       id_shear
25227/20D726 : =10H                     S_LAT    equ 16     ; s16  lateral
25228/20D726 : =12H                     S_N      equ 18     ; u16  lignes (> 0, < 256)
25229/20D726 : =80H                     RC_MIN   equ 0x80   ; id_dx_max - id_dx_min, en octets (RoadClamp)
25230/20D726 :                          
25231/20D726 :                          
25232/20D726 :                          _id_road_shear_asm:
25233/20D726 : 3E                               push    xiz
25234/20D727 : AF 08 20                         ld      xwa,(xsp+0x8)
25235/20D72A : A0 24                            ld      xix,(xwa+S_W)
25236/20D72C : A8 04 25                         ld      xiy,(xwa+S_CV)
25237/20D72F : A8 08 23                         ld      xhl,(xwa+S_MX)
25238/20D732 : A8 0C 21                         ld      xbc,(xwa+S_SH)
25239/20D735 : 98 10 26                         ld      iz,(xwa+S_LAT)
25240/20D738 : 98 12 22                         ld      de,(xwa+S_N)
25241/20D73B : 2A                               push    de                      ; le compteur, en (xsp)
25242/20D73C :                          sh_loop:
25243/20D73C : C5 F0 25                         ld      e,(xix+)
25244/20D73F : DA 12                            extz    de
25245/20D741 : DE 4A                            muls    xde,iz
25246/20D743 : EA ED 08                         sra     0x8,xde                 ; (lateral * w) >> 8 on 32 bits (SUNSET RUN: |lateral| > 128)
25247/20D746 : D5 F5 20                         ld      wa,(xiy+)
25248/20D749 : DA 80                            add     wa,de
25249/20D74B : 93 F0                            cp      wa,(xhl)
25250/20D74D : F2 61 D7 20 DA                   jp       gt,sh_hi                ; dx > max
25251/20D752 : 9B 80 F0                         cp      wa,(xhl-RC_MIN)
25252/20D755 : F2 63 D7 20 D9                   jp       ge,sh_st
25253/20D75A : 9B 80 20                         ld      wa,(xhl-RC_MIN)         ; dx < min
25254/20D75D : 1B 63 D7 20                      jp       sh_st
25255/20D761 :                          sh_hi:
25256/20D761 : 93 20                            ld      wa,(xhl)
25257/20D763 :                          sh_st:
25258/20D763 : F5 E5 50                         ld      (xbc+),wa
25259/20D766 : EB 62                            inc     0x2,xhl
25260/20D768 : 87 69                            decb    0x1,(xsp)
25261/20D76A : F2 3C D7 20 DE                   jp       ne,sh_loop
25262/20D76F : 4A                               pop     de
25263/20D770 : 5E                               pop     xiz
25264/20D771 : 0E                               ret
25265/20D772 :                          
25266/20D772 :                          ; ================================================================
25267/20D772 :                          ; void id_road_curve_asm(RoadCurve *c);
25268/20D772 :                          ;
25269/20D772 :                          ; La double integration de id_road_frame_ahead() : la courbure de chaque
25270/20D772 :                          ; tranche, du pare-chocs vers l'horizon, sommee deux fois -- le cap, puis le
25271/20D772 :                          ; deplacement lateral. Le C reste dans id_road.c (ID_ROAD_CURVE_C=1).
25272/20D772 :                          ;
25273/20D772 :                          ;   XIX = &bend[k] (descend de 2)   XIY = &id_curve_dx[k] (descend de 2)
25274/20D772 :                          ;   DE  = id_curve_cm               BC  = slope      HL = acc      IZ = k
25275/20D772 : =0H                      C_BEND   equ 0      ; const s16 * &bend[lines]
25276/20D772 : =4H                      C_OUT    equ 4      ; s16 *       &id_curve_dx[lines]
25277/20D772 : =8H                      C_CM     equ 8      ; u16 id_curve_cm
25278/20D772 : =0AH                     C_N      equ 10     ; u16 lignes (> 0)
25279/20D772 :                          
25280/20D772 :                          
25281/20D772 :                          _id_road_curve_asm:
25282/20D772 : 3E                               push    xiz
25283/20D773 : AF 08 26                         ld      xiz,(xsp+0x8)
25284/20D776 : A6 24                            ld      xix,(xiz+C_BEND)
25285/20D778 : AE 04 25                         ld      xiy,(xiz+C_OUT)
25286/20D77B : 9E 08 22                         ld      de,(xiz+C_CM)
25287/20D77E : 9E 0A 26                         ld      iz,(xiz+C_N)
25288/20D781 : D9 A8                            ld      bc,0x0
25289/20D783 : DB A8                            ld      hl,0x0
25290/20D785 :                                  ; (Un cache "meme virage que la tranche d'avant, meme c" a ete essaye
25291/20D785 :                                  ; le 2026-09-19 : 71 a 76 % de tranches repetees, et ZERO cycle gagne
25292/20D785 :                                  ; mesure -- la comparaison en memoire et le saut pris coutent ce que la
25293/20D785 :                                  ; multiplication coutait. Retire.)
25294/20D785 :                          cv_loop:
25295/20D785 : EC 6A                            dec     0x2,xix
25296/20D787 : 94 20                            ld      wa,(xix)                ; b
25297/20D789 : D8 D8                            cp      wa,0x0
25298/20D78B : F2 A1 D7 20 D9                   jp       ge,cv_pos
25299/20D790 : D8 07                            neg     wa                      ; mag = -b
25300/20D792 : DA 40                            mul     xwa,de                  ; (u16)mag * cm, 16 bits gardes
25301/20D794 : D8 C8 80 00                      add     wa,0x80
25302/20D798 : D8 EF 08                         srl     0x8,wa                  ; c
25303/20D79B : D8 07                            neg     wa                      ; b < 0 : -c
25304/20D79D : 1B AA D7 20                      jp       cv_have
25305/20D7A1 :                          cv_pos:
25306/20D7A1 : DA 40                            mul     xwa,de
25307/20D7A3 : D8 C8 80 00                      add     wa,0x80
25308/20D7A7 : D8 EF 08                         srl     0x8,wa
25309/20D7AA :                          cv_have:
25310/20D7AA : D8 81                            add     bc,wa                   ; slope += c
25311/20D7AC : D9 83                            add     hl,bc                   ; acc += slope
25312/20D7AE : DB 88                            ld      wa,hl
25313/20D7B0 : D8 ED 08                         sra     0x8,wa
25314/20D7B3 : ED 6A                            dec     0x2,xiy
25315/20D7B5 : B5 50                            ld      (xiy),wa                ; id_curve_dx[k] = acc >> 8
25316/20D7B7 : DE CA 01 00                      sub     iz,0x1                  ; SUB pose les drapeaux (DEC 16 bits non)
25317/20D7BB : F2 85 D7 20 DE                   jp       ne,cv_loop
25318/20D7C0 : 5E                               pop     xiz
25319/20D7C1 : 0E                               ret
25320/20D7C2 :                          
25321/20D7C2 :                          ; ---- src/spr_cells_asm.asm
25322/20D7C2 :                          ; spr_cells_asm.asm - write a list of 8x8 sprite cells to the K2GE sprite table
25323/20D7C2 :                          ;
25324/20D7C2 :                          ; SUNSET RUN.  The car, the traffic and the roadside objects are all drawn as
25325/20D7C2 :                          ; lists of {cx, cy, ch} cells; this loop replaces three copies of the same C
25326/20D7C2 :                          ; loop (the hottest code of a frame).  asm900 syntax, also assembled by the
25327/20D7C2 :                          ; open toolchain.
25328/20D7C2 :                          ;
25329/20D7C2 :                          ; void spr_cells_asm(SprJob *j);
25330/20D7C2 :                          ;   (xsp+0) return address, (xsp+4) j.  Preserves XIZ (cc900 convention).
25331/20D7C2 :                          ;
25332/20D7C2 :                          
25333/20D7C2 : =0H                      J_CELLS  equ 0      ; const u8 *   cells, 3 bytes each: cx, cy, ch
25334/20D7C2 : =4H                      J_MAP    equ 4      ; const u16 *  tile per ch (when J_HASMAP != 0)
25335/20D7C2 : =8H                      J_BASE   equ 8      ; u16          tile = base + ch (when J_HASMAP == 0)
25336/20D7C2 : =0AH                     J_X      equ 10     ; s16          left edge of the cell grid
25337/20D7C2 : =0CH                     J_Y      equ 12     ; u8           top of the cell grid
25338/20D7C2 : =0DH                     J_N      equ 13     ; u8           number of cells
25339/20D7C2 : =0EH                     J_WM1    equ 14     ; u8           grid width - 1 (mirroring)
25340/20D7C2 : =0FH                     J_ATTR   equ 15     ; u8           flip bits | priority bits
25341/20D7C2 : =10H                     J_PAL    equ 16     ; u8           palette
25342/20D7C2 : =11H                     J_SPR    equ 17     ; u8           next free sprite (in/out)
25343/20D7C2 : =12H                     J_END    equ 18     ; u8           first sprite NOT to use
25344/20D7C2 : =13H                     J_FLIP   equ 19     ; u8           != 0 : mirror the cell columns
25345/20D7C2 : =14H                     J_HASMAP equ 20     ; u8
25346/20D7C2 :                          
25347/20D7C2 :                          
25348/20D7C2 :                          
25349/20D7C2 :                          
25350/20D7C2 :                          _spr_cells_asm:
25351/20D7C2 : 3E                               push    xiz
25352/20D7C3 : AF 08 26                         ld      xiz,(xsp+0x8)
25353/20D7C6 : A6 24                            ld      xix,(xiz+J_CELLS)
25354/20D7C8 : 8E 11 23                         ld      c,(xiz+J_SPR)
25355/20D7CB : 8E 0D 22                         ld      b,(xiz+J_N)
25356/20D7CE : CA D8                            cp      b,0x0
25357/20D7D0 : F2 5D D8 20 D6                   jp      z,sc_done
25358/20D7D5 :                          sc_loop:
25359/20D7D5 : 8E 12 F3                         cp      c,(xiz+J_END)
25360/20D7D8 : F2 5D D8 20 DF                   jp      nc,sc_done
25361/20D7DD : 84 21                            ld      a,(xix)                 ; cx
25362/20D7DF : 8E 13 3F 00                      cpb     (xiz+J_FLIP),0x0
25363/20D7E3 : 66 07                            jr      z,sc_noflip
25364/20D7E5 : C9 8D                            ld      e,a
25365/20D7E7 : 8E 0E 21                         ld      a,(xiz+J_WM1)
25366/20D7EA : CD A1                            sub     a,e
25367/20D7EC :                          sc_noflip:
25368/20D7EC : D8 12                            extz    wa
25369/20D7EE : D8 EE 03                         sll     0x3,wa
25370/20D7F1 : 9E 0A 80                         add     wa,(xiz+J_X)            ; sx
25371/20D7F4 : D8 8A                            ld      de,wa
25372/20D7F6 : DA C8 08 00                      add     de,0x8
25373/20D7FA : DA CF B0 00                      cp      de,0xb0                 ; -8 <= sx <= 167
25374/20D7FE : 6F 54                            jr      nc,sc_next
25375/20D800 :                                  ; HL = 0x8800 + spr * 4
25376/20D800 : CB 8F                            ld      l,c
25377/20D802 : DB 12                            extz    hl
25378/20D804 : DB EE 02                         sll     0x2,hl
25379/20D807 : DB C8 00 88                      add     hl,0x8800
25380/20D80B : EB 12                            extz    xhl
25381/20D80D : BB 02 41                         ld      (xhl+0x2),a             ; x (low byte of sx)
25382/20D810 : 8C 01 21                         ld      a,(xix+0x1)             ; cy * 8 + y
25383/20D813 : C9 EE 03                         sll     0x3,a
25384/20D816 : 8E 0C 81                         add     a,(xiz+J_Y)
25385/20D819 : BB 03 41                         ld      (xhl+0x3),a
