27374/20EC93 :                          
27375/20EC93 :                          ; ---- src/id_road_asm.asm
27376/20EC93 :                          ; id_road_asm.asm - la marche par tranches de id_road_write(), en assembleur
27377/20EC93 :                          ;
27378/20EC93 :                          ; POURQUOI EN ASSEMBLEUR. Profil de la ROM livree (tools/profil_course.py,
27379/20EC93 :                          ; temporisation de la cartouche comprise) : cette boucle etait le plus gros
27380/20EC93 :                          ; poste du tour de course. cc900 n'y gardait pas ses valeurs en registres --
27381/20EC93 :                          ; tout allait sur la pile -- et relisait chaque adresse de table par une
27382/20EC93 :                          ; instruction de cinq octets, cinquante-six fois par trame. Sur cette machine
27383/20EC93 :                          ; chaque octet d'instruction se lit dans la cartouche.
27384/20EC93 :                          ;
27385/20EC93 :                          ; LE CALCUL EST CELUI DU C, A L'OCTET PRES : la version C est gardee dans
27386/20EC93 :                          ; id_road.c (ID_ROAD_WALK_C=1) et tools/equivalence.py compare, tour de boucle
27387/20EC93 :                          ; par tour de boucle, la RAM de cette ROM a celle de la ROM d'origine sur les
27388/20EC93 :                          ; dix circuits.
27389/20EC93 :                          ;
27390/20EC93 :                          ; !! SEULEMENT DES FORMES QUE cc900 EMET DEJA. Les pieges materiel connus de ce
27391/20EC93 :                          ; processeur (docs du projet, fiches) venaient d'encodages que Toshiba n'emet
27392/20EC93 :                          ; pas. `python tools/formes_asm.py` verifie chaque instruction de ce fichier
27393/20EC93 :                          ; contre le code que cc900 genere pour ce projet (build/prof_asm/*.asm).
27394/20EC93 :                          ;
27395/20EC93 :                          ; void id_road_walk_asm(RoadWalk *w);
27396/20EC93 :                          ;
27397/20EC93 :                          ;   (xsp+0) adresse de retour, 4 octets ; (xsp+4) w.
27398/20EC93 :                          ;   cc900 : seul XIZ doit etre preserve (ses fonctions le poussent quand elles
27399/20EC93 :                          ;   s'en servent) ; XWA XBC XDE XHL XIX XIY sont a l'appele.
27400/20EC93 :                          ;
27401/20EC93 :                          ; SECONDE ECRITURE (2026-09-19). La premiere relisait dans le bloc, a chaque
27402/20EC93 :                          ; tranche, sept pointeurs de table et l'accumulateur : 44 500 cycles par tour.
27403/20EC93 :                          ; Celle-ci tient toute la marche en registres :
27404/20EC93 :                          ;
27405/20EC93 :                          ;   XIX = &id_line_of[k]   (descend de 1)   la pente a +SL_GRADE, la bande a +SL_BANDI
27406/20EC93 :                          ;   XIY = &id_shear[k]     (descend de 2)
27407/20EC93 :                          ;   XHL = &xy[ligne]       (descend de 2 par ligne ecrite)
27408/20EC93 :                          ;   XDE = &bande[ligne]    (descend de 2 par ligne ecrite)
27409/20EC93 :                          ;   B   = l'accumulateur   C = la ligne courante (>= top : tient sur un octet)
27410/20EC93 :                          ;   XIZ = &hill_rate[20]   (la cadence, indice signe)
27411/20EC93 :                          ;
27412/20EC93 :                          ; Les valeurs fixes du bloc sont RECOPIEES sur la pile de la routine (F_*) et
27413/20EC93 :                          ; lues par (xsp+d) : c'est ce qui libere XIZ pour la table des cadences.
27414/20EC93 :                          ;
27415/20EC93 :                          ; LES DEUX RETENUES SANS SEIZE BITS. c = (acc + 2 rate) >> 8 et le nouvel
27416/20EC93 :                          ; accumulateur est l'octet bas : c'est exactement le nombre de retenues de deux
27417/20EC93 :                          ; additions de `rate` sur huit bits, et l'octet restant.
27418/20EC93 :                          ;
27419/20EC93 :                          ; LA LIGNE Y. (u8)((row >> 8) - (u8)(scr - plane0)) = (row >> 8) + plane0 - scr
27420/20EC93 :                          ; modulo 256 : les deux formes rendent le meme octet.
27421/20EC93 :                          ;
27422/20EC93 :                          ; LA COULEUR DE BANDE EN DEUX TEMPS. band_col[lut[id_bandi[k]]] demande deux
27423/20EC93 :                          ; pointeurs de table et la marche n'a plus de registre. Elle pose donc l'INDICE
27424/20EC93 :                          ; id_bandi[k] dans l'octet bas de l'entree du tampon de couleur, et une passe
27425/20EC93 :                          ; courte, apres elle, le convertit sur les seules lignes ecrites. Aucun octet de
27426/20EC93 :                          ; RAM de plus : la pile n'en a pas a donner (voir RoadSlices dans id_road.c).
27427/20EC93 :                          ;
27428/20EC93 :                          
27429/20EC93 :                          ; Le bloc RoadWalk (id_road.c ; sa TAILLE y est VERIFIEE a la compilation) :
27430/20EC93 : =0H                      V_XY      equ 0     ; u16 * &xy[road_bottom]
27431/20EC93 : =4H                      V_BAND    equ 4     ; u16 * &bandcol[road_bottom]
27432/20EC93 : =8H                      V_SL      equ 8     ; u8  * &id_line_of[lines]   (juste APRES la fin)
27433/20EC93 : =0CH                     V_SH      equ 12    ; s16 * &id_shear[lines]     (juste APRES la fin)
27434/20EC93 : =10H                     V_RTAB    equ 16    ; u8  * &hill_rate[20]
27435/20EC93 : =14H                     V_LUT     equ 20    ; u8  * ligne de band_lut de cette trame
27436/20EC93 : =18H                     V_BCOL    equ 24    ; u16 * band_col
27437/20EC93 : =1CH                     V_ROW     equ 28    ; u16  row_fx     (8.8)
27438/20EC93 : =1EH                     V_STEP    equ 30    ; u16  step_fx
27439/20EC93 : =20H                     V_HALF    equ 32    ; u16  (u16)step_fx >> 1
27440/20EC93 : =22H                     V_TOP     equ 34    ; u8   top_limit        } recopies d'un mot
27441/20EC93 : =23H                     V_PLANE0  equ 35    ; u8   road_plane0      }
27442/20EC93 : =24H                     V_BASEX   equ 36    ; u8   road_base_x      } recopies d'un mot
27443/20EC93 : =25H                     V_N       equ 37    ; u8   entree : lines ; sortie : k + 1
27444/20EC93 : =26H                     V_LINE    equ 38    ; u8   entree : road_bottom ; sortie : la ligne a l'arret
27445/20EC93 :                          ; Les tableaux voisins de id_line_of (RoadSlices dans id_road.c) :
27446/20EC93 : =40H                     SL_GRADE  equ 64    ; id_grade[k] = id_line_of[k] + 64
27447/20EC93 : =80H                     SL_BANDI  equ 128   ; id_bandi[k] = id_line_of[k] + 128
27448/20EC93 :                          ; Le cadre de la routine, sous la sauvegarde de XIZ :
27449/20EC93 : =0H                      F_ROW     equ 0     ; u16  row_fx (modifie)
27450/20EC93 : =2H                      F_STEP    equ 2
27451/20EC93 : =4H                      F_HALF    equ 4
27452/20EC93 : =6H                      F_TOP     equ 6
27453/20EC93 : =7H                      F_PLANE0  equ 7
27454/20EC93 : =8H                      F_BASEX   equ 8
27455/20EC93 : =9H                      F_N       equ 9     ; le compteur de tranches
27456/20EC93 : =0AH                     F_BOT     equ 10    ; road_bottom
27457/20EC93 : =0CH                     F_SIZE    equ 12
27458/20EC93 : =14H                     F_W       equ 20    ; w : F_SIZE + XIZ (4) + adresse de retour (4)
27459/20EC93 :                          
27460/20EC93 :                          
27461/20EC93 :                          
27462/20EC93 :                          
27463/20EC93 :                          _id_road_walk_asm:
27464/20EC93 : 3E                               push    xiz
27465/20EC94 : AF 08 20                         ld      xwa,(xsp+0x8)           ; w
27466/20EC97 : BF F4 37                         lda     xsp,(xsp-F_SIZE)
27467/20EC9A : 98 1C 21                         ld      bc,(xwa+V_ROW)
27468/20EC9D : B7 51                            ld      (xsp+F_ROW),bc
27469/20EC9F : 98 1E 21                         ld      bc,(xwa+V_STEP)
27470/20ECA2 : BF 02 51                         ld      (xsp+F_STEP),bc
27471/20ECA5 : 98 20 21                         ld      bc,(xwa+V_HALF)
27472/20ECA8 : BF 04 51                         ld      (xsp+F_HALF),bc
27473/20ECAB : 98 22 21                         ld      bc,(xwa+V_TOP)          ; top et plane0
27474/20ECAE : BF 06 51                         ld      (xsp+F_TOP),bc
27475/20ECB1 : 98 24 21                         ld      bc,(xwa+V_BASEX)        ; base_x et le compteur
27476/20ECB4 : BF 08 51                         ld      (xsp+F_BASEX),bc
27477/20ECB7 : 88 26 23                         ld      c,(xwa+V_LINE)          ; la ligne : road_bottom, >= top (le C le verifie)
27478/20ECBA : BF 0A 43                         ld      (xsp+F_BOT),c
27479/20ECBD : A0 23                            ld      xhl,(xwa+V_XY)
27480/20ECBF : A8 04 22                         ld      xde,(xwa+V_BAND)
27481/20ECC2 : A8 08 24                         ld      xix,(xwa+V_SL)
27482/20ECC5 : A8 0C 25                         ld      xiy,(xwa+V_SH)
27483/20ECC8 : A8 10 26                         ld      xiz,(xwa+V_RTAB)
27484/20ECCB : CA A8                            ld      b,0x0                   ; l'accumulateur part de zero, CHAQUE trame
27485/20ECCD :                          
27486/20ECCD :                          vw_slice:
27487/20ECCD : EC 69                            dec     0x1,xix
27488/20ECCF : ED 6A                            dec     0x2,xiy
27489/20ECD1 :                                  ; ou va la tranche : id_line_of[k] = max(ligne, top) = la ligne, puisque
27490/20ECD1 :                                  ; la marche s'arrete des qu'elle passe sous top
