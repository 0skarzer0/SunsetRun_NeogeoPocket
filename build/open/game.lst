27350/20EC79 : 9F 0C 20                         ld      wa,(xsp+12)
27351/20EC7C : D8 2E 20                         ldc    dmac0,wa
27352/20EC7F : 21 08                            ld      a,DMA_MODE_SINC1
27353/20EC81 : C9 2E 22                         ldc    dmam0,a
27354/20EC84 : 0E                               ret
