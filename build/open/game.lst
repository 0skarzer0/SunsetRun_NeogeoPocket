28650/20F8C9 : 21 09                            ld      a,DMA_MODE_SINC2
28651/20F8CB : C9 2E 2E                         ldc    dmam3,a
28652/20F8CE : 0E                               ret
28653/20F8CF :                          
28654/20F8CF :                          _dma3_program_u32_asm:
28655/20F8CF : AF 04 20                         ld      xwa,(xsp+4)
28656/20F8D2 : E8 2E 0C                         ldc    dmas3,xwa
28657/20F8D5 : AF 08 20                         ld      xwa,(xsp+8)
28658/20F8D8 : E8 2E 1C                         ldc    dmad3,xwa
28659/20F8DB : 9F 0C 20                         ld      wa,(xsp+12)
28660/20F8DE : D8 2E 2C                         ldc    dmac3,wa
28661/20F8E1 : 21 0A                            ld      a,DMA_MODE_SINC4
28662/20F8E3 : C9 2E 2E                         ldc    dmam3,a
28663/20F8E6 : 0E                               ret
28664/20F8E7 :                          
28665/20F8E7 :                          ; ---- src/id_road_asm.asm
28666/20F8E7 :                          ; id_road_asm.asm - la marche par tranches de id_road_write(), en assembleur
28667/20F8E7 :                          ;
28668/20F8E7 :                          ; POURQUOI EN ASSEMBLEUR. Profil de la ROM livree (tools/profil_course.py,
28669/20F8E7 :                          ; temporisation de la cartouche comprise) : cette boucle etait le plus gros
28670/20F8E7 :                          ; poste du tour de course. cc900 n'y gardait pas ses valeurs en registres --
28671/20F8E7 :                          ; tout allait sur la pile -- et relisait chaque adresse de table par une
28672/20F8E7 :                          ; instruction de cinq octets, cinquante-six fois par trame. Sur cette machine
28673/20F8E7 :                          ; chaque octet d'instruction se lit dans la cartouche.
28674/20F8E7 :                          ;
28675/20F8E7 :                          ; LE CALCUL EST CELUI DU C, A L'OCTET PRES : la version C est gardee dans
28676/20F8E7 :                          ; id_road.c (ID_ROAD_WALK_C=1) et tools/equivalence.py compare, tour de boucle
28677/20F8E7 :                          ; par tour de boucle, la RAM de cette ROM a celle de la ROM d'origine sur les
28678/20F8E7 :                          ; dix circuits.
28679/20F8E7 :                          ;
28680/20F8E7 :                          ; !! SEULEMENT DES FORMES QUE cc900 EMET DEJA. Les pieges materiel connus de ce
28681/20F8E7 :                          ; processeur (docs du projet, fiches) venaient d'encodages que Toshiba n'emet
28682/20F8E7 :                          ; pas. `python tools/formes_asm.py` verifie chaque instruction de ce fichier
28683/20F8E7 :                          ; contre le code que cc900 genere pour ce projet (build/prof_asm/*.asm).
28684/20F8E7 :                          ;
28685/20F8E7 :                          ; void id_road_walk_asm(RoadWalk *w);
28686/20F8E7 :                          ;
28687/20F8E7 :                          ;   (xsp+0) adresse de retour, 4 octets ; (xsp+4) w.
28688/20F8E7 :                          ;   cc900 : seul XIZ doit etre preserve (ses fonctions le poussent quand elles
28689/20F8E7 :                          ;   s'en servent) ; XWA XBC XDE XHL XIX XIY sont a l'appele.
28690/20F8E7 :                          ;
28691/20F8E7 :                          ; SECONDE ECRITURE (2026-09-19). La premiere relisait dans le bloc, a chaque
28692/20F8E7 :                          ; tranche, sept pointeurs de table et l'accumulateur : 44 500 cycles par tour.
28693/20F8E7 :                          ; Celle-ci tient toute la marche en registres :
28694/20F8E7 :                          ;
28695/20F8E7 :                          ;   XIX = &id_line_of[k]   (descend de 1)   la pente a +SL_GRADE, la bande a +SL_BANDI
28696/20F8E7 :                          ;   XIY = &id_shear[k]     (descend de 2)
28697/20F8E7 :                          ;   XHL = &xy[ligne]       (descend de 2 par ligne ecrite)
28698/20F8E7 :                          ;   XDE = &bande[ligne]    (descend de 2 par ligne ecrite)
28699/20F8E7 :                          ;   B   = l'accumulateur   C = la ligne courante (>= top : tient sur un octet)
28700/20F8E7 :                          ;   XIZ = &hill_rate[20]   (la cadence, indice signe)
28701/20F8E7 :                          ;
28702/20F8E7 :                          ; Les valeurs fixes du bloc sont RECOPIEES sur la pile de la routine (F_*) et
28703/20F8E7 :                          ; lues par (xsp+d) : c'est ce qui libere XIZ pour la table des cadences.
28704/20F8E7 :                          ;
28705/20F8E7 :                          ; LES DEUX RETENUES SANS SEIZE BITS. c = (acc + 2 rate) >> 8 et le nouvel
28706/20F8E7 :                          ; accumulateur est l'octet bas : c'est exactement le nombre de retenues de deux
28707/20F8E7 :                          ; additions de `rate` sur huit bits, et l'octet restant.
28708/20F8E7 :                          ;
28709/20F8E7 :                          ; LA LIGNE Y. (u8)((row >> 8) - (u8)(scr - plane0)) = (row >> 8) + plane0 - scr
28710/20F8E7 :                          ; modulo 256 : les deux formes rendent le meme octet.
28711/20F8E7 :                          ;
28712/20F8E7 :                          ; LA COULEUR DE BANDE EN DEUX TEMPS. band_col[lut[id_bandi[k]]] demande deux
28713/20F8E7 :                          ; pointeurs de table et la marche n'a plus de registre. Elle pose donc l'INDICE
28714/20F8E7 :                          ; id_bandi[k] dans l'octet bas de l'entree du tampon de couleur, et une passe
28715/20F8E7 :                          ; courte, apres elle, le convertit sur les seules lignes ecrites. Aucun octet de
28716/20F8E7 :                          ; RAM de plus : la pile n'en a pas a donner (voir RoadSlices dans id_road.c).
28717/20F8E7 :                          ;
28718/20F8E7 :                          
28719/20F8E7 :                          ; Le bloc RoadWalk (id_road.c ; sa TAILLE y est VERIFIEE a la compilation) :
28720/20F8E7 : =0H                      V_XY      equ 0     ; u16 * &xy[road_bottom]
28721/20F8E7 : =4H                      V_BAND    equ 4     ; u16 * &bandcol[road_bottom]
28722/20F8E7 : =8H                      V_SL      equ 8     ; u8  * &id_line_of[lines]   (juste APRES la fin)
28723/20F8E7 : =0CH                     V_SH      equ 12    ; s16 * &id_shear[lines]     (juste APRES la fin)
28724/20F8E7 : =10H                     V_RTAB    equ 16    ; u8  * &hill_rate[20]
28725/20F8E7 : =14H                     V_LUT     equ 20    ; u8  * ligne de band_lut de cette trame
28726/20F8E7 : =18H                     V_BCOL    equ 24    ; u16 * band_col
28727/20F8E7 : =1CH                     V_ROW     equ 28    ; u16  row_fx     (8.8)
28728/20F8E7 : =1EH                     V_STEP    equ 30    ; u16  step_fx
28729/20F8E7 : =20H                     V_HALF    equ 32    ; u16  (u16)step_fx >> 1
28730/20F8E7 : =22H                     V_TOP     equ 34    ; u8   top_limit        } recopies d'un mot
28731/20F8E7 : =23H                     V_PLANE0  equ 35    ; u8   road_plane0      }
28732/20F8E7 : =24H                     V_BASEX   equ 36    ; u8   road_base_x      } recopies d'un mot
28733/20F8E7 : =25H                     V_N       equ 37    ; u8   entree : lines ; sortie : k + 1
28734/20F8E7 : =26H                     V_LINE    equ 38    ; u8   entree : road_bottom ; sortie : la ligne a l'arret
28735/20F8E7 :                          ; Les tableaux voisins de id_line_of (RoadSlices dans id_road.c) :
28736/20F8E7 : =40H                     SL_GRADE  equ 64    ; id_grade[k] = id_line_of[k] + 64
28737/20F8E7 : =80H                     SL_BANDI  equ 128   ; id_bandi[k] = id_line_of[k] + 128
28738/20F8E7 :                          ; Le cadre de la routine, sous la sauvegarde de XIZ :
28739/20F8E7 : =0H                      F_ROW     equ 0     ; u16  row_fx (modifie)
28740/20F8E7 : =2H                      F_STEP    equ 2
28741/20F8E7 : =4H                      F_HALF    equ 4
28742/20F8E7 : =6H                      F_TOP     equ 6
28743/20F8E7 : =7H                      F_PLANE0  equ 7
28744/20F8E7 : =8H                      F_BASEX   equ 8
28745/20F8E7 : =9H                      F_N       equ 9     ; le compteur de tranches
28746/20F8E7 : =0AH                     F_BOT     equ 10    ; road_bottom
28747/20F8E7 : =0CH                     F_SIZE    equ 12
28748/20F8E7 : =14H                     F_W       equ 20    ; w : F_SIZE + XIZ (4) + adresse de retour (4)
28749/20F8E7 :                          
28750/20F8E7 :                          
28751/20F8E7 :                          
28752/20F8E7 :                          
28753/20F8E7 :                          _id_road_walk_asm:
28754/20F8E7 : 3E                               push    xiz
28755/20F8E8 : AF 08 20                         ld      xwa,(xsp+0x8)           ; w
28756/20F8EB : BF F4 37                         lda     xsp,(xsp-F_SIZE)
28757/20F8EE : 98 1C 21                         ld      bc,(xwa+V_ROW)
28758/20F8F1 : B7 51                            ld      (xsp+F_ROW),bc
28759/20F8F3 : 98 1E 21                         ld      bc,(xwa+V_STEP)
28760/20F8F6 : BF 02 51                         ld      (xsp+F_STEP),bc
28761/20F8F9 : 98 20 21                         ld      bc,(xwa+V_HALF)
28762/20F8FC : BF 04 51                         ld      (xsp+F_HALF),bc
28763/20F8FF : 98 22 21                         ld      bc,(xwa+V_TOP)          ; top et plane0
28764/20F902 : BF 06 51                         ld      (xsp+F_TOP),bc
28765/20F905 : 98 24 21                         ld      bc,(xwa+V_BASEX)        ; base_x et le compteur
28766/20F908 : BF 08 51                         ld      (xsp+F_BASEX),bc
28767/20F90B : 88 26 23                         ld      c,(xwa+V_LINE)          ; la ligne : road_bottom, >= top (le C le verifie)
28768/20F90E : BF 0A 43                         ld      (xsp+F_BOT),c
28769/20F911 : A0 23                            ld      xhl,(xwa+V_XY)
28770/20F913 : A8 04 22                         ld      xde,(xwa+V_BAND)
28771/20F916 : A8 08 24                         ld      xix,(xwa+V_SL)
28772/20F919 : A8 0C 25                         ld      xiy,(xwa+V_SH)
28773/20F91C : A8 10 26                         ld      xiz,(xwa+V_RTAB)
28774/20F91F : CA A8                            ld      b,0x0                   ; l'accumulateur part de zero, CHAQUE trame
28775/20F921 :                          
28776/20F921 :                          vw_slice:
28777/20F921 : EC 69                            dec     0x1,xix
28778/20F923 : ED 6A                            dec     0x2,xiy
28779/20F925 :                                  ; ou va la tranche : id_line_of[k] = max(ligne, top) = la ligne, puisque
28780/20F925 :                                  ; la marche s'arrete des qu'elle passe sous top
28781/20F925 : B4 43                            ld      (xix),c
28782/20F927 :                                  ; ---- la cadence : hill_rate[20 + id_grade[k]]
28783/20F927 : 8C 40 21                         ld      a,(xix+SL_GRADE)
28784/20F92A : D8 13                            exts    wa
28785/20F92C : C3 07 F8 E0 21                   ld      a,(xiz+wa)
28786/20F931 : C9 88                            ld      w,a
28787/20F933 :                                  ; ---- les deux retenues : A = acc + rate + rate, sur huit bits
28788/20F933 : CA 89                            ld      a,b
28789/20F935 : C8 81                            add     a,w
28790/20F937 : F2 49 F9 20 D7                   jp       ult,vw_c1               ; premiere retenue
28791/20F93C : C8 81                            add     a,w
28792/20F93E : F2 50 F9 20 D7                   jp       ult,vw_one              ; une seule retenue : une ligne
28793/20F943 : C9 8A                            ld      b,a                     ; aucune : la tranche ne prend pas de ligne
28794/20F945 : 1B C6 F9 20                      jp       vw_next
28795/20F949 :                          vw_c1:
28796/20F949 : C8 81                            add     a,w
28797/20F94B : F2 74 F9 20 D7                   jp       ult,vw_two              ; deux retenues : deux lignes
28798/20F950 :                          vw_one:
28799/20F950 : C9 8A                            ld      b,a
28800/20F952 :                                  ; ---- une ligne, a la rangee de la tranche
28801/20F952 : 8F 01 21                         ld      a,(xsp+F_ROW+1)         ; (u8)(row_fx >> 8)
28802/20F955 : 8F 07 81                         add     a,(xsp+F_PLANE0)
28803/20F958 : CB A1                            sub     a,c
28804/20F95A : C9 88                            ld      w,a
28805/20F95C : 85 21                            ld      a,(xiy)                 ; (u8)dx
28806/20F95E : 8F 08 81                         add     a,(xsp+F_BASEX)
28807/20F961 : B3 50                            ld      (xhl),wa
28808/20F963 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)        ; l'indice de bande, converti plus bas
28809/20F968 : B2 41                            ld      (xde),a
28810/20F96A : EB 6A                            dec     0x2,xhl
28811/20F96C : EA 6A                            dec     0x2,xde
28812/20F96E : CB 69                            dec     0x1,c
28813/20F970 : 1B C6 F9 20                      jp       vw_next
28814/20F974 :                          
28815/20F974 :                          vw_two:
28816/20F974 : C9 8A                            ld      b,a
28817/20F976 :                                  ; ---- premiere ligne, a la rangee de la tranche
28818/20F976 : 8F 01 21                         ld      a,(xsp+F_ROW+1)
28819/20F979 : 8F 07 81                         add     a,(xsp+F_PLANE0)
28820/20F97C : CB A1                            sub     a,c
28821/20F97E : C9 88                            ld      w,a
28822/20F980 : 85 21                            ld      a,(xiy)
28823/20F982 : 8F 08 81                         add     a,(xsp+F_BASEX)
28824/20F985 : B3 50                            ld      (xhl),wa
28825/20F987 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
28826/20F98C : B2 41                            ld      (xde),a
28827/20F98E : EB 6A                            dec     0x2,xhl
28828/20F990 : EA 6A                            dec     0x2,xde
28829/20F992 : CB 69                            dec     0x1,c
28830/20F994 :                                  ; ---- seconde ligne, seulement si elle reste sur l'ecran, a mi-marche
28831/20F994 : 8F 06 F3                         cp      c,(xsp+F_TOP)
28832/20F997 : F2 C6 F9 20 D7                   jp       ult,vw_next
28833/20F99C : 97 20                            ld      wa,(xsp+F_ROW)
28834/20F99E : 9F 04 F0                         cp      wa,(xsp+F_HALF)
28835/20F9A1 : F2 A9 F9 20 D3                   jp       ule,vw_mid              ; row_fx <= half : pas sous la rangee 0
28836/20F9A6 : 9F 04 A0                         sub     wa,(xsp+F_HALF)
28837/20F9A9 :                          vw_mid:
28838/20F9A9 : C8 89                            ld      a,w                     ; (u8)(mid >> 8)
28839/20F9AB : 8F 07 81                         add     a,(xsp+F_PLANE0)
28840/20F9AE : CB A1                            sub     a,c
28841/20F9B0 : C9 88                            ld      w,a
28842/20F9B2 : 85 21                            ld      a,(xiy)
28843/20F9B4 : 8F 08 81                         add     a,(xsp+F_BASEX)
28844/20F9B7 : B3 50                            ld      (xhl),wa
28845/20F9B9 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
28846/20F9BE : B2 41                            ld      (xde),a
28847/20F9C0 : EB 6A                            dec     0x2,xhl
28848/20F9C2 : EA 6A                            dec     0x2,xde
28849/20F9C4 : CB 69                            dec     0x1,c
28850/20F9C6 :                          
28851/20F9C6 :                          vw_next:
28852/20F9C6 :                                  ; TOUJOURS, meme pour une tranche qui n'a pris aucune ligne
28853/20F9C6 : 9F 02 20                         ld      wa,(xsp+F_STEP)
28854/20F9C9 : 97 A8                            sub     (xsp+F_ROW),wa
28855/20F9CB : 8F 06 F3                         cp      c,(xsp+F_TOP)
28856/20F9CE : F2 DB F9 20 D7                   jp       ult,vw_done             ; plus d'ecran : le compteur reste k + 1
28857/20F9D3 : 8F 09 69                         decb    0x1,(xsp+F_N)
28858/20F9D6 : F2 21 F9 20 DE                   jp       ne,vw_slice             ; au bout : 0, soit k = -1
28859/20F9DB :                          
28860/20F9DB :                          vw_done:
28861/20F9DB :                                  ; ---- les indices de bande deviennent des couleurs, lignes C+1..bas.
28862/20F9DB :                                  ; XDE pointe l'entree de la ligne C (la prochaine qu'on aurait ecrite).
28863/20F9DB : 8F 0A 21                         ld      a,(xsp+F_BOT)
28864/20F9DE : CB A1                            sub     a,c
28865/20F9E0 : F2 0D FA 20 D6                   jp       eq,vw_conv_done         ; aucune ligne ecrite
28866/20F9E5 : C9 8A                            ld      b,a
28867/20F9E7 : AF 14 20                         ld      xwa,(xsp+F_W)
28868/20F9EA : A8 14 24                         ld      xix,(xwa+V_LUT)
28869/20F9ED : A8 18 25                         ld      xiy,(xwa+V_BCOL)
28870/20F9F0 :                          vw_conv:
28871/20F9F0 : EA 62                            inc     0x2,xde
28872/20F9F2 : 82 21                            ld      a,(xde)
28873/20F9F4 : D8 12                            extz    wa
28874/20F9F6 : C3 07 F0 E0 21                   ld      a,(xix+wa)
28875/20F9FB : D8 12                            extz    wa
28876/20F9FD : D8 80                            add     wa,wa
28877/20F9FF : D3 07 F4 E0 20                   ld      wa,(xiy+wa)
28878/20FA04 : B2 50                            ld      (xde),wa
28879/20FA06 : CA 69                            dec     0x1,b                   ; huit bits : DEC pose les drapeaux
28880/20FA08 : F2 F0 F9 20 DE                   jp       ne,vw_conv
28881/20FA0D :                          vw_conv_done:
28882/20FA0D : AF 14 20                         ld      xwa,(xsp+F_W)
28883/20FA10 : B8 26 43                         ld      (xwa+V_LINE),c
28884/20FA13 :                                  ; !! PAS PAR A : A est l'octet bas de XWA, qui tient le bloc. Une
28885/20FA13 :                                  ; premiere version faisait `ld a,(xsp+F_N)` ici et ecrivait le
28886/20FA13 :                                  ; compteur a 0x..00+37, dans la pile.
28887/20FA13 : 8F 09 22                         ld      b,(xsp+F_N)
28888/20FA16 : B8 25 42                         ld      (xwa+V_N),b
28889/20FA19 : BF 0C 37                         lda     xsp,(xsp+F_SIZE)
28890/20FA1C : 5E                               pop     xiz
28891/20FA1D : 0E                               ret
28892/20FA1E :                          
28893/20FA1E :                          ; ================================================================
28894/20FA1E :                          ; void id_road_ahead_asm(RoadAhead *a);
28895/20FA1E :                          ;
28896/20FA1E :                          ; build_road_ahead() de main.c : pour chaque tranche, du pare-chocs vers
28897/20FA1E :                          ; l'horizon, avancer sur le profil jusqu'a la distance que la tranche regarde,
28898/20FA1E :                          ; puis rendre le virage et la pente a cette distance, joints arrondis. La
28899/20FA1E :                          ; version C reste dans main.c (ID_ROAD_AHEAD_C=1) ; tools/equivalence.py prouve
28900/20FA1E :                          ; que les deux rendent la meme RAM, tour par tour, sur les dix circuits.
28901/20FA1E :                          ;
28902/20FA1E :                          ; Registres pendant la boucle :
28903/20FA1E :                          ;   XIX = &ahead[k]            (descend de 2)
28904/20FA1E :                          ;   XHL = &road_bend[k]        (descend de 2)
28905/20FA1E :                          ;   XBC = &id_grade[k]         (descend de 1 ; id_road_grade_buf)
28906/20FA1E :                          ;   XIY = sc, le segment courant
28907/20FA1E :                          ;   DE  = into, la position dans ce segment
28908/20FA1E :                          ;   XIZ = le bloc (ci-dessous)
28909/20FA1E :                          ;
28910/20FA1E :                          ; SECONDE ECRITURE (2026-09-19) : DEUX CACHES PAR SEGMENT, valables un appel.
28911/20FA1E :                          ; Profil par bloc : le fondu aux jonctions coutait 10 000 cycles par tour et la
28912/20FA1E :                          ; borne de pente + grade_tab 8 000, refaits a CHAQUE tranche alors qu'ils ne
28913/20FA1E :                          ; dependent que du SEGMENT tant qu'on y reste :
28914/20FA1E :                          ;   - la pente a plat d'un segment, bornee et convertie, est la meme pour
28915/20FA1E :                          ;     toutes ses tranches (cle A_FKEY) ;
28916/20FA1E :                          ;   - un fondu melange le segment courant et un voisin avec un poids w : les
28917/20FA1E :                          ;     deux ecarts (voisin - courant, virage et pente) ne dependent que du
28918/20FA1E :                          ;     segment et du cote (cles A_NKEY, A_PKEY). Il ne reste par tranche que les
28919/20FA1E :                          ;     deux multiplications, et la seconde saute quand les deux pentes sont
28920/20FA1E :                          ;     egales -- le cas de toute route plate.
28921/20FA1E :                          ; Les cles sont le numero du segment ; 0xFF = vide (track_len est un u8, un
28922/20FA1E :                          ; numero vaut au plus 254). Le C les vide avant chaque appel.
28923/20FA1E :                          ;
28924/20FA1E :                          ; Le bloc RoadAhead (main.c ; taille VERIFIEE a la compilation) :
28925/20FA1E : =0H                      A_AHEAD  equ 0      ; const u16 * &ahead[lines]            (juste APRES la fin)
28926/20FA1E : =4H                      A_BEND   equ 4      ; s16 *       &road_bend[lines]
28927/20FA1E : =8H                      A_GL     equ 8      ; s8 *        &id_grade[lines]
28928/20FA1E : =0CH                     A_SEG    equ 12     ; const Segment * track_seg
28929/20FA1E : =10H                     A_GTAB   equ 16     ; const s8 *  &grade_tab[HILL_SLOPE_MAX]  (indice signe)
28930/20FA1E : =14H                     A_SC     equ 20     ; const Segment * &track_seg[seg_index]
28931/20FA1E : =18H                     A_INTO   equ 24     ; u16 seg_pos
28932/20FA1E : =1AH                     A_W      equ 26     ; u16 want (temporaire, traversee de segments)
28933/20FA1E : =1CH                     A_K      equ 28     ; u8  lignes (> 0)
28934/20FA1E : =1DH                     A_CUR    equ 29     ; u8  seg_index
28935/20FA1E : =1EH                     A_LEN    equ 30     ; u8  track_len
28936/20FA1E : =1FH                     A_FKEY   equ 31     ; u8  segment de la pente a plat en cache (0xFF = vide)
28937/20FA1E : =20H                     A_FG     equ 32     ; s8  cette pente, bornee et convertie
28938/20FA1E : =21H                     A_NKEY   equ 33     ; u8  segment du fondu vers le SUIVANT en cache
28939/20FA1E : =22H                     A_PKEY   equ 34     ; u8  ... vers le PRECEDENT
