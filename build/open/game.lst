21707/20B9E2 : 0E                               ret
21708/20B9E3 :                          
21709/20B9E3 :                          ; ================================================================
21710/20B9E3 :                          ; void id_road_ahead_asm(RoadAhead *a);
21711/20B9E3 :                          ;
21712/20B9E3 :                          ; build_road_ahead() de main.c : pour chaque tranche, du pare-chocs vers
21713/20B9E3 :                          ; l'horizon, avancer sur le profil jusqu'a la distance que la tranche regarde,
21714/20B9E3 :                          ; puis rendre le virage et la pente a cette distance, joints arrondis. La
21715/20B9E3 :                          ; version C reste dans main.c (ID_ROAD_AHEAD_C=1) ; tools/equivalence.py prouve
21716/20B9E3 :                          ; que les deux rendent la meme RAM, tour par tour, sur les dix circuits.
21717/20B9E3 :                          ;
21718/20B9E3 :                          ; Registres pendant la boucle :
21719/20B9E3 :                          ;   XIX = &ahead[k]            (descend de 2)
21720/20B9E3 :                          ;   XHL = &road_bend[k]        (descend de 2)
21721/20B9E3 :                          ;   XBC = &id_grade[k]         (descend de 1 ; id_road_grade_buf)
21722/20B9E3 :                          ;   XIY = sc, le segment courant
21723/20B9E3 :                          ;   DE  = into, la position dans ce segment
21724/20B9E3 :                          ;   XIZ = le bloc (ci-dessous)
21725/20B9E3 :                          ;
21726/20B9E3 :                          ; SECONDE ECRITURE (2026-09-19) : DEUX CACHES PAR SEGMENT, valables un appel.
21727/20B9E3 :                          ; Profil par bloc : le fondu aux jonctions coutait 10 000 cycles par tour et la
21728/20B9E3 :                          ; borne de pente + grade_tab 8 000, refaits a CHAQUE tranche alors qu'ils ne
21729/20B9E3 :                          ; dependent que du SEGMENT tant qu'on y reste :
21730/20B9E3 :                          ;   - la pente a plat d'un segment, bornee et convertie, est la meme pour
21731/20B9E3 :                          ;     toutes ses tranches (cle A_FKEY) ;
21732/20B9E3 :                          ;   - un fondu melange le segment courant et un voisin avec un poids w : les
21733/20B9E3 :                          ;     deux ecarts (voisin - courant, virage et pente) ne dependent que du
21734/20B9E3 :                          ;     segment et du cote (cles A_NKEY, A_PKEY). Il ne reste par tranche que les
21735/20B9E3 :                          ;     deux multiplications, et la seconde saute quand les deux pentes sont
21736/20B9E3 :                          ;     egales -- le cas de toute route plate.
21737/20B9E3 :                          ; Les cles sont le numero du segment ; 0xFF = vide (track_len est un u8, un
21738/20B9E3 :                          ; numero vaut au plus 254). Le C les vide avant chaque appel.
21739/20B9E3 :                          ;
21740/20B9E3 :                          ; Le bloc RoadAhead (main.c ; taille VERIFIEE a la compilation) :
21741/20B9E3 : =0H                      A_AHEAD  equ 0      ; const u16 * &ahead[lines]            (juste APRES la fin)
21742/20B9E3 : =4H                      A_BEND   equ 4      ; s16 *       &road_bend[lines]
21743/20B9E3 : =8H                      A_GL     equ 8      ; s8 *        &id_grade[lines]
21744/20B9E3 : =0CH                     A_SEG    equ 12     ; const Segment * track_seg
21745/20B9E3 : =10H                     A_GTAB   equ 16     ; const s8 *  &grade_tab[HILL_SLOPE_MAX]  (indice signe)
21746/20B9E3 : =14H                     A_SC     equ 20     ; const Segment * &track_seg[seg_index]
21747/20B9E3 : =18H                     A_INTO   equ 24     ; u16 seg_pos
21748/20B9E3 : =1AH                     A_W      equ 26     ; u16 want (temporaire, traversee de segments)
21749/20B9E3 : =1CH                     A_K      equ 28     ; u8  lignes (> 0)
21750/20B9E3 : =1DH                     A_CUR    equ 29     ; u8  seg_index
21751/20B9E3 : =1EH                     A_LEN    equ 30     ; u8  track_len
21752/20B9E3 : =1FH                     A_FKEY   equ 31     ; u8  segment de la pente a plat en cache (0xFF = vide)
21753/20B9E3 : =20H                     A_FG     equ 32     ; s8  cette pente, bornee et convertie
21754/20B9E3 : =21H                     A_NKEY   equ 33     ; u8  segment du fondu vers le SUIVANT en cache
21755/20B9E3 : =22H                     A_PKEY   equ 34     ; u8  ... vers le PRECEDENT
21756/20B9E3 : =24H                     A_NDB    equ 36     ; s16 suivant->bend - bend
21757/20B9E3 : =26H                     A_NDP    equ 38     ; s16 suivant->slope - slope
21758/20B9E3 : =28H                     A_PDB    equ 40     ; s16 precedent->bend - bend
21759/20B9E3 : =2AH                     A_PDP    equ 42     ; s16 precedent->slope - slope
21760/20B9E3 :                          ; Segment : span u16 +0, bend s16 +2, slope s8 +4, six octets.
21761/20B9E3 :                          
21762/20B9E3 :                          
21763/20B9E3 :                          _id_road_ahead_asm:
21764/20B9E3 : 3E                               push    xiz
21765/20B9E4 : AF 08 26                         ld      xiz,(xsp+0x8)
21766/20B9E7 : A6 24                            ld      xix,(xiz+A_AHEAD)
21767/20B9E9 : AE 04 23                         ld      xhl,(xiz+A_BEND)
21768/20B9EC : AE 08 21                         ld      xbc,(xiz+A_GL)
21769/20B9EF : AE 14 25                         ld      xiy,(xiz+A_SC)
21770/20B9F2 : 9E 18 22                         ld      de,(xiz+A_INTO)
21771/20B9F5 :                                  ; la PREMIERE tranche : walked vaut 0
21772/20B9F5 : EC 6A                            dec     0x2,xix
21773/20B9F7 : EB 6A                            dec     0x2,xhl
21774/20B9F9 : E9 69                            dec     0x1,xbc
21775/20B9FB : 94 20                            ld      wa,(xix)
21776/20B9FD : 1B 0C BA 20                      jp       ah_want
21777/20BA01 :                          
21778/20BA01 :                          _id_road_ahead_asm__L1:
21779/20BA01 :                          ah_slice:
21780/20BA01 : EC 6A                            dec     0x2,xix
21781/20BA03 : EB 6A                            dec     0x2,xhl
21782/20BA05 : E9 69                            dec     0x1,xbc
21783/20BA07 :                                  ; want = ahead[k] - walked, et walked est ahead[k+1] : la tranche
21784/20BA07 :                                  ; d'avant, deux octets plus haut dans le meme tableau
21785/20BA07 : 94 20                            ld      wa,(xix)
21786/20BA09 : 9C 02 A0                         sub     wa,(xix+0x2)
21787/20BA0C :                          _id_road_ahead_asm__L2:
21788/20BA0C :                          ah_want:
21789/20BA0C :                                  ; LE CAS COURANT SANS MEMOIRE : into += want, et si ca reste dans le
21790/20BA0C :                                  ; segment, c'est fini. (u16)(into + want) >= span se lit sur DE lui-meme.
21791/20BA0C : D8 82                            add     de,wa
21792/20BA0E : 95 F2                            cp      de,(xiy)
21793/20BA10 : F2 56 BA 20 D7                   jp       ult,ah_seg_ok
21794/20BA15 : D8 A2                            sub     de,wa                   ; on defait, et on marche segment par segment
21795/20BA17 : BE 1A 50                         ld      (xiz+A_W),wa
21796/20BA1A :                          _id_road_ahead_asm__L3:
21797/20BA1A :                          ah_seg:
21798/20BA1A : DA 88                            ld      wa,de
21799/20BA1C : 9E 1A 80                         add     wa,(xiz+A_W)
21800/20BA1F : 95 F0                            cp      wa,(xiy)
21801/20BA21 : F2 53 BA 20 D7                   jp       ult,ah_seg_last
21802/20BA26 : 95 20                            ld      wa,(xiy)                ; want -= span - into
21803/20BA28 : DA A0                            sub     wa,de                   ; (formes emises par cc900 ; l'ancien
21804/20BA2A : 9E 1A A8                         sub     (xiz+A_W),wa            ;  `sub wa,(xiy)` n'en etait pas une)
21805/20BA2D : 8E 1D 21                         ld      a,(xiz+A_CUR)           ; le voisin SANS modulo
21806/20BA30 : C9 61                            inc     0x1,a
21807/20BA32 : 8E 1E F1                         cp      a,(xiz+A_LEN)
21808/20BA35 : F2 3C BA 20 D7                   jp       ult,ah_cur_ok
21809/20BA3A : C9 A8                            ld      a,0x0
21810/20BA3C :                          ah_cur_ok:
21811/20BA3C : BE 1D 41                         ld      (xiz+A_CUR),a
21812/20BA3F : D8 12                            extz    wa
21813/20BA41 : D8 09 06 00                      muls    xwa,0x6
21814/20BA45 : AE 0C 25                         ld      xiy,(xiz+A_SEG)
21815/20BA48 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa)
21816/20BA4D : DA A8                            ld      de,0x0
21817/20BA4F : 1B 1A BA 20                      jp       ah_seg
21818/20BA53 :                          ah_seg_last:
21819/20BA53 : 9E 1A 82                         add     de,(xiz+A_W)            ; into += want
21820/20BA56 :                          _id_road_ahead_asm__L4:
21821/20BA56 :                          ah_seg_ok:
21822/20BA56 :                                  ; rem = span - into
21823/20BA56 : 95 20                            ld      wa,(xiy)
21824/20BA58 : DA A0                            sub     wa,de
21825/20BA5A : DA F0                            cp      wa,de
21826/20BA5C : F2 CD BA 20 DB                   jp       ugt,ah_prev             ; pas (rem <= into)
21827/20BA61 : D8 CF 80 00                      cp      wa,0x80
21828/20BA65 : F2 CD BA 20 DF                   jp       uge,ah_prev             ; pas (rem < BEND_HALF)
21829/20BA6A : D8 07                            neg     wa                      ; w = BEND_HALF - rem
21830/20BA6C : D8 C8 80 00                      add     wa,0x80
21831/20BA70 : 3A                               push    xde
21832/20BA71 : D8 8A                            ld      de,wa                   ; DE = w pendant le fondu
21833/20BA73 : 8E 1D 21                         ld      a,(xiz+A_CUR)
21834/20BA76 : 8E 21 F1                         cp      a,(xiz+A_NKEY)
21835/20BA79 : F2 B9 BA 20 D6                   jp       eq,ah_nhit
21836/20BA7E :                                  ; ---- les ecarts vers le SUIVANT, une fois par segment
21837/20BA7E : BE 21 41                         ld      (xiz+A_NKEY),a
21838/20BA81 : C9 61                            inc     0x1,a                   ; other = cursor + 1, sans modulo
21839/20BA83 : 8E 1E F1                         cp      a,(xiz+A_LEN)
21840/20BA86 : F2 8D BA 20 D7                   jp       ult,ah_nseg
21841/20BA8B : C9 A8                            ld      a,0x0
21842/20BA8D :                          ah_nseg:
21843/20BA8D : D8 12                            extz    wa
21844/20BA8F : D8 09 06 00                      muls    xwa,0x6
21845/20BA93 : 3D                               push    xiy
21846/20BA94 : AE 0C 25                         ld      xiy,(xiz+A_SEG)
21847/20BA97 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa); XIY = sn
21848/20BA9C : 9D 02 20                         ld      wa,(xiy+0x2)
21849/20BA9F : BE 24 50                         ld      (xiz+A_NDB),wa
21850/20BAA2 : 8D 04 21                         ld      a,(xiy+0x4)
21851/20BAA5 : D8 13                            exts    wa
21852/20BAA7 : BE 26 50                         ld      (xiz+A_NDP),wa
21853/20BAAA : 5D                               pop     xiy                     ; XIY = sc
21854/20BAAB : 9D 02 20                         ld      wa,(xiy+0x2)
21855/20BAAE : 9E 24 A8                         sub     (xiz+A_NDB),wa          ; (s16)(sn->bend - b)
21856/20BAB1 : 8D 04 21                         ld      a,(xiy+0x4)
21857/20BAB4 : D8 13                            exts    wa
21858/20BAB6 : 9E 26 A8                         sub     (xiz+A_NDP),wa          ; (s16)sn->slope - p
21859/20BAB9 :                          _id_road_ahead_asm__L5:
21860/20BAB9 :                          ah_nhit:
21861/20BAB9 :                                  ; road_bend[k] = b + (s16)(((s16)(sn->bend - b) * (s16)w) >> 8)
21862/20BAB9 : 9E 24 20                         ld      wa,(xiz+A_NDB)
21863/20BABC : DA 48                            muls    xwa,de
21864/20BABE : D8 ED 08                         sra     0x8,wa
21865/20BAC1 : 9D 02 80                         add     wa,(xiy+0x2)
21866/20BAC4 : B3 50                            ld      (xhl),wa
21867/20BAC6 : 9E 26 20                         ld      wa,(xiz+A_NDP)
21868/20BAC9 : 1B 37 BB 20                      jp       ah_blend_slope
21869/20BACD :                          
21870/20BACD :                          _id_road_ahead_asm__L6:
21871/20BACD :                          ah_prev:
21872/20BACD : DA CF 80 00                      cp      de,0x80
21873/20BAD1 : F2 50 BB 20 DF                   jp       uge,ah_flat             ; loin des deux joints : le cas courant
21874/20BAD6 : DA 88                            ld      wa,de                   ; w = BEND_HALF - into
21875/20BAD8 : D8 07                            neg     wa
21876/20BADA : D8 C8 80 00                      add     wa,0x80
21877/20BADE : 3A                               push    xde
21878/20BADF : D8 8A                            ld      de,wa                   ; DE = w pendant le fondu
21879/20BAE1 : 8E 1D 21                         ld      a,(xiz+A_CUR)
21880/20BAE4 : 8E 22 F1                         cp      a,(xiz+A_PKEY)
21881/20BAE7 : F2 27 BB 20 D6                   jp       eq,ah_phit
21882/20BAEC :                                  ; ---- les ecarts vers le PRECEDENT, une fois par segment
21883/20BAEC : BE 22 41                         ld      (xiz+A_PKEY),a
21884/20BAEF : C9 D8                            cp      a,0x0                   ; other = cursor ? cursor - 1 : len - 1
21885/20BAF1 : F2 F9 BA 20 DE                   jp       ne,ah_prev_dec
21886/20BAF6 : 8E 1E 21                         ld      a,(xiz+A_LEN)
21887/20BAF9 :                          ah_prev_dec:
21888/20BAF9 : C9 69                            dec     0x1,a
21889/20BAFB : D8 12                            extz    wa
21890/20BAFD : D8 09 06 00                      muls    xwa,0x6
21891/20BB01 : 3D                               push    xiy
21892/20BB02 : AE 0C 25                         ld      xiy,(xiz+A_SEG)
21893/20BB05 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa); XIY = sn
21894/20BB0A : 9D 02 20                         ld      wa,(xiy+0x2)
21895/20BB0D : BE 28 50                         ld      (xiz+A_PDB),wa
21896/20BB10 : 8D 04 21                         ld      a,(xiy+0x4)
21897/20BB13 : D8 13                            exts    wa
21898/20BB15 : BE 2A 50                         ld      (xiz+A_PDP),wa
21899/20BB18 : 5D                               pop     xiy                     ; XIY = sc
21900/20BB19 : 9D 02 20                         ld      wa,(xiy+0x2)
21901/20BB1C : 9E 28 A8                         sub     (xiz+A_PDB),wa
21902/20BB1F : 8D 04 21                         ld      a,(xiy+0x4)
