27962/20F217 :                          
27963/20F217 :                          ; ---- src/id_road_asm.asm
27964/20F217 :                          ; id_road_asm.asm - la marche par tranches de id_road_write(), en assembleur
27965/20F217 :                          ;
27966/20F217 :                          ; POURQUOI EN ASSEMBLEUR. Profil de la ROM livree (tools/profil_course.py,
27967/20F217 :                          ; temporisation de la cartouche comprise) : cette boucle etait le plus gros
27968/20F217 :                          ; poste du tour de course. cc900 n'y gardait pas ses valeurs en registres --
27969/20F217 :                          ; tout allait sur la pile -- et relisait chaque adresse de table par une
27970/20F217 :                          ; instruction de cinq octets, cinquante-six fois par trame. Sur cette machine
27971/20F217 :                          ; chaque octet d'instruction se lit dans la cartouche.
27972/20F217 :                          ;
27973/20F217 :                          ; LE CALCUL EST CELUI DU C, A L'OCTET PRES : la version C est gardee dans
27974/20F217 :                          ; id_road.c (ID_ROAD_WALK_C=1) et tools/equivalence.py compare, tour de boucle
27975/20F217 :                          ; par tour de boucle, la RAM de cette ROM a celle de la ROM d'origine sur les
27976/20F217 :                          ; dix circuits.
27977/20F217 :                          ;
27978/20F217 :                          ; !! SEULEMENT DES FORMES QUE cc900 EMET DEJA. Les pieges materiel connus de ce
27979/20F217 :                          ; processeur (docs du projet, fiches) venaient d'encodages que Toshiba n'emet
27980/20F217 :                          ; pas. `python tools/formes_asm.py` verifie chaque instruction de ce fichier
27981/20F217 :                          ; contre le code que cc900 genere pour ce projet (build/prof_asm/*.asm).
27982/20F217 :                          ;
27983/20F217 :                          ; void id_road_walk_asm(RoadWalk *w);
27984/20F217 :                          ;
27985/20F217 :                          ;   (xsp+0) adresse de retour, 4 octets ; (xsp+4) w.
27986/20F217 :                          ;   cc900 : seul XIZ doit etre preserve (ses fonctions le poussent quand elles
27987/20F217 :                          ;   s'en servent) ; XWA XBC XDE XHL XIX XIY sont a l'appele.
27988/20F217 :                          ;
27989/20F217 :                          ; SECONDE ECRITURE (2026-09-19). La premiere relisait dans le bloc, a chaque
27990/20F217 :                          ; tranche, sept pointeurs de table et l'accumulateur : 44 500 cycles par tour.
27991/20F217 :                          ; Celle-ci tient toute la marche en registres :
27992/20F217 :                          ;
27993/20F217 :                          ;   XIX = &id_line_of[k]   (descend de 1)   la pente a +SL_GRADE, la bande a +SL_BANDI
27994/20F217 :                          ;   XIY = &id_shear[k]     (descend de 2)
27995/20F217 :                          ;   XHL = &xy[ligne]       (descend de 2 par ligne ecrite)
27996/20F217 :                          ;   XDE = &bande[ligne]    (descend de 2 par ligne ecrite)
27997/20F217 :                          ;   B   = l'accumulateur   C = la ligne courante (>= top : tient sur un octet)
27998/20F217 :                          ;   XIZ = &hill_rate[20]   (la cadence, indice signe)
27999/20F217 :                          ;
28000/20F217 :                          ; Les valeurs fixes du bloc sont RECOPIEES sur la pile de la routine (F_*) et
28001/20F217 :                          ; lues par (xsp+d) : c'est ce qui libere XIZ pour la table des cadences.
28002/20F217 :                          ;
28003/20F217 :                          ; LES DEUX RETENUES SANS SEIZE BITS. c = (acc + 2 rate) >> 8 et le nouvel
28004/20F217 :                          ; accumulateur est l'octet bas : c'est exactement le nombre de retenues de deux
28005/20F217 :                          ; additions de `rate` sur huit bits, et l'octet restant.
28006/20F217 :                          ;
28007/20F217 :                          ; LA LIGNE Y. (u8)((row >> 8) - (u8)(scr - plane0)) = (row >> 8) + plane0 - scr
28008/20F217 :                          ; modulo 256 : les deux formes rendent le meme octet.
28009/20F217 :                          ;
28010/20F217 :                          ; LA COULEUR DE BANDE EN DEUX TEMPS. band_col[lut[id_bandi[k]]] demande deux
28011/20F217 :                          ; pointeurs de table et la marche n'a plus de registre. Elle pose donc l'INDICE
28012/20F217 :                          ; id_bandi[k] dans l'octet bas de l'entree du tampon de couleur, et une passe
28013/20F217 :                          ; courte, apres elle, le convertit sur les seules lignes ecrites. Aucun octet de
28014/20F217 :                          ; RAM de plus : la pile n'en a pas a donner (voir RoadSlices dans id_road.c).
28015/20F217 :                          ;
28016/20F217 :                          
28017/20F217 :                          ; Le bloc RoadWalk (id_road.c ; sa TAILLE y est VERIFIEE a la compilation) :
28018/20F217 : =0H                      V_XY      equ 0     ; u16 * &xy[road_bottom]
28019/20F217 : =4H                      V_BAND    equ 4     ; u16 * &bandcol[road_bottom]
28020/20F217 : =8H                      V_SL      equ 8     ; u8  * &id_line_of[lines]   (juste APRES la fin)
28021/20F217 : =0CH                     V_SH      equ 12    ; s16 * &id_shear[lines]     (juste APRES la fin)
28022/20F217 : =10H                     V_RTAB    equ 16    ; u8  * &hill_rate[20]
28023/20F217 : =14H                     V_LUT     equ 20    ; u8  * ligne de band_lut de cette trame
28024/20F217 : =18H                     V_BCOL    equ 24    ; u16 * band_col
28025/20F217 : =1CH                     V_ROW     equ 28    ; u16  row_fx     (8.8)
28026/20F217 : =1EH                     V_STEP    equ 30    ; u16  step_fx
28027/20F217 : =20H                     V_HALF    equ 32    ; u16  (u16)step_fx >> 1
28028/20F217 : =22H                     V_TOP     equ 34    ; u8   top_limit        } recopies d'un mot
28029/20F217 : =23H                     V_PLANE0  equ 35    ; u8   road_plane0      }
28030/20F217 : =24H                     V_BASEX   equ 36    ; u8   road_base_x      } recopies d'un mot
28031/20F217 : =25H                     V_N       equ 37    ; u8   entree : lines ; sortie : k + 1
28032/20F217 : =26H                     V_LINE    equ 38    ; u8   entree : road_bottom ; sortie : la ligne a l'arret
28033/20F217 :                          ; Les tableaux voisins de id_line_of (RoadSlices dans id_road.c) :
28034/20F217 : =40H                     SL_GRADE  equ 64    ; id_grade[k] = id_line_of[k] + 64
28035/20F217 : =80H                     SL_BANDI  equ 128   ; id_bandi[k] = id_line_of[k] + 128
28036/20F217 :                          ; Le cadre de la routine, sous la sauvegarde de XIZ :
28037/20F217 : =0H                      F_ROW     equ 0     ; u16  row_fx (modifie)
28038/20F217 : =2H                      F_STEP    equ 2
28039/20F217 : =4H                      F_HALF    equ 4
28040/20F217 : =6H                      F_TOP     equ 6
28041/20F217 : =7H                      F_PLANE0  equ 7
28042/20F217 : =8H                      F_BASEX   equ 8
28043/20F217 : =9H                      F_N       equ 9     ; le compteur de tranches
28044/20F217 : =0AH                     F_BOT     equ 10    ; road_bottom
28045/20F217 : =0CH                     F_SIZE    equ 12
28046/20F217 : =14H                     F_W       equ 20    ; w : F_SIZE + XIZ (4) + adresse de retour (4)
28047/20F217 :                          
28048/20F217 :                          
28049/20F217 :                          
28050/20F217 :                          
28051/20F217 :                          _id_road_walk_asm:
28052/20F217 : 3E                               push    xiz
28053/20F218 : AF 08 20                         ld      xwa,(xsp+0x8)           ; w
28054/20F21B : BF F4 37                         lda     xsp,(xsp-F_SIZE)
28055/20F21E : 98 1C 21                         ld      bc,(xwa+V_ROW)
28056/20F221 : B7 51                            ld      (xsp+F_ROW),bc
28057/20F223 : 98 1E 21                         ld      bc,(xwa+V_STEP)
28058/20F226 : BF 02 51                         ld      (xsp+F_STEP),bc
28059/20F229 : 98 20 21                         ld      bc,(xwa+V_HALF)
28060/20F22C : BF 04 51                         ld      (xsp+F_HALF),bc
28061/20F22F : 98 22 21                         ld      bc,(xwa+V_TOP)          ; top et plane0
28062/20F232 : BF 06 51                         ld      (xsp+F_TOP),bc
28063/20F235 : 98 24 21                         ld      bc,(xwa+V_BASEX)        ; base_x et le compteur
28064/20F238 : BF 08 51                         ld      (xsp+F_BASEX),bc
28065/20F23B : 88 26 23                         ld      c,(xwa+V_LINE)          ; la ligne : road_bottom, >= top (le C le verifie)
28066/20F23E : BF 0A 43                         ld      (xsp+F_BOT),c
28067/20F241 : A0 23                            ld      xhl,(xwa+V_XY)
28068/20F243 : A8 04 22                         ld      xde,(xwa+V_BAND)
28069/20F246 : A8 08 24                         ld      xix,(xwa+V_SL)
28070/20F249 : A8 0C 25                         ld      xiy,(xwa+V_SH)
28071/20F24C : A8 10 26                         ld      xiz,(xwa+V_RTAB)
28072/20F24F : CA A8                            ld      b,0x0                   ; l'accumulateur part de zero, CHAQUE trame
28073/20F251 :                          
28074/20F251 :                          vw_slice:
28075/20F251 : EC 69                            dec     0x1,xix
28076/20F253 : ED 6A                            dec     0x2,xiy
28077/20F255 :                                  ; ou va la tranche : id_line_of[k] = max(ligne, top) = la ligne, puisque
28078/20F255 :                                  ; la marche s'arrete des qu'elle passe sous top
28079/20F255 : B4 43                            ld      (xix),c
28080/20F257 :                                  ; ---- la cadence : hill_rate[20 + id_grade[k]]
28081/20F257 : 8C 40 21                         ld      a,(xix+SL_GRADE)
28082/20F25A : D8 13                            exts    wa
28083/20F25C : C3 07 F8 E0 21                   ld      a,(xiz+wa)
28084/20F261 : C9 88                            ld      w,a
28085/20F263 :                                  ; ---- les deux retenues : A = acc + rate + rate, sur huit bits
28086/20F263 : CA 89                            ld      a,b
28087/20F265 : C8 81                            add     a,w
28088/20F267 : F2 79 F2 20 D7                   jp       ult,vw_c1               ; premiere retenue
28089/20F26C : C8 81                            add     a,w
28090/20F26E : F2 80 F2 20 D7                   jp       ult,vw_one              ; une seule retenue : une ligne
28091/20F273 : C9 8A                            ld      b,a                     ; aucune : la tranche ne prend pas de ligne
28092/20F275 : 1B F6 F2 20                      jp       vw_next
28093/20F279 :                          vw_c1:
28094/20F279 : C8 81                            add     a,w
28095/20F27B : F2 A4 F2 20 D7                   jp       ult,vw_two              ; deux retenues : deux lignes
28096/20F280 :                          vw_one:
28097/20F280 : C9 8A                            ld      b,a
28098/20F282 :                                  ; ---- une ligne, a la rangee de la tranche
28099/20F282 : 8F 01 21                         ld      a,(xsp+F_ROW+1)         ; (u8)(row_fx >> 8)
28100/20F285 : 8F 07 81                         add     a,(xsp+F_PLANE0)
28101/20F288 : CB A1                            sub     a,c
28102/20F28A : C9 88                            ld      w,a
28103/20F28C : 85 21                            ld      a,(xiy)                 ; (u8)dx
28104/20F28E : 8F 08 81                         add     a,(xsp+F_BASEX)
28105/20F291 : B3 50                            ld      (xhl),wa
28106/20F293 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)        ; l'indice de bande, converti plus bas
28107/20F298 : B2 41                            ld      (xde),a
28108/20F29A : EB 6A                            dec     0x2,xhl
28109/20F29C : EA 6A                            dec     0x2,xde
28110/20F29E : CB 69                            dec     0x1,c
28111/20F2A0 : 1B F6 F2 20                      jp       vw_next
28112/20F2A4 :                          
28113/20F2A4 :                          vw_two:
28114/20F2A4 : C9 8A                            ld      b,a
28115/20F2A6 :                                  ; ---- premiere ligne, a la rangee de la tranche
28116/20F2A6 : 8F 01 21                         ld      a,(xsp+F_ROW+1)
28117/20F2A9 : 8F 07 81                         add     a,(xsp+F_PLANE0)
28118/20F2AC : CB A1                            sub     a,c
28119/20F2AE : C9 88                            ld      w,a
28120/20F2B0 : 85 21                            ld      a,(xiy)
28121/20F2B2 : 8F 08 81                         add     a,(xsp+F_BASEX)
28122/20F2B5 : B3 50                            ld      (xhl),wa
28123/20F2B7 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
28124/20F2BC : B2 41                            ld      (xde),a
28125/20F2BE : EB 6A                            dec     0x2,xhl
28126/20F2C0 : EA 6A                            dec     0x2,xde
28127/20F2C2 : CB 69                            dec     0x1,c
28128/20F2C4 :                                  ; ---- seconde ligne, seulement si elle reste sur l'ecran, a mi-marche
28129/20F2C4 : 8F 06 F3                         cp      c,(xsp+F_TOP)
28130/20F2C7 : F2 F6 F2 20 D7                   jp       ult,vw_next
28131/20F2CC : 97 20                            ld      wa,(xsp+F_ROW)
28132/20F2CE : 9F 04 F0                         cp      wa,(xsp+F_HALF)
28133/20F2D1 : F2 D9 F2 20 D3                   jp       ule,vw_mid              ; row_fx <= half : pas sous la rangee 0
28134/20F2D6 : 9F 04 A0                         sub     wa,(xsp+F_HALF)
28135/20F2D9 :                          vw_mid:
28136/20F2D9 : C8 89                            ld      a,w                     ; (u8)(mid >> 8)
28137/20F2DB : 8F 07 81                         add     a,(xsp+F_PLANE0)
28138/20F2DE : CB A1                            sub     a,c
28139/20F2E0 : C9 88                            ld      w,a
28140/20F2E2 : 85 21                            ld      a,(xiy)
28141/20F2E4 : 8F 08 81                         add     a,(xsp+F_BASEX)
28142/20F2E7 : B3 50                            ld      (xhl),wa
28143/20F2E9 : C3 F1 80 00 21                   ld      a,(xix+SL_BANDI)
28144/20F2EE : B2 41                            ld      (xde),a
28145/20F2F0 : EB 6A                            dec     0x2,xhl
28146/20F2F2 : EA 6A                            dec     0x2,xde
28147/20F2F4 : CB 69                            dec     0x1,c
28148/20F2F6 :                          
28149/20F2F6 :                          vw_next:
28150/20F2F6 :                                  ; TOUJOURS, meme pour une tranche qui n'a pris aucune ligne
28151/20F2F6 : 9F 02 20                         ld      wa,(xsp+F_STEP)
28152/20F2F9 : 97 A8                            sub     (xsp+F_ROW),wa
28153/20F2FB : 8F 06 F3                         cp      c,(xsp+F_TOP)
28154/20F2FE : F2 0B F3 20 D7                   jp       ult,vw_done             ; plus d'ecran : le compteur reste k + 1
28155/20F303 : 8F 09 69                         decb    0x1,(xsp+F_N)
28156/20F306 : F2 51 F2 20 DE                   jp       ne,vw_slice             ; au bout : 0, soit k = -1
28157/20F30B :                          
28158/20F30B :                          vw_done:
28159/20F30B :                                  ; ---- les indices de bande deviennent des couleurs, lignes C+1..bas.
28160/20F30B :                                  ; XDE pointe l'entree de la ligne C (la prochaine qu'on aurait ecrite).
28161/20F30B : 8F 0A 21                         ld      a,(xsp+F_BOT)
28162/20F30E : CB A1                            sub     a,c
28163/20F310 : F2 3D F3 20 D6                   jp       eq,vw_conv_done         ; aucune ligne ecrite
28164/20F315 : C9 8A                            ld      b,a
28165/20F317 : AF 14 20                         ld      xwa,(xsp+F_W)
28166/20F31A : A8 14 24                         ld      xix,(xwa+V_LUT)
28167/20F31D : A8 18 25                         ld      xiy,(xwa+V_BCOL)
28168/20F320 :                          vw_conv:
28169/20F320 : EA 62                            inc     0x2,xde
28170/20F322 : 82 21                            ld      a,(xde)
28171/20F324 : D8 12                            extz    wa
28172/20F326 : C3 07 F0 E0 21                   ld      a,(xix+wa)
28173/20F32B : D8 12                            extz    wa
28174/20F32D : D8 80                            add     wa,wa
28175/20F32F : D3 07 F4 E0 20                   ld      wa,(xiy+wa)
28176/20F334 : B2 50                            ld      (xde),wa
28177/20F336 : CA 69                            dec     0x1,b                   ; huit bits : DEC pose les drapeaux
28178/20F338 : F2 20 F3 20 DE                   jp       ne,vw_conv
28179/20F33D :                          vw_conv_done:
28180/20F33D : AF 14 20                         ld      xwa,(xsp+F_W)
28181/20F340 : B8 26 43                         ld      (xwa+V_LINE),c
28182/20F343 :                                  ; !! PAS PAR A : A est l'octet bas de XWA, qui tient le bloc. Une
28183/20F343 :                                  ; premiere version faisait `ld a,(xsp+F_N)` ici et ecrivait le
28184/20F343 :                                  ; compteur a 0x..00+37, dans la pile.
28185/20F343 : 8F 09 22                         ld      b,(xsp+F_N)
28186/20F346 : B8 25 42                         ld      (xwa+V_N),b
28187/20F349 : BF 0C 37                         lda     xsp,(xsp+F_SIZE)
28188/20F34C : 5E                               pop     xiz
28189/20F34D : 0E                               ret
28190/20F34E :                          
28191/20F34E :                          ; ================================================================
28192/20F34E :                          ; void id_road_ahead_asm(RoadAhead *a);
28193/20F34E :                          ;
28194/20F34E :                          ; build_road_ahead() de main.c : pour chaque tranche, du pare-chocs vers
28195/20F34E :                          ; l'horizon, avancer sur le profil jusqu'a la distance que la tranche regarde,
28196/20F34E :                          ; puis rendre le virage et la pente a cette distance, joints arrondis. La
28197/20F34E :                          ; version C reste dans main.c (ID_ROAD_AHEAD_C=1) ; tools/equivalence.py prouve
28198/20F34E :                          ; que les deux rendent la meme RAM, tour par tour, sur les dix circuits.
28199/20F34E :                          ;
28200/20F34E :                          ; Registres pendant la boucle :
28201/20F34E :                          ;   XIX = &ahead[k]            (descend de 2)
28202/20F34E :                          ;   XHL = &road_bend[k]        (descend de 2)
28203/20F34E :                          ;   XBC = &id_grade[k]         (descend de 1 ; id_road_grade_buf)
28204/20F34E :                          ;   XIY = sc, le segment courant
28205/20F34E :                          ;   DE  = into, la position dans ce segment
28206/20F34E :                          ;   XIZ = le bloc (ci-dessous)
28207/20F34E :                          ;
28208/20F34E :                          ; SECONDE ECRITURE (2026-09-19) : DEUX CACHES PAR SEGMENT, valables un appel.
28209/20F34E :                          ; Profil par bloc : le fondu aux jonctions coutait 10 000 cycles par tour et la
28210/20F34E :                          ; borne de pente + grade_tab 8 000, refaits a CHAQUE tranche alors qu'ils ne
28211/20F34E :                          ; dependent que du SEGMENT tant qu'on y reste :
28212/20F34E :                          ;   - la pente a plat d'un segment, bornee et convertie, est la meme pour
28213/20F34E :                          ;     toutes ses tranches (cle A_FKEY) ;
28214/20F34E :                          ;   - un fondu melange le segment courant et un voisin avec un poids w : les
28215/20F34E :                          ;     deux ecarts (voisin - courant, virage et pente) ne dependent que du
28216/20F34E :                          ;     segment et du cote (cles A_NKEY, A_PKEY). Il ne reste par tranche que les
28217/20F34E :                          ;     deux multiplications, et la seconde saute quand les deux pentes sont
28218/20F34E :                          ;     egales -- le cas de toute route plate.
28219/20F34E :                          ; Les cles sont le numero du segment ; 0xFF = vide (track_len est un u8, un
28220/20F34E :                          ; numero vaut au plus 254). Le C les vide avant chaque appel.
28221/20F34E :                          ;
28222/20F34E :                          ; Le bloc RoadAhead (main.c ; taille VERIFIEE a la compilation) :
28223/20F34E : =0H                      A_AHEAD  equ 0      ; const u16 * &ahead[lines]            (juste APRES la fin)
28224/20F34E : =4H                      A_BEND   equ 4      ; s16 *       &road_bend[lines]
28225/20F34E : =8H                      A_GL     equ 8      ; s8 *        &id_grade[lines]
28226/20F34E : =0CH                     A_SEG    equ 12     ; const Segment * track_seg
28227/20F34E : =10H                     A_GTAB   equ 16     ; const s8 *  &grade_tab[HILL_SLOPE_MAX]  (indice signe)
28228/20F34E : =14H                     A_SC     equ 20     ; const Segment * &track_seg[seg_index]
28229/20F34E : =18H                     A_INTO   equ 24     ; u16 seg_pos
28230/20F34E : =1AH                     A_W      equ 26     ; u16 want (temporaire, traversee de segments)
28231/20F34E : =1CH                     A_K      equ 28     ; u8  lignes (> 0)
28232/20F34E : =1DH                     A_CUR    equ 29     ; u8  seg_index
28233/20F34E : =1EH                     A_LEN    equ 30     ; u8  track_len
28234/20F34E : =1FH                     A_FKEY   equ 31     ; u8  segment de la pente a plat en cache (0xFF = vide)
28235/20F34E : =20H                     A_FG     equ 32     ; s8  cette pente, bornee et convertie
28236/20F34E : =21H                     A_NKEY   equ 33     ; u8  segment du fondu vers le SUIVANT en cache
28237/20F34E : =22H                     A_PKEY   equ 34     ; u8  ... vers le PRECEDENT
28238/20F34E : =24H                     A_NDB    equ 36     ; s16 suivant->bend - bend
28239/20F34E : =26H                     A_NDP    equ 38     ; s16 suivant->slope - slope
28240/20F34E : =28H                     A_PDB    equ 40     ; s16 precedent->bend - bend
28241/20F34E : =2AH                     A_PDP    equ 42     ; s16 precedent->slope - slope
28242/20F34E :                          ; Segment : span u16 +0, bend s16 +2, slope s8 +4, six octets.
28243/20F34E :                          
28244/20F34E :                          
28245/20F34E :                          _id_road_ahead_asm:
28246/20F34E : 3E                               push    xiz
28247/20F34F : AF 08 26                         ld      xiz,(xsp+0x8)
28248/20F352 : A6 24                            ld      xix,(xiz+A_AHEAD)
28249/20F354 : AE 04 23                         ld      xhl,(xiz+A_BEND)
28250/20F357 : AE 08 21                         ld      xbc,(xiz+A_GL)
28251/20F35A : AE 14 25                         ld      xiy,(xiz+A_SC)
28252/20F35D : 9E 18 22                         ld      de,(xiz+A_INTO)
28253/20F360 :                                  ; la PREMIERE tranche : walked vaut 0
28254/20F360 : EC 6A                            dec     0x2,xix
28255/20F362 : EB 6A                            dec     0x2,xhl
28256/20F364 : E9 69                            dec     0x1,xbc
28257/20F366 : 94 20                            ld      wa,(xix)
28258/20F368 : 1B 77 F3 20                      jp       ah_want
28259/20F36C :                          
28260/20F36C :                          _id_road_ahead_asm__L1:
28261/20F36C :                          ah_slice:
28262/20F36C : EC 6A                            dec     0x2,xix
28263/20F36E : EB 6A                            dec     0x2,xhl
28264/20F370 : E9 69                            dec     0x1,xbc
28265/20F372 :                                  ; want = ahead[k] - walked, et walked est ahead[k+1] : la tranche
28266/20F372 :                                  ; d'avant, deux octets plus haut dans le meme tableau
28267/20F372 : 94 20                            ld      wa,(xix)
28268/20F374 : 9C 02 A0                         sub     wa,(xix+0x2)
28269/20F377 :                          _id_road_ahead_asm__L2:
28270/20F377 :                          ah_want:
28271/20F377 :                                  ; LE CAS COURANT SANS MEMOIRE : into += want, et si ca reste dans le
28272/20F377 :                                  ; segment, c'est fini. (u16)(into + want) >= span se lit sur DE lui-meme.
28273/20F377 : D8 82                            add     de,wa
28274/20F379 : 95 F2                            cp      de,(xiy)
28275/20F37B : F2 C1 F3 20 D7                   jp       ult,ah_seg_ok
28276/20F380 : D8 A2                            sub     de,wa                   ; on defait, et on marche segment par segment
28277/20F382 : BE 1A 50                         ld      (xiz+A_W),wa
28278/20F385 :                          _id_road_ahead_asm__L3:
28279/20F385 :                          ah_seg:
28280/20F385 : DA 88                            ld      wa,de
28281/20F387 : 9E 1A 80                         add     wa,(xiz+A_W)
28282/20F38A : 95 F0                            cp      wa,(xiy)
28283/20F38C : F2 BE F3 20 D7                   jp       ult,ah_seg_last
28284/20F391 : 95 20                            ld      wa,(xiy)                ; want -= span - into
28285/20F393 : DA A0                            sub     wa,de                   ; (formes emises par cc900 ; l'ancien
28286/20F395 : 9E 1A A8                         sub     (xiz+A_W),wa            ;  `sub wa,(xiy)` n'en etait pas une)
28287/20F398 : 8E 1D 21                         ld      a,(xiz+A_CUR)           ; le voisin SANS modulo
28288/20F39B : C9 61                            inc     0x1,a
28289/20F39D : 8E 1E F1                         cp      a,(xiz+A_LEN)
28290/20F3A0 : F2 A7 F3 20 D7                   jp       ult,ah_cur_ok
28291/20F3A5 : C9 A8                            ld      a,0x0
28292/20F3A7 :                          ah_cur_ok:
28293/20F3A7 : BE 1D 41                         ld      (xiz+A_CUR),a
28294/20F3AA : D8 12                            extz    wa
28295/20F3AC : D8 09 06 00                      muls    xwa,0x6
28296/20F3B0 : AE 0C 25                         ld      xiy,(xiz+A_SEG)
28297/20F3B3 : F3 07 F4 E0 35                   lda     xiy,(xiy+wa)
28298/20F3B8 : DA A8                            ld      de,0x0
28299/20F3BA : 1B 85 F3 20                      jp       ah_seg
28300/20F3BE :                          ah_seg_last:
28301/20F3BE : 9E 1A 82                         add     de,(xiz+A_W)            ; into += want
28302/20F3C1 :                          _id_road_ahead_asm__L4:
28303/20F3C1 :                          ah_seg_ok:
28304/20F3C1 :                                  ; rem = span - into
28305/20F3C1 : 95 20                            ld      wa,(xiy)
28306/20F3C3 : DA A0                            sub     wa,de
28307/20F3C5 : DA F0                            cp      wa,de
