26900/20EA11 :                          ; c900 runtime helpers (TLCS-900/H, asl syntax)
26901/20EA11 :                          ; Convention: operands in XWA (left) and XBC (right); result in XWA.
26902/20EA11 :                          ; May clobber XWA XBC XDE XHL XIX XIY.
26903/20EA11 :                          
26904/20EA11 :                          __mul32:
26905/20EA11 : E8 8A                            ld      xde,xwa
26906/20EA13 : E9 8B                            ld      xhl,xbc
26907/20EA15 : D9 40                            mul     xwa,bc
26908/20EA17 : D7 EA 8C                         ld      ix,qde
26909/20EA1A : DB 44                            mul     xix,hl
26910/20EA1C : D7 EE 8D                         ld      iy,qhl
26911/20EA1F : DA 45                            mul     xiy,de
26912/20EA21 : ED 84                            add     xix,xiy
26913/20EA23 : EC EE 00                         sll     16,xix
26914/20EA26 : EC 80                            add     xwa,xix
26915/20EA28 : 0E                               ret
26916/20EA29 :                          
26917/20EA29 :                          ; unsigned 32/32: quotient XWA, remainder XHL
26918/20EA29 :                          __div32u:
26919/20EA29 : EB A8                            ld      xhl,0
26920/20EA2B : 25 20                            ld      e,32
26921/20EA2D :                          __div32u_loop:
26922/20EA2D : E8 EE 01                         sll     1,xwa
26923/20EA30 : EB EA 01                         rl      1,xhl
26924/20EA33 : E9 F3                            cp      xhl,xbc
26925/20EA35 : 67 04                            jr      ult,__div32u_skip
26926/20EA37 : E9 A3                            sub     xhl,xbc
26927/20EA39 : E8 61                            inc     1,xwa
26928/20EA3B :                          __div32u_skip:
26929/20EA3B : CD 1C EF                         djnz    e,__div32u_loop
26930/20EA3E : 0E                               ret
26931/20EA3F :                          
26932/20EA3F :                          __mod32u:
26933/20EA3F : 1D 29 EA 20                      call    __div32u
26934/20EA43 : EB 88                            ld      xwa,xhl
26935/20EA45 : 0E                               ret
26936/20EA46 :                          
26937/20EA46 :                          __div32s:
26938/20EA46 : 1D 52 EA 20                      call    __divmod32s
26939/20EA4A : 0E                               ret
26940/20EA4B :                          
26941/20EA4B :                          __mod32s:
26942/20EA4B : 1D 52 EA 20                      call    __divmod32s
26943/20EA4F : EB 88                            ld      xwa,xhl
26944/20EA51 : 0E                               ret
26945/20EA52 :                          
26946/20EA52 :                          ; signed: quotient XWA, remainder XHL (sign of dividend)
26947/20EA52 :                          __divmod32s:
26948/20EA52 : CC A8                            ld      d,0
26949/20EA54 : E8 CF 00 00 00 00                cp      xwa,0
26950/20EA5A : 69 0B                            jr      ge,__dms_apos
26951/20EA5C : E8 CD FF FF FF FF                xor     xwa,0ffffffffh
26952/20EA62 : E8 61                            inc     1,xwa
26953/20EA64 : CC CD 03                         xor     d,3
26954/20EA67 :                          __dms_apos:
26955/20EA67 : E9 CF 00 00 00 00                cp      xbc,0
26956/20EA6D : 69 0B                            jr      ge,__dms_bpos
26957/20EA6F : E9 CD FF FF FF FF                xor     xbc,0ffffffffh
26958/20EA75 : E9 61                            inc     1,xbc
26959/20EA77 : CC CD 01                         xor     d,1
26960/20EA7A :                          __dms_bpos:
26961/20EA7A : 1D 29 EA 20                      call    __div32u
26962/20EA7E : CC 33 00                         bit     0,d
26963/20EA81 : 66 08                            jr      z,__dms_q
26964/20EA83 : E8 CD FF FF FF FF                xor     xwa,0ffffffffh
26965/20EA89 : E8 61                            inc     1,xwa
26966/20EA8B :                          __dms_q:
26967/20EA8B : CC 33 01                         bit     1,d
26968/20EA8E : 66 08                            jr      z,__dms_r
26969/20EA90 : EB CD FF FF FF FF                xor     xhl,0ffffffffh
