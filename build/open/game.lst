27602/20EDCA :                          
27603/20EDCA :                          ; ================================================================
27604/20EDCA :                          ; void id_road_ahead_asm(RoadAhead *a);
27605/20EDCA :                          ;
27606/20EDCA :                          ; build_road_ahead() de main.c : pour chaque tranche, du pare-chocs vers
27607/20EDCA :                          ; l'horizon, avancer sur le profil jusqu'a la distance que la tranche regarde,
27608/20EDCA :                          ; puis rendre le virage et la pente a cette distance, joints arrondis. La
27609/20EDCA :                          ; version C reste dans main.c (ID_ROAD_AHEAD_C=1) ; tools/equivalence.py prouve
27610/20EDCA :                          ; que les deux rendent la meme RAM, tour par tour, sur les dix circuits.
27611/20EDCA :                          ;
27612/20EDCA :                          ; Registres pendant la boucle :
27613/20EDCA :                          ;   XIX = &ahead[k]            (descend de 2)
27614/20EDCA :                          ;   XHL = &road_bend[k]        (descend de 2)
27615/20EDCA :                          ;   XBC = &id_grade[k]         (descend de 1 ; id_road_grade_buf)
27616/20EDCA :                          ;   XIY = sc, le segment courant
27617/20EDCA :                          ;   DE  = into, la position dans ce segment
27618/20EDCA :                          ;   XIZ = le bloc (ci-dessous)
27619/20EDCA :                          ;
27620/20EDCA :                          ; SECONDE ECRITURE (2026-09-19) : DEUX CACHES PAR SEGMENT, valables un appel.
27621/20EDCA :                          ; Profil par bloc : le fondu aux jonctions coutait 10 000 cycles par tour et la
27622/20EDCA :                          ; borne de pente + grade_tab 8 000, refaits a CHAQUE tranche alors qu'ils ne
27623/20EDCA :                          ; dependent que du SEGMENT tant qu'on y reste :
27624/20EDCA :                          ;   - la pente a plat d'un segment, bornee et convertie, est la meme pour
27625/20EDCA :                          ;     toutes ses tranches (cle A_FKEY) ;
27626/20EDCA :                          ;   - un fondu melange le segment courant et un voisin avec un poids w : les
27627/20EDCA :                          ;     deux ecarts (voisin - courant, virage et pente) ne dependent que du
27628/20EDCA :                          ;     segment et du cote (cles A_NKEY, A_PKEY). Il ne reste par tranche que les
27629/20EDCA :                          ;     deux multiplications, et la seconde saute quand les deux pentes sont
27630/20EDCA :                          ;     egales -- le cas de toute route plate.
27631/20EDCA :                          ; Les cles sont le numero du segment ; 0xFF = vide (track_len est un u8, un
27632/20EDCA :                          ; numero vaut au plus 254). Le C les vide avant chaque appel.
27633/20EDCA :                          ;
27634/20EDCA :                          ; Le bloc RoadAhead (main.c ; taille VERIFIEE a la compilation) :
27635/20EDCA : =0H                      A_AHEAD  equ 0      ; const u16 * &ahead[lines]            (juste APRES la fin)
27636/20EDCA : =4H                      A_BEND   equ 4      ; s16 *       &road_bend[lines]
27637/20EDCA : =8H                      A_GL     equ 8      ; s8 *        &id_grade[lines]
27638/20EDCA : =0CH                     A_SEG    equ 12     ; const Segment * track_seg
27639/20EDCA : =10H                     A_GTAB   equ 16     ; const s8 *  &grade_tab[HILL_SLOPE_MAX]  (indice signe)
27640/20EDCA : =14H                     A_SC     equ 20     ; const Segment * &track_seg[seg_index]
27641/20EDCA : =18H                     A_INTO   equ 24     ; u16 seg_pos
27642/20EDCA : =1AH                     A_W      equ 26     ; u16 want (temporaire, traversee de segments)
27643/20EDCA : =1CH                     A_K      equ 28     ; u8  lignes (> 0)
27644/20EDCA : =1DH                     A_CUR    equ 29     ; u8  seg_index
27645/20EDCA : =1EH                     A_LEN    equ 30     ; u8  track_len
27646/20EDCA : =1FH                     A_FKEY   equ 31     ; u8  segment de la pente a plat en cache (0xFF = vide)
27647/20EDCA : =20H                     A_FG     equ 32     ; s8  cette pente, bornee et convertie
27648/20EDCA : =21H                     A_NKEY   equ 33     ; u8  segment du fondu vers le SUIVANT en cache
27649/20EDCA : =22H                     A_PKEY   equ 34     ; u8  ... vers le PRECEDENT
27650/20EDCA : =24H                     A_NDB    equ 36     ; s16 suivant->bend - bend
27651/20EDCA : =26H                     A_NDP    equ 38     ; s16 suivant->slope - slope
27652/20EDCA : =28H                     A_PDB    equ 40     ; s16 precedent->bend - bend
27653/20EDCA : =2AH                     A_PDP    equ 42     ; s16 precedent->slope - slope
27654/20EDCA :                          ; Segment : span u16 +0, bend s16 +2, slope s8 +4, six octets.
27655/20EDCA :                          
27656/20EDCA :                          
27657/20EDCA :                          _id_road_ahead_asm:
27658/20EDCA : 3E                               push    xiz
27659/20EDCB : AF 08 26                         ld      xiz,(xsp+0x8)
27660/20EDCE : A6 24                            ld      xix,(xiz+A_AHEAD)
27661/20EDD0 : AE 04 23                         ld      xhl,(xiz+A_BEND)
27662/20EDD3 : AE 08 21                         ld      xbc,(xiz+A_GL)
27663/20EDD6 : AE 14 25                         ld      xiy,(xiz+A_SC)
27664/20EDD9 : 9E 18 22                         ld      de,(xiz+A_INTO)
27665/20EDDC :                                  ; la PREMIERE tranche : walked vaut 0
27666/20EDDC : EC 6A                            dec     0x2,xix
27667/20EDDE : EB 6A                            dec     0x2,xhl
27668/20EDE0 : E9 69                            dec     0x1,xbc
27669/20EDE2 : 94 20                            ld      wa,(xix)
