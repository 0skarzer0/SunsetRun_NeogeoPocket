28460/20F529 :                          
28461/20F529 :                          ; ================================================================
28462/20F529 :                          ; void id_road_shear_asm(RoadShearWalk *s);
28463/20F529 :                          ;
28464/20F529 :                          ; Le cisaillement de chaque tranche, en tete de id_road_write() :
28465/20F529 :                          ;   dx = (s16)((lateral * w_lat[k]) >> 8) + curve_dx[k], borne a [min, max].
28466/20F529 :                          ; Le C reste dans id_road.c (ID_ROAD_SHEAR_C=1). cc900 y relisait sur la pile,
28467/20F529 :                          ; a chaque tranche, trois des cinq pointeurs et le deplacement lateral : 13 200
28468/20F529 :                          ; cycles par tour, le plus gros bloc C restant (2026-09-19).
28469/20F529 :                          ;
28470/20F529 :                          ;   XIX = &id_w_lat[k]      (monte de 1)
28471/20F529 :                          ;   XIY = &id_curve_dx[k]   (monte de 2)
28472/20F529 :                          ;   XHL = &id_dx_max[k]     (monte de 2) ; id_dx_min[k] est a -128 (RoadClamp)
28473/20F529 :                          ;   XBC = &id_shear[k]      (monte de 2)
28474/20F529 :                          ;   IZ  = lateral           (xsp+0) = tranches restantes
28475/20F529 : =0H                      S_W      equ 0      ; const u8  * id_w_lat
28476/20F529 : =4H                      S_CV     equ 4      ; const s16 * id_curve_dx
28477/20F529 : =8H                      S_MX     equ 8      ; const s16 * id_dx_max  (id_dx_min = id_dx_max - 128)
28478/20F529 : =0CH                     S_SH     equ 12     ; s16 *       id_shear
28479/20F529 : =10H                     S_LAT    equ 16     ; s16  lateral
28480/20F529 : =12H                     S_N      equ 18     ; u16  lignes (> 0, < 256)
28481/20F529 : =80H                     RC_MIN   equ 0x80   ; id_dx_max - id_dx_min, en octets (RoadClamp)
28482/20F529 :                          
28483/20F529 :                          
28484/20F529 :                          _id_road_shear_asm:
28485/20F529 : 3E                               push    xiz
28486/20F52A : AF 08 20                         ld      xwa,(xsp+0x8)
28487/20F52D : A0 24                            ld      xix,(xwa+S_W)
28488/20F52F : A8 04 25                         ld      xiy,(xwa+S_CV)
28489/20F532 : A8 08 23                         ld      xhl,(xwa+S_MX)
28490/20F535 : A8 0C 21                         ld      xbc,(xwa+S_SH)
28491/20F538 : 98 10 26                         ld      iz,(xwa+S_LAT)
28492/20F53B : 98 12 22                         ld      de,(xwa+S_N)
28493/20F53E : 2A                               push    de                      ; le compteur, en (xsp)
28494/20F53F :                          sh_loop:
28495/20F53F : C5 F0 25                         ld      e,(xix+)
28496/20F542 : DA 12                            extz    de
28497/20F544 : DE 4A                            muls    xde,iz
28498/20F546 : EA ED 08                         sra     0x8,xde                 ; (lateral * w) >> 8 on 32 bits (SUNSET RUN: |lateral| > 128)
28499/20F549 : D5 F5 20                         ld      wa,(xiy+)
28500/20F54C : DA 80                            add     wa,de
28501/20F54E : 93 F0                            cp      wa,(xhl)
28502/20F550 : F2 64 F5 20 DA                   jp       gt,sh_hi                ; dx > max
28503/20F555 : 9B 80 F0                         cp      wa,(xhl-RC_MIN)
28504/20F558 : F2 66 F5 20 D9                   jp       ge,sh_st
28505/20F55D : 9B 80 20                         ld      wa,(xhl-RC_MIN)         ; dx < min
28506/20F560 : 1B 66 F5 20                      jp       sh_st
28507/20F564 :                          sh_hi:
28508/20F564 : 93 20                            ld      wa,(xhl)
28509/20F566 :                          sh_st:
28510/20F566 : F5 E5 50                         ld      (xbc+),wa
28511/20F569 : EB 62                            inc     0x2,xhl
28512/20F56B : 87 69                            decb    0x1,(xsp)
28513/20F56D : F2 3F F5 20 DE                   jp       ne,sh_loop
28514/20F572 : 4A                               pop     de
28515/20F573 : 5E                               pop     xiz
28516/20F574 : 0E                               ret
28517/20F575 :                          
28518/20F575 :                          ; ================================================================
28519/20F575 :                          ; void id_road_curve_asm(RoadCurve *c);
28520/20F575 :                          ;
28521/20F575 :                          ; La double integration de id_road_frame_ahead() : la courbure de chaque
28522/20F575 :                          ; tranche, du pare-chocs vers l'horizon, sommee deux fois -- le cap, puis le
28523/20F575 :                          ; deplacement lateral. Le C reste dans id_road.c (ID_ROAD_CURVE_C=1).
28524/20F575 :                          ;
28525/20F575 :                          ;   XIX = &bend[k] (descend de 2)   XIY = &id_curve_dx[k] (descend de 2)
28526/20F575 :                          ;   DE  = id_curve_cm               BC  = slope      HL = acc      IZ = k
28527/20F575 : =0H                      C_BEND   equ 0      ; const s16 * &bend[lines]
28528/20F575 : =4H                      C_OUT    equ 4      ; s16 *       &id_curve_dx[lines]
28529/20F575 : =8H                      C_CM     equ 8      ; u16 id_curve_cm
28530/20F575 : =0AH                     C_N      equ 10     ; u16 lignes (> 0)
28531/20F575 :                          
28532/20F575 :                          
28533/20F575 :                          _id_road_curve_asm:
28534/20F575 : 3E                               push    xiz
28535/20F576 : AF 08 26                         ld      xiz,(xsp+0x8)
28536/20F579 : A6 24                            ld      xix,(xiz+C_BEND)
28537/20F57B : AE 04 25                         ld      xiy,(xiz+C_OUT)
28538/20F57E : 9E 08 22                         ld      de,(xiz+C_CM)
28539/20F581 : 9E 0A 26                         ld      iz,(xiz+C_N)
28540/20F584 : D9 A8                            ld      bc,0x0
28541/20F586 : DB A8                            ld      hl,0x0
28542/20F588 :                                  ; (Un cache "meme virage que la tranche d'avant, meme c" a ete essaye
28543/20F588 :                                  ; le 2026-09-19 : 71 a 76 % de tranches repetees, et ZERO cycle gagne
28544/20F588 :                                  ; mesure -- la comparaison en memoire et le saut pris coutent ce que la
28545/20F588 :                                  ; multiplication coutait. Retire.)
28546/20F588 :                          cv_loop:
28547/20F588 : EC 6A                            dec     0x2,xix
28548/20F58A : 94 20                            ld      wa,(xix)                ; b
28549/20F58C : D8 D8                            cp      wa,0x0
28550/20F58E : F2 A4 F5 20 D9                   jp       ge,cv_pos
28551/20F593 : D8 07                            neg     wa                      ; mag = -b
28552/20F595 : DA 40                            mul     xwa,de                  ; (u16)mag * cm, 16 bits gardes
28553/20F597 : D8 C8 80 00                      add     wa,0x80
28554/20F59B : D8 EF 08                         srl     0x8,wa                  ; c
28555/20F59E : D8 07                            neg     wa                      ; b < 0 : -c
28556/20F5A0 : 1B AD F5 20                      jp       cv_have
28557/20F5A4 :                          cv_pos:
28558/20F5A4 : DA 40                            mul     xwa,de
28559/20F5A6 : D8 C8 80 00                      add     wa,0x80
28560/20F5AA : D8 EF 08                         srl     0x8,wa
28561/20F5AD :                          cv_have:
28562/20F5AD : D8 81                            add     bc,wa                   ; slope += c
28563/20F5AF : D9 83                            add     hl,bc                   ; acc += slope
28564/20F5B1 : DB 88                            ld      wa,hl
28565/20F5B3 : D8 ED 08                         sra     0x8,wa
28566/20F5B6 : ED 6A                            dec     0x2,xiy
28567/20F5B8 : B5 50                            ld      (xiy),wa                ; id_curve_dx[k] = acc >> 8
28568/20F5BA : DE CA 01 00                      sub     iz,0x1                  ; SUB pose les drapeaux (DEC 16 bits non)
28569/20F5BE : F2 88 F5 20 DE                   jp       ne,cv_loop
28570/20F5C3 : 5E                               pop     xiz
28571/20F5C4 : 0E                               ret
28572/20F5C5 :                          
28573/20F5C5 :                          ; ---- src/spr_cells_asm.asm
28574/20F5C5 :                          ; spr_cells_asm.asm - write a list of 8x8 sprite cells to the K2GE sprite table
28575/20F5C5 :                          ;
28576/20F5C5 :                          ; SUNSET RUN.  The car, the traffic and the roadside objects are all drawn as
28577/20F5C5 :                          ; lists of {cx, cy, ch} cells; this loop replaces three copies of the same C
28578/20F5C5 :                          ; loop (the hottest code of a frame).  asm900 syntax, also assembled by the
28579/20F5C5 :                          ; open toolchain.
28580/20F5C5 :                          ;
28581/20F5C5 :                          ; void spr_cells_asm(SprJob *j);
28582/20F5C5 :                          ;   (xsp+0) return address, (xsp+4) j.  Preserves XIZ (cc900 convention).
28583/20F5C5 :                          ;
28584/20F5C5 :                          
28585/20F5C5 : =0H                      J_CELLS  equ 0      ; const u8 *   cells, 3 bytes each: cx, cy, ch
28586/20F5C5 : =4H                      J_MAP    equ 4      ; const u16 *  tile per ch (when J_HASMAP != 0)
28587/20F5C5 : =8H                      J_BASE   equ 8      ; u16          tile = base + ch (when J_HASMAP == 0)
28588/20F5C5 : =0AH                     J_X      equ 10     ; s16          left edge of the cell grid
28589/20F5C5 : =0CH                     J_Y      equ 12     ; u8           top of the cell grid
28590/20F5C5 : =0DH                     J_N      equ 13     ; u8           number of cells
28591/20F5C5 : =0EH                     J_WM1    equ 14     ; u8           grid width - 1 (mirroring)
28592/20F5C5 : =0FH                     J_ATTR   equ 15     ; u8           flip bits | priority bits
28593/20F5C5 : =10H                     J_PAL    equ 16     ; u8           palette
28594/20F5C5 : =11H                     J_SPR    equ 17     ; u8           next free sprite (in/out)
28595/20F5C5 : =12H                     J_END    equ 18     ; u8           first sprite NOT to use
28596/20F5C5 : =13H                     J_FLIP   equ 19     ; u8           != 0 : mirror the cell columns
28597/20F5C5 : =14H                     J_HASMAP equ 20     ; u8
28598/20F5C5 :                          
28599/20F5C5 :                          
28600/20F5C5 :                          
28601/20F5C5 :                          
28602/20F5C5 :                          _spr_cells_asm:
28603/20F5C5 : 3E                               push    xiz
28604/20F5C6 : AF 08 26                         ld      xiz,(xsp+0x8)
28605/20F5C9 : A6 24                            ld      xix,(xiz+J_CELLS)
28606/20F5CB : 8E 11 23                         ld      c,(xiz+J_SPR)
28607/20F5CE : 8E 0D 22                         ld      b,(xiz+J_N)
28608/20F5D1 : CA D8                            cp      b,0x0
28609/20F5D3 : F2 60 F6 20 D6                   jp      z,sc_done
28610/20F5D8 :                          sc_loop:
28611/20F5D8 : 8E 12 F3                         cp      c,(xiz+J_END)
28612/20F5DB : F2 60 F6 20 DF                   jp      nc,sc_done
28613/20F5E0 : 84 21                            ld      a,(xix)                 ; cx
28614/20F5E2 : 8E 13 3F 00                      cpb     (xiz+J_FLIP),0x0
28615/20F5E6 : 66 07                            jr      z,sc_noflip
28616/20F5E8 : C9 8D                            ld      e,a
28617/20F5EA : 8E 0E 21                         ld      a,(xiz+J_WM1)
28618/20F5ED : CD A1                            sub     a,e
28619/20F5EF :                          sc_noflip:
28620/20F5EF : D8 12                            extz    wa
28621/20F5F1 : D8 EE 03                         sll     0x3,wa
28622/20F5F4 : 9E 0A 80                         add     wa,(xiz+J_X)            ; sx
28623/20F5F7 : D8 8A                            ld      de,wa
28624/20F5F9 : DA C8 08 00                      add     de,0x8
28625/20F5FD : DA CF B0 00                      cp      de,0xb0                 ; -8 <= sx <= 167
28626/20F601 : 6F 54                            jr      nc,sc_next
28627/20F603 :                                  ; HL = 0x8800 + spr * 4
28628/20F603 : CB 8F                            ld      l,c
28629/20F605 : DB 12                            extz    hl
28630/20F607 : DB EE 02                         sll     0x2,hl
28631/20F60A : DB C8 00 88                      add     hl,0x8800
28632/20F60E : EB 12                            extz    xhl
28633/20F610 : BB 02 41                         ld      (xhl+0x2),a             ; x (low byte of sx)
28634/20F613 : 8C 01 21                         ld      a,(xix+0x1)             ; cy * 8 + y
28635/20F616 : C9 EE 03                         sll     0x3,a
28636/20F619 : 8E 0C 81                         add     a,(xiz+J_Y)
28637/20F61C : BB 03 41                         ld      (xhl+0x3),a
28638/20F61F : 8C 02 25                         ld      e,(xix+0x2)             ; ch
28639/20F622 : DA 12                            extz    de
28640/20F624 : 8E 14 3F 00                      cpb     (xiz+J_HASMAP),0x0
28641/20F628 : 66 0C                            jr      z,sc_base
28642/20F62A : DA 82                            add     de,de
28643/20F62C : AE 04 25                         ld      xiy,(xiz+J_MAP)
28644/20F62F : D3 07 F4 E8 22                   ld      de,(xiy+de)
28645/20F634 : 68 03                            jr      sc_tile
28646/20F636 :                          sc_base:
28647/20F636 : 9E 08 82                         add     de,(xiz+J_BASE)
28648/20F639 :                          sc_tile:
28649/20F639 : B3 45                            ld      (xhl),e                 ; tile, low 8 bits
28650/20F63B : CC 89                            ld      a,d
28651/20F63D : C9 CC 01                         and     a,0x1
28652/20F640 : 8E 0F E1                         or      a,(xiz+J_ATTR)
28653/20F643 : BB 01 41                         ld      (xhl+0x1),a
28654/20F646 :                                  ; palette: 0x8C00 + spr
28655/20F646 : CB 8F                            ld      l,c
28656/20F648 : DB 12                            extz    hl
28657/20F64A : DB C8 00 8C                      add     hl,0x8c00
28658/20F64E : EB 12                            extz    xhl
28659/20F650 : 8E 10 21                         ld      a,(xiz+J_PAL)
28660/20F653 : B3 41                            ld      (xhl),a
28661/20F655 : CB 61                            inc     0x1,c
28662/20F657 :                          sc_next:
28663/20F657 : EC 63                            inc     0x3,xix
28664/20F659 : CA 69                            dec     0x1,b
28665/20F65B : F2 D8 F5 20 DE                   jp      nz,sc_loop
28666/20F660 :                          sc_done:
28667/20F660 : BE 11 43                         ld      (xiz+J_SPR),c
28668/20F663 : 5E                               pop     xiz
28669/20F664 : 0E                               ret
