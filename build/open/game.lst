24236/20D192 :                          ; c900 runtime helpers (TLCS-900/H, asl syntax)
24237/20D192 :                          ; Convention: operands in XWA (left) and XBC (right); result in XWA.
24238/20D192 :                          ; May clobber XWA XBC XDE XHL XIX XIY.
24239/20D192 :                          
24240/20D192 :                          __mul32:
24241/20D192 : E8 8A                            ld      xde,xwa
24242/20D194 : E9 8B                            ld      xhl,xbc
24243/20D196 : D9 40                            mul     xwa,bc
24244/20D198 : D7 EA 8C                         ld      ix,qde
24245/20D19B : DB 44                            mul     xix,hl
24246/20D19D : D7 EE 8D                         ld      iy,qhl
24247/20D1A0 : DA 45                            mul     xiy,de
24248/20D1A2 : ED 84                            add     xix,xiy
24249/20D1A4 : EC EE 00                         sll     16,xix
24250/20D1A7 : EC 80                            add     xwa,xix
24251/20D1A9 : 0E                               ret
24252/20D1AA :                          
24253/20D1AA :                          ; unsigned 32/32: quotient XWA, remainder XHL
24254/20D1AA :                          __div32u:
