29163/20FBF9 :                          ; ================================================================
29164/20FBF9 :                          ; void id_road_shear_asm(RoadShearWalk *s);
29165/20FBF9 :                          ;
29166/20FBF9 :                          ; Le cisaillement de chaque tranche, en tete de id_road_write() :
29167/20FBF9 :                          ;   dx = (s16)((lateral * w_lat[k]) >> 8) + curve_dx[k], borne a [min, max].
29168/20FBF9 :                          ; Le C reste dans id_road.c (ID_ROAD_SHEAR_C=1). cc900 y relisait sur la pile,
29169/20FBF9 :                          ; a chaque tranche, trois des cinq pointeurs et le deplacement lateral : 13 200
29170/20FBF9 :                          ; cycles par tour, le plus gros bloc C restant (2026-09-19).
29171/20FBF9 :                          ;
29172/20FBF9 :                          ;   XIX = &id_w_lat[k]      (monte de 1)
29173/20FBF9 :                          ;   XIY = &id_curve_dx[k]   (monte de 2)
29174/20FBF9 :                          ;   XHL = &id_dx_max[k]     (monte de 2) ; id_dx_min[k] est a -128 (RoadClamp)
29175/20FBF9 :                          ;   XBC = &id_shear[k]      (monte de 2)
29176/20FBF9 :                          ;   IZ  = lateral           (xsp+0) = tranches restantes
29177/20FBF9 : =0H                      S_W      equ 0      ; const u8  * id_w_lat
29178/20FBF9 : =4H                      S_CV     equ 4      ; const s16 * id_curve_dx
29179/20FBF9 : =8H                      S_MX     equ 8      ; const s16 * id_dx_max  (id_dx_min = id_dx_max - 128)
29180/20FBF9 : =0CH                     S_SH     equ 12     ; s16 *       id_shear
29181/20FBF9 : =10H                     S_LAT    equ 16     ; s16  lateral
29182/20FBF9 : =12H                     S_N      equ 18     ; u16  lignes (> 0, < 256)
29183/20FBF9 : =80H                     RC_MIN   equ 0x80   ; id_dx_max - id_dx_min, en octets (RoadClamp)
29184/20FBF9 :                          
29185/20FBF9 :                          
29186/20FBF9 :                          _id_road_shear_asm:
29187/20FBF9 : 3E                               push    xiz
29188/20FBFA : AF 08 20                         ld      xwa,(xsp+0x8)
29189/20FBFD : A0 24                            ld      xix,(xwa+S_W)
29190/20FBFF : A8 04 25                         ld      xiy,(xwa+S_CV)
29191/20FC02 : A8 08 23                         ld      xhl,(xwa+S_MX)
29192/20FC05 : A8 0C 21                         ld      xbc,(xwa+S_SH)
29193/20FC08 : 98 10 26                         ld      iz,(xwa+S_LAT)
29194/20FC0B : 98 12 22                         ld      de,(xwa+S_N)
29195/20FC0E : 2A                               push    de                      ; le compteur, en (xsp)
29196/20FC0F :                          sh_loop:
29197/20FC0F : C5 F0 25                         ld      e,(xix+)
29198/20FC12 : DA 12                            extz    de
29199/20FC14 : DE 4A                            muls    xde,iz
29200/20FC16 : EA ED 08                         sra     0x8,xde                 ; (lateral * w) >> 8 on 32 bits (SUNSET RUN: |lateral| > 128)
29201/20FC19 : D5 F5 20                         ld      wa,(xiy+)
29202/20FC1C : DA 80                            add     wa,de
29203/20FC1E : 93 F0                            cp      wa,(xhl)
29204/20FC20 : F2 34 FC 20 DA                   jp       gt,sh_hi                ; dx > max
29205/20FC25 : 9B 80 F0                         cp      wa,(xhl-RC_MIN)
29206/20FC28 : F2 36 FC 20 D9                   jp       ge,sh_st
29207/20FC2D : 9B 80 20                         ld      wa,(xhl-RC_MIN)         ; dx < min
29208/20FC30 : 1B 36 FC 20                      jp       sh_st
29209/20FC34 :                          sh_hi:
29210/20FC34 : 93 20                            ld      wa,(xhl)
29211/20FC36 :                          sh_st:
29212/20FC36 : F5 E5 50                         ld      (xbc+),wa
29213/20FC39 : EB 62                            inc     0x2,xhl
29214/20FC3B : 87 69                            decb    0x1,(xsp)
29215/20FC3D : F2 0F FC 20 DE                   jp       ne,sh_loop
29216/20FC42 : 4A                               pop     de
29217/20FC43 : 5E                               pop     xiz
29218/20FC44 : 0E                               ret
29219/20FC45 :                          
29220/20FC45 :                          ; ================================================================
29221/20FC45 :                          ; void id_road_curve_asm(RoadCurve *c);
29222/20FC45 :                          ;
29223/20FC45 :                          ; La double integration de id_road_frame_ahead() : la courbure de chaque
29224/20FC45 :                          ; tranche, du pare-chocs vers l'horizon, sommee deux fois -- le cap, puis le
29225/20FC45 :                          ; deplacement lateral. Le C reste dans id_road.c (ID_ROAD_CURVE_C=1).
29226/20FC45 :                          ;
29227/20FC45 :                          ;   XIX = &bend[k] (descend de 2)   XIY = &id_curve_dx[k] (descend de 2)
29228/20FC45 :                          ;   DE  = id_curve_cm               BC  = slope      HL = acc      IZ = k
29229/20FC45 : =0H                      C_BEND   equ 0      ; const s16 * &bend[lines]
29230/20FC45 : =4H                      C_OUT    equ 4      ; s16 *       &id_curve_dx[lines]
29231/20FC45 : =8H                      C_CM     equ 8      ; u16 id_curve_cm
29232/20FC45 : =0AH                     C_N      equ 10     ; u16 lignes (> 0)
29233/20FC45 :                          
29234/20FC45 :                          
29235/20FC45 :                          _id_road_curve_asm:
29236/20FC45 : 3E                               push    xiz
29237/20FC46 : AF 08 26                         ld      xiz,(xsp+0x8)
29238/20FC49 : A6 24                            ld      xix,(xiz+C_BEND)
29239/20FC4B : AE 04 25                         ld      xiy,(xiz+C_OUT)
29240/20FC4E : 9E 08 22                         ld      de,(xiz+C_CM)
29241/20FC51 : 9E 0A 26                         ld      iz,(xiz+C_N)
29242/20FC54 : D9 A8                            ld      bc,0x0
29243/20FC56 : DB A8                            ld      hl,0x0
29244/20FC58 :                                  ; (Un cache "meme virage que la tranche d'avant, meme c" a ete essaye
29245/20FC58 :                                  ; le 2026-09-19 : 71 a 76 % de tranches repetees, et ZERO cycle gagne
29246/20FC58 :                                  ; mesure -- la comparaison en memoire et le saut pris coutent ce que la
29247/20FC58 :                                  ; multiplication coutait. Retire.)
29248/20FC58 :                          cv_loop:
29249/20FC58 : EC 6A                            dec     0x2,xix
29250/20FC5A : 94 20                            ld      wa,(xix)                ; b
29251/20FC5C : D8 D8                            cp      wa,0x0
29252/20FC5E : F2 74 FC 20 D9                   jp       ge,cv_pos
29253/20FC63 : D8 07                            neg     wa                      ; mag = -b
29254/20FC65 : DA 40                            mul     xwa,de                  ; (u16)mag * cm, 16 bits gardes
29255/20FC67 : D8 C8 80 00                      add     wa,0x80
29256/20FC6B : D8 EF 08                         srl     0x8,wa                  ; c
29257/20FC6E : D8 07                            neg     wa                      ; b < 0 : -c
29258/20FC70 : 1B 7D FC 20                      jp       cv_have
29259/20FC74 :                          cv_pos:
29260/20FC74 : DA 40                            mul     xwa,de
29261/20FC76 : D8 C8 80 00                      add     wa,0x80
29262/20FC7A : D8 EF 08                         srl     0x8,wa
29263/20FC7D :                          cv_have:
29264/20FC7D : D8 81                            add     bc,wa                   ; slope += c
29265/20FC7F : D9 83                            add     hl,bc                   ; acc += slope
