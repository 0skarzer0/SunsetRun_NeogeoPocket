24309/20D21A :                          ; ---- src/core/ngpc_flash_asm.asm
24310/20D21A :                          
24311/20D21A :                          ;
24312/20D21A :                          ; ngpc_flash_asm.asm - Flash erase/write primitives for ngpc_flash.c
24313/20D21A :                          ;
24314/20D21A :                          ; Part of NgpCraft_base_template (MIT License)
24315/20D21A :                          ;
24316/20D21A :                          ; Two entry points, both called ONLY by ngpc_flash.c (never from an ISR):
24317/20D21A :                          ;
24318/20D21A :                          ;   _ngpc_flash_erase_asm(u32 abs_block)
24319/20D21A :                          ;       Erases one 8 KB block with the AMD erase stub extracted from StarGunner
24320/20D21A :                          ;       (hardware-validated), copied to RAM 0x6E00 and run from there.
24321/20D21A :                          ;       VECT_FLASHERS cannot erase blocks 32/33/34 (SysCall.txt p.299), so the
24322/20D21A :                          ;       erase keeps the stub.
24323/20D21A :                          ;
24324/20D21A :                          ;   _ngpc_flash_write_bios(const void *src, u32 offset, u32 pages)
24325/20D21A :                          ;       Programs pages x 256 bytes through the BIOS (VECT_FLASHWRITE, swi 1),
24326/20D21A :                          ;       the path StarGunner uses on hardware. The watchdog is refreshed right
24327/20D21A :                          ;       before and right after, as in the SDK save pattern.
24328/20D21A :                          ;
24329/20D21A :                          ; THE BLOCK IS A PARAMETER, NOT A CONSTANT. The save block sits 0x6000 below
24330/20D21A :                          ; the top of the chip, so its address depends on the cartridge size:
24331/20D21A :                          ; 0x27A000 on 4 Mbit, 0x2FA000 on 8 Mbit, 0x3FA000 on 16 Mbit. A hard-coded
24332/20D21A :                          ; 0x3FA000 erases 8 KB ELSEWHERE on a smaller chip - possibly the game code.
24333/20D21A :                          ; ngpc_flash.c reads the size the BIOS stores at 0x6C58 and refuses unknown ones.
24334/20D21A :                          ;
24335/20D21A :                          ; cc900 ABI (CALL pushes 4-byte XPC as return address):
24336/20D21A :                          ;   (xsp+0)..(xsp+3)  = return address
24337/20D21A :                          ;   (xsp+4)..(xsp+7)  = 1st parameter
24338/20D21A :                          ;   (xsp+8)..(xsp+11) = 2nd parameter
24339/20D21A :                          ;   (xsp+12)..(xsp+15)= 3rd parameter
24340/20D21A :                          ;
24341/20D21A :                          ; ===========================================================================
24342/20D21A :                          ; INTERRUPTS ARE PROHIBITED FOR THE WHOLE SEQUENCE. On hardware that is not
24343/20D21A :                          ; optional. A flash chip being programmed or erased answers reads with STATUS,
24344/20D21A :                          ; not with its contents. The stub runs from RAM for that reason, but the
24345/20D21A :                          ; interrupt handlers are still in the cartridge: an interrupt taken while the
24346/20D21A :                          ; chip is busy fetches its handler from status bits. A game taking VBlank at
24347/20D21A :                          ; 60 Hz cannot get through a 256-byte program or an 8 KB erase without one.
24348/20D21A :                          ;
24349/20D21A :                          ; AN EMULATOR WHOSE FLASH KEEPS SERVING ROM DURING THE WRITE NEVER SHOWS THIS.
24350/20D21A :                          ; Toshiba: "all interrupts are prohibited during system calls related to flash
24351/20D21A :                          ; memory management" (SysCall.txt). Hence `di` (encoded 06 07 = EI 7) on entry
24352/20D21A :                          ; and `ei 0` (06 00) on exit: level 0 is what ngpc_init() runs the game at.
24353/20D21A :                          ; ===========================================================================
24354/20D21A :                          
24355/20D21A :                          
24356/20D21A :                          
24357/20D21A : =6E00H                   FLASH_RAM       equ     0x6E00          ; RAM address for stub execution
24358/20D21A : =6EH                     FLASH_BUS_CTRL  equ     0x6E            ; I/O: flash /WE enable (0x14=on, 0xF0=off)
24359/20D21A : =6FH                     FLASH_WD        equ     0x6F            ; I/O: watchdog  (0xB1=extended, 0x4E=refresh)
24360/20D21A : =200000H                 CART_BASE       equ     0x200000        ; CS0 base address
24361/20D21A :                          
24362/20D21A :                          
24363/20D21A :                          
24364/20D21A :                          ; ===========================================================================
24365/20D21A :                          ; _ngpc_flash_erase_asm
24366/20D21A :                          ;   param 1 (xsp+4) : u32 abs_block -- ABSOLUTE address of the 8 KB block
24367/20D21A :                          ; C prototype: void ngpc_flash_erase_asm(u32 abs_block);
24368/20D21A :                          ; ===========================================================================
24369/20D21A :                          _ngpc_flash_erase_asm:
24370/20D21A :                          
24371/20D21A : 06 07                            di                              ; see the note at the top of the file
24372/20D21C : 08 6E 14                         ld      (FLASH_BUS_CTRL),0x14   ; enable /WE on cart bus
24373/20D21F : 08 6F B1                         ld      (FLASH_WD),0xB1         ; watchdog: extended mode
24374/20D222 :                          
24375/20D222 :                                  ; Copy erase stub (98 bytes) from ROM to RAM at FLASH_RAM
24376/20D222 : 39                               push    xbc                     ; preserve XBC across copy
24377/20D223 : 42 00 6E 00 00                   ld      xde,FLASH_RAM           ; destination: RAM
24378/20D228 : 43 6F D2 20 00                   ld      xhl,_erase_stub         ; source: stub bytes in ROM
24379/20D22D : 31 62 00                         ld      bc,0x62                 ; BC = 98 bytes
24380/20D230 : 83 11                            db      0x83,0x11               ; ldir (xde+),(xhl+) -- copy BC bytes
24381/20D232 : 59                               pop     xbc                     ; restore XBC (stack back to entry)
24382/20D233 :                          
24383/20D233 :                                  ; Set up registers for stub call
24384/20D233 : 44 00 00 20 00                   ld      xix,CART_BASE           ; XIX = 0x200000 (AMD unlock base)
24385/20D238 : ED A8                            ld      xiy,0x0                 ; XIY = 0 (erase stub uses as delay counter)
24386/20D23A : C9 A8                            ld      a,0x0                   ; A = 0 (erase stub state init)
24387/20D23C : AF 04 22                         ld      xde,(xsp+4)             ; XDE = block, given by the caller
24388/20D23F :                          
24389/20D23F : 1C 00 6E                         call    FLASH_RAM               ; execute stub from RAM
24390/20D242 :                          
24391/20D242 : 08 6E F0                         ld      (FLASH_BUS_CTRL),0xF0   ; restore watchdog mode first
24392/20D245 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; then refresh the enabled watchdog
24393/20D248 : 06 00                            ei      0                       ; the chip answers as memory again
24394/20D24A : 0E                               ret
24395/20D24B :                          
24396/20D24B :                          
24397/20D24B :                          ; ===========================================================================
24398/20D24B :                          ; _ngpc_flash_write_bios
24399/20D24B :                          ;   param 1 (xsp+4)  : const void *src -- source buffer, in RAM
24400/20D24B :                          ;   param 2 (xsp+8)  : u32 offset      -- offset INSIDE the cartridge
24401/20D24B :                          ;                                         (e.g. 0x1FA000 + slot*SAVE_SIZE),
24402/20D24B :                          ;                                         not the absolute address: XDE3 wants
24403/20D24B :                          ;                                         the offset.
24404/20D24B :                          ;   param 3 (xsp+12) : u32 pages       -- number of 256-byte units
24405/20D24B :                          ; C prototype: void ngpc_flash_write_bios(const void *src, u32 offset, u32 pages);
24406/20D24B :                          ;
24407/20D24B :                          ; The BIOS holds the bus itself (no manual 0x6E write). The AMD write stub used
24408/20D24B :                          ; before disabled the watchdog and wrote its refresh code while it was off.
24409/20D24B :                          ; ===========================================================================
24410/20D24B :                          _ngpc_flash_write_bios:
24411/20D24B :                          
24412/20D24B : 06 07                            di                              ; see the note at the top of the file
24413/20D24D : AF 04 23                         ld      xhl,(xsp+4)             ; 1st param: source
24414/20D250 : AF 08 22                         ld      xde,(xsp+8)             ; 2nd param: cartridge offset
24415/20D253 : AF 0C 21                         ld      xbc,(xsp+12)            ; 3rd param: 256-byte pages
24416/20D256 : E7 3C 9B                         ld      xhl3,xhl                ; bank 3: the BIOS reads its arguments there
24417/20D259 : E7 38 9A                         ld      xde3,xde
24418/20D25C : E7 34 99                         ld      xbc3,xbc
24419/20D25F : C7 30 A8                         ld      ra3,0                   ; CS0
24420/20D262 : C7 31 AE                         ld      rw3,0x0006              ; VECT_FLASHWRITE
24421/20D265 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; watchdog refreshed RIGHT BEFORE
24422/20D268 : F9                               swi     1
24423/20D269 : 08 6F 4E                         ld      (FLASH_WD),0x4E         ; and right after
24424/20D26C : 06 00                            ei      0
24425/20D26E : 0E                               ret
24426/20D26F :                          
24427/20D26F :                          
24428/20D26F :                          ; ===========================================================================
24429/20D26F :                          ; Erase stub, extracted from StarGunner/bin/main.ngp (hardware-validated).
24430/20D26F :                          ; 98 bytes, file offset 0x13733. Position-independent, uses XIX for AMD cycles.
24431/20D26F :                          ;   AMD unlock -> reset -> unlock -> erase setup (0x80) -> unlock -> sector
24432/20D26F :                          ;   erase (0x30) -> poll DQ7 -> final reset/unlock -> ret
24433/20D26F :                          ;   Register interface: XIX=cart_base XDE=block_addr XIY=0 A=0
24434/20D26F :                          ; ===========================================================================
24435/20D26F :                          
24436/20D26F :                          _erase_stub:
24437/20D26F : F3 F1 55 55 00 AA F3 F1          db      0xF3,0xF1,0x55,0x55,0x00,0xAA, 0xF3,0xF1,0xAA,0x2A,0x00,0x55
      20D277 : AA 2A 00 55            
24438/20D27B : F3 F1 55 55 00 F0 00 00          db      0xF3,0xF1,0x55,0x55,0x00,0xF0, 0x00,0x00,0xF3,0xF1,0x55,0x55
      20D283 : F3 F1 55 55            
24439/20D287 : 00 AA F3 F1 AA 2A 00 55          db      0x00,0xAA,0xF3,0xF1,0xAA,0x2A, 0x00,0x55,0xF3,0xF1,0x55,0x55
      20D28F : F3 F1 55 55            
24440/20D293 : 00 80 F3 F1 55 55 00 AA          db      0x00,0x80,0xF3,0xF1,0x55,0x55, 0x00,0xAA,0xF3,0xF1,0xAA,0x2A
      20D29B : F3 F1 AA 2A            
