21604/20B8F8 : CA 89                            ld      a,b
21605/20B8FA : C8 81                            add     a,w
21606/20B8FC : F2 0E B9 20 D7                   jp       ult,vw_c1               ; premiere retenue
21607/20B901 : C8 81                            add     a,w
21608/20B903 : F2 15 B9 20 D7                   jp       ult,vw_one              ; une seule retenue : une ligne
21609/20B908 : C9 8A                            ld      b,a                     ; aucune : la tranche ne prend pas de ligne
21610/20B90A : 1B 8B B9 20                      jp       vw_next
