21460/20B87C : AF 04 20                         ld      xwa,(xsp+4)
21461/20B87F : E8 2E 0C                         ldc    dmas3,xwa
21462/20B882 : AF 08 20                         ld      xwa,(xsp+8)
21463/20B885 : E8 2E 1C                         ldc    dmad3,xwa
21464/20B888 : 9F 0C 20                         ld      wa,(xsp+12)
21465/20B88B : D8 2E 2C                         ldc    dmac3,wa
