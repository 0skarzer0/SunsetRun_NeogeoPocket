27841/20F2EA :                          ; c900 runtime helpers (TLCS-900/H, asl syntax)
27842/20F2EA :                          ; Convention: operands in XWA (left) and XBC (right); result in XWA.
27843/20F2EA :                          ; May clobber XWA XBC XDE XHL XIX XIY.
27844/20F2EA :                          
27845/20F2EA :                          __mul32:
27846/20F2EA : E8 8A                            ld      xde,xwa
27847/20F2EC : E9 8B                            ld      xhl,xbc
27848/20F2EE : D9 40                            mul     xwa,bc
27849/20F2F0 : D7 EA 8C                         ld      ix,qde
27850/20F2F3 : DB 44                            mul     xix,hl
27851/20F2F5 : D7 EE 8D                         ld      iy,qhl
27852/20F2F8 : DA 45                            mul     xiy,de
27853/20F2FA : ED 84                            add     xix,xiy
27854/20F2FC : EC EE 00                         sll     16,xix
27855/20F2FF : EC 80                            add     xwa,xix
