29456/20FD8F : 3E                               push    xiz
29457/20FD90 : AF 08 20                         ld      xwa,(xsp+0x8)
29458/20FD93 : A0 24                            ld      xix,(xwa+F_GRID)
29459/20FD95 : A8 04 25                         ld      xiy,(xwa+F_PREV)
29460/20FD98 : A8 08 23                         ld      xhl,(xwa+F_VRAM)
29461/20FD9B : 98 0C 21                         ld      bc,(xwa+F_ROWS)         ; C = rows, B = cols
29462/20FD9E : 29                               push    bc
29463/20FD9F : CA 89                            ld      a,b
29464/20FDA1 : D8 12                            extz    wa
29465/20FDA3 : D8 80                            add     wa,wa
29466/20FDA5 : D8 07                            neg     wa                      ; -2 * cols
29467/20FDA7 : D8 8A                            ld      de,wa
29468/20FDA9 : DA C8 28 00                      add     de,0x28                 ; 40 - 2 cols: next row of the grids
29469/20FDAD : EA 12                            extz    xde
29470/20FDAF : D8 8E                            ld      iz,wa
29471/20FDB1 : DE C8 40 00                      add     iz,0x40                 ; 64 - 2 cols: next SCR1 row
29472/20FDB5 : EE 12                            extz    xiz
29473/20FDB7 :                          of_row:
29474/20FDB7 : 8F 01 22                         ld      b,(xsp+0x1)
29475/20FDBA :                          of_col:
29476/20FDBA : D5 F1 20                         ld      wa,(xix+)
29477/20FDBD : 95 F0                            cp      wa,(xiy)
29478/20FDBF : 66 04                            jr      z,of_same
29479/20FDC1 : B5 50                            ld      (xiy),wa
29480/20FDC3 : B3 50                            ld      (xhl),wa
29481/20FDC5 :                          of_same:
29482/20FDC5 : ED 62                            inc     0x2,xiy
29483/20FDC7 : EB 62                            inc     0x2,xhl
29484/20FDC9 : CA 69                            dec     0x1,b
29485/20FDCB : 6E ED                            jr      nz,of_col
